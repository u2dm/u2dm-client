    user-dm)         echo 'U2DM_DEMO_USER_INFO=verified' ;;
    user-dm-start)   echo 'U2DM_DEMO_USER_INFO=slow' ;;
    user-dm-failures) echo 'U2DM_DEMO_USER_INFO=dm-fails' ;;
    user-sessions)   echo 'U2DM_DEMO_WINDOW=900x760' ;;
    user-verify)     echo 'U2DM_DEMO_WINDOW=900x760' ;;
    user-verify-new-chat) echo 'U2DM_DEMO_USER_INFO=slow U2DM_DEMO_WINDOW=900x760' ;;
    user-verify-failures) echo 'U2DM_DEMO_USER_INFO=verify-fails U2DM_DEMO_WINDOW=900x760' ;;
    user-verify-declined) echo 'U2DM_DEMO_USER_INFO=verify-declined U2DM_DEMO_WINDOW=900x760' ;;
    user-verify-unverified-session) echo 'U2DM_DEMO_ENCRYPTION=unverified U2DM_DEMO_WINDOW=900x760' ;;
    user-ignore)     echo 'U2DM_DEMO_USER_INFO=slow' ;;
    user-moderation) echo 'U2DM_DEMO_USER_INFO=admin,slow' ;;
    user-moderation-failures) echo 'U2DM_DEMO_USER_INFO=admin,kick-fails' ;;
    user-tags)       echo 'U2DM_DEMO_RICHTEXT=links,bare' ;;
    custom-emoji)    echo 'U2DM_DEMO_RICHTEXT=emoji U2DM_DEMO_WINDOW=900x1400' ;;
    spoilers)        echo 'U2DM_DEMO_RICHTEXT=spoilers U2DM_DEMO_WINDOW=900x1400' ;;
    message-types)   echo 'U2DM_DEMO_MSGTYPES=all U2DM_DEMO_WINDOW=900x1400' ;;
    message-link)    echo 'U2DM_DEMO_MESSAGE_MENU=slow' ;;
    message-source)  echo 'U2DM_DEMO_MESSAGE_MENU=slow' ;;
    message-pins)    echo 'U2DM_DEMO_MESSAGE_MENU=slow U2DM_DEMO_PINNED=slow' ;;
    message-pin-failures) echo 'U2DM_DEMO_MESSAGE_MENU=pin-fails' ;;
    message-delete)  echo 'U2DM_DEMO_MESSAGE_MENU=slow U2DM_DEMO_PINNED=slow' ;;
    message-delete-failures) echo 'U2DM_DEMO_MESSAGE_MENU=delete-fails,member' ;;
