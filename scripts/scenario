scenario_note() {
  case $1 in
    unread-anchor)   echo 'deep history, a repeated Reset: anchor_index must equal the one first_unread row' ;;
    all-unread)      echo 'every loaded message unread, so the anchor is the top row' ;;
    unread-unresolved) echo 'the read position cannot be placed, so opening the room withholds the receipt' ;;
    reactions-late)  echo 'every chip arrives as a Set, with an overflow run and a crowd of reactors' ;;
    sticker-trickle) echo 'images arrive one batch at a time over a slow catalog, in an encrypted room' ;;
    jump-to-reply)   echo 'a short live window, so a reply quote must take the focused /context path' ;;
    pinned-bar)      echo 'three pins arrive late; opening keeps the newest preview, previous/next navigate through focused windows, then previous finishes on pin 1 / 3' ;;
    media-failures)  echo 'every MediaFailure variant on one timeline' ;;
    compact-layout)  echo 'below the 720px breakpoint; run with --headless, a compositor clamps the width' ;;
    login-oauth)     echo 'starts logged out on an OAuth flow that succeeds slowly' ;;
    logout-left-behind) echo 'Log Out shows signing-out for 3s, then the homeserver never confirms, so the login form names the device (device-left-behind)' ;;
    identity-diverged) echo 'the restore finds another signing key published for the device and cannot sign it out: identity-diverged and device-left-behind on the login form' ;;
    login-no-sliding-sync) echo 'the homeserver offers no sliding sync, so the server check stays on the homeserver step with sliding-sync-unsupported' ;;
    sync-unsupported) echo 'a restored session whose homeserver refuses sliding sync every 4s: the drawer status stays sliding-sync-unsupported, and the toast, dismissed, does not come back' ;;
    verify-self)     echo 'a scripted SAS verification arriving 3s after the chat opens' ;;
    audio-track)     echo 'a track downloads slowly, starts playing, and keeps playing after switching rooms' ;;
    voice-notes)     echo 'a voice note advances to the next one, whose download then fails' ;;
    delivery-marks)  echo 'read marks arrive as Sets, a crowd has read the newest, and a sent text turns read live' ;;
    space-index)     echo 'the Matrix space index loads slowly, pages, and joins a room that turns to Open on the sync echo' ;;
    polls)           echo 'tallies arrive as Sets while members keep voting; an own vote and an own multi-choice change land, then the own poll is ended' ;;
    poll-edits)      echo 'an own unanswered poll is edited, keeping two answer ids, then the room list bars voting in every poll' ;;
    room-info)       echo 'the room info of a 1243-member room loads slowly, pages, filters, and turns notifications to mentions' ;;
    room-leave)      echo 'a room is left from its room info; it drops from the list on the sync echo and the timeline closes' ;;
    room-info-failures) echo 'the member list fails once and is retried, then a notification change and a leave fail inline' ;;
    room-info-pane)  echo 'with the docked pane up, the sheet follows two room switches and ignores a close meant for the dialog' ;;
    room-menu)       echo 'from !rust, the room menu marks !trip read, mutes it to mentions, and two quick room links coalesce to the second' ;;
