    announcement-room) echo 'U2DM_DEMO_POWERS=reactions-only U2DM_DEMO_WINDOW=900x760' ;;
    powers-revoked)  echo 'U2DM_DEMO_POWERS=revoked U2DM_DEMO_WINDOW=900x760' ;;
    readers)         echo 'U2DM_DEMO_RECEIPTS=late,throng U2DM_DEMO_ROOM_INFO=slow' ;;
    room-search)     echo 'U2DM_DEMO_WINDOW=900x760' ;;
    room-search-open) echo 'U2DM_DEMO_WINDOW=900x760' ;;
    subspace-tabs)   echo 'U2DM_DEMO_WINDOW=900x760' ;;
    reduced-motion)  echo 'U2DM_DEMO_MOTION=reduced U2DM_DEMO_WINDOW=900x760' ;;
    mentions)        echo 'U2DM_DEMO_ROOM_INFO=slow' ;;
    room-mention)    echo 'U2DM_DEMO_WINDOW=900x760' ;;
    display-names)   echo 'U2DM_DEMO_NAMES=all' ;;
    message-shields) echo 'U2DM_DEMO_SHIELDS=all U2DM_DEMO_WINDOW=900x1400' ;;
    identity-alerts) echo 'U2DM_DEMO_IDENTITY=reset,own-reset U2DM_DEMO_WINDOW=900x760' ;;
    identity-held-sends) echo 'U2DM_DEMO_IDENTITY=verified-reset U2DM_DEMO_WINDOW=900x760' ;;
    encryption-unverified) echo 'U2DM_DEMO_ENCRYPTION=unverified U2DM_DEMO_WINDOW=900x760' ;;
    encryption-recovery-key) echo 'U2DM_DEMO_ENCRYPTION=unverified,no-sessions,slow U2DM_DEMO_WINDOW=900x760' ;;
    encryption-new-account) echo 'U2DM_DEMO_ENCRYPTION=new-account,key-storage-off U2DM_DEMO_WINDOW=900x760' ;;
    encryption-setup-refused) echo 'U2DM_DEMO_ENCRYPTION=setup-refused U2DM_DEMO_WINDOW=900x760' ;;
    identity-reset)  echo 'U2DM_DEMO_ENCRYPTION=unverified,no-sessions,no-recovery U2DM_DEMO_WINDOW=900x760' ;;
    identity-reset-oauth) echo 'U2DM_DEMO_ENCRYPTION=unverified,no-sessions,no-recovery U2DM_DEMO_ACCOUNT=oauth U2DM_DEMO_WINDOW=900x760' ;;
    room-keys)       echo 'U2DM_DEMO_ENCRYPTION=slow U2DM_DEMO_WINDOW=900x760' ;;
    account-sessions) echo 'U2DM_DEMO_ACCOUNT=slow U2DM_DEMO_WINDOW=900x760' ;;
    account-password) echo 'U2DM_DEMO_ACCOUNT=two-stages U2DM_DEMO_WINDOW=900x760' ;;
    account-sso)     echo 'U2DM_DEMO_ACCOUNT=sso-unfinished U2DM_DEMO_WINDOW=900x760' ;;
    account-oauth)   echo 'U2DM_DEMO_ACCOUNT=oauth,forgets-rooms U2DM_DEMO_WINDOW=900x760' ;;
    account-limits)  echo 'U2DM_DEMO_ACCOUNT=no-password-change,profile-managed,unsupported U2DM_DEMO_WINDOW=900x760' ;;
    account-deactivate) echo 'U2DM_DEMO_ACCOUNT=dummy U2DM_DEMO_WINDOW=900x760' ;;
    logout-warning)  echo 'U2DM_DEMO_ACCOUNT=last-session,unsent U2DM_DEMO_ENCRYPTION=no-recovery U2DM_DEMO_WINDOW=900x760' ;;
    invites)         echo 'U2DM_DEMO_INVITES=slow,late U2DM_DEMO_WINDOW=900x760' ;;
    invites-folded)  echo 'U2DM_DEMO_WINDOW=900x760' ;;
    invite-failures) echo 'U2DM_DEMO_INVITES=accept-fails,decline-fails,revoked U2DM_DEMO_WINDOW=900x760' ;;
    removals)        echo 'U2DM_DEMO_DEPARTURES=removed,kicked,slow U2DM_DEMO_WINDOW=900x760' ;;
    removal-failures) echo 'U2DM_DEMO_DEPARTURES=removed,forget-fails U2DM_DEMO_WINDOW=900x760' ;;
    leave-space)     echo 'U2DM_DEMO_DEPARTURES=slow,sole-admin U2DM_DEMO_WINDOW=900x760' ;;
    leave-space-failures) echo 'U2DM_DEMO_DEPARTURES=room-stays U2DM_DEMO_WINDOW=900x760' ;;
    moderation-reasons) echo 'U2DM_DEMO_DEPARTURES=reasons U2DM_DEMO_USER_INFO=admin U2DM_DEMO_WINDOW=900x760' ;;
    room-upgrades)   echo 'U2DM_DEMO_UPGRADES=slow U2DM_DEMO_WINDOW=900x760' ;;
    room-state)      echo 'U2DM_DEMO_WINDOW=900x760' ;;
    room-upgrade-failures) echo 'U2DM_DEMO_UPGRADES=join-fails U2DM_DEMO_WINDOW=900x760' ;;
    room-links)      echo 'U2DM_DEMO_LINKS=slow U2DM_DEMO_WINDOW=900x760' ;;
    room-finder)     echo 'U2DM_DEMO_LINKS=slow U2DM_DEMO_WINDOW=700x900' ;;
    room-link-failures) echo 'U2DM_DEMO_LINKS=preview-fails,join-fails U2DM_DEMO_WINDOW=900x760' ;;
    create-room)     echo 'U2DM_DEMO_CREATE_ROOM=slow U2DM_DEMO_WINDOW=900x760' ;;
    create-space)    echo 'U2DM_DEMO_WINDOW=900x760' ;;
    create-in-space) echo 'U2DM_DEMO_CREATE_ROOM=parent-late U2DM_DEMO_WINDOW=900x760' ;;
    create-room-failures) echo 'U2DM_DEMO_CREATE_ROOM=child-fails U2DM_DEMO_WINDOW=900x760' ;;
    invite-people)   echo 'U2DM_DEMO_INVITE_PEOPLE=slow U2DM_DEMO_WINDOW=900x760' ;;
    invite-people-failures) echo 'U2DM_DEMO_INVITE_PEOPLE=blocked,search-fails U2DM_DEMO_WINDOW=900x760' ;;
    typing)          echo 'U2DM_DEMO_TYPING=two U2DM_DEMO_WINDOW=900x760' ;;
    typing-names)    echo 'U2DM_DEMO_TYPING=two U2DM_DEMO_NAMES=clash U2DM_DEMO_WINDOW=900x760' ;;
    presence)        echo 'U2DM_DEMO_PRESENCE=partners,status U2DM_DEMO_WINDOW=900x760' ;;
    presence-idle)   echo 'U2DM_DEMO_PRESENCE=partners U2DM_DEMO_WINDOW=900x760' ;;
    presence-off)    echo 'U2DM_DEMO_WINDOW=900x760' ;;
    presence-refused) echo 'U2DM_DEMO_PRESENCE=refused U2DM_DEMO_WINDOW=900x760' ;;
    calls-active)    echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
    call-ring)       echo 'U2DM_DEMO_CALLS=ring U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-ring-ends)  echo 'U2DM_DEMO_CALLS=ring,ring-ends U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-ring-elsewhere) echo 'U2DM_DEMO_CALLS=ring,answered-elsewhere U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-ring-unconfirmed) echo 'U2DM_DEMO_CALLS=ring,ring-unconfirmed U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-expiry)     echo 'U2DM_DEMO_CALLS=active,expiring U2DM_DEMO_WINDOW=900x760' ;;
    call-join)       echo 'U2DM_DEMO_CALLS=active,speaking U2DM_DEMO_WINDOW=900x760' ;;
    call-start-dm)   echo 'U2DM_DEMO_CALLS=answers U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-start-dm-declined) echo 'U2DM_DEMO_CALLS=declines U2DM_DEMO_AUDIO=silent U2DM_DEMO_WINDOW=900x760' ;;
    call-keys-late)  echo 'U2DM_DEMO_CALLS=active,keys-late U2DM_DEMO_WINDOW=900x760' ;;
    call-undecryptable) echo 'U2DM_DEMO_CALLS=active,undecryptable U2DM_DEMO_WINDOW=900x760' ;;
    call-no-sfu)     echo 'U2DM_DEMO_CALLS=active,no-sfu U2DM_DEMO_WINDOW=900x760' ;;
    call-no-permission) echo 'U2DM_DEMO_CALLS=active,no-permission U2DM_DEMO_WINDOW=900x760' ;;
    call-unverified-session) echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_ENCRYPTION=unverified U2DM_DEMO_WINDOW=900x760' ;;
    call-reconnect)  echo 'U2DM_DEMO_CALLS=active,reconnecting U2DM_DEMO_WINDOW=900x760' ;;
    call-remote-sfu) echo 'U2DM_DEMO_CALLS=active,remote-sfu U2DM_DEMO_WINDOW=900x760' ;;
    call-switch-rooms) echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
    call-compact)    echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=420x760' ;;
    call-strip-nav)  echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=420x760' ;;
    call-strip-index) echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
    call-minimum)    echo 'U2DM_DEMO_CALLS=active,cameras U2DM_DEMO_WINDOW=360x420' ;;
    call-crowd)      echo 'U2DM_DEMO_CALLS=active,crowd U2DM_DEMO_WINDOW=900x760' ;;
    call-video)      echo 'U2DM_DEMO_CALLS=active,cameras U2DM_DEMO_WINDOW=900x760' ;;
    call-camera)     echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
    call-screen-share) echo 'U2DM_DEMO_CALLS=active,cameras,screen-share U2DM_DEMO_WINDOW=900x760' ;;
    call-share-screen) echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
    call-join-sheet) echo 'U2DM_DEMO_CALLS=active U2DM_DEMO_WINDOW=900x760' ;;
