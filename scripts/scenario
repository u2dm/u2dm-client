#!/usr/bin/env bash
set -euo pipefail

readonly ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly DRIVE="$ROOT/scripts/u2dm-drive"
readonly OUT_ROOT=${U2DM_SCENARIO_OUT:-$ROOT/target/scenarios}
readonly SETTLE=${U2DM_SCENARIO_SETTLE:-6}

die() { printf '%s\n' "$*" >&2; exit 1; }

scenario_env() {
  case $1 in
    unread-anchor)   echo 'U2DM_DEMO_TIMELINE=deep,late-reset' ;;
    all-unread)      echo 'U2DM_DEMO_TIMELINE=deep,all-unread' ;;
    unread-unresolved) echo 'U2DM_DEMO_TIMELINE=deep,unread-unresolved' ;;
    reactions-late)  echo 'U2DM_DEMO_TIMELINE=deep U2DM_DEMO_REACTIONS=late,overflow,crowd' ;;
    sticker-trickle) echo 'U2DM_DEMO_STICKERS=trickle,slow,encrypted' ;;
    jump-to-reply)   echo 'U2DM_DEMO_TIMELINE=deep,jump-far' ;;
    pinned-bar)      echo 'U2DM_DEMO_TIMELINE=deep,jump-far U2DM_DEMO_PINNED=slow' ;;
    media-failures)  echo 'U2DM_DEMO_TIMELINE=deep' ;;
    compact-layout)  echo 'U2DM_DEMO_WINDOW=700x900 U2DM_DEMO_TIMELINE=deep' ;;
    login-oauth)     echo 'U2DM_DEMO_LOGIN=oauth-ok' ;;
    verify-self)     echo 'U2DM_DEMO_VERIFY=self' ;;
    audio-track)     echo 'U2DM_DEMO_AUDIO=silent,slow' ;;
    voice-notes)     echo 'U2DM_DEMO_AUDIO=silent' ;;
    delivery-marks)  echo 'U2DM_DEMO_RECEIPTS=late,crowd,seen' ;;
    space-index)     echo 'U2DM_DEMO_SPACE_INDEX=slow' ;;
    polls)           echo 'U2DM_DEMO_TIMELINE=deep U2DM_DEMO_POLLS=late,live,ended' ;;
    poll-edits)      echo 'U2DM_DEMO_POLLS=late,revoked' ;;
    *) return 1 ;;
  esac
}

scenario_steps() {
  case $1 in
    unread-anchor|reactions-late|jump-to-reply|compact-layout|all-unread|unread-unresolved)
      echo '{"op":"select_room","room_id":"!rust:demo.local"}' ;;
    sticker-trickle)
      echo '{"op":"select_room","room_id":"!stickers:demo.local"}' ;;
    media-failures)
      echo '{"op":"select_room","room_id":"!sarah:demo.local"}' ;;
    pinned-bar)
      echo '{"op":"select_room","room_id":"!rust:demo.local"}'
      echo 'sleep 3'
      echo '{"op":"open_pinned","event_id":"demo-rust-chart-copy5"}'
      echo 'sleep 2'
      echo '{"op":"open_pinned","event_id":"demo-rust-13-copy5"}'
      echo 'sleep 3' ;;
    audio-track)
      echo '{"op":"select_room","room_id":"!music:demo.local"}'
      echo 'sleep 2'
      echo '{"op":"play_audio","event_id":"demo-music-interlude"}'
      echo 'sleep 4'
      echo '{"op":"select_room","room_id":"!rust:demo.local"}' ;;
    voice-notes)
      echo '{"op":"select_room","room_id":"!nina:demo.local"}'
      echo 'sleep 2'
      echo '{"op":"play_audio","event_id":"demo-nina-voice-1"}'
      echo 'sleep 6' ;;
    delivery-marks)
      echo '{"op":"select_room","room_id":"!rust:demo.local"}'
      echo 'sleep 3'
      echo '{"op":"send_message","body":"one check, then two"}' ;;
    space-index)
      echo '{"op":"select_space","space_id":"!space-matrix:demo.local"}'
      echo '{"op":"open_space_index"}'
      echo 'sleep 3'
      echo '{"op":"page_space_index"}'
      echo 'sleep 3'
      echo '{"op":"join_space_child","room_id":"!matrix-dev:demo.local"}'
      echo 'sleep 4' ;;
    polls)
      echo '{"op":"select_room","room_id":"!trip:demo.local"}'
      echo 'sleep 2'
      echo '{"op":"vote_poll","event_id":"demo-trip-poll","answer_id":"train"}'
      echo 'sleep 1'
      echo '{"op":"vote_poll","event_id":"demo-trip-snacks","answer_id":"pierogi"}'
      echo 'sleep 1'
      echo '{"op":"end_poll","event_id":"demo-trip-snacks"}' ;;
    poll-edits)
      echo '{"op":"select_room","room_id":"!book:demo.local"}'
      echo 'sleep 1'
      echo '{"op":"edit_poll","event_id":"demo-book-venue","question":"where do we meet next month","answers":["the café again","the library basement","the park, weather permitting"],"multiple":true}'
      echo 'sleep 4' ;;
    login-oauth|verify-self)
      : ;;
  esac
}

scenario_note() {
  case $1 in
    unread-anchor)   echo 'deep history, a repeated Reset: anchor_index must equal the one first_unread row' ;;
    all-unread)      echo 'every loaded message unread, so the anchor is the top row' ;;
    unread-unresolved) echo 'the read position cannot be placed, so opening the room withholds the receipt' ;;
    reactions-late)  echo 'every chip arrives as a Set, with an overflow run and a crowd of reactors' ;;
    sticker-trickle) echo 'images arrive one batch at a time over a slow catalog, in an encrypted room' ;;
    jump-to-reply)   echo 'a short live window, so a reply quote must take the focused /context path' ;;
    pinned-bar)      echo 'three pins arrive late; the newest opens in the live window, the next through /context, and the bar steps back from #3 to #1' ;;
    media-failures)  echo 'every MediaFailure variant on one timeline' ;;
    compact-layout)  echo 'below the 720px breakpoint; run with --headless, a compositor clamps the width' ;;
    login-oauth)     echo 'starts logged out on an OAuth flow that succeeds slowly' ;;
    verify-self)     echo 'a scripted SAS verification arriving 3s after the chat opens' ;;
    audio-track)     echo 'a track downloads slowly, starts playing, and keeps playing after switching rooms' ;;
    voice-notes)     echo 'a voice note advances to the next one, whose download then fails' ;;
    delivery-marks)  echo 'read marks arrive as Sets, a crowd has read the newest, and a sent text turns read live' ;;
    space-index)     echo 'the Matrix space index loads slowly, pages, and joins a room that turns to Open on the sync echo' ;;
    polls)           echo 'tallies arrive as Sets while members keep voting; an own vote and an own multi-choice change land, then the own poll is ended' ;;
    poll-edits)      echo 'an own unanswered poll is edited, keeping two answer ids, then the room list bars voting in every poll' ;;
  esac
}

check_window() {
  local requested logical
  requested=$(scenario_env "$1" | grep -oE 'U2DM_DEMO_WINDOW=[0-9]+x[0-9]+' | cut -d= -f2) || return 0
  [[ -n $requested ]] || return 0
  logical=$("$DRIVE" window 2>/dev/null) || return 0
  if [[ $logical != "$requested" ]]; then
    printf '  ! window is %s, not the requested %s: the compositor clamped it,\n' "$logical" "$requested"
    printf '  ! so this scenario is NOT reproducing what its name claims. Re-run with --headless.\n'
  fi
}

names() {
  printf '%s\n' unread-anchor all-unread unread-unresolved reactions-late sticker-trickle jump-to-reply \
    pinned-bar media-failures compact-layout login-oauth verify-self audio-track voice-notes delivery-marks \
    space-index polls poll-edits
}

cmd_list() {
  local name
  while read -r name; do
    printf '  %-16s %s\n' "$name" "$(scenario_note "$name")"
    printf '  %-16s   %s\n' "" "$(scenario_env "$name")"
  done < <(names)
}

cmd_run() {
  local name=$1 mode=${2:-} out env step
  env=$(scenario_env "$name") || die "unknown scenario: $name (try: $0 list)"
  out="$OUT_ROOT/$name"
  rm -rf "$out"; mkdir -p "$out"

  local -a launch=() shot=""
  case $mode in
    --shot)     launch+=(--mcp); shot=1 ;;
    --headless) launch+=(--headless); shot=1 ;;
    "")         ;;
    *)          die "unknown flag: $mode (use --shot or --headless)" ;;
  esac

  echo "# $name — $(scenario_note "$name")"
  echo "# env: $env"
  ( eval "export $env"; "$DRIVE" up "${launch[@]}" ) >"$out/up.log" 2>&1 ||
    { cat "$out/up.log" >&2; die "the app did not come up"; }

  while read -r step; do
    [[ -n $step ]] || continue
    if [[ $step == "sleep "* ]]; then
      sleep "${step#sleep }"
      continue
    fi
    "$DRIVE" send "$step" >>"$out/commands.json"
  done < <(scenario_steps "$name")

  sleep "$SETTLE"
  "$DRIVE" state    >"$out/state.json"
  "$DRIVE" timeline >"$out/timeline.json" 2>/dev/null || echo '{}' >"$out/timeline.json"
  "$DRIVE" journal  >"$out/journal.json"
  if [[ -n $shot ]]; then
    "$DRIVE" shot "$out/shot.png" >/dev/null
    "$DRIVE" scroll >"$out/scroll.txt" 2>/dev/null || true
    check_window "$name" "$mode"
  fi
  cp "$ROOT/target/u2dm-drive.log" "$out/app.log" 2>/dev/null || true
  "$DRIVE" down >/dev/null

  echo "# wrote $out"
  jq -r '"  rooms=\(.view.directory.rooms|length) step=\(.view.lifecycle.step) toast=\(.view.toast.kind)"' "$out/state.json"
  jq -r 'if .rows then "  timeline rows=\(.rows|length) anchor=\(.anchor_index) unread=\([.rows[]|select(.first_unread)|.row])" else "  timeline unavailable" end' "$out/timeline.json"
  jq -r 'if .pinned.count > 0 then "  pinned bar #\(.pinned.index + 1) of \(.pinned.count) event=\(.pinned.event_id) focus=\(.focus_event_id)" else empty end' "$out/timeline.json"
  jq -r 'if .audio then "  audio state=\(.audio.state) event=\(.audio.event_id) position=\(.audio.position_ms)/\(.audio.duration_ms) output=\(.audio.output)" else empty end' "$out/timeline.json"
  jq -r 'if .poll_permissions then "  polls vote=\(.poll_permissions.vote) end=\(.poll_permissions.end) start=\(.poll_permissions.start)" else empty end' "$out/timeline.json"
  jq -r '.rows[]? | select(.message_type == "poll") | "  poll \(.event_id) \(.poll_phase)\(if .poll_editable then " editable" else "" end) voters=\(.poll_voters) [\([.poll_answers[] | "\(.id)=\(.count)\(if .mine then "*" else "" end)"] | join(" "))]"' "$out/timeline.json"
}

case "${1:-}" in
  list) cmd_list ;;
  run)  [[ -n ${2:-} ]] || die "run needs a scenario name"
        cmd_run "$2" "${3:-}" ;;
  all)  while read -r n; do cmd_run "$n" "${2:-}" || true; echo; done < <(names) ;;
  ""|-h|--help|help)
        echo "usage: scenario list | run <name> [--shot|--headless] | all [--shot|--headless]"
        echo "  --shot      capture a screenshot through the real window manager"
        echo "  --headless  no display needed, and U2DM_DEMO_WINDOW is honoured exactly"
        echo; cmd_list ;;
  *)    die "unknown command: $1" ;;
esac
