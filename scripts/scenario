#!/usr/bin/env bash
set -euo pipefail

readonly ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly DRIVE="$ROOT/scripts/u2dm-drive"
readonly OUT_ROOT=${U2DM_SCENARIO_OUT:-$ROOT/target/scenarios}
readonly SETTLE=${U2DM_SCENARIO_SETTLE:-6}

die() { printf '%s\n' "$*" >&2; exit 1; }

scenario_env() {
  case $1 in
    unread-anchor)   echo 'U2DM_DEMO_TIMELINE=deep,late-reset' ;;
    all-unread)      echo 'U2DM_DEMO_TIMELINE=deep,all-unread' ;;
    unread-unresolved) echo 'U2DM_DEMO_TIMELINE=deep,unread-unresolved' ;;
    reactions-late)  echo 'U2DM_DEMO_TIMELINE=deep U2DM_DEMO_REACTIONS=late,overflow,crowd' ;;
    sticker-trickle) echo 'U2DM_DEMO_STICKERS=trickle,slow,encrypted' ;;
    jump-to-reply)   echo 'U2DM_DEMO_TIMELINE=deep,jump-far' ;;
    pinned-bar)      echo 'U2DM_DEMO_TIMELINE=deep,jump-far U2DM_DEMO_PINNED=slow' ;;
    media-failures)  echo 'U2DM_DEMO_TIMELINE=deep' ;;
    compact-layout)  echo 'U2DM_DEMO_WINDOW=700x900 U2DM_DEMO_TIMELINE=deep' ;;
    login-oauth)     echo 'U2DM_DEMO_LOGIN=oauth-ok' ;;
    logout-left-behind) echo 'U2DM_DEMO_LOGOUT=slow,fails' ;;
    identity-diverged) echo 'U2DM_DEMO_LOGIN=diverged U2DM_DEMO_LOGOUT=fails' ;;
    login-no-sliding-sync) echo 'U2DM_DEMO_LOGIN=password U2DM_DEMO_SYNC=no-sliding-sync' ;;
    sync-unsupported) echo 'U2DM_DEMO_SYNC=no-sliding-sync' ;;
