    call-video)      echo 'the Design Team video call with everyone'"'"'s camera on: painted demo videos fill the tiles, yours mirrored (call-ui, call-media)' ;;
    call-camera)     echo 'join the Rust Programming voice call, then switch your camera on: the band grows and your tile shows video (call-ui)' ;;
    call-screen-share) echo 'Nadia shares her screen in the Design Team call: it takes the spotlight, fitted, and the cameras line up in the strip below (call-ui)' ;;
    call-share-screen) echo 'join the Rust Programming call and share your screen: the share button turns to Stop, your tile says you are sharing (call-ui, call-media)' ;;
    call-join-sheet) echo 'Join in Design Team opens the call sheet: the video call, two in it, the microphone and camera proposed off (call-ui, calls)' ;;
    call-start-sheet-dm) echo 'Start in Sarah'"'"'s chat opens the call sheet: a voice call, the microphone proposed on, the camera off (call-ui, calls)' ;;
    call-video-sheet) echo 'the room menu'"'"'s Video call in linux ricing: the sheet starts a video call with the camera still off (call-ui, room-menu)' ;;
    call-switch-calls) echo 'in the Rust Programming call, Join in Design Team is refused until the sheet asks to leave Rust Programming first (calls, call-ui)' ;;
    call-sheet-ended) echo 'the sheet for Sarah'"'"'s call stays open while she hangs up: it turns into Start, and Join says the call ended (calls)' ;;
    call-answer-video) echo 'Sarah rings with video: the card offers Answer without camera and Answer with camera (call-ui)' ;;
    call-answer-switch) echo 'in the Design Team call Sarah rings: an answer that did not agree to leave Design Team is refused and it keeps ringing (calls)' ;;
    call-alone)      echo 'start a call in Matrix HQ, where nobody else is: the band says Waiting for others instead of a clock (calls, call-ui)' ;;
    call-announce-fails) echo 'start a call in Sarah'"'"'s chat whose ring fails to send: no ringback, the band says it could not call her and offers Try again (calls, call-ui)' ;;
    call-cut-off)    echo 'the media server drops the Design Team call 5 s in: the band gives way to a strip that keeps the failure with Try again (calls, call-ui)' ;;
    call-camera-lost) echo 'in the Rust Programming call your camera stops 3 s after starting: the camera button turns red and the status row offers Try again (call-ui, call-media)' ;;
    call-share-cancelled) echo 'the picker for your screen share closes twice without a choice: the second time the status row says sharing did not start and offers the room logs (call-ui)' ;;
    notifications)   echo 'with the window unfocused, every scripted arrival notifies except the muted room; !rust is read elsewhere and withdrawn, Leo'"'"'s invite notifies, and a click on Priya'"'"'s opens her chat (notifications, directory.attention, title)' ;;
    notifications-focused) echo 'the window keeps focus: arrivals light their rooms and the title count, but nothing notifies (notifications, directory.attention)' ;;
    notifications-burst) echo 'three messages in !rust a second apart: one notification, replaced twice (notifications)' ;;
  esac
}

check_window() {
  local requested logical
  requested=$(scenario_env "$1" | grep -oE 'U2DM_DEMO_WINDOW=[0-9]+x[0-9]+' | cut -d= -f2) || return 0
  [[ -n $requested ]] || return 0
  logical=$("$DRIVE" window 2>/dev/null) || return 0
  if [[ $logical != "$requested" ]]; then
    printf '  ! window is %s, not the requested %s: the compositor clamped it,\n' "$logical" "$requested"
    printf '  ! so this scenario is NOT reproducing what its name claims. Re-run with --headless.\n'
  fi
}

names() {
  printf '%s\n' unread-anchor all-unread unread-unresolved reactions-late sticker-trickle jump-to-reply \
    pinned-bar media-failures compact-layout login-oauth logout-left-behind identity-diverged \
    login-no-sliding-sync sync-unsupported verify-self \
    audio-track voice-notes delivery-marks \
    space-index polls poll-edits room-info room-leave room-info-failures room-info-pane room-menu room-menu-leave \
    room-menu-failures room-log user-info user-info-failures user-dm user-dm-start user-dm-failures user-sessions \
    user-verify user-verify-new-chat user-verify-failures user-verify-declined user-verify-unverified-session \
    user-ignore user-moderation \
    user-moderation-failures user-tags custom-emoji spoilers message-types message-link message-source message-pins message-pin-failures message-delete \
    message-delete-failures read-only-room announcement-room powers-revoked \
    readers room-search room-search-open subspace-tabs reduced-motion mentions room-mention display-names \
    message-shields identity-alerts identity-held-sends invites-folded invites invite-failures room-upgrades room-upgrade-failures room-state \
    removals removal-failures leave-space leave-space-failures moderation-reasons \
    room-links room-finder room-link-failures \
    create-room create-space create-in-space create-room-failures invite-people invite-people-failures \
    typing typing-names presence presence-idle presence-off presence-refused \
    calls-active call-ring call-ring-ends call-ring-elsewhere call-ring-unconfirmed call-expiry \
    call-join call-start-dm call-start-dm-declined call-keys-late call-undecryptable call-no-sfu \
    call-no-permission call-unverified-session call-reconnect call-remote-sfu call-switch-rooms \
    call-compact call-strip-nav call-strip-index call-minimum call-crowd call-video call-camera \
    call-screen-share call-share-screen call-join-sheet call-start-sheet-dm call-video-sheet \
    call-switch-calls call-sheet-ended call-answer-video call-answer-switch \
    call-alone call-announce-fails call-cut-off call-camera-lost call-share-cancelled \
    notifications notifications-focused notifications-burst \
    encryption-unverified encryption-recovery-key encryption-new-account encryption-setup-refused \
    identity-reset identity-reset-oauth room-keys \
    account-sessions account-password account-sso account-oauth account-limits account-deactivate \
    logout-warning
}

cmd_list() {
  local name
  while read -r name; do
    printf '  %-16s %s\n' "$name" "$(scenario_note "$name")"
    printf '  %-16s   %s\n' "" "$(scenario_env "$name")"
  done < <(names)
}

cmd_run() {
  local name=$1 mode=${2:-} out env step
  env=$(scenario_env "$name") || die "unknown scenario: $name (try: $0 list)"
  out="$OUT_ROOT/$name"
  rm -rf "$out"; mkdir -p "$out"

  local -a launch=() shot=""
  case $mode in
    --shot)     launch+=(--mcp); shot=1 ;;
    --headless) launch+=(--headless); shot=1 ;;
    "")         ;;
    *)          die "unknown flag: $mode (use --shot or --headless)" ;;
  esac

  echo "# $name — $(scenario_note "$name")"
  echo "# env: $env"
  ( eval "export $env"; "$DRIVE" up "${launch[@]}" ) >"$out/up.log" 2>&1 ||
    { cat "$out/up.log" >&2; die "the app did not come up"; }

  while read -r step; do
    [[ -n $step ]] || continue
    if [[ $step == "sleep "* ]]; then
      sleep "${step#sleep }"
      continue
    fi
    "$DRIVE" send "$step" >>"$out/commands.json"
  done < <(scenario_steps "$name")

  sleep "$SETTLE"
  "$DRIVE" state    >"$out/state.json"
  "$DRIVE" timeline >"$out/timeline.json" 2>/dev/null || echo '{}' >"$out/timeline.json"
  "$DRIVE" journal  >"$out/journal.json"
  if [[ -n $shot ]]; then
    "$DRIVE" shot "$out/shot.png" >/dev/null
    "$DRIVE" scroll >"$out/scroll.txt" 2>/dev/null || true
    check_window "$name" "$mode"
  fi
  cp "$ROOT/target/u2dm-drive.log" "$out/app.log" 2>/dev/null || true
  "$DRIVE" down >/dev/null

  echo "# wrote $out"
  jq -r '"  rooms=\(.view.directory.rooms|length) step=\(.view.lifecycle.step) toast=\(.view.toast.kind) connection=\(.view.connection.status)"' "$out/state.json"
  jq -r '.view.directory | if (.space_matches|length) > 0 then "  space matches \([.space_matches[] | "\(.name)\(if .parent then " in \(.parent)" else "" end) (\(.rooms) rooms)"] | join(", "))" else empty end' "$out/state.json"
  jq -r '.view.directory | if .scope == "space" then "  listing space \(.space_id)\(if .subspace_id != "" then " > \(.subspace_id)" else "" end): \([.rooms[].name] | join(", "))" else empty end' "$out/state.json"
  jq -r 'if .rows then "  timeline rows=\(.rows|length) anchor=\(.anchor_index) unread=\([.rows[]|select(.first_unread)|.row])" else "  timeline unavailable" end' "$out/timeline.json"
  jq -r 'if .pinned.count > 0 then "  pinned bar #\(.pinned.index + 1) of \(.pinned.count) event=\(.pinned.event_id) focus=\(.focus_event_id)" else empty end' "$out/timeline.json"
  jq -r 'if .audio then "  audio state=\(.audio.state) event=\(.audio.event_id) position=\(.audio.position_ms)/\(.audio.duration_ms) output=\(.audio.output)" else empty end' "$out/timeline.json"
  jq -r 'if .poll_permissions then "  polls vote=\(.poll_permissions.vote) end=\(.poll_permissions.end) start=\(.poll_permissions.start)" else empty end' "$out/timeline.json"
  jq -r '.rows[]? | select(.message_type == "poll") | "  poll \(.event_id) \(.poll_phase)\(if .poll_editable then " editable" else "" end) voters=\(.poll_voters) [\([.poll_answers[] | "\(.id)=\(.count)\(if .mine then "*" else "" end)"] | join(" "))]"' "$out/timeline.json"
  jq -r 'if .message_permissions then "  messages delete_own=\(.message_permissions.delete_own) delete_others=\(.message_permissions.delete_others) pin=\(.message_permissions.pin) pinned_rows=\([.rows[]? | select(.pinned) | .event_id])" else empty end' "$out/timeline.json"
  jq -r 'if .view.message_link.serial > 0 then "  message link #\(.view.message_link.serial) \(.view.message_link.url)" else empty end' "$out/state.json"
  jq -r 'if .view.room_menu then "  room menu \(.view.room_menu.room_id) space=\(.view.room_menu.is_space) unread=\(.view.room_menu.unread) notify=\(.view.room_menu.notify) busy=\(.view.room_menu.notify_busy) leaving=\(.view.room_menu.leaving)" else empty end' "$out/state.json"
  jq -r 'if (.view.directory.removals|length) > 0 then "  removals \([.view.directory.removals[] | "\(.name) \(.kind) by \(.by_name)\(if .reason then " (\(.reason))" else "" end)"] | join(", "))" else empty end' "$out/state.json"
  jq -r 'if .view.removal.open then "  removal sheet \(.view.removal.removal.id) forgetting=\(.view.removal.forgetting) error=\(.view.removal.error.kind)" else empty end' "$out/state.json"
  jq -r 'if .view.leave_space.open then "  leave space \(.view.leave_space.space_id) rooms=\(.view.leave_space.rooms) spaces=\(.view.leave_space.spaces) standing=\(.view.leave_space.standing) leaving=\(.view.leave_space.leaving) error=\(.view.leave_space.error.kind)" else empty end' "$out/state.json"
  jq -r 'if .view.user_info.open then "  user info \(.view.user_info.user_id) in \(.view.user_info.room_id) \(.view.user_info.status) membership=\(.view.user_info.membership) role=\(.view.user_info.role) identity=\(.view.user_info.identity) verify=\(.view.user_info.verify) sessions=\([(.view.user_info.sessions // [])[] | "\(.device_id):\(.trust)"] | join(","))\(if .view.user_info.error.kind != "none" then " error=\(.view.user_info.error.kind)" else "" end) pronouns=\(.view.user_info.pronouns) direct=\(.view.user_info.direct) ignored=\(.view.user_info.ignored) kick=\(.view.user_info.may_kick) ban=\(.view.user_info.may_ban) unban=\(.view.user_info.may_unban)" else empty end' "$out/state.json"
  jq -r 'if .view.identity_alert.kind != "none" then "  identity alert \(.view.identity_alert.kind) \(.view.identity_alert.user_id // "") busy=\(.view.identity_alert.busy)" else empty end' "$out/state.json"
  jq -r '.view.encryption | "  encryption \(.standing) recovery=\(.recovery) sessions=\(.verified_sessions) key_storage=\(.key_storage)\(if .open then " dialog=\(.step) activity=\(.activity) error=\(.error.kind)\(if .recovery_key then " key shown" else "" end)\(if .auth then " auth=\(.auth.stage) auth_error=\(.auth.error.kind)" else "" end)\(if .key_file then " key_file=\(.key_file)" else "" end)\(if .keys_exported then " exported=\(.keys_exported)" else "" end)\(if .keys_imported then " imported=\(.keys_imported[0])/\(.keys_imported[1])" else "" end)" else "" end)"' "$out/state.json"
  jq -r 'if .view.account then "  account \(.view.account.step) activity=\(.view.account.activity)\(if .view.account.auth then " auth=\(.view.account.auth.stage) for=\(.view.account.auth_for) auth_error=\(.view.account.auth.error.kind)" else "" end) sessions=\([(.view.account.sessions // [])[] | "\(.device_id):\(.name // "-")"] | join(",")) api=\(.view.account.facts.api // "-") notice=\(.view.account.notice.kind) error=\(.view.account.error.kind)" else empty end' "$out/state.json"
  jq -r 'if .view.logout then "  logout warning keys_at_risk=\(.view.logout.keys_at_risk) unsent=\(.view.logout.unsent)" else empty end' "$out/state.json"
  jq -r '"  selected room \(.selected_room_id // "none")"' "$out/timeline.json"
  jq -r 'if .view.room_link.serial > 0 then "  room link #\(.view.room_link.serial) \(.view.room_link.url)" else empty end' "$out/state.json"
  jq -r 'if .view.room_log then "  room log \(.view.room_log.room_id) lines=\(.view.room_log.lines) dropped=\(.view.room_log.dropped) newest=\(.view.room_log.newest[-1] // "none")" else empty end' "$out/state.json"
  jq -r 'if .view.source.status != "closed" then "  source \(.view.source.status) \(.view.source.event_id) encryption=\(.view.source.encryption)" else empty end' "$out/state.json"
  jq -r '[.rows[]? | select(.mentions_you) | .event_id] | if length > 0 then "  tinted rows \(join(", "))" else empty end' "$out/timeline.json"
  jq -r 'if (.view.typing.typists|length) > 0 then "  typing in \(.view.typing.room_id): \([.view.typing.typists[].shown] | join(", "))" else empty end' "$out/state.json"
  jq -r '.view.presence | if .partner or .person then "  presence partner=\(.partner.user_id // "none"):\(.partner.line // "-") person=\(.person.user_id // "none"):\(.person.line // "-")\(if .person.status then " status=\(.person.status)" else "" end)" else empty end' "$out/state.json"
  jq -r '.view.call | if .ring or .here or .active then "  call ring=\(.ring.room_id // "none")\(if .ring.desktop then " desktop" else "" end) here=\(.here.room_id // "none"):\(.here.people // 0) active=\(.active.room_id // "none"):\(.active.phase // "-"):\((.active.tiles // []) | length)\(if .active then " microphone=\(.active.microphone) camera=\(.active.camera)" else "" end)" else empty end' "$out/state.json"
  jq -r '.view.call.sheet | if . then "  call sheet \(.room_id) \(.offer)\(if .refusal then ":\(.refusal)" else "" end) video=\(.video) people=\(.people) microphone=\(.microphone) camera=\(.camera) leaving=\(.leaving // "none") ended=\(.ended)" else empty end' "$out/state.json"
  jq -r 'if (.view.notifications|length) > 0 or .view.directory.attention > 0 then "  notifications [\([.view.notifications[] | "\(.room_id)#\(.serial)"] | join(", "))] attention=\(.view.directory.attention)" else empty end' "$out/state.json"
  jq -r 'if .title then "  title \(.title)" else empty end' "$out/timeline.json"
  jq -r 'if (.view.mentions.rows|length) > 0 or .view.mentions.offers_room then "  mentions in \(.view.mentions.room_id) room=\(.view.mentions.offers_room) rows=\([.view.mentions.rows[].user_id] | join(", "))" else empty end' "$out/state.json"
}

case "${1:-}" in
  list) cmd_list ;;
  run)  [[ -n ${2:-} ]] || die "run needs a scenario name"
        cmd_run "$2" "${3:-}" ;;
  all)  while read -r n; do cmd_run "$n" "${2:-}" || true; echo; done < <(names) ;;
  ""|-h|--help|help)
        echo "usage: scenario list | run <name> [--shot|--headless] | all [--shot|--headless]"
        echo "  --shot      capture a screenshot through the real window manager"
        echo "  --headless  no display needed, and U2DM_DEMO_WINDOW is honoured exactly"
        echo; cmd_list ;;
  *)    die "unknown command: $1" ;;
esac
