import { KeyChord, ShortcutBinding } from "./types.slint";

export global Shortcuts {
    in property <ShortcutBinding> open-settings;
    in property <ShortcutBinding> find-room;
    in property <ShortcutBinding> show-shortcuts;
    in property <ShortcutBinding> next-region;
    in property <ShortcutBinding> previous-region;
    in property <ShortcutBinding> previous-room;
    in property <ShortcutBinding> next-room;
    in property <ShortcutBinding> previous-unread-room;
    in property <ShortcutBinding> next-unread-room;
    in property <ShortcutBinding> move-space-up;
    in property <ShortcutBinding> move-space-down;
    in property <ShortcutBinding> toggle-microphone;
    in property <ShortcutBinding> toggle-camera;
    in property <ShortcutBinding> reply;
    in property <ShortcutBinding> edit;
    in property <ShortcutBinding> first-unread;

    public pure function matches(event: KeyEvent, binding: ShortcutBinding) -> bool {
        return binding.on && root.presses(event, binding.keys);
    }

    public pure function presses(event: KeyEvent, chord: KeyChord) -> bool {
        return chord.key != ""
            && event.text.to-lowercase() == chord.key
            && event.modifiers.control == chord.control
            && event.modifiers.alt == chord.alt
            && event.modifiers.meta == chord.meta
            && (chord.any-shift || event.modifiers.shift == chord.shift);
    }

    public pure function label(binding: ShortcutBinding) -> string {
        return binding.on ? root.keys-label(binding.keys) : "";
    }

    public pure function keys-label(chord: KeyChord) -> string {
        if chord.key == "" {
            return "";
        }
        return (chord.meta ? root.meta-name() + "+" : "")
            + (chord.control ? root.control-name() + "+" : "")
            + (chord.alt ? root.alt-name() + "+" : "")
            + (chord.shift ? root.shift-name() + "+" : "")
            + root.key-name(chord.key);
    }

    public pure function meta-name() -> string {
        return @tr("Key" => "Super");
    }

    public pure function control-name() -> string {
        return @tr("Key" => "Ctrl");
    }

    public pure function alt-name() -> string {
        return @tr("Key" => "Alt");
    }

    public pure function shift-name() -> string {
        return @tr("Key" => "Shift");
    }

    public pure function key-name(key: string) -> string {
        if key == Key.UpArrow {
            return @tr("Key" => "Up");
        }
        if key == Key.DownArrow {
            return @tr("Key" => "Down");
        }
        if key == Key.LeftArrow {
            return @tr("Key" => "Left");
        }
        if key == Key.RightArrow {
            return @tr("Key" => "Right");
        }
        if key == Key.PageUp {
            return @tr("Key" => "Page Up");
        }
        if key == Key.PageDown {
            return @tr("Key" => "Page Down");
        }
        if key == Key.Home {
            return @tr("Key" => "Home");
        }
        if key == Key.End {
            return @tr("Key" => "End");
        }
        if key == Key.Return {
            return @tr("Key" => "Enter");
        }
        if key == Key.Escape {
            return @tr("Key" => "Esc");
        }
        if key == Key.Tab {
            return @tr("Key" => "Tab");
        }
        if key == Key.Space {
            return @tr("Key" => "Space");
        }
        if key == Key.Backspace {
            return @tr("Key" => "Backspace");
        }
        if key == Key.Delete {
            return @tr("Key" => "Delete");
        }
        if key == Key.Insert {
            return @tr("Key" => "Insert");
        }
        if key == Key.Menu {
            return @tr("Key" => "Menu");
        }
        if key == Key.F1 {
            return "F1";
        }
        if key == Key.F2 {
            return "F2";
        }
        if key == Key.F3 {
            return "F3";
        }
        if key == Key.F4 {
            return "F4";
        }
        if key == Key.F5 {
            return "F5";
        }
        if key == Key.F6 {
            return "F6";
        }
        if key == Key.F7 {
            return "F7";
        }
        if key == Key.F8 {
            return "F8";
        }
        if key == Key.F9 {
            return "F9";
        }
        if key == Key.F10 {
            return "F10";
        }
        if key == Key.F11 {
            return "F11";
        }
        if key == Key.F12 {
            return "F12";
        }
        return key.to-uppercase();
    }
}
