import "fonts/Twemoji.ttf";

import {
    LoginPhase,
    ConnectionState,
    TimelineState,
    VerificationPhase,
    MediaState,
    MediaFailure,
    MessageKind,
    PreviewKind,
    ServiceKind,
    LoginMethodKind,
    AudioKind,
} from "./enums.slint";
import {
    LoginView,
    SessionView,
    DirectoryView,
    SpaceIndexView,
    RoomView,
    RoomInfoView,
    StickerView,
    VerificationView,
    AttachmentView,
    VideoView,
    AudioView,
    UnsentView,
    WindowView,
    SourceView,
    RoomMenuView,
    RoomLogView,
    UserInfoView,
    ReadersView,
} from "./views.slint";
import { Actions } from "./actions.slint";
import { EmojiStore } from "./emoji-store.slint";
import { Polls, Probe, ReplySwipe, RoomMenu, Shell } from "./local.slint";
import { Metrics } from "./theme.slint";
import { LoadingScreen } from "./screens/login/loading.slint";
import { RestorePausedScreen } from "./screens/login/restore-paused.slint";
import { HomeserverScreen } from "./screens/login/homeserver.slint";
import { CredentialsScreen } from "./screens/login/credentials.slint";
import { ReauthenticateScreen } from "./screens/login/reauthenticate.slint";
import { ChatScreen } from "./screens/chat/chat.slint";
import { VerificationDialog } from "./screens/chat/components/verification.slint";
import { AttachmentDialog } from "./screens/chat/components/timeline/attachment-dialog.slint";
import { PollDialog } from "./screens/chat/components/timeline/poll-dialog.slint";
import { VideoPlayer } from "./screens/chat/components/timeline/video-player.slint";
import { RoomInfoDialog } from "./screens/chat/components/room-info.slint";
import { EventSourceDialog } from "./screens/chat/components/event-source.slint";
import { UserInfoDialog } from "./screens/chat/components/user-info.slint";
import { RoomLogDialog } from "./screens/chat/components/room-log.slint";
import { ReadersDialog } from "./screens/chat/components/readers.slint";

export { EmojiStore }
export { LoginPhase, ConnectionState, TimelineState, VerificationPhase, MediaState, MediaFailure }
export { MessageKind, PreviewKind, ServiceKind, LoginMethodKind, AudioKind }
export { LoginView, SessionView, DirectoryView, SpaceIndexView, RoomView, StickerView, VerificationView }
export { AttachmentView, VideoView, AudioView, UnsentView, WindowView, RoomInfoView, SourceView, RoomMenuView, RoomLogView, UserInfoView, ReadersView }
export { Actions }
export { Probe, ReplySwipe, RoomMenu }

export component AppWindow inherits Window {
    title: @tr("U2DM Matrix Client");
    preferred-width: Metrics.window-initial-width;
    preferred-height: Metrics.window-initial-height;
    min-width: Metrics.window-min-width;
    min-height: Metrics.window-min-height;

    in-out property <string> input-homeserver: "matrix.org";
    in-out property <string> input-username: "";
    in-out property <string> input-message: "";

    if LoginView.step == LoginPhase.loading: LoadingScreen { }

    if LoginView.step == LoginPhase.restore-paused: RestorePausedScreen { }

    if LoginView.step == LoginPhase.homeserver: HomeserverScreen {
        input-homeserver <=> root.input-homeserver;
    }

    if LoginView.step == LoginPhase.credentials: CredentialsScreen {
        input-username <=> root.input-username;
    }

    if LoginView.step == LoginPhase.reauthenticate: ReauthenticateScreen { }

    if LoginView.step == LoginPhase.logged-in: ChatScreen {
        input-message <=> root.input-message;
        window-minimized: root.minimized;
    }

    if Shell.attachment-open: AttachmentDialog { }
    if Shell.poll-open && LoginView.step == LoginPhase.logged-in: PollDialog {
        room-id: DirectoryView.selected-room-id;
        source: Polls.edit-source;
        closed => {
            Shell.poll-open = false;
            Polls.stop-editing();
        }
    }
    if Shell.video-open: VideoPlayer { }
    if Shell.room-info-open: RoomInfoDialog { }
    if Shell.readers-open: ReadersDialog { }
    if Shell.user-info-open: UserInfoDialog { }
    if Shell.source-open: EventSourceDialog { }
    if Shell.room-log-open: RoomLogDialog { }

    if Shell.verification-open: VerificationDialog { }
}
