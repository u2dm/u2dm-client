import { IconSet } from "@lucide";

import {
    LoginPage,
    BrandHeader,
    FieldLabel,
    StatusRow,
    StepDots,
} from "./common.slint";
import { LoginField } from "./field.slint";
import { AppStyle, Fonts, Metrics, Space } from "../../theme.slint";
import { AppButton } from "../../components/button.slint";
import { ErrorBanner } from "../../components/banner.slint";
import { LoginActivity } from "../../enums.slint";
import { LoginView } from "../../views.slint";
import { Actions } from "../../actions.slint";

export component HomeserverScreen inherits LoginPage {
    in-out property <string> input-homeserver: "matrix.org";

    private property <bool> is-checking: LoginView.activity == LoginActivity.checking-server;

    function submit() {
        if (!root.is-checking && root.input-homeserver != "") {
            Actions.check-server(root.input-homeserver);
        }
    }

    BrandHeader {
        mark-size: root.dense ? Metrics.login-mark-dense : Metrics.login-mark;
        subtitle: @tr("Sign in to your Matrix account");
    }

    VerticalLayout {
        spacing: Space.md;

        FieldLabel {
            text: @tr("HOMESERVER");
        }

        LoginField {
            icon: IconSet.Globe;
            label: @tr("Homeserver");
            placeholder: "matrix.org";
            enabled: !root.is-checking;
            text <=> root.input-homeserver;
            accepted => {
                root.submit();
            }
        }

        Text {
            text: @tr("The server that stores your account and messages.");
            font-size: Fonts.caption;
            wrap: word-wrap;
            color: AppStyle.foreground-muted;
        }
    }

    AppButton {
        text: @tr("Continue");
        icon: IconSet.ArrowRight;
        trailing-icon: true;
        busy: root.is-checking;
        enabled: root.input-homeserver != "";
        clicked => {
            root.submit();
        }
    }

    if LoginView.activity != LoginActivity.idle: StatusRow {
        activity: LoginView.activity;
    }

    if LoginView.messages.length > 0: ErrorBanner {
        messages: LoginView.messages;
    }

    StepDots {
        step: 1;
    }
}
