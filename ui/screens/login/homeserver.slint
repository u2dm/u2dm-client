import { IconSet } from "@lucide";

import {
    LoginPage,
    BrandHeader,
    FieldLabel,
    StatusRow,
    ErrorBanner,
    StepDots,
    LoginStyle,
} from "./common.slint";
import { LoginField } from "./field.slint";
import { LoginButton } from "./button.slint";
import { LoginView } from "../../views.slint";

export component HomeserverScreen inherits LoginPage {
    in-out property <string> input-homeserver: "matrix.org";

    private property <bool> is-checking: LoginView.status == "checking-server";

    callback check-server(string);

    function submit() {
        if (!root.is-checking && root.input-homeserver != "") {
            root.check-server(root.input-homeserver);
        }
    }

    BrandHeader {
        subtitle: @tr("Sign in to your Matrix account");
    }

    VerticalLayout {
        spacing: 8px;

        FieldLabel {
            text: @tr("HOMESERVER");
        }

        LoginField {
            icon: IconSet.Globe;
            label: @tr("Homeserver");
            placeholder: "matrix.org";
            enabled: !root.is-checking;
            text <=> root.input-homeserver;
            accepted => {
                root.submit();
            }
        }

        Text {
            text: @tr("The server that stores your account and messages.");
            font-size: 11px;
            wrap: word-wrap;
            color: LoginStyle.faint;
        }
    }

    LoginButton {
        text: @tr("Continue");
        icon: IconSet.ArrowRight;
        trailing-icon: true;
        busy: root.is-checking;
        enabled: root.input-homeserver != "";
        clicked => {
            root.submit();
        }
    }

    if LoginView.status != "": StatusRow {
        status: LoginView.status;
    }

    if LoginView.error != "": ErrorBanner {
        message: LoginView.error;
    }

    StepDots {
        step: 1;
    }
}
