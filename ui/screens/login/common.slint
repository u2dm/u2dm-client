import { Palette, ScrollView, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";
import { LoginActivity } from "../../enums.slint";
import { TextField } from "../../components/text-field.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Size, Space, Stroke, Tracking, Weight } from "../../theme.slint";

component MatrixBracket inherits Rectangle {
    in property <bool> closing;

    Rectangle {
        x: root.closing ? root.width - self.width : 0;
        width: Stroke.hairline;
        background: AppStyle.login-bracket;
    }

    Rectangle {
        y: 0;
        height: Stroke.hairline;
        background: AppStyle.login-bracket;
    }

    Rectangle {
        y: root.height - self.height;
        height: Stroke.hairline;
        background: AppStyle.login-bracket;
    }
}

export component LoginPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: AppStyle.page;

    out property <bool> dense: root.height < Metrics.login-dense-below;
    property <length> card-height: card-body.preferred-height;
    property <length> card-margin: root.dense ? Space.xl : Metrics.login-card-margin;

    property <length> bracket-gap: Space.xl;
    property <length> bracket-tick: Space.lg;
    property <length> bracket-overshoot: root.dense ? Space.md : Space.lg;
    property <length> bracket-room: root.bracket-gap + root.bracket-tick + Space.lg;
    property <bool> bracketed: card.x >= root.bracket-room;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, root.card-height + 2 * root.card-margin);

        if root.bracketed: MatrixBracket {
            x: card.x - root.bracket-gap - self.width;
            y: card.y - root.bracket-overshoot;
            width: root.bracket-tick;
            height: card.height + 2 * root.bracket-overshoot;
        }

        if root.bracketed: MatrixBracket {
            closing: true;
            x: card.x + card.width + root.bracket-gap;
            y: card.y - root.bracket-overshoot;
            width: root.bracket-tick;
            height: card.height + 2 * root.bracket-overshoot;
        }

        card := Rectangle {
            x: (root.width - self.width) / 2;
            y: (scroll.content-height - self.height) / 2;
            width: min(AppStyle.card-width, root.width - AppStyle.card-inset);
            height: root.card-height;
            background: AppStyle.card;
            border-radius: Radius.xl;
            border-width: Stroke.hairline;
            border-color: AppStyle.border;

            card-body := VerticalLayout {
                padding: root.dense ? AppStyle.card-padding-dense : AppStyle.card-padding;
                spacing: root.dense ? Space.lg : Space.xl;

                @children
            }
        }
    }
}

component BrandMark inherits Image {
    in property <length> size: Metrics.login-mark;

    width: root.size;
    height: root.size;
    source: @image-url("../../../assets/logo.svg");
    colorize: Palette.foreground;
    accessible-role: none;
}

export component BrandHeader inherits VerticalLayout {
    in property <string> subtitle;
    in property <length> mark-size: Metrics.login-mark;

    spacing: Space.lg;

    HorizontalLayout {
        alignment: center;

        BrandMark {
            size: root.mark-size;
        }
    }

    Text {
        text: @tr("U2DM");
        font-size: Fonts.display;
        font-weight: Weight.bold;
        letter-spacing: Tracking.wide;
        horizontal-alignment: center;
    }

    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: Fonts.label;
        horizontal-alignment: center;
        wrap: word-wrap;
        color: AppStyle.foreground-muted;
    }
}

export component FieldLabel inherits Text {
    font-size: Fonts.caption;
    font-weight: Weight.semibold;
    letter-spacing: Tracking.wide;
    color: AppStyle.foreground-muted;
}

export component LabelledField inherits VerticalLayout {
    in property <string> heading;
    in property <Icon> icon;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret;
    in property <bool> enabled: true;
    in-out property <string> text;

    callback accepted();

    spacing: Space.md;

    FieldLabel {
        text: root.heading;
    }

    TextField {
        icon: root.icon;
        label: root.label;
        placeholder: root.placeholder;
        secret: root.secret;
        enabled: root.enabled;
        text <=> root.text;
        accepted => {
            root.accepted();
        }
    }

    @children
}

export component StepDots inherits HorizontalLayout {
    in property <int> step: 1;

    alignment: center;
    spacing: Space.md;

    for index in [1, 2]: Rectangle {
        property <bool> active: index == root.step;

        width: self.active ? Space.xxl : Space.md;
        height: Space.md;
        border-radius: self.height / 2;
        background: self.active ? Palette.accent-background : AppStyle.overlay-pressed;

        animate width, background {
            duration: Motion.slow;
            easing: ease-out;
        }
    }
}

struct ActivityStyle {
    label: string,
    icon: Icon,
}

export component StatusRow inherits HorizontalLayout {
    in property <LoginActivity> activity;
    in property <bool> spinner: false;

    property <ActivityStyle> style: self.activity-style();

    pure function activity-style() -> ActivityStyle {
        if root.activity == LoginActivity.loading-session {
            return { label: @tr("Loading saved session..."), icon: IconSet.History };
        }
        if root.activity == LoginActivity.opening-store {
            return { label: @tr("Opening encrypted store..."), icon: IconSet.LockKeyhole };
        }
        if root.activity == LoginActivity.connecting {
            return { label: @tr("Connecting to homeserver..."), icon: IconSet.Globe };
        }
        if root.activity == LoginActivity.restoring-auth {
            return { label: @tr("Restoring authentication..."), icon: IconSet.KeyRound };
        }
        if root.activity == LoginActivity.syncing {
            return { label: @tr("Syncing rooms..."), icon: IconSet.RefreshCw };
        }
        if root.activity == LoginActivity.checking-server {
            return { label: @tr("Checking server..."), icon: IconSet.Server };
        }
        if root.activity == LoginActivity.logging-in {
            return { label: @tr("Logging in..."), icon: IconSet.LogIn };
        }
        if root.activity == LoginActivity.opening-browser {
            return { label: @tr("Opening browser..."), icon: IconSet.ExternalLink };
        }
        if root.activity == LoginActivity.waiting-auth {
            return { label: @tr("Waiting for authentication..."), icon: IconSet.Hourglass };
        }
        if root.activity == LoginActivity.cancelling {
            return { label: @tr("Cancelling..."), icon: IconSet.CircleX };
        }
        if root.activity == LoginActivity.cleaning-up {
            return { label: @tr("Erasing local account data..."), icon: IconSet.Trash2 };
        }
        return { label: "", icon: IconSet.Loader };
    }

    alignment: center;
    spacing: Space.md;

    if root.spinner: Spinner {
        cross-axis-self-alignment: center;
        width: Size.xxs;
        height: Size.xxs;
        indeterminate: true;
    }

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: root.style.icon;
        size: IconSize.sm;
        stroke: AppStyle.foreground-faint;
    }

    Text {
        text: root.style.label;
        font-size: Fonts.label;
        vertical-alignment: center;
        color: AppStyle.foreground-muted;
        accessible-live-region: AccessibleLiveness.polite;
    }
}

export component ServerChip inherits Rectangle {
    in property <string> server;

    background: AppStyle.overlay-subtle;
    border-radius: Radius.md;
    border-width: Stroke.hairline;
    border-color: AppStyle.border;
    height: chip-layout.preferred-height;

    chip-layout := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.md;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Server;
            size: IconSize.sm;
            stroke: AppStyle.success;
        }

        Text {
            text: root.server;
            font-size: Fonts.body-small;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
            color: AppStyle.foreground-muted;
        }

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Check;
            size: IconSize.sm;
            stroke: AppStyle.success;
        }
    }
}

export component OrDivider inherits HorizontalLayout {
    spacing: Space.lg;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        Rectangle {
            height: Stroke.hairline;
            background: AppStyle.overlay-pressed;
        }
    }

    Text {
        text: @tr("or");
        font-size: Fonts.caption;
        font-weight: Weight.semibold;
        letter-spacing: Tracking.wide;
        vertical-alignment: center;
        color: AppStyle.foreground-muted;
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        Rectangle {
            height: Stroke.hairline;
            background: AppStyle.overlay-pressed;
        }
    }
}
