import { IconSet } from "@lucide";

import {
    LoginPage,
    BrandHeader,
    FieldLabel,
    StatusRow,
    ErrorBanner,
    ServerChip,
    OrDivider,
    StepDots,
} from "./common.slint";
import { LoginField } from "./field.slint";
import { LoginButton, BackButton } from "./button.slint";
import { LoginActivity, LoginMethodKind } from "../../enums.slint";
import { LoginView } from "../../views.slint";
import { Actions } from "../../actions.slint";

export component CredentialsScreen inherits LoginPage {
    in-out property <string> input-username: "";
    in-out property <string> input-password: "";

    private property <bool> is-logging-in: LoginView.activity != LoginActivity.idle;
    private property <bool> is-oauth-pending: LoginView.activity == LoginActivity.opening-browser
        || LoginView.activity == LoginActivity.waiting-auth;
    private property <bool> wants-password: LoginView.method == LoginMethodKind.password || LoginView.method == LoginMethodKind.both;
    private property <bool> wants-oauth: LoginView.method == LoginMethodKind.oauth || LoginView.method == LoginMethodKind.both;

    function submit-password() {
        if (!root.is-logging-in && root.input-username != "" && root.input-password != "") {
            Actions.login-password({
                homeserver: LoginView.resolved-homeserver,
                username: root.input-username,
                password: root.input-password,
            });
        }
    }

    HorizontalLayout {
        alignment: start;

        BackButton {
            enabled: !root.is-logging-in;
            clicked => {
                Actions.back-to-homeserver();
            }
        }
    }

    BrandHeader {
        mark-size: 52px;
        subtitle: @tr("Enter your credentials to continue");
    }

    ServerChip {
        server: LoginView.resolved-homeserver;
    }

    if root.wants-password: VerticalLayout {
        spacing: 14px;

        VerticalLayout {
            spacing: 8px;

            FieldLabel {
                text: @tr("USERNAME");
            }

            LoginField {
                icon: IconSet.AtSign;
                label: @tr("Username");
                placeholder: @tr("username");
                enabled: !root.is-logging-in;
                text <=> root.input-username;
                accepted => {
                    root.submit-password();
                }
            }
        }

        VerticalLayout {
            spacing: 8px;

            FieldLabel {
                text: @tr("PASSWORD");
            }

            LoginField {
                icon: IconSet.LockKeyhole;
                label: @tr("Password");
                placeholder: @tr("password");
                secret: true;
                enabled: !root.is-logging-in;
                text <=> root.input-password;
                accepted => {
                    root.submit-password();
                }
            }
        }

        LoginButton {
            text: @tr("Log in");
            icon: IconSet.LogIn;
            busy: root.is-logging-in;
            enabled: root.input-username != "" && root.input-password != "";
            clicked => {
                root.submit-password();
            }
        }
    }

    if root.wants-password && root.wants-oauth: OrDivider { }

    if root.wants-oauth: LoginButton {
        text: @tr("Continue with browser");
        icon: IconSet.ExternalLink;
        filled: false;
        busy: root.is-oauth-pending;
        enabled: !root.is-logging-in;
        clicked => {
            Actions.login-oauth();
        }
    }

    if root.is-oauth-pending: LoginButton {
        text: @tr("Cancel");
        icon: IconSet.X;
        filled: false;
        clicked => {
            Actions.cancel-oauth();
        }
    }

    if LoginView.activity != LoginActivity.idle: StatusRow {
        activity: LoginView.activity;
    }

    if LoginView.messages.length > 0: ErrorBanner {
        messages: LoginView.messages;
    }

    StepDots {
        step: 2;
    }
}
