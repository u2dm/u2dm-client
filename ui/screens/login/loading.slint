import {
    LoginPage,
    BrandHeader,
    StatusRow,
} from "./common.slint";
import { ErrorBanner } from "../../components/banner.slint";
import { LoginActivity } from "../../enums.slint";
import { LoginView } from "../../views.slint";

export component LoadingScreen inherits LoginPage {
    BrandHeader {
        subtitle: LoginView.activity == LoginActivity.idle && LoginView.messages.length == 0
            ? @tr("Starting up...")
            : "";
    }

    if LoginView.activity != LoginActivity.idle: StatusRow {
        activity: LoginView.activity;
        spinner: true;
    }

    if LoginView.messages.length > 0: ErrorBanner {
        messages: LoginView.messages;
    }
}
