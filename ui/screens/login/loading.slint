import {
    LoginPage,
    BrandHeader,
    StatusRow,
    ErrorBanner,
} from "./common.slint";
import { LoginActivity } from "../../enums.slint";
import { LoginView } from "../../views.slint";

export component LoadingScreen inherits LoginPage {
    BrandHeader {
        subtitle: LoginView.activity == LoginActivity.idle && LoginView.error == ""
            ? @tr("Starting up...")
            : "";
    }

    if LoginView.activity != LoginActivity.idle: StatusRow {
        activity: LoginView.activity;
        spinner: true;
    }

    if LoginView.error != "": ErrorBanner {
        message: LoginView.error;
    }
}
