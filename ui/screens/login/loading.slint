import {
    LoginPage,
    BrandHeader,
    StatusRow,
    ErrorBanner,
} from "./common.slint";
import { LoginView } from "../../views.slint";

export component LoadingScreen inherits LoginPage {
    BrandHeader {
        subtitle: LoginView.status == "" && LoginView.error == ""
            ? @tr("Starting up...")
            : "";
    }

    if LoginView.status != "": StatusRow {
        status: LoginView.status;
        spinner: true;
    }

    if LoginView.error != "": ErrorBanner {
        message: LoginView.error;
    }
}
