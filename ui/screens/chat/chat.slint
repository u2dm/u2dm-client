import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Sidebar } from "components/sidebar.slint";
import { Drawer } from "components/drawer.slint";
import { TimelineView } from "components/timeline/timeline-view.slint";
import { ClickArea, FocusRing } from "../../components/a11y.slint";
import { UserMessageKind } from "../../enums.slint";
import { UserMessages } from "../../messages.slint";
import { Metrics } from "../../theme.slint";
import { DirectoryView, RoomView } from "../../views.slint";
import { Actions } from "../../actions.slint";
import { Composer, Shell } from "../../local.slint";

export component ChatScreen inherits Rectangle {
    in-out property <string> input-message: "";

    init => {
        Composer.clear();
        Shell.close-overlays();
    }

    property <bool> compact: root.width < Metrics.compact-breakpoint;
    property <bool> has-room: RoomView.selected-room-name != "";
    property <bool> shows-room-list: root.compact && (!root.has-room || Shell.nav-open);

    property <length> sidebar-width: Metrics.sidebar-default;
    property <bool> nav-collapsed: root.sidebar-width <= Metrics.sidebar-collapsed;
    property <length> divider-width: 4px;
    property <length> resize-step: 16px;

    property <bool> has-subspaces: DirectoryView.subspaces.length > 0;
    property <length> subrail-width: Metrics.subspace-rail;
    property <length> subrail-inset: root.has-subspaces ? root.subrail-width : 0;

    property <length> widest-usable-sidebar: max(
        Metrics.sidebar-min,
        root.width - Metrics.timeline-min - root.subrail-inset,
    );
    property <length> nav-width: min(root.sidebar-width, root.widest-usable-sidebar)
        + root.subrail-inset;

    property <length> timeline-x: root.compact ? 0 : root.nav-width;
    property <length> timeline-width: root.width - root.timeline-x;

    property <bool> has-toast: RoomView.toast-message != UserMessageKind.none;
    property <bool> is-file-saved-toast: RoomView.toast-message == UserMessageKind.file-saved;

    pure function snapped-width(width: length) -> length {
        if width < Metrics.sidebar-collapse-at {
            return Metrics.sidebar-collapsed;
        }
        return clamp(width, Metrics.sidebar-min, Metrics.sidebar-max);
    }

    function drag-sidebar(delta: length) {
        root.sidebar-width = root.snapped-width(root.sidebar-width + delta);
    }

    function step-sidebar(delta: length) {
        if root.nav-collapsed {
            if delta > 0 {
                root.sidebar-width = Metrics.sidebar-min;
            }
            return;
        }
        if delta < 0 && root.sidebar-width <= Metrics.sidebar-min {
            root.sidebar-width = Metrics.sidebar-collapsed;
            return;
        }
        root.sidebar-width = clamp(
                root.sidebar-width + delta,
                Metrics.sidebar-min,
                Metrics.sidebar-max,
            );
    }

    function close-nav() {
        Shell.nav-open = false;
        timeline.focus-nav();
    }

    changed compact => {
        if !root.compact {
            Shell.nav-open = false;
        }
    }

    if !root.compact: Sidebar {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: root.height;
        subrail-width: root.subrail-width;
        collapsed: root.nav-collapsed;
    }

    timeline := TimelineView {
        x: root.timeline-x;
        y: 0;
        width: root.timeline-width;
        height: root.height;
        compact: root.compact && root.has-room;
        overlay-width: root.width;
        input-message <=> root.input-message;
    }

    if root.shows-room-list: Sidebar {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        subrail-width: root.subrail-width;
        above-modal: Shell.nav-open;
        room-selected => {
            root.close-nav();
        }
    }

    if !root.compact: Rectangle {
        x: root.nav-width - root.divider-width / 2;
        y: 0;
        width: root.divider-width;
        height: root.height;

        accessible-role: AccessibleRole.slider;
        accessible-label: @tr("Sidebar width");
        accessible-value: root.sidebar-width / 1px;
        accessible-value-minimum: Metrics.sidebar-collapsed / 1px;
        accessible-value-maximum: Metrics.sidebar-max / 1px;
        accessible-value-step: root.resize-step / 1px;
        accessible-enabled: Shell.background-reachable;
        accessible-action-increment => {
            root.step-sidebar(root.resize-step);
        }
        accessible-action-decrement => {
            root.step-sidebar(-root.resize-step);
        }
        forward-focus: divider-focus;

        divider-focus := FocusScope {
            width: 0;
            focus-on-tab-navigation: Shell.background-reachable;
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) {
                    root.step-sidebar(-root.resize-step);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.step-sidebar(root.resize-step);
                    return accept;
                }
                return reject;
            }
        }

        TouchArea {
            mouse-cursor: col-resize;
            moved => {
                root.drag-sidebar(self.mouse-x - self.pressed-x);
            }
        }

        if divider-focus.has-focus: FocusRing {
            width: 100%;
            height: 100%;
            border-radius: 0;
        }
    }

    if has-toast: Rectangle {
        width: min(max(200px, root.timeline-width - 32px), 500px);
        x: root.timeline-x + (root.timeline-width - self.width) / 2;
        y: root.height - self.height - 16px;
        height: toast-layout.preferred-height;
        border-radius: 8px;
        background: Palette.alternate-background;
        drop-shadow-blur: 8px;
        drop-shadow-color: Palette.foreground.transparentize(0.8);
        drop-shadow-offset-y: 2px;

        toast-layout := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: space-between;

            Text {
                text: UserMessages.text(RoomView.toast-message, RoomView.toast-detail);
                color: root.is-file-saved-toast
                    ? Palette.foreground
                    : Colors.tomato.mix(Palette.foreground, 60%);
                wrap: word-wrap;
                vertical-alignment: center;
                accessible-live-region: root.is-file-saved-toast
                    ? AccessibleLiveness.polite
                    : AccessibleLiveness.assertive;
            }

            ClickArea {
                width: 24px;
                height: 24px;
                ring-radius: 6px;
                label: @tr("Dismiss");
                clicked => {
                    Actions.dismiss-toast();
                }
                IconDisplay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.X;
                    size: 16px;
                    stroke: Palette.foreground.transparentize(0.4);
                }
            }
        }
    }

    Drawer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        open <=> Shell.drawer-open;
    }
}
