import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Sidebar } from "components/sidebar.slint";
import { Drawer } from "components/drawer.slint";
import { TimelineView } from "components/timeline/timeline-view.slint";
import { ClickArea, FocusRing } from "../../components/a11y.slint";
import { UserMessageKind } from "../../enums.slint";
import { UserMessages } from "../../messages.slint";
import { DirectoryView, RoomView } from "../../views.slint";
import { Actions } from "../../actions.slint";
import { Composer, Shell } from "../../local.slint";

export component ChatScreen inherits Rectangle {
    in-out property <string> input-message: "";

    init => {
        Composer.clear();
        Shell.drawer-open = false;
    }

    property <length> sidebar-width: 340px;
    property <length> divider-width: 4px;
    property <length> min-sidebar-width: 260px;
    property <length> max-sidebar-width: 500px;
    property <length> resize-step: 16px;

    function resize-sidebar(delta: length) {
        root.sidebar-width = clamp(
                root.sidebar-width + delta,
                root.min-sidebar-width,
                root.max-sidebar-width,
            );
    }

    property <length> subrail-width: 68px;
    property <bool> has-subspaces: DirectoryView.subspaces.length > 0;
    property <length> total-sidebar-width: root.sidebar-width
        + (root.has-subspaces ? root.subrail-width : 0);
    property <bool> has-toast: RoomView.toast-message != UserMessageKind.none;
    property <bool> is-file-saved-toast: RoomView.toast-message == UserMessageKind.file-saved;

    Sidebar {
        x: 0;
        y: 0;
        width: root.total-sidebar-width;
        height: root.height;
        subrail-width: root.subrail-width;
    }

    TimelineView {
        x: root.total-sidebar-width;
        y: 0;
        width: root.width - root.total-sidebar-width;
        height: root.height;
        input-message <=> root.input-message;
    }

    Rectangle {
        x: root.total-sidebar-width - root.divider-width / 2;
        y: 0;
        width: root.divider-width;
        height: root.height;

        accessible-role: AccessibleRole.slider;
        accessible-label: @tr("Sidebar width");
        accessible-value: root.sidebar-width / 1px;
        accessible-value-minimum: root.min-sidebar-width / 1px;
        accessible-value-maximum: root.max-sidebar-width / 1px;
        accessible-value-step: root.resize-step / 1px;
        accessible-action-increment => {
            root.resize-sidebar(root.resize-step);
        }
        accessible-action-decrement => {
            root.resize-sidebar(-root.resize-step);
        }
        forward-focus: divider-focus;

        divider-focus := FocusScope {
            width: 0;
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) {
                    root.resize-sidebar(-root.resize-step);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.resize-sidebar(root.resize-step);
                    return accept;
                }
                return reject;
            }
        }

        TouchArea {
            mouse-cursor: col-resize;
            moved => {
                root.resize-sidebar(self.mouse-x - self.pressed-x);
            }
        }

        if divider-focus.has-focus: FocusRing {
            width: 100%;
            height: 100%;
            border-radius: 0;
        }
    }

    if has-toast: Rectangle {
        x: root.total-sidebar-width + (root.width - root.total-sidebar-width - self.width) / 2;
        y: root.height - self.height - 16px;
        width: min(root.width - root.total-sidebar-width - 32px, 500px);
        height: toast-layout.preferred-height;
        border-radius: 8px;
        background: Palette.alternate-background;
        drop-shadow-blur: 8px;
        drop-shadow-color: Palette.foreground.transparentize(0.8);
        drop-shadow-offset-y: 2px;

        toast-layout := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: space-between;

            Text {
                text: UserMessages.text(RoomView.toast-message, RoomView.toast-detail);
                color: root.is-file-saved-toast
                    ? Palette.foreground
                    : Colors.tomato.mix(Palette.foreground, 60%);
                wrap: word-wrap;
                vertical-alignment: center;
            }

            ClickArea {
                width: 24px;
                height: 24px;
                ring-radius: 6px;
                label: @tr("Dismiss");
                clicked => {
                    Actions.dismiss-toast();
                }
                IconDisplay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.X;
                    size: 16px;
                    stroke: Palette.foreground.transparentize(0.4);
                }
            }
        }
    }

    Drawer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        open <=> Shell.drawer-open;
    }
}
