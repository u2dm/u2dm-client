import { Palette } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Sidebar } from "./components/sidebar.slint";
import { Drawer } from "./components/drawer.slint";
import { TimelineView } from "./components/timeline/timeline-view.slint";
import { SpaceIndexPane } from "./components/space-index.slint";
import { RoomMenuOverlay } from "./components/room-menu.slint";
import { CallAnnouncer } from "./components/call/call-announcer.slint";
import { CallKey, CallKeys } from "./components/call/call-controls.slint";
import { CallDevicesMenu } from "./components/call/call-devices-menu.slint";
import { CallDock } from "./components/call/call-dock.slint";
import { CallPeopleMenu } from "./components/call/call-people-menu.slint";
import { CallReactionsMenu } from "./components/call/call-reactions-menu.slint";
import { ModalHost, Placement } from "../../components/overlay.slint";
import { ResizeEdge, ResizeHandle } from "../../components/resize-handle.slint";
import { RoomInfoPlacement, RoomScope, UserMessageKind } from "../../enums.slint";
import { UserMessages } from "../../messages.slint";
import { AppStyle, IconSize, Metrics, Radius, Size, Space } from "../../theme.slint";
import { IconButton } from "../../components/button.slint";
import { CallView, DirectoryView, RoomInfoView, RoomView, SpaceIndexView, WindowView } from "../../views.slint";
import { Actions } from "../../actions.slint";
import { CallPanel, LocalState, RoomSearch, Shell, Subspaces } from "../../local.slint";

component Toast inherits Rectangle {
    property <bool> is-file-saved: RoomView.toast-message == UserMessageKind.file-saved;

    height: toast-layout.preferred-height;
    border-radius: Radius.md;
    background: AppStyle.elevated;

    toast-layout := HorizontalLayout {
        padding: Space.lg;
        spacing: Space.md;
        alignment: space-between;

        Text {
            text: UserMessages.text(RoomView.toast-message, RoomView.toast-detail);
            color: root.is-file-saved ? Palette.foreground : AppStyle.danger-muted;
            wrap: word-wrap;
            vertical-alignment: center;
            accessible-live-region: root.is-file-saved ? AccessibleLiveness.polite : AccessibleLiveness.assertive;
        }

        IconButton {
            size: Size.target-min;
            icon-size: IconSize.sm;
            icon: IconSet.X;
            label: @tr("Dismiss");
            clicked => {
                Actions.dismiss-toast();
            }
        }
    }
}

export component ChatScreen inherits FocusScope {
    in-out property <string> input-message: "";
    in property <bool> window-minimized;

    property <bool> compact: root.width < Metrics.compact-breakpoint;
    property <bool> has-room: RoomView.selected-room-name != "";
    property <bool> shows-room-list: root.compact
        && !SpaceIndexView.visible
        && (!root.has-room || Shell.nav-open);
    property <bool> timeline-visible: WindowView.focused
        && !root.window-minimized
        && !root.shows-room-list
        && !SpaceIndexView.visible
        && !Shell.modal-open
        && !timeline.call-covers-timeline;
    property <bool> call-stage-on-screen: timeline.shows-call-media
        && !root.shows-room-list
        && !SpaceIndexView.visible;
    property <bool> call-media-on-screen: root.call-stage-on-screen && !root.window-minimized;
    property <int> active-call: CallView.active-call;

    property <length> sidebar-width: Metrics.sidebar-default;
    property <length> room-info-pane-width: Metrics.room-info-pane-default;
    property <bool> nav-collapsed: root.sidebar-width <= Metrics.sidebar-collapsed;
    property <bool> in-space: DirectoryView.room-scope == RoomScope.space;

    property <length> subrail-width: Metrics.subspace-rail;
    property <length> subrail-inset: Subspaces.in-column(root.nav-collapsed) ? root.subrail-width : 0;

    property <bool> room-info-pane-fits: root.width >= Metrics.room-info-pane-breakpoint;
    property <bool> room-info-pane-up: Shell.room-info-pane-open && root.room-info-pane-fits;
    property <bool> room-info-pane-shown: root.room-info-pane-up
        && root.has-room
        && RoomInfoView.placement == RoomInfoPlacement.pane
        && !SpaceIndexView.visible;
    property <length> room-info-pane-floor: root.room-info-pane-shown ? Metrics.room-info-pane-min : 0;

    property <length> widest-usable-sidebar: max(
        Metrics.sidebar-min,
        root.width - Metrics.timeline-min - root.subrail-inset - root.room-info-pane-floor,
    );
    property <length> nav-width: min(root.sidebar-width, root.widest-usable-sidebar)
        + root.subrail-inset;

    property <length> timeline-x: root.compact ? 0 : root.nav-width;
    property <length> widest-usable-pane: max(
        Metrics.room-info-pane-min,
        root.width - root.timeline-x - Metrics.timeline-min,
    );
    property <length> room-info-pane-inset: root.room-info-pane-shown
        ? clamp(root.room-info-pane-width, Metrics.room-info-pane-min, root.widest-usable-pane)
        : 0;
    property <length> timeline-width: root.width - root.timeline-x - root.room-info-pane-inset;

    property <bool> has-toast: RoomView.toast-message != UserMessageKind.none;
    property <bool> shows-dock: CallView.active || CallView.failed;
    property <bool> devices-open: CallPanel.devices-open && CallView.active;
    property <length> dock-height: root.shows-dock ? dock.height : 0px;
    property <length> dock-height-with-stage: root.shows-dock ? dock.height-with-stage : 0px;
    property <length> menu-room-above: dock.devices-y - Space.xs - Space.md;
    property <length> menu-room-below: root.height - dock.devices-y - dock.devices-size - Space.xs - Space.md;
    property <bool> menu-above: root.menu-room-above >= root.menu-room-below;
    property <length> react-room-above: dock.react-y - Space.xs - Space.md;
    property <length> react-room-below: root.height - dock.react-y - dock.react-size - Space.xs - Space.md;
    property <bool> react-above: root.react-room-above >= root.react-room-below;
    property <length> people-room-above: CallPanel.people-top - Space.xs - Space.md;
    property <length> people-room-below: root.height - CallPanel.people-bottom - Space.xs - Space.md;
    property <bool> people-above: root.people-room-above > root.people-room-below;

    focus-on-click: false;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
        let key = CallKeys.of(event);
        if key == CallKey.none || Shell.modal-over-nav {
            return reject;
        }
        if key == CallKey.chat {
            if !Shell.background-reachable || CallPanel.menu-open || CallPanel.devices-open || CallPanel.reactions-open
                || CallPanel.people-open {
                return reject;
            }
            return timeline.show-call-chat() ? EventResult.accept : EventResult.reject;
        }
        if !CallView.active {
            return reject;
        }
        if !event.repeat {
            if !dock.focuses(key) {
                announcer.expect(key);
            }
            CallKeys.press(key);
        }
        return accept;
    }

    init => {
        root.focus();
        LocalState.forget-session();
        if root.active-call != 0 {
            CallPanel.begin(CallView.video-call);
        }
        Actions.timeline-visibility-changed(root.timeline-visible);
        Actions.call-media-shown(root.call-media-on-screen);
    }

    changed active-call => {
        if self.active-call != 0 {
            CallPanel.begin(CallView.video-call);
        }
    }

    changed call-media-on-screen => {
        Actions.call-media-shown(self.call-media-on-screen);
    }

    changed devices-open => {
        Actions.watch-microphone({ on: self.devices-open });
    }

    changed compact => {
        if !root.compact {
            Shell.nav-open = false;
        }
    }

    changed timeline-visible => {
        Actions.timeline-visibility-changed(root.timeline-visible);
    }

    changed in-space => {
        if root.in-space {
            RoomSearch.clear();
        }
    }

    changed nav-collapsed => {
        if root.nav-collapsed {
            RoomSearch.clear();
        }
    }

    changed room-info-pane-up => {
        if root.room-info-pane-up {
            Actions.show-room-info-pane();
        } else {
            Actions.hide-room-info-pane();
        }
    }

    pure function snapped-width(width: length) -> length {
        if width < Metrics.sidebar-collapse-at {
            return Metrics.sidebar-collapsed;
        }
        return clamp(width, Metrics.sidebar-min, Metrics.sidebar-max);
    }

    function drag-sidebar(delta: length) {
        root.sidebar-width = root.snapped-width(root.sidebar-width + delta);
    }

    function step-sidebar(delta: length) {
        if root.nav-collapsed {
            if delta > 0 {
                root.sidebar-width = Metrics.sidebar-min;
            }
            return;
        }
        if delta < 0 && root.sidebar-width <= Metrics.sidebar-min {
            root.sidebar-width = Metrics.sidebar-collapsed;
            return;
        }
        root.sidebar-width = clamp(
                root.sidebar-width + delta,
                Metrics.sidebar-min,
                Metrics.sidebar-max,
            );
    }

    function resize-room-info-pane(grow: length) {
        root.room-info-pane-width = clamp(
                root.room-info-pane-inset + grow,
                Metrics.room-info-pane-min,
                Metrics.room-info-pane-max,
            );
    }

    function close-nav() {
        Shell.nav-open = false;
        timeline.focus-nav();
    }

    function show-person(key: string, by-keys: bool) {
        CallPanel.people-open = false;
        CallPanel.show-call();
        let staged = CallView.stage-chosen && CallView.stage.length > 0 && CallView.stage[0].key == key;
        if by-keys && !staged {
            CallPanel.focus-stage = true;
        } else {
            CallPanel.people-returns += 1;
        }
        Actions.focus-call-tile(key);
    }

    if !root.compact: Sidebar {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: root.height;
        subrail-width: root.subrail-width;
        collapsed: root.nav-collapsed;
        joins-timeline: !SpaceIndexView.visible;
    }

    timeline := TimelineView {
        x: root.timeline-x;
        y: 0;
        width: root.timeline-width;
        height: root.height;
        visible: !SpaceIndexView.visible;
        compact: root.compact && root.has-room;
        overlay-width: root.width;
        dock-height: root.dock-height;
        dock-height-with-stage: root.dock-height-with-stage;
        room-info-pane-fits: root.room-info-pane-fits;
        room-info-pane-shown: root.room-info-pane-shown;
        room-info-pane-width: root.room-info-pane-inset;
        input-message <=> root.input-message;
    }

    if root.shows-room-list: Sidebar {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - root.dock-height;
        subrail-width: root.subrail-width;
        above-modal: Shell.nav-on-top;
        room-selected => {
            root.close-nav();
        }
    }

    if SpaceIndexView.visible: SpaceIndexPane {
        x: root.timeline-x;
        y: 0;
        width: root.timeline-width;
        height: root.height - root.dock-height;
        above-modal: Shell.nav-on-top;
    }

    if !root.compact: ResizeHandle {
        x: root.nav-width - Metrics.divider / 2;
        y: 0;
        width: Metrics.divider;
        height: root.height;
        label: @tr("Sidebar width");
        grab-after: Metrics.divider-grab;
        value: root.sidebar-width;
        minimum: Metrics.sidebar-collapsed;
        maximum: Metrics.sidebar-max;
        step: Metrics.resize-step;
        dragged(delta) => {
            root.drag-sidebar(delta);
        }
        stepped(delta) => {
            root.step-sidebar(delta);
        }
    }

    if root.room-info-pane-shown: ResizeHandle {
        x: root.width - root.room-info-pane-inset - Metrics.divider / 2;
        y: 0;
        width: Metrics.divider;
        height: root.height;
        edge: ResizeEdge.left;
        label: @tr("Room info panel width");
        grab-after: Metrics.divider-grab;
        value: root.room-info-pane-inset;
        minimum: Metrics.room-info-pane-min;
        maximum: Metrics.room-info-pane-max;
        step: Metrics.resize-step;
        dragged(grow) => {
            root.resize-room-info-pane(grow);
        }
        stepped(grow) => {
            root.resize-room-info-pane(grow);
        }
    }

    dock := CallDock {
        x: root.timeline-x;
        y: root.height - self.height;
        width: root.timeline-width;
        visible: root.shows-dock;
        above-modal: Shell.nav-on-top;
        stage-shown: root.call-stage-on-screen;
        returned => {
            timeline.focus-composer();
        }
    }

    if CallPanel.devices-open && CallView.active: ModalHost {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        dim: false;
        label: @tr("Devices");
        dismissed => {
            CallPanel.devices-open = false;
            dock.focus-devices();
        }
        opened => {
            devices-menu.open(CallPanel.devices-by-keys);
        }

        devices-menu := CallDevicesMenu {
            x: Placement.fit(dock.devices-x + dock.devices-size - self.width, self.width, root.width, Space.md);
            y: root.menu-above
                ? dock.devices-y - Space.xs - self.height
                : dock.devices-y + dock.devices-size + Space.xs;
            room: root.menu-above ? root.menu-room-above : root.menu-room-below;
            above-modal: Shell.nav-on-top;
            in-call: true;
            details(by-keys) => {
                CallPanel.open-details(by-keys);
            }
        }
    }

    if CallPanel.reactions-open && CallView.active: ModalHost {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        dim: false;
        label: @tr("Reactions");
        dismissed => {
            CallPanel.reactions-open = false;
            dock.focus-react();
        }
        opened => {
            reactions-menu.open(CallPanel.reactions-by-keys);
        }

        reactions-menu := CallReactionsMenu {
            x: Placement.fit(dock.react-x + dock.react-size - self.width, self.width, root.width, Space.md);
            y: root.react-above
                ? dock.react-y - Space.xs - self.height
                : dock.react-y + dock.react-size + Space.xs;
            room: root.react-above ? root.react-room-above : root.react-room-below;
            above-modal: Shell.nav-on-top;
            sent => {
                CallPanel.reactions-open = false;
                dock.focus-react();
            }
        }
    }

    if CallPanel.people-open && CallView.active: ModalHost {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        dim: false;
        label: @tr("People in the call");
        dismissed => {
            CallPanel.people-open = false;
            CallPanel.people-returns += 1;
        }
        opened => {
            people-menu.open(CallPanel.people-by-keys);
        }

        people-menu := CallPeopleMenu {
            x: Placement.fit(CallPanel.people-left, self.width, root.width, Space.md);
            y: root.people-above
                ? CallPanel.people-top - Space.xs - self.height
                : CallPanel.people-bottom + Space.xs;
            room: root.people-above ? root.people-room-above : root.people-room-below;
            above-modal: Shell.nav-on-top;
            picked(key, by-keys) => {
                root.show-person(key, by-keys);
            }
        }
    }

    RoomMenuOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        room-info-in-pane: root.room-info-pane-up;
    }

    if root.has-toast: Toast {
        width: clamp(root.timeline-width - 2 * Space.xl, Metrics.toast-min-width, Metrics.toast-max-width);
        x: root.timeline-x + (root.timeline-width - self.width) / 2;
        y: root.height - root.dock-height - self.height - Space.xl;
    }

    Drawer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        open <=> Shell.drawer-open;
    }

    announcer := CallAnnouncer { }
}
