import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

import { Avatar } from "../../../components/avatar.slint";
import { ClickArea } from "../../../components/a11y.slint";
import { ModalHost } from "../../../components/overlay.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Motion, Radius, Size, Space, Stroke, Weight } from "../../../theme.slint";
import { ConnectionState } from "../../../enums.slint";
import { SessionView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";

component DrawerRow inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <color> tint: Palette.foreground;

    callback clicked();

    height: Metrics.drawer-row;
    background: touch.has-hover ? AppStyle.overlay-hover : transparent;

    touch := ClickArea {
        above-modal: true;
        label: root.label;
        ring-radius: 0;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        spacing: Space.xl;

        VerticalLayout {
            alignment: center;
            IconDisplay {
                icon: root.icon;
                size: IconSize.md;
                stroke: root.tint;
            }
        }

        Text {
            text: root.label;
            font-size: Fonts.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.tint;
        }
    }
}

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;

    callback add-account();

    property <length> panel-width: min(
        Metrics.drawer-width,
        max(Metrics.drawer-min-width, root.width - Metrics.overlay-peek),
    );
    property <bool> accounts-expanded: false;
    property <length> accounts-height: root.accounts-expanded ? Metrics.drawer-accounts-row : 0;

    function dismiss() {
        root.open = false;
        root.accounts-expanded = false;
    }

    pure function status-color(status: ConnectionState) -> color {
        if status == ConnectionState.connected {
            return AppStyle.status-online;
        }
        if status == ConnectionState.connecting {
            return AppStyle.status-pending;
        }
        if status == ConnectionState.error {
            return AppStyle.status-error;
        }
        return Palette.border;
    }

    pure function status-label(status: ConnectionState) -> string {
        if status == ConnectionState.connected {
            return @tr("Online");
        }
        if status == ConnectionState.connecting {
            return @tr("Connecting…");
        }
        if status == ConnectionState.error {
            return @tr("Connection error");
        }
        return @tr("Offline");
    }

    if root.open: ModalHost {
        label: @tr("Account menu");
        dismissed => {
            root.dismiss();
        }

        panel := Rectangle {
            property <bool> entered: false;

            width: root.panel-width;
            height: 100%;
            x: self.entered ? 0 : -root.panel-width - Space.xxl;
            background: Palette.alternate-background;
            clip: true;
            animate x {
                duration: Motion.slow;
                easing: ease-in-out;
            }

            init => {
                self.entered = true;
            }

            TouchArea { }

            header := Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: Metrics.drawer-header;
                background: Palette.accent-background;

                avatar := Avatar {
                    x: Metrics.drawer-inset;
                    y: Space.xxl;
                    width: Metrics.drawer-avatar;
                    height: Metrics.drawer-avatar;
                    background: Palette.background;
                    has-image: SessionView.user-has-avatar;
                    image: SessionView.user-avatar;
                    initial: SessionView.user-initial;
                    initial-color: Palette.accent-background;
                    initial-size: Glyph.xl;
                    initial-weight: Weight.bold;
                    initial-font-family: "";
                }

                status-dot := Rectangle {
                    x: avatar.x + avatar.width - self.width;
                    y: avatar.y + avatar.height - self.height;
                    width: Size.xxs;
                    height: Size.xxs;
                    border-radius: self.width / 2;
                    background: root.status-color(SessionView.connection-status);
                    border-width: Stroke.marker;
                    border-color: Palette.accent-background;
                }

                expand-touch := ClickArea {
                    x: parent.width - Metrics.drawer-close-inset;
                    y: Metrics.drawer-inset;
                    width: Size.xl;
                    height: Metrics.drawer-row;
                    above-modal: true;
                    ring-radius: Radius.sm;
                    label: @tr("Toggle account list");
                    clicked => {
                        root.accounts-expanded = !root.accounts-expanded;
                    }

                    Rectangle {
                        width: Size.lg;
                        height: Size.lg;
                        border-radius: Radius.sm;
                        background: expand-touch.has-hover
                            ? AppStyle.on-accent-strong
                            : transparent;

                        IconDisplay {
                            icon: root.accounts-expanded ? IconSet.ChevronDown : IconSet.ChevronRight;
                            size: IconSize.md;
                            stroke: Palette.accent-foreground;
                        }
                    }
                }

                Text {
                    x: Metrics.drawer-inset;
                    y: avatar.y + avatar.height + Space.lg;
                    width: parent.width - 2 * Metrics.drawer-inset;
                    text: SessionView.user-id;
                    font-size: Fonts.title;
                    font-weight: Weight.bold;
                    overflow: elide;
                    color: Palette.accent-foreground;
                }

                Text {
                    x: Metrics.drawer-inset;
                    y: avatar.y + avatar.height + Size.lg;
                    width: parent.width - 2 * Metrics.drawer-inset;
                    text: root.status-label(SessionView.connection-status);
                    font-size: Fonts.body-small;
                    overflow: elide;
                    color: AppStyle.on-accent-muted;
                }
            }

            accounts := Rectangle {
                x: 0;
                y: header.y + header.height;
                width: 100%;
                height: root.accounts-height;
                clip: true;
                background: AppStyle.surface-panel;
                animate height {
                    duration: Motion.slow;
                    easing: ease-in-out;
                }

                Text {
                    x: Metrics.drawer-inset;
                    y: Space.lg;
                    text: @tr("No other accounts");
                    font-size: Fonts.body-small;
                    color: AppStyle.foreground-muted;
                }

                DrawerRow {
                    x: 0;
                    y: Size.lg;
                    width: 100%;
                    icon: IconSet.UserRoundPlus;
                    label: @tr("Add Account");
                    tint: Palette.accent-background;
                    clicked => {
                        root.add-account();
                    }
                }
            }

            DrawerRow {
                x: 0;
                y: parent.height - self.height;
                width: 100%;
                icon: IconSet.LogOut;
                label: @tr("Log Out");
                tint: AppStyle.danger-muted;
                clicked => {
                    root.dismiss();
                    Actions.logout();
                }
            }
        }
    }
}
