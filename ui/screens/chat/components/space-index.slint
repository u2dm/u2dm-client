import { ListView, Spinner } from "std-widgets.slint";
import { IconSet } from "@lucide";

import { Avatar } from "../../../components/avatar.slint";
import { AppButton, HeaderIconButton } from "../../../components/button.slint";
import { ListItemArea, RovingList } from "../../../components/a11y.slint";
import { RetryNotice } from "../../../components/retry-notice.slint";
import { StatusPill } from "../../../components/status-pill.slint";
import { SecondaryText } from "../../../components/text-roles.slint";
import { RowTitle } from "./row-title.slint";
import { SpaceBadge } from "./space-badge.slint";
import { SpaceChildEntry } from "../../../types.slint";
import { AppStyle, Fonts, Metrics, Space, Stroke, Weight } from "../../../theme.slint";
import { ChildAccess, SpaceIndexStatus } from "../../../enums.slint";
import { SpaceIndexView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { FocusHome, FocusRegion, Shell, SpaceIndexEntry } from "../../../local.slint";

export global ChildAccessText {
    public pure function reason(access: ChildAccess) -> string {
        if access == ChildAccess.joined {
            return @tr("Joined");
        }
        if access == ChildAccess.invite-only {
            return @tr("Invite only");
        }
        if access == ChildAccess.knock {
            return @tr("Requires approval");
        }
        if access == ChildAccess.members-only {
            return @tr("Members only");
        }
        if access == ChildAccess.unavailable {
            return @tr("Can't join");
        }
        return "";
    }
}

component ChildAvatar inherits Rectangle {
    in property <SpaceChildEntry> entry;

    width: Metrics.index-avatar;
    height: Metrics.index-avatar;

    Avatar {
        width: 100%;
        height: 100%;
        color-index: root.entry.color-index;
        has-image: root.entry.has-avatar;
        image: root.entry.avatar;
        initial: root.entry.initial;
    }

    if root.entry.is-space: SpaceBadge {
        x: parent.width - self.width + Space.xs;
        y: parent.height - self.height + Space.xs;
    }
}

global ChildActions {
    public pure function joinable(entry: SpaceChildEntry) -> bool {
        return entry.access == ChildAccess.join || entry.access == ChildAccess.joining;
    }

    public pure function openable(entry: SpaceChildEntry) -> bool {
        return entry.access == ChildAccess.open || entry.access == ChildAccess.open-subspace;
    }

    public function act(entry: SpaceChildEntry) {
        if root.openable(entry) {
            Actions.open-space-child(entry.id);
            if entry.access == ChildAccess.open {
                Shell.nav-open = false;
            }
        } else if entry.access == ChildAccess.join {
            Actions.join-space-child(entry.id);
        }
    }
}

component ChildAction inherits HorizontalLayout {
    in property <SpaceChildEntry> entry;
    in property <bool> above-modal;

    property <bool> joinable: ChildActions.joinable(root.entry);
    property <bool> openable: ChildActions.openable(root.entry);

    if root.joinable || root.openable: AppButton {
        height: Metrics.index-action;
        min-width: Metrics.index-action-min-width;
        text: root.openable ? @tr("Open")
            : root.entry.access == ChildAccess.joining ? @tr("Joining")
            : @tr("Join");
        label: root.openable ? @tr("Open {}", root.entry.name)
            : root.entry.access == ChildAccess.joining ? @tr("Joining {}", root.entry.name)
            : @tr("Join {}", root.entry.name);
        filled: !root.openable;
        busy: root.entry.access == ChildAccess.joining;
        above-modal: root.above-modal;
        tab-stop: false;
        clicked => {
            ChildActions.act(root.entry);
        }
    }

    if !root.joinable && !root.openable: Text {
        text: ChildAccessText.reason(root.entry.access);
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
    }
}

component ChildRow inherits ListItemArea {
    in property <SpaceChildEntry> entry;
    in property <bool> cursor-waits;

    pure function summary(entry: SpaceChildEntry) -> string {
        if entry.is-space {
            return @tr("{n} room" | "{n} rooms" % entry.children);
        }
        return entry.detail;
    }

    pure function describe(entry: SpaceChildEntry) -> string {
        if entry.access == ChildAccess.open {
            return @tr("{}, joined", entry.name);
        }
        if entry.access == ChildAccess.open-subspace {
            return @tr("{}, joined space", entry.name);
        }
        if entry.access == ChildAccess.joining {
            return @tr("{}, joining", entry.name);
        }
        if entry.access == ChildAccess.join {
            return entry.is-space ? @tr("{}, space you can join", entry.name) : @tr("{}, room you can join", entry.name);
        }
        return @tr("{}, {}", entry.name, ChildAccessText.reason(entry.access));
    }

    label: root.describe(root.entry);
    region: FocusRegion.space-index;
    place: root.entry.id;
    region-row: true;
    shows-pointer: false;
    clicked => {
        if self.has-focus {
            ChildActions.act(root.entry);
        }
    }

    init => {
        if root.cursor && root.cursor-waits {
            root.take-focus();
        }
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        ChildAvatar {
            cross-axis-self-alignment: center;
            entry: root.entry;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.sm;

            HorizontalLayout {
                spacing: Space.md;

                RowTitle {
                    text: root.entry.name;
                }

                if root.entry.members > 0: Text {
                    text: @tr("{n} member" | "{n} members" % root.entry.members);
                    font-size: Fonts.caption;
                    vertical-alignment: center;
                    color: AppStyle.foreground-muted;
                }
            }

            if root.summary(root.entry) != "": SecondaryText {
                text: root.summary(root.entry);
                overflow: elide;
            }
        }

        ChildAction {
            cross-axis-self-alignment: center;
            entry: root.entry;
            above-modal: root.above-modal;
        }
    }
}

component SpaceIndexHeader inherits Rectangle {
    in property <string> title;
    in property <bool> above-modal;

    height: Metrics.header-row;
    background: AppStyle.canvas;

    public function focus-close() {
        close.take-focus();
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        background: AppStyle.border;
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.sm;
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-family: Fonts.emoji;
            font-size: Fonts.title;
            font-weight: Weight.bold;
            vertical-alignment: center;
            overflow: elide;
        }

        close := HeaderIconButton {
            cross-axis-self-alignment: center;
            icon: IconSet.X;
            label: @tr("Close the room index");
            above-modal: root.above-modal;
            region: FocusRegion.space-index;
            place: "close";
            init => {
                if SpaceIndexEntry.by-keys {
                    SpaceIndexEntry.by-keys = false;
                    self.take-focus();
                }
            }
            clicked => {
                FocusHome.forget();
                Actions.close-space-index();
            }
        }
    }
}

export component SpaceIndexPane inherits Rectangle {
    in property <bool> above-modal: false;

    property <SpaceIndexStatus> status: SpaceIndexView.status;
    property <bool> has-rows: SpaceIndexView.rows.length > 0;
    property <bool> shows-footer: root.status == SpaceIndexStatus.loading-more
        || root.status == SpaceIndexStatus.more-failed;
    property <length> rows-height: SpaceIndexView.rows.length * Metrics.index-row;
    property <int> asked-after: -1;
    property <int> focus-asks: FocusHome.asks;
    property <bool> wants-page: root.status == SpaceIndexStatus.partial
        && root.asked-after != SpaceIndexView.pages-landed
        && root.rows-height + rows-view.content-y - rows-view.visible-height <= Metrics.index-page-ahead;

    pure function title(name: string) -> string {
        if name == "" {
            return @tr("Rooms in this space");
        }
        return @tr("Rooms in {}", name);
    }

    function page-if-wanted() {
        if root.wants-page {
            root.asked-after = SpaceIndexView.pages-landed;
            Actions.page-space-index();
        }
    }

    init => {
        root.page-if-wanted();
    }

    changed wants-page => {
        root.page-if-wanted();
    }

    changed focus-asks => {
        if FocusHome.asked != FocusRegion.space-index {
            return;
        }
        let place = FocusHome.asked-place;
        if place != "" && place == child-keys.cursor-key {
            child-keys.focus-cursor();
        } else if place == "" && root.has-rows {
            child-keys.focus-cursor();
        } else if place == "" || place == "close" {
            header.focus-close();
        }
    }

    background: AppStyle.canvas;
    accessible-role: main;
    accessible-label: root.title(SpaceIndexView.space-name);

    VerticalLayout {
        header := SpaceIndexHeader {
            title: root.title(SpaceIndexView.space-name);
            above-modal: root.above-modal;
        }

        Rectangle {
            vertical-stretch: 1;

            child-keys := RovingList {
                count: SpaceIndexView.rows.length;
                unbuilt-rows: true;
                above-modal: root.above-modal;
                page: max(1, floor(rows-view.visible-height / Metrics.index-row));
                reveal(row) => {
                    rows-view.content-y = -clamp(
                        row * Metrics.index-row - (rows-view.visible-height - Metrics.index-row) / 2,
                        0px,
                        max(0px, rows-view.content-height - rows-view.visible-height));
                }

                rows-view := ListView {
                    accessible-role: list;
                    accessible-label: @tr("Rooms in this space");
                    accessible-item-count: SpaceIndexView.rows.length;

                    for child[idx] in SpaceIndexView.rows: ChildRow {
                        height: Metrics.index-row;
                        index: idx;
                        entry: child;
                        above-modal: root.above-modal;
                        tab-stop: child-keys.items-tab-stop;
                        cursor: idx == child-keys.cursor;
                        cursor-asks: child-keys.asks;
                        cursor-waits: child-keys.waiting;
                        cursor-taken => {
                            child-keys.took(idx, child.id);
                        }
                    }
                }
            }

            if root.status == SpaceIndexStatus.loading: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }

            if root.status == SpaceIndexStatus.failed: RetryNotice {
                text: @tr("Couldn't load the rooms in this space.");
                failed: true;
                above-modal: root.above-modal;
                shows-icon: true;
                icon: IconSet.CircleAlert;
                retry => {
                    Actions.retry-space-index();
                }
            }

            if root.status == SpaceIndexStatus.complete && !root.has-rows: RetryNotice {
                text: @tr("This space has no rooms you can see.");
                shows-icon: true;
                icon: IconSet.Compass;
            }
        }

        if root.shows-footer: Rectangle {
            height: Metrics.index-footer;

            StatusPill {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: root.status == SpaceIndexStatus.loading-more
                    ? @tr("Loading more rooms...")
                    : @tr("Couldn't load more rooms");
                loading: root.status == SpaceIndexStatus.loading-more;
                show-retry: root.status == SpaceIndexStatus.more-failed;
                retry-label: @tr("Retry loading more rooms");
                above-modal: root.above-modal;
                retry => {
                    Actions.retry-space-index();
                }
            }
        }
    }
}
