import { Palette } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { Fonts } from "../../../theme.slint";

export component TileGlyph inherits Rectangle {
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-icon;
    in property <Icon> icon;
    in property <string> initial;
    in property <color> foreground;
    in property <length> icon-size: 20px;
    in property <length> initial-size: 16px;
    in property <int> initial-weight: 700;
    in property <string> initial-font-family: Fonts.emoji;

    clip: true;

    if root.has-avatar: Image {
        width: 100%;
        height: 100%;
        source: root.avatar;
        image-fit: cover;
    }

    if root.has-icon && !root.has-avatar: IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.icon-size;
        stroke: root.foreground;
    }

    if !root.has-avatar && !root.has-icon: Text {
        width: 100%;
        height: 100%;
        text: root.initial;
        font-family: root.initial-font-family;
        font-size: root.initial-size;
        font-weight: root.initial-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: clip;
        color: root.foreground;
    }
}

export component UnreadDot inherits Rectangle {
    in property <bool> alert;
    in property <bool> mention;
    in property <bool> hint;
    in property <length> diameter: 10px;
    in property <bool> ringed;

    height: root.mention ? 18px : root.diameter + (root.ringed ? 4px : 0);
    width: self.height;
    border-radius: self.height / 2;
    background: root.mention || root.alert
        ? Palette.accent-background
        : Palette.foreground;
    border-width: root.ringed || root.mention ? 2px : 0;
    border-color: Palette.alternate-background;

    if root.mention: IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: IconSet.AtSign;
        size: 12px;
        stroke: Palette.accent-foreground;
    }
}
