import { Palette } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { SpaceEntry } from "./types.slint";
import { RailTileFace } from "./tile.slint";
import { ClickArea, ListItemArea } from "../../../components/a11y.slint";
import { DirectoryView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { Shell } from "../../../local.slint";
import { AppStyle, Glyph, IconSize, Metrics, Motion, Radius, Size, Space, Stroke } from "../../../theme.slint";

component SpaceTile inherits ListItemArea {
    in property <string> initial;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-icon;
    in property <Icon> icon;
    in property <bool> alert;
    in property <bool> mention;
    in property <bool> hint;
    in property <bool> elevated;
    in property <bool> hidden;

    property <length> glyph-size: Size.xxl;
    property <length> marker-height: Size.lg;

    height: Metrics.rail-row;
    ring-radius: Radius.md;
    ring-inset: Metrics.rail-tile-inset;

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.hidden ? 0 : 1;
        background: root.has-hover && !root.hidden ? AppStyle.overlay-hover : transparent;

        Rectangle {
            x: 0;
            width: Stroke.marker;
            height: root.selected ? root.marker-height : 0;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Palette.accent-background;

            animate height {
                duration: Motion.normal;
                easing: ease-out;
            }
        }

        RailTileFace {
            width: 100%;
            height: 100%;
            caption: root.label;
            initial: root.initial;
            has-avatar: root.has-avatar;
            avatar: root.avatar;
            has-icon: root.has-icon;
            icon: root.icon;
            alert: root.alert;
            mention: root.mention;
            hint: root.hint;
            selected: root.selected;
            glyph-extent: root.glyph-size;
            glyph-top: Space.sm;
            glyph-radius: root.selected || root.elevated ? Radius.md : root.glyph-size / 2;
            glyph-background: root.selected ? Palette.accent-background : AppStyle.accent-background-soft;
            glyph-icon-size: IconSize.md;
            glyph-initial-size: Glyph.md;
            glyph-initial-family: "";
            caption-family: "";
            caption-gap: Space.xs;
        }
    }
}

export component SpaceRail inherits Rectangle {
    in property <bool> above-modal: false;

    property <length> menu-height: Metrics.header-row;
    property <length> row-height: Metrics.rail-row;
    property <length> drag-threshold: Space.md;
    property <bool> dragging: false;
    property <int> drag-from: -1;
    property <length> drag-dy: 0;
    property <bool> did-drag: false;
    property <int> drag-to: clamp(
        root.drag-from + round(root.drag-dy / root.row-height),
        0,
        DirectoryView.spaces.length - 1,
    );

    property <SpaceEntry> drag-entry;
    property <bool> drag-selected;

    background: AppStyle.surface-rail;

    public function focus-menu() {
        menu-touch.take-focus();
    }

    function begin-drag(idx: int, entry: SpaceEntry, selected: bool) {
        root.drag-from = idx;
        root.drag-dy = 0;
        root.did-drag = false;
        root.drag-entry = entry;
        root.drag-selected = selected;
        root.dragging = true;
    }

    function update-drag(dy: length) {
        root.drag-dy = dy;
        if (dy > root.drag-threshold || dy < -root.drag-threshold) {
            root.did-drag = true;
        }
    }

    function end-drag() {
        if (root.dragging) {
            if (root.did-drag && root.drag-to != root.drag-from) {
                Actions.move-space(root.drag-from, root.drag-to);
            }
            root.dragging = false;
            root.drag-from = -1;
            root.drag-dy = 0;
        }
    }

    pure function drag-rank(idx: int) -> int {
        return idx < root.drag-from ? idx : idx - 1;
    }

    pure function slot-for(idx: int) -> int {
        if (!root.dragging || idx == root.drag-from) {
            return idx;
        }
        return root.drag-rank(idx) < root.drag-to
            ? root.drag-rank(idx)
            : root.drag-rank(idx) + 1;
    }

    menu-touch := ClickArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.menu-height;
        above-modal: root.above-modal;
        ring-radius: Radius.md;
        label: @tr("Menu");
        clicked => {
            Shell.drawer-open = true;
        }

        Rectangle {
            width: Size.xl;
            height: Size.xl;
            border-radius: Radius.md;
            background: menu-touch.has-hover
                ? AppStyle.overlay-hover
                : transparent;

            IconDisplay {
                icon: IconSet.Menu;
                size: IconSize.md;
                stroke: AppStyle.foreground-strong;
            }
        }
    }

    Flickable {
        x: 0;
        y: root.menu-height;
        width: root.width;
        height: root.height - root.menu-height;
        interactive: !root.dragging;
        viewport-width: root.width;
        viewport-height: (DirectoryView.spaces.length + 1) * root.row-height;
        accessible-role: list;
        accessible-label: @tr("Spaces");
        accessible-item-count: DirectoryView.spaces.length + 1;

        SpaceTile {
            x: 0;
            y: 0;
            width: root.width;
            height: root.row-height;
            draggable: false;
            above-modal: root.above-modal;
            index: 0;
            label: @tr("All Rooms");
            has-icon: true;
            icon: IconSet.MessagesSquare;
            selected: DirectoryView.selected-space-id == "";
            changed pressed => {
                if (self.pressed) {
                    root.did-drag = false;
                }
            }
            clicked => {
                if (!root.did-drag) {
                    Actions.select-space("");
                }
            }
        }

        for space[idx] in DirectoryView.spaces: SpaceTile {
            x: 0;
            y: (root.slot-for(idx) + 1) * root.row-height;
            width: root.width;
            height: root.row-height;
            draggable: true;
            above-modal: root.above-modal;
            index: idx + 1;
            hidden: root.dragging && idx == root.drag-from;
            label: space.name;
            initial: space.initial;
            has-avatar: space.has-avatar;
            avatar: space.avatar;
            alert: space.alert;
            mention: space.mention;
            hint: space.hint;
            selected: DirectoryView.selected-space-id == space.id;
            animate y {
                duration: Motion.fast;
                easing: ease-out;
            }
            changed pressed => {
                if (self.pressed) {
                    root.begin-drag(idx, space, DirectoryView.selected-space-id == space.id);
                } else {
                    root.end-drag();
                }
            }
            moved(dy) => {
                root.update-drag(dy);
            }
            clicked => {
                if (!root.did-drag) {
                    Actions.select-space(space.id);
                }
            }
        }

        if root.dragging: SpaceTile {
            x: 0;
            y: (root.drag-from + 1) * root.row-height + root.drag-dy;
            width: root.width;
            height: root.row-height;
            enabled: false;
            elevated: true;
            label: root.drag-entry.name;
            initial: root.drag-entry.initial;
            has-avatar: root.drag-entry.has-avatar;
            avatar: root.drag-entry.avatar;
            alert: root.drag-entry.alert;
            mention: root.drag-entry.mention;
            hint: root.drag-entry.hint;
            selected: root.drag-selected;
        }
    }
}
