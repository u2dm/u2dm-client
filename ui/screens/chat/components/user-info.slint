import { Palette, ScrollView } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

import { AppButton } from "../../../components/button.slint";
import { CopyFeedback } from "../../../components/copier.slint";
import { DialogCard, ModalHost } from "../../../components/overlay.slint";
import { ErrorBanner } from "../../../components/banner.slint";
import { MenuRow } from "../../../components/menu-row.slint";
import { ActionTile } from "./action-tile.slint";
import { DetailLine } from "./detail-line.slint";
import { MemberRoles } from "./member-roles.slint";
import { CopyLinkTile, SheetCloseChip, SheetCover, TilePrompt, TileRow } from "./sheet.slint";
import { AppStyle, Fonts, IconSize, Metrics, Space, Weight } from "../../../theme.slint";
import { DirectChat, Moderation, RoomMembership, UserMessageKind } from "../../../enums.slint";
import { UserInfoView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { DeliveryTip, Reactions } from "../../../local.slint";

enum Asking {
    none,
    ignore,
    remove,
    ban,
}

struct AskingCopy {
    prompt: string,
    confirm-text: string,
    confirm-label: string,
    confirm-icon: Icon,
}

component Badge inherits Rectangle {
    in property <Icon> icon;
    in property <string> text;
    in property <color> tint: AppStyle.foreground-muted;

    width: badge-row.preferred-width;
    height: badge-row.preferred-height;
    border-radius: self.height / 2;
    background: AppStyle.overlay-hover;

    badge-row := HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        padding-top: Space.xs;
        padding-bottom: Space.xs;
        spacing: Space.xs;

        if root.icon.paths.length > 0: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.xs;
            stroke: root.tint;
        }

        Text {
            text: root.text;
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: root.tint;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component ModerationRow inherits MenuRow {
    in property <bool> anyone-asking;
    in property <bool> asking-this;
    in property <bool> idle-enabled;
    in property <Icon> idle-icon;
    in property <string> idle-label;
    in property <bool> idle-destructive;

    property <bool> warns: !root.anyone-asking && root.idle-destructive;

    height: Metrics.user-info-row;
    above-modal: true;
    enabled: root.anyone-asking ? root.asking-this : root.idle-enabled;
    icon: root.asking-this ? IconSet.X : root.idle-icon;
    label: root.asking-this ? @tr("Cancel") : root.idle-label;
    tint: root.warns ? AppStyle.danger : AppStyle.foreground-muted;
    text-color: root.warns ? AppStyle.danger : Palette.foreground;
}

component ProfileCover inherits SheetCover {
    property <string> role-label: MemberRoles.label(UserInfoView.role);
    property <string> note: root.membership-note(UserInfoView.membership);

    pure function membership-note(membership: RoomMembership) -> string {
        if membership == RoomMembership.invited {
            return @tr("Invited to this room");
        }
        if membership == RoomMembership.knocking {
            return @tr("Asked to join this room");
        }
        if membership == RoomMembership.left {
            return @tr("Not in this room anymore");
        }
        if membership == RoomMembership.banned {
            return @tr("Banned from this room");
        }
        if membership == RoomMembership.outside {
            return @tr("Not in this room");
        }
        return "";
    }

    avatar-size: Metrics.user-info-avatar;
    color-index: UserInfoView.color-index;
    has-avatar: UserInfoView.has-avatar;
    avatar: UserInfoView.avatar;
    initial: UserInfoView.initial;
    name: UserInfoView.name;

    if UserInfoView.pronouns != "": Text {
        text: UserInfoView.pronouns;
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        overflow: elide;
    }

    if root.role-label != "" || UserInfoView.verified: HorizontalLayout {
        alignment: center;
        spacing: Space.sm;

        if root.role-label != "": Badge {
            text: root.role-label;
        }

        if UserInfoView.verified: Badge {
            icon: IconSet.ShieldCheck;
            text: @tr("Verified");
            tint: AppStyle.accent-on-surface;
        }
    }

    if root.note != "": Text {
        text: root.note;
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component ModerationRows inherits VerticalLayout {
    in property <Asking> asking;

    callback ignore-clicked();
    callback remove-clicked();
    callback ban-clicked();

    padding-left: Space.md;
    padding-right: Space.md;

    ModerationRow {
        anyone-asking: root.asking != Asking.none;
        asking-this: root.asking == Asking.ignore;
        idle-enabled: !UserInfoView.ignore-busy;
        busy: UserInfoView.ignore-busy;
        idle-icon: UserInfoView.ignored ? IconSet.Eye : IconSet.EyeOff;
        idle-label: UserInfoView.ignored ? @tr("Stop ignoring") : @tr("Ignore");
        idle-destructive: !UserInfoView.ignored;
        clicked => {
            root.ignore-clicked();
        }
    }

    if UserInfoView.may-kick || root.asking == Asking.remove: ModerationRow {
        anyone-asking: root.asking != Asking.none;
        asking-this: root.asking == Asking.remove;
        idle-enabled: UserInfoView.moderating == Moderation.none;
        busy: UserInfoView.moderating == Moderation.kick;
        idle-icon: IconSet.UserMinus;
        idle-label: @tr("Remove from room");
        idle-destructive: true;
        clicked => {
            root.remove-clicked();
        }
    }

    if UserInfoView.may-ban || UserInfoView.may-unban || root.asking == Asking.ban: ModerationRow {
        anyone-asking: root.asking != Asking.none;
        asking-this: root.asking == Asking.ban;
        idle-enabled: UserInfoView.moderating == Moderation.none;
        busy: UserInfoView.moderating == Moderation.ban
            || UserInfoView.moderating == Moderation.unban;
        idle-icon: UserInfoView.may-unban ? IconSet.UserCheck : IconSet.Ban;
        idle-label: UserInfoView.may-unban ? @tr("Unban") : @tr("Ban from room");
        idle-destructive: !UserInfoView.may-unban;
        clicked => {
            root.ban-clicked();
        }
    }
}

export component UserInfoDialog inherits ModalHost {
    property <length> card-width: min(AppStyle.card-width-wide, root.width - AppStyle.card-inset);
    property <length> card-height: min(
        body.preferred-height,
        root.height - AppStyle.card-inset,
        Metrics.user-info-max-height);
    property <bool> offers-actions: !UserInfoView.is-self
        && !UserInfoView.read-failed
        && !UserInfoView.retrying;

    property <string> shown-user: UserInfoView.user-id;
    property <Asking> asking: Asking.none;
    property <AskingCopy> asking-copy: root.copy-for(root.asking);

    dim-opacity: AppStyle.dialog-scrim;
    label: @tr("Profile of {}", UserInfoView.name);
    dismissed => {
        if root.asking != Asking.none {
            root.cancel-asking();
        } else {
            Actions.close-user-info();
        }
    }
    opened => {
        Reactions.close();
        DeliveryTip.clear();
    }

    changed shown-user => {
        link-copy.reset();
        root.asking = Asking.none;
    }

    pure function direct-text(direct: DirectChat) -> string {
        if direct == DirectChat.starting {
            return @tr("Starting…");
        }
        return @tr("Message");
    }

    pure function direct-label(direct: DirectChat) -> string {
        if direct == DirectChat.open {
            return @tr("Open your chat with {}", UserInfoView.name);
        }
        if direct == DirectChat.start {
            return @tr("Start a chat with {}", UserInfoView.name);
        }
        if direct == DirectChat.starting {
            return @tr("Starting a chat with {}", UserInfoView.name);
        }
        return "";
    }

    pure function copy-for(asking: Asking) -> AskingCopy {
        if asking == Asking.ignore {
            return {
                prompt: @tr("Ignore {}? Their messages and invites will be hidden.", UserInfoView.name),
                confirm-text: @tr("Ignore"),
                confirm-label: @tr("Confirm ignoring {}", UserInfoView.name),
                confirm-icon: IconSet.EyeOff,
            };
        }
        if asking == Asking.remove {
            return {
                prompt: @tr("Remove {} from this room?", UserInfoView.name),
                confirm-text: @tr("Remove"),
                confirm-label: @tr("Confirm removing {} from this room", UserInfoView.name),
                confirm-icon: IconSet.UserMinus,
            };
        }
        if asking == Asking.ban {
            return {
                prompt: @tr("Ban {} from this room? They cannot rejoin until unbanned.", UserInfoView.name),
                confirm-text: @tr("Ban"),
                confirm-label: @tr("Confirm banning {} from this room", UserInfoView.name),
                confirm-icon: IconSet.Ban,
            };
        }
        return { confirm-icon: IconSet.EyeOff };
    }

    function cancel-asking() {
        root.asking = Asking.none;
        root.focus();
    }

    function ignore-clicked() {
        if root.asking == Asking.ignore {
            root.asking = Asking.none;
        } else if UserInfoView.ignored {
            Actions.unignore-user(UserInfoView.user-id);
        } else {
            root.asking = Asking.ignore;
        }
    }

    function remove-clicked() {
        if root.asking == Asking.remove {
            root.asking = Asking.none;
        } else {
            root.asking = Asking.remove;
        }
    }

    function ban-clicked() {
        if root.asking == Asking.ban {
            root.asking = Asking.none;
        } else if UserInfoView.may-unban {
            Actions.unban-user(UserInfoView.user-id);
        } else {
            root.asking = Asking.ban;
        }
    }

    function confirm() {
        let asking = root.asking;
        root.focus();
        root.asking = Asking.none;
        if asking == Asking.ignore {
            Actions.ignore-user(UserInfoView.user-id);
        } else if asking == Asking.remove {
            Actions.kick-user(UserInfoView.user-id);
        } else if asking == Asking.ban {
            Actions.ban-user(UserInfoView.user-id);
        }
    }

    link-copy := CopyFeedback { }

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        clip: true;

        scroll := ScrollView {
            width: 100%;
            height: 100%;
            content-width: root.card-width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: root.card-width;
                padding-top: Space.xl;
                padding-bottom: Space.xl;
                spacing: Space.lg;

                ProfileCover { }

                tiles := TileRow {
                    height: Metrics.user-info-action;

                    if root.asking == Asking.none && UserInfoView.direct != DirectChat.hidden: ActionTile {
                        width: tiles.slot-width;
                        enabled: UserInfoView.direct != DirectChat.starting;
                        busy: UserInfoView.direct == DirectChat.starting;
                        icon: IconSet.MessageCircle;
                        text: root.direct-text(UserInfoView.direct);
                        label: root.direct-label(UserInfoView.direct);
                        clicked => {
                            Actions.message-user(UserInfoView.user-id);
                        }
                    }

                    if root.asking == Asking.none: CopyLinkTile {
                        width: tiles.slot-width;
                        enabled: UserInfoView.link != "";
                        copied: link-copy.copied;
                        copy-label: @tr("Copy the link to this profile");
                        clicked => {
                            link-copy.copy(UserInfoView.link);
                        }
                    }

                    if root.asking != Asking.none: TilePrompt {
                        width: 2 * tiles.slot-width + Space.md;
                        text: root.asking-copy.prompt;
                        overflow: elide;
                    }

                    if root.asking != Asking.none: ActionTile {
                        width: tiles.slot-width;
                        destructive: true;
                        icon: root.asking-copy.confirm-icon;
                        text: root.asking-copy.confirm-text;
                        label: root.asking-copy.confirm-label;
                        clicked => {
                            root.confirm();
                        }
                    }
                }

                if UserInfoView.error != UserMessageKind.none: HorizontalLayout {
                    padding-left: Space.xl;
                    padding-right: Space.xl;

                    ErrorBanner {
                        messages: [{ kind: UserInfoView.error, detail: UserInfoView.error-detail }];
                    }
                }

                if UserInfoView.read-failed || UserInfoView.retrying: HorizontalLayout {
                    alignment: center;

                    AppButton {
                        text: @tr("Retry");
                        filled: false;
                        above-modal: true;
                        enabled: !UserInfoView.retrying;
                        busy: UserInfoView.retrying;
                        clicked => {
                            Actions.retry-user-info();
                        }
                    }
                }

                VerticalLayout {
                    padding-left: Space.xl;
                    padding-right: Space.xl;

                    DetailLine {
                        value: UserInfoView.user-id;
                        caption: @tr("Matrix ID");
                    }
                }

                if root.offers-actions: ModerationRows {
                    asking: root.asking;
                    ignore-clicked => {
                        root.ignore-clicked();
                    }
                    remove-clicked => {
                        root.remove-clicked();
                    }
                    ban-clicked => {
                        root.ban-clicked();
                    }
                }
            }
        }

        SheetCloseChip {
            x: parent.width - self.width - Space.md;
            y: Space.md;
            surface: AppStyle.card;
            label: @tr("Close the profile");
            above-modal: true;
            clicked => {
                Actions.close-user-info();
            }
        }
    }
}
