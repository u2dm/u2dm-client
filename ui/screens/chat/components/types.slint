import { AudioKind, ChildAccess, Delivery, MediaFailure, MediaState, MessageKind, PreviewKind, ReactionSend, SendState, ServiceKind } from "../../../enums.slint";

export struct RoomEntry {
    id: string,
    name: string,
    initial: string,
    avatar: image,
    has-avatar: bool,
    color-index: int,
    members: int,
    alert: bool,
    mention: bool,
    hint: bool,
    muted: bool,
    last-message-sender: string,
    last-message-kind: PreviewKind,
    last-message-body: string,
    last-message-service-kind: ServiceKind,
    last-message-service-target: string,
    last-message-is-own: bool,
    last-message-edited: bool,
    last-message-time: string,
}

export struct SpaceEntry {
    id: string,
    name: string,
    alert: bool,
    mention: bool,
    hint: bool,
    initial: string,
    avatar: image,
    has-avatar: bool,
}

export struct SpaceChildEntry {
    id: string,
    name: string,
    initial: string,
    color-index: int,
    detail: string,
    members: int,
    is-space: bool,
    children: int,
    access: ChildAccess,
    has-avatar: bool,
    avatar: image,
}

export struct ReactorAvatar {
    user-id: string,
    initial: string,
    color-index: int,
    avatar: image,
    has-avatar: bool,
}

export struct ReactionEntry {
    key: string,
    label: string,
    count: int,
    mine: bool,
    send: ReactionSend,
    overflow: bool,
    reactors: string,
    hidden-reactors: int,
    avatars: [ReactorAvatar],
}

export struct MessageEntry {
    unique-id: string,
    local-id: string,
    sender: string,
    sender-id: string,
    pronouns: [string],
    body: string,
    styled: styled-text,
    has-links: bool,
    timestamp: string,
    sent-at: string,
    message-type: MessageKind,
    preview-kind: PreviewKind,
    unsupported-kind: string,
    thumbnail: image,
    media-state: MediaState,
    media-failure: MediaFailure,
    image-mimetype: string,
    image-extension: string,
    image-width: int,
    image-height: int,
    duration: string,
    filename: string,
    size: string,
    audio-kind: AudioKind,
    waveform: [float],
    event-id: string,
    has-avatar: bool,
    needs-media: bool,
    avatar: image,
    sender-initial: string,
    color-index: int,
    is-own: bool,
    edited: bool,
    first-unread: bool,
    counts-as-unread: bool,
    send-state: SendState,
    send-progress: float,
    delivery: Delivery,
    readers: string,
    hidden-readers: int,
    reader-count: int,
    has-reply: bool,
    reply-event-id: string,
    reply-sender: string,
    reply-kind: PreviewKind,
    reply-body: string,
    service-kind: ServiceKind,
    service-target: string,
    reactions: [ReactionEntry],
    all-reactions: [ReactionEntry],
}

export struct EmojiEntry {
    base: string,
    tones: [string],
    name: string,
}

export struct EmojiGroup {
    items: [EmojiEntry],
}

export struct EmojiInsert {
    text: string,
    caret: int,
}

export struct StickerCell {
    key: string,
    pack-id: string,
    shortcode: string,
    label: string,
    image: image,
    media-state: MediaState,
}

export struct StickerRow {
    title: string,
    is-header: bool,
    cells: [StickerCell],
}

export struct StickerPackTab {
    id: string,
    title: string,
    header-row: int,
    icon: image,
    has-icon: bool,
}

export struct SendMessageRequest {
    room-id: string,
    body: string,
    reply-to: string,
    reply-sender: string,
    reply-preview: string,
}

export struct SendStickerRequest {
    room-id: string,
    pack-id: string,
    shortcode: string,
    reply-to: string,
}

export struct SendAttachmentRequest {
    room-id: string,
    caption: string,
    as-document: bool,
    reply-to: string,
}

export struct SaveFileRequest {
    event-id: string,
    filename: string,
}
