import { Palette } from "std-widgets.slint";
import { Icon, IconSet } from "@lucide";

import { RailTileFace } from "./rail-tile.slint";
import { ContextPress } from "./context-press.slint";
import { AppStyle, Metrics, Radius, Size, Space, Weight } from "../../../theme.slint";
import { Interaction, ListItemArea, RovingList } from "../../../components/a11y.slint";
import { IconButton } from "../../../components/button.slint";
import { DirectoryView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { FocusHome, FocusRegion, RoomMenu, RoomMenuOrigin, SubspacePlacement, Subspaces } from "../../../local.slint";

component SubspaceTile inherits ListItemArea {
    in property <string> caption;
    in property <string> initial;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-icon;
    in property <Icon> icon;
    in property <bool> alert;
    in property <bool> mention;
    in property <bool> hint;
    in property <string> menu-id;

    property <int> focus-asks: FocusHome.asks;

    pure function describe() -> string {
        if root.mention {
            return @tr("{}, mentions you", root.caption);
        }
        if root.alert {
            return @tr("{}, unread", root.caption);
        }
        if root.hint {
            return @tr("{}, new activity", root.caption);
        }
        return root.caption;
    }

    height: Metrics.rail-row;
    label: root.describe();
    ring-radius: Radius.md;
    ring-inset: Metrics.rail-tile-inset;
    region: root.menu-id != "" ? FocusRegion.rail : FocusRegion.none;
    place: "sub:\{root.menu-id}";

    changed focus-asks => {
        if root.menu-id != "" && FocusHome.asked == FocusRegion.rail
            && FocusHome.asked-place == "sub:\{root.menu-id}" {
            root.take-focus();
        }
    }

    context-menu-requested => {
        if root.menu-id == "" {
            return EventResult.reject;
        }
        RoomMenu.open(
            root.menu-id,
            RoomMenuOrigin.rail,
            root.absolute-position.x + root.width,
            root.absolute-position.y + Space.sm,
            true);
        return EventResult.accept;
    }

    if root.menu-id != "": ContextPress {
        hovered: root.has-hover && Interaction.actionable(root.enabled, root.above-modal);
        pressed => {
            RoomMenu.open(
                root.menu-id,
                RoomMenuOrigin.rail,
                root.absolute-position.x + root.mouse-x,
                root.absolute-position.y + root.mouse-y,
                false);
        }
    }

    Rectangle {
        x: Metrics.rail-tile-inset;
        y: Metrics.rail-tile-inset;
        width: parent.width - Metrics.rail-tile-inset * 2;
        height: parent.height - Metrics.rail-tile-inset * 2;
        border-radius: Radius.md;
        background: root.selected
            ? AppStyle.accent-background-soft
            : (root.has-hover ? AppStyle.overlay-hover : transparent);
    }

    RailTileFace {
        width: 100%;
        height: 100%;
        caption: root.caption;
        initial: root.initial;
        has-avatar: root.has-avatar;
        avatar: root.avatar;
        has-icon: root.has-icon;
        icon: root.icon;
        alert: root.alert;
        mention: root.mention;
        hint: root.hint;
        selected: root.selected;
        glyph-extent: Size.xxl;
        glyph-top: Space.md;
        glyph-radius: Radius.md;
        glyph-background: root.selected ? Palette.accent-background : AppStyle.accent-background-soft;
        caption-gap: Space.sm;
        caption-weight: root.selected ? Weight.bold : Weight.regular;
        dot-diameter: Space.md;
    }
}

export component SubspaceRail inherits Rectangle {
    in property <bool> above-modal: false;
    in property <bool> offers-tabs: false;

    property <length> row-height: Metrics.rail-row;
    property <length> switch-band: Metrics.header-row;
    property <string> chosen: "sub:\{DirectoryView.selected-subspace-id}";

    background: AppStyle.nav;

    init => {
        tile-keys.cursor-key = root.chosen;
    }

    changed chosen => {
        tile-keys.cursor-key = root.chosen;
    }

    if root.offers-tabs: IconButton {
        x: (root.width - self.width) / 2;
        y: (root.switch-band - self.height) / 2;
        icon: IconSet.PanelTopOpen;
        label: @tr("Show topics as tabs");
        above-modal: root.above-modal;
        init => {
            if Subspaces.take-refocus() {
                self.take-focus();
            }
        }
        clicked => {
            Subspaces.place(SubspacePlacement.tabs, self.has-focus);
        }
    }

    tile-keys := RovingList {
        y: root.switch-band;
        width: root.width;
        height: root.height - root.switch-band;
        count: DirectoryView.subspaces.length + 1;
        above-modal: root.above-modal;

        Flickable {
            content-width: root.width;
            content-height: (DirectoryView.subspaces.length + 1) * root.row-height;

            VerticalLayout {
                alignment: start;
                accessible-role: list;
                accessible-label: @tr("Topics");
                accessible-item-count: DirectoryView.subspaces.length + 1;

                SubspaceTile {
                    property <int> keyed-at: self.place == tile-keys.cursor-key ? 0 : -1;

                    height: root.row-height;
                    above-modal: root.above-modal;
                    index: 0;
                    caption: @tr("All");
                    has-icon: true;
                    icon: IconSet.MessagesSquare;
                    selected: DirectoryView.selected-subspace-id == "";
                    tab-stop: self.cursor;
                    cursor: tile-keys.cursor == 0;
                    cursor-asks: tile-keys.asks;
                    cursor-taken => {
                        tile-keys.took(0, self.place);
                    }
                    changed keyed-at => {
                        if self.keyed-at >= 0 {
                            tile-keys.cursor = self.keyed-at;
                        }
                    }
                    clicked => {
                        tile-keys.took(0, self.place);
                        Actions.select-subspace("");
                    }
                }

                for subspace[idx] in DirectoryView.subspaces: SubspaceTile {
                    property <int> keyed-at: self.place == tile-keys.cursor-key ? idx + 1 : -1;

                    height: root.row-height;
                    above-modal: root.above-modal;
                    index: idx + 1;
                    caption: subspace.name;
                    menu-id: subspace.id;
                    initial: subspace.initial;
                    has-avatar: subspace.has-avatar;
                    avatar: subspace.avatar;
                    alert: subspace.alert;
                    mention: subspace.mention;
                    hint: subspace.hint;
                    selected: DirectoryView.selected-subspace-id == subspace.id;
                    tab-stop: self.cursor;
                    cursor: tile-keys.cursor == idx + 1;
                    cursor-asks: tile-keys.asks;
                    cursor-taken => {
                        tile-keys.took(idx + 1, self.place);
                    }
                    changed keyed-at => {
                        if self.keyed-at >= 0 {
                            tile-keys.cursor = self.keyed-at;
                        }
                    }
                    clicked => {
                        tile-keys.took(idx + 1, self.place);
                        Actions.select-subspace(subspace.id);
                    }
                }
            }
        }
    }
}
