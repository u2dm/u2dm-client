import { Palette } from "std-widgets.slint";
import { Icon, IconSet } from "@lucide";

import { RailTileFace } from "./rail-tile.slint";
import { ContextPress } from "./context-press.slint";
import { AppStyle, Metrics, Radius, Size, Space, Stroke, Weight } from "../../../theme.slint";
import { Interaction, ListItemArea } from "../../../components/a11y.slint";
import { DirectoryView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { RoomMenu, RoomMenuOrigin, RoomMenuReturn } from "../../../local.slint";

component SubspaceTile inherits ListItemArea {
    in property <string> initial;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-icon;
    in property <Icon> icon;
    in property <bool> alert;
    in property <bool> mention;
    in property <bool> hint;
    in property <string> menu-id;

    property <int> menu-returns: RoomMenu.focus-returns;

    height: Metrics.rail-row;
    ring-radius: Radius.md;
    ring-inset: Metrics.rail-tile-inset;

    changed menu-returns => {
        if root.menu-id != "" && RoomMenu.returns-to(RoomMenuReturn.tile, root.menu-id) {
            root.take-focus();
        }
    }

    context-menu-requested => {
        if root.menu-id == "" {
            return EventResult.reject;
        }
        RoomMenu.open(
            root.menu-id,
            RoomMenuOrigin.rail,
            root.absolute-position.x + root.width,
            root.absolute-position.y + Space.sm,
            true);
        return EventResult.accept;
    }

    if root.menu-id != "": ContextPress {
        hovered: root.has-hover && Interaction.actionable(root.enabled, root.above-modal);
        pressed => {
            RoomMenu.open(
                root.menu-id,
                RoomMenuOrigin.rail,
                root.absolute-position.x + root.mouse-x,
                root.absolute-position.y + root.mouse-y,
                false);
        }
    }

    Rectangle {
        x: Metrics.rail-tile-inset;
        y: Metrics.rail-tile-inset;
        width: parent.width - Metrics.rail-tile-inset * 2;
        height: parent.height - Metrics.rail-tile-inset * 2;
        border-radius: Radius.md;
        background: root.selected
            ? AppStyle.accent-background-soft
            : (root.has-hover ? AppStyle.overlay-hover : transparent);
    }

    RailTileFace {
        width: 100%;
        height: 100%;
        caption: root.label;
        initial: root.initial;
        has-avatar: root.has-avatar;
        avatar: root.avatar;
        has-icon: root.has-icon;
        icon: root.icon;
        alert: root.alert;
        mention: root.mention;
        hint: root.hint;
        selected: root.selected;
        glyph-extent: Size.xxl;
        glyph-top: Space.md;
        glyph-radius: Radius.md;
        glyph-background: root.selected ? Palette.accent-background : AppStyle.accent-background-soft;
        caption-gap: Space.sm;
        caption-weight: root.selected ? Weight.bold : Weight.regular;
        dot-diameter: Space.md;
    }
}

export component SubspaceRail inherits Rectangle {
    in property <bool> above-modal: false;

    property <length> row-height: Metrics.rail-row;
    property <length> top-padding: Space.md;

    background: Palette.alternate-background;

    Rectangle {
        x: parent.width - Stroke.hairline;
        width: Stroke.hairline;
        background: AppStyle.overlay-hover;
    }

    Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: (DirectoryView.subspaces.length + 1) * root.row-height + root.top-padding;

        VerticalLayout {
            alignment: start;
            padding-top: root.top-padding;
            accessible-role: list;
            accessible-label: @tr("Topics");
            accessible-item-count: DirectoryView.subspaces.length + 1;

            SubspaceTile {
                height: root.row-height;
                above-modal: root.above-modal;
                index: 0;
                label: @tr("All");
                has-icon: true;
                icon: IconSet.MessagesSquare;
                selected: DirectoryView.selected-subspace-id == "";
                clicked => {
                    Actions.select-subspace("");
                }
            }

            for subspace[idx] in DirectoryView.subspaces: SubspaceTile {
                height: root.row-height;
                above-modal: root.above-modal;
                index: idx + 1;
                label: subspace.name;
                menu-id: subspace.id;
                initial: subspace.initial;
                has-avatar: subspace.has-avatar;
                avatar: subspace.avatar;
                alert: subspace.alert;
                mention: subspace.mention;
                hint: subspace.hint;
                selected: DirectoryView.selected-subspace-id == subspace.id;
                clicked => {
                    Actions.select-subspace(subspace.id);
                }
            }
        }
    }
}
