import { AppStyle, Fonts, Metrics, Space } from "../../../theme.slint";
import { PresenceLine } from "../../../enums.slint";

export component PresenceLabel inherits HorizontalLayout {
    in property <PresenceLine> line;
    in property <string> text;

    spacing: Space.sm;

    if root.line == PresenceLine.online || root.line == PresenceLine.away: Rectangle {
        cross-axis-self-alignment: center;
        width: Metrics.presence-dot;
        height: Metrics.presence-dot;
        border-radius: self.width / 2;
        background: root.line == PresenceLine.online ? AppStyle.status-online : AppStyle.status-pending;
    }

    Text {
        text: root.text;
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        overflow: elide;
        vertical-alignment: center;
    }
}
