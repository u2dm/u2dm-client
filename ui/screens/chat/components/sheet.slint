import { ScrollView } from "std-widgets.slint";
import { IconSet } from "@lucide";

import { FocusReveal } from "../../../components/a11y.slint";
import { Avatar } from "../../../components/avatar.slint";
import { IconButton } from "../../../components/button.slint";
import { DialogCard } from "../../../components/overlay.slint";
import { ActionTile } from "./action-tile.slint";
import { AppStyle, Fonts, Glyph, Metrics, Size, Space, Weight } from "../../../theme.slint";

export component SheetCover inherits VerticalLayout {
    in property <length> avatar-size;
    in property <int> color-index;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <string> initial;
    in property <string> name;

    padding-left: Space.xl;
    padding-right: Space.xl;
    spacing: Space.sm;

    HorizontalLayout {
        alignment: center;

        Avatar {
            width: root.avatar-size;
            height: root.avatar-size;
            color-index: root.color-index;
            has-image: root.has-avatar;
            image: root.avatar;
            initial: root.initial;
            initial-size: Glyph.xxl;
            initial-weight: Weight.bold;
            initial-font-family: "";
        }
    }

    Text {
        text: root.name;
        font-family: Fonts.emoji;
        font-size: Fonts.heading;
        font-weight: Weight.bold;
        horizontal-alignment: center;
        overflow: elide;
    }

    @children
}

export global ChipClearance {
    public pure function content-y(content-y: length, top: length, left: length, width: length,
        content-height: length, chip-left: length, chip-bottom: length) -> length {
        let start = top + content-y;
        let middle-x = FocusReveal.x + FocusReveal.width / 2;
        let middle-y = FocusReveal.y + FocusReveal.height / 2;
        if middle-x < left || middle-x >= left + width || middle-y < start || middle-y >= start + content-height
            || FocusReveal.x + FocusReveal.width <= chip-left {
            return content-y;
        }
        return min(0px, content-y + max(0px, chip-bottom - FocusReveal.y));
    }
}

export component SheetCloseChip inherits Rectangle {
    in property <brush> surface;
    in property <string> label;
    in property <bool> above-modal;
    out property <length> reserve: root.width + Space.lg;
    out property <length> clear-below: root.y + root.height + Space.md;
    out property <bool> has-focus: button.has-focus;

    callback clicked();

    public function take-focus() {
        button.take-focus();
    }

    width: Size.md;
    height: Size.md;
    border-radius: self.width / 2;
    background: root.surface;

    button := IconButton {
        size: Size.md;
        icon: IconSet.X;
        above-modal: root.above-modal;
        label: root.label;
        clicked => {
            root.clicked();
        }
    }
}

export component SheetCard inherits Rectangle {
    in property <length> max-card-height;
    in property <length> body-padding-top: Space.xl;
    in property <length> body-spacing: Space.lg;
    in property <string> close-label;

    callback close-clicked();

    public function focus-close() {
        close-chip.take-focus();
    }

    property <length> card-width: min(AppStyle.card-width-wide, root.width - AppStyle.card-inset);
    property <length> card-height: min(
        body.preferred-height,
        root.height - AppStyle.card-inset,
        root.max-card-height);
    property <int> reveal-serial: FocusReveal.serial;

    changed reveal-serial => {
        let clear = ChipClearance.content-y(scroll.content-y, scroll.absolute-position.y,
            scroll.absolute-position.x, scroll.width, scroll.content-height,
            close-chip.absolute-position.x - Metrics.ring-outset,
            scroll.absolute-position.y + close-chip.clear-below);
        if !close-chip.has-focus && clear != scroll.content-y {
            scroll.content-y = clear;
        }
    }

    width: 100%;
    height: 100%;

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        clip: true;

        scroll := ScrollView {
            width: 100%;
            height: 100%;
            content-width: root.card-width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: root.card-width;
                padding-top: root.body-padding-top;
                padding-bottom: Space.xl;
                spacing: root.body-spacing;

                @children
            }
        }

        close-chip := SheetCloseChip {
            x: parent.width - self.width - Space.md;
            y: Space.md;
            surface: AppStyle.elevated;
            label: root.close-label;
            above-modal: true;
            clicked => {
                root.close-clicked();
            }
        }
    }
}

export component TileRow inherits HorizontalLayout {
    out property <length> slot-width: (root.width - root.padding-left - root.padding-right - 2 * root.spacing) / 3;

    alignment: center;
    padding-left: Space.xl;
    padding-right: Space.xl;
    spacing: Space.md;

    @children
}

export component TilePrompt inherits Text {
    font-size: Fonts.body-small;
    font-weight: Weight.semibold;
    vertical-alignment: center;
    wrap: word-wrap;
    accessible-live-region: AccessibleLiveness.polite;
}

export component CopyLinkTile inherits ActionTile {
    in property <bool> copied;
    in property <string> copy-label;

    icon: root.copied ? IconSet.Check : IconSet.Link;
    text: root.copied ? @tr("Copied") : @tr("Copy link");
    label: root.copied ? @tr("Link copied") : root.copy-label;
}
