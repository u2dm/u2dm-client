import { Palette, ScrollView, Spinner } from "std-widgets.slint";

import { CopyFeedback } from "../../../components/copier.slint";
import { DialogHeader } from "../../../components/dialog-header.slint";
import { DialogCard, ModalHost } from "../../../components/overlay.slint";
import { SourceEncryption, SourceStatus } from "../../../enums.slint";
import { SourceView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { AppStyle, Fonts, Metrics, Radius, Size, Space, Weight } from "../../../theme.slint";

component SourceSection inherits VerticalLayout {
    in property <string> title;
    in property <string> json;

    spacing: Space.sm;

    Text {
        text: root.title;
        font-size: Fonts.caption;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-muted;
    }

    Rectangle {
        border-radius: Radius.sm;
        background: AppStyle.overlay-subtle;

        VerticalLayout {
            padding: Space.md;

            TextInput {
                text: root.json;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                font-family: Fonts.mono;
                font-size: Fonts.body-small;
                color: Palette.foreground;
                selection-background-color: Palette.selection-background;
                selection-foreground-color: Palette.selection-foreground;
            }
        }
    }
}

export component EventSourceDialog inherits ModalHost {
    dim-opacity: AppStyle.dialog-scrim;
    label: @tr("Message source");
    dismissed => {
        Actions.close-event-source();
    }
    opened => {
        header.focus-close();
    }

    property <length> card-width: min(Metrics.source-width, root.width - AppStyle.card-inset);
    property <length> card-height: min(root.height - AppStyle.card-inset, Metrics.source-max-height);
    property <bool> ready: SourceView.status == SourceStatus.ready;

    pure function encryption-note(encryption: SourceEncryption) -> string {
        if encryption == SourceEncryption.decrypted {
            return @tr("Decrypted on this device. Only the decrypted event is kept, not the encrypted one.");
        }
        if encryption == SourceEncryption.undecryptable {
            return @tr("This device couldn't decrypt it, so this is the encrypted event.");
        }
        return @tr("Not encrypted.");
    }

    changed ready => {
        source-copy.reset();
    }

    source-copy := CopyFeedback { }

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        clip: true;

        VerticalLayout {
            padding: Space.xl;
            spacing: Space.md;

            header := DialogHeader {
                title: @tr("Message source");
                copied: source-copy.copied;
                copy-enabled: root.ready;
                copy-label: @tr("Copy the source");
                copied-label: @tr("Source copied");
                close-label: @tr("Close the message source");
                copy-clicked => {
                    source-copy.copy(SourceView.json);
                }
                close-clicked => {
                    Actions.close-event-source();
                }

                Text {
                    text: SourceView.event-id;
                    font-size: Fonts.caption;
                    color: AppStyle.foreground-muted;
                    overflow: elide;
                }
            }

            if SourceView.status == SourceStatus.locating: HorizontalLayout {
                spacing: Space.md;
                alignment: start;

                Spinner {
                    width: Size.xxs;
                    height: Size.xxs;
                    indeterminate: true;
                }

                Text {
                    text: @tr("Loading the source...");
                    font-size: Fonts.body;
                    color: AppStyle.foreground-muted;
                    vertical-alignment: center;
                }
            }

            if SourceView.status == SourceStatus.unavailable: Text {
                text: @tr("The source of this message isn't available.");
                font-size: Fonts.body;
                color: AppStyle.foreground-muted;
                wrap: word-wrap;
            }

            if root.ready: Text {
                text: root.encryption-note(SourceView.encryption);
                font-size: Fonts.caption;
                color: AppStyle.foreground-muted;
                wrap: word-wrap;
            }

            if root.ready: scroll := ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    width: scroll.visible-width;
                    spacing: Space.lg;
                    alignment: start;

                    SourceSection {
                        title: @tr("Event");
                        json: SourceView.json;
                    }

                    if SourceView.edit-json != "": SourceSection {
                        title: @tr("Latest edit");
                        json: SourceView.edit-json;
                    }

                    if SourceView.encryption-json != "": SourceSection {
                        title: @tr("Decryption");
                        json: SourceView.encryption-json;
                    }
                }
            }

            if !root.ready: Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
