import { ChoiceGroup } from "../../../../components/choice-group.slint";
import { Hairline } from "../../../../components/divider.slint";
import { SectionLabel } from "../../../../components/text-roles.slint";
import { MotionChoice, ThemeChoice } from "../../../../enums.slint";
import { AppearanceView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { Motion, Space } from "../../../../theme.slint";
import { PageHeader } from "./page-header.slint";

export component AppearancePage inherits VerticalLayout {
    callback back();
    callback close();

    pure function theme-at(index: int) -> ThemeChoice {
        return index == 1 ? ThemeChoice.light : index == 2 ? ThemeChoice.dark : ThemeChoice.system;
    }

    pure function motion-at(index: int) -> MotionChoice {
        return index == 1 ? MotionChoice.reduced : index == 2 ? MotionChoice.full : MotionChoice.system;
    }

    spacing: Space.lg;

    PageHeader {
        title: @tr("Appearance");
        back => {
            root.back();
        }
        close => {
            root.close();
        }
    }

    Hairline { }

    SectionLabel {
        text: @tr("THEME");
    }

    ChoiceGroup {
        label: @tr("Theme");
        options: [
            {
                text: SettingsWords.theme(ThemeChoice.system),
                detail: @tr("Matches your desktop"),
            },
            { text: SettingsWords.theme(ThemeChoice.light), detail: "" },
            { text: SettingsWords.theme(ThemeChoice.dark), detail: "" },
        ];
        selected: AppearanceView.theme == ThemeChoice.light ? 1
            : AppearanceView.theme == ThemeChoice.dark ? 2
            : 0;
        chose(index) => {
            Actions.set-theme({ choice: root.theme-at(index) });
        }
    }

    SectionLabel {
        text: @tr("MOTION");
    }

    ChoiceGroup {
        label: @tr("Motion");
        options: [
            {
                text: SettingsWords.motion(MotionChoice.system),
                detail: SettingsWords.motion-detail(MotionChoice.system),
            },
            {
                text: SettingsWords.motion(MotionChoice.reduced),
                detail: SettingsWords.motion-detail(MotionChoice.reduced),
            },
            {
                text: SettingsWords.motion(MotionChoice.full),
                detail: SettingsWords.motion-detail(MotionChoice.full),
            },
        ];
        selected: Motion.choice == MotionChoice.reduced ? 1
            : Motion.choice == MotionChoice.full ? 2
            : 0;
        chose(index) => {
            Actions.set-motion({ choice: root.motion-at(index) });
        }
    }
}
