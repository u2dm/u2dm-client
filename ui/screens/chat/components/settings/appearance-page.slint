import { ClockChoice, MotionChoice, SettingKey, ThemeChoice } from "../../../../enums.slint";
import { AppearanceView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { Motion, Space } from "../../../../theme.slint";
import { SegmentedRow, SettingsGroup } from "./group.slint";

export component AppearancePage inherits VerticalLayout {
    pure function theme-at(index: int) -> ThemeChoice {
        return index == 1 ? ThemeChoice.light : index == 2 ? ThemeChoice.dark : ThemeChoice.system;
    }

    pure function motion-at(index: int) -> MotionChoice {
        return index == 1 ? MotionChoice.reduced : index == 2 ? MotionChoice.full : MotionChoice.system;
    }

    pure function clock-at(index: int) -> ClockChoice {
        return index == 1 ? ClockChoice.twelve-hour : index == 2 ? ClockChoice.twenty-four-hour : ClockChoice.system;
    }

    spacing: Space.xl;

    SettingsGroup {
        SegmentedRow {
            text: SettingsWords.label(SettingKey.theme);
            options: [
                SettingsWords.theme-segment(ThemeChoice.system),
                SettingsWords.theme-segment(ThemeChoice.light),
                SettingsWords.theme-segment(ThemeChoice.dark),
            ];
            selected: AppearanceView.theme == ThemeChoice.light ? 1
                : AppearanceView.theme == ThemeChoice.dark ? 2
                : 0;
            detail: SettingsWords.theme-detail(AppearanceView.theme);
            chose(index) => {
                Actions.set-theme({ choice: root.theme-at(index) });
            }
        }

        SegmentedRow {
            text: SettingsWords.label(SettingKey.motion);
            options: [
                SettingsWords.motion-segment(MotionChoice.system),
                SettingsWords.motion-segment(MotionChoice.reduced),
                SettingsWords.motion-segment(MotionChoice.full),
            ];
            selected: Motion.choice == MotionChoice.reduced ? 1
                : Motion.choice == MotionChoice.full ? 2
                : 0;
            detail: SettingsWords.motion-detail(Motion.choice);
            chose(index) => {
                Actions.set-motion({ choice: root.motion-at(index) });
            }
        }

        SegmentedRow {
            text: SettingsWords.label(SettingKey.clock);
            options: [
                SettingsWords.clock-segment(ClockChoice.system),
                SettingsWords.clock-segment(ClockChoice.twelve-hour),
                SettingsWords.clock-segment(ClockChoice.twenty-four-hour),
            ];
            selected: AppearanceView.clock == ClockChoice.twelve-hour ? 1
                : AppearanceView.clock == ClockChoice.twenty-four-hour ? 2
                : 0;
            detail: SettingsWords.clock-detail(AppearanceView.clock);
            chose(index) => {
                Actions.set-clock({ choice: root.clock-at(index) });
            }
        }
    }
}
