import { IconSet } from "@lucide";

import { IconButton } from "../../../../components/button.slint";
import { Fonts, Size, Space, Weight } from "../../../../theme.slint";

export component PageHeader inherits HorizontalLayout {
    in property <string> title;

    callback back();
    callback close();

    public function take-focus() {
        back-button.take-focus();
    }

    spacing: Space.sm;

    init => {
        back-button.take-focus();
    }

    back-button := IconButton {
        cross-axis-self-alignment: center;
        size: Size.md;
        icon: IconSet.ArrowLeft;
        above-modal: true;
        label: @tr("Back to Settings");
        clicked => {
            root.back();
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.title;
        font-size: Fonts.title;
        font-weight: Weight.bold;
        vertical-alignment: center;
    }

    IconButton {
        cross-axis-self-alignment: center;
        size: Size.md;
        icon: IconSet.X;
        above-modal: true;
        label: @tr("Close settings");
        clicked => {
            root.close();
        }
    }
}
