import { IconSet } from "@lucide";

import { ErrorBanner } from "../../../../components/banner.slint";
import { IconButton } from "../../../../components/button.slint";
import { Hairline } from "../../../../components/divider.slint";
import { UserMessageKind } from "../../../../enums.slint";
import { SettingsView } from "../../../../views.slint";
import { Fonts, Size, Space, Weight } from "../../../../theme.slint";

export component UnsavedBanner inherits ErrorBanner {
    messages: [{ kind: UserMessageKind.settings-not-saved, detail: "" }];
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;

    callback back();
    callback close();

    public function take-focus() {
        back-button.take-focus();
    }

    spacing: Space.lg;

    init => {
        back-button.take-focus();
    }

    HorizontalLayout {
        spacing: Space.sm;

        back-button := IconButton {
            cross-axis-self-alignment: center;
            size: Size.md;
            icon: IconSet.ArrowLeft;
            above-modal: true;
            label: @tr("Back to Settings");
            clicked => {
                root.back();
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Fonts.title;
            font-weight: Weight.bold;
            vertical-alignment: center;
        }

        IconButton {
            cross-axis-self-alignment: center;
            size: Size.md;
            icon: IconSet.X;
            above-modal: true;
            label: @tr("Close settings");
            clicked => {
                root.close();
            }
        }
    }

    Hairline { }

    if SettingsView.unsaved: UnsavedBanner { }
}
