import { IconSet } from "@lucide";

import { DialogHeader } from "../../../../components/dialog-header.slint";
import { Hairline } from "../../../../components/divider.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { ModalHost, ScrollingDialogCard } from "../../../../components/overlay.slint";
import { SettingsPage } from "../../../../enums.slint";
import { AppearanceView, SettingsView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { MetaTip, Reactions } from "../../../../local.slint";
import { AppStyle, Metrics, Space } from "../../../../theme.slint";
import { AppearancePage } from "./appearance-page.slint";
import { MessagesPage } from "./messages-page.slint";
import { NotificationsPage } from "./notifications-page.slint";
import { CallsPage } from "./calls-page.slint";
import { MediaPage } from "./media-page.slint";
import { RulesPage } from "./rules-page.slint";
import { IgnoredPage } from "./ignored-page.slint";
import { UnsavedBanner } from "./page-header.slint";

component Overview inherits VerticalLayout {
    in property <SettingsPage> came-from;

    callback open-page(SettingsPage);
    callback close();

    spacing: Space.lg;

    init => {
        if root.came-from == SettingsPage.appearance {
            appearance.take-focus();
        }
        if root.came-from == SettingsPage.messages {
            messages.take-focus();
        }
        if root.came-from == SettingsPage.notifications {
            notifications.take-focus();
        }
        if root.came-from == SettingsPage.calls {
            calls.take-focus();
        }
        if root.came-from == SettingsPage.media {
            media.take-focus();
        }
        if root.came-from == SettingsPage.rules {
            rules.take-focus();
        }
        if root.came-from == SettingsPage.ignored {
            ignored.take-focus();
        }
    }

    DialogHeader {
        title: @tr("Settings");
        copyable: false;
        close-label: @tr("Close settings");
        close-clicked => {
            root.close();
        }
    }

    Hairline { }

    if SettingsView.unsaved: UnsavedBanner { }

    VerticalLayout {
        spacing: Space.xs;

        appearance := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.Palette;
            label: @tr("Appearance");
            detail: SettingsWords.theme(AppearanceView.theme);
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.appearance);
            }
        }

        messages := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.MessageSquareText;
            label: @tr("Messages and privacy");
            detail: SettingsWords.messages-summary(SettingsView.send-key, SettingsView.receipts);
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.messages);
            }
        }

        notifications := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.Bell;
            label: @tr("Notifications and sounds");
            detail: SettingsWords.notifications-summary(SettingsView.desktop-notifications, SettingsView.hide-message-text);
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.notifications);
            }
        }

        calls := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.Phone;
            label: @tr("Calls");
            detail: SettingsWords.calls-summary(SettingsView.call-layout);
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.calls);
            }
        }

        media := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.Image;
            label: @tr("Media and storage");
            detail: SettingsWords.media-summary(SettingsView.auto-load-media);
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.media);
            }
        }

        rules := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.BellRing;
            label: @tr("Notification rules");
            detail: @tr("Kept on your homeserver");
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.rules);
            }
        }

        ignored := MenuRow {
            height: Metrics.choice-row;
            icon: IconSet.EyeOff;
            label: @tr("Ignored users");
            detail: @tr("Kept on your homeserver");
            trailing: IconSet.ChevronRight;
            above-modal: true;
            clicked => {
                root.open-page(SettingsPage.ignored);
            }
        }
    }
}

export component SettingsDialog inherits ModalHost {
    property <SettingsPage> came-from: SettingsPage.overview;
    property <bool> asking-clear;

    function show(page: SettingsPage) {
        root.focus();
        scroll.content-y = 0;
        root.asking-clear = false;
        Actions.show-settings-page({ page: page });
    }

    function open-page(page: SettingsPage) {
        root.came-from = page;
        root.show(page);
    }

    function back() {
        root.show(SettingsPage.overview);
    }

    dim-opacity: AppStyle.dialog-scrim;
    label: @tr("Settings");
    dismissed => {
        if root.asking-clear && !root.dismissing-by-pointer {
            root.asking-clear = false;
            return;
        }
        if SettingsView.page != SettingsPage.overview && !root.dismissing-by-pointer {
            root.back();
            return;
        }
        Actions.close-settings();
    }
    opened => {
        Reactions.close();
        MetaTip.clear();
    }

    scroll := ScrollingDialogCard {
        if SettingsView.page == SettingsPage.overview: Overview {
            came-from: root.came-from;
            open-page(page) => {
                root.open-page(page);
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.appearance: AppearancePage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.messages: MessagesPage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.notifications: NotificationsPage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.calls: CallsPage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.media: MediaPage {
            asking-clear <=> root.asking-clear;
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.rules: RulesPage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }

        if SettingsView.page == SettingsPage.ignored: IgnoredPage {
            back => {
                root.back();
            }
            close => {
                Actions.close-settings();
            }
        }
    }
}
