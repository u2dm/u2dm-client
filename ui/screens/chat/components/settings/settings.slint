component SettingsNavRow inherits Rectangle {
    in property <Icon> icon;
    in property <color> icon-tint: AppStyle.foreground-muted;
    in property <string> label;
    in property <string> description;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> roving-focus;
    in property <Icon> trailing;

    callback clicked();

    property <bool> has-trailing: root.trailing.paths.length > 0;

    border-radius: Radius.sm;
    background: root.selected ? AppStyle.accent-background-soft : transparent;

    StateLayer {
        border-radius: root.border-radius;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }

    touch := ClickArea {
        above-modal: true;
        focusable: false;
        roving-focus: root.roving-focus;
        ring-radius: root.border-radius;
        label: root.label;
        accessible-description: root.description != "" ? root.description : root.detail;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.md;
            stroke: root.selected ? Palette.foreground : root.icon-tint;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.label;
                font-size: Fonts.body;
                font-weight: root.selected ? Weight.semibold : Weight.regular;
                overflow: elide;
                accessible-role: none;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-size: Fonts.caption;
                color: AppStyle.foreground-muted;
                overflow: elide;
                accessible-role: none;
            }
        }

        if root.has-trailing: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.trailing;
            size: IconSize.sm;
            stroke: AppStyle.foreground-muted;
        }
    }
}

component SettingsNav inherits Rectangle {
    in property <bool> listing;
    in property <int> selected;
    in-out property <string> query;

    callback picked(SettingsPage, bool);
    callback followed(bool);
    callback found(int, bool);

    property <bool> searching: root.query != "";
    property <[int]> hits: root.searching ? Actions.settings-matches(root.query, SettingsIndex.entries) : [];
    property <int> opened-hit: -1;
    property <length> hit-height: Metrics.choice-row;
    property <length> hit-pitch: root.hit-height + Space.xs;
    property <length> list-top: Size.md + Space.md;
    property <string> found-words: root.hits.length == 0
        ? @tr("No settings match")
        : @tr("{n} setting" | "{n} settings" % root.hits.length);
    property <int> pages: SettingsPages.all.length;
    property <int> account: root.pages;
    property <int> encryption: root.pages + 1;
    property <int> about: root.pages + SettingsPages.link-count;
    property <length> row-height: root.listing ? Metrics.choice-row : Metrics.settings-nav-row;
    property <length> pitch: root.row-height + Space.xs;
    property <length> gap: Space.lg;
    property <string> account-label: @tr("Account and sessions");
    property <string> encryption-label: EncryptionView.needs-you
        ? @tr("Encryption, this session needs your attention")
        : @tr("Encryption");

    public function take-focus(ring: bool) {
        if root.searching {
            found-keys.cursor = ring && root.hits.length > 0
                ? clamp(root.opened-hit, 0, root.hits.length - 1)
                : -1;
            found-keys.focus();
            if found-keys.cursor >= 0 {
                root.reveal-hit(found-keys.cursor);
            }
            return;
        }
        keys.cursor = ring ? root.selected : -1;
        keys.focus();
        if ring {
            root.reveal(root.selected);
        }
    }

    public function focus-search() {
        search.focus();
    }

    pure function hit-label(position: int) -> string {
        if position < 0 || position >= root.hits.length {
            return "";
        }
        return @tr("{}, {}", SettingsIndex.entries[root.hits[position]].label,
            SettingsIndex.entries[root.hits[position]].page-title);
    }

    function open-hit(position: int, by-keys: bool) {
        if position < 0 || position >= root.hits.length {
            return;
        }
        root.opened-hit = position;
        root.found(root.hits[position], by-keys);
    }

    function reveal-hit(position: int) {
        results.reveal(count.preferred-height + Space.xs + position * root.hit-pitch, root.hit-height);
    }

    pure function label-at(index: int) -> string {
        if index == root.account {
            return root.account-label;
        }
        if index == root.encryption {
            return root.encryption-label;
        }
        return SettingsPages.title(root.page-at(index));
    }

    pure function page-at(index: int) -> SettingsPage {
        return index == root.about ? SettingsPage.about : SettingsPages.all[index];
    }

    function activate(index: int, by-keys: bool) {
        if index == root.account || index == root.encryption {
            root.followed(index == root.account);
        } else {
            root.picked(root.page-at(index), by-keys);
        }
    }

    pure function row-top(index: int) -> length {
        return index < root.pages
            ? index * root.pitch
            : root.pages * root.pitch + root.gap + Space.xs + (index - root.pages) * root.pitch;
    }

    function reveal(index: int) {
        scroll.reveal(root.row-top(index), root.row-height);
    }

    field-keys := FocusScope {
        x: Space.sm;
        y: 0;
        width: root.width - 2 * Space.sm;
        height: Size.md;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.DownArrow && root.hits.length > 0 {
                found-keys.cursor = 0;
                found-keys.focus();
                root.reveal-hit(0);
                return accept;
            }
            return reject;
        }

        search := SearchField {
            width: 100%;
            height: 100%;
            placeholder: @tr("Search settings");
            query <=> root.query;
            above-modal: true;
            edited(text) => {
                found-keys.cursor = -1;
                root.opened-hit = -1;
                results.content-y = 0;
            }
            accepted => {
                root.open-hit(0, true);
            }
        }
    }

    found-keys := RovingKeys {
        count: root.hits.length;
        focus-on-tab-navigation: root.searching;
        accessible-label: root.hit-label(max(self.cursor, 0));
        accessible-description: root.found-words;
        accessible-action-default => {
            root.open-hit(max(self.cursor, 0), true);
        }
        intercept(event) => {
            if event.text == Key.UpArrow && self.cursor <= 0 {
                root.focus-search();
                return accept;
            }
            return reject;
        }
        moved(position) => {
            root.reveal-hit(position);
        }
        activated(position) => {
            root.open-hit(position, true);
        }
    }

    keys := RovingKeys {
        count: root.about + 1;
        focus-on-tab-navigation: !root.searching;
        start-at: root.selected;
        accessible-role: tab;
        accessible-label: root.label-at(max(self.cursor, 0));
        accessible-item-selected: max(self.cursor, 0) == root.selected;
        accessible-action-default => {
            root.activate(max(self.cursor, 0), true);
        }
        intercept(event) => {
            if self.cursor < 0 && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                self.cursor = root.selected;
                root.reveal(root.selected);
                return accept;
            }
            return reject;
        }
        moved(index) => {
            root.reveal(index);
        }
        activated(index) => {
            root.activate(index, true);
        }
    }

    scroll := MenuScroll {
        y: root.list-top;
        height: root.height - root.list-top;
        visible: !root.searching;

        for page[index] in SettingsPages.all: SettingsNavRow {
            height: root.row-height;
            icon: SettingsPages.icon(page);
            label: SettingsPages.title(page);
            detail: root.listing ? SettingsPages.summary(page) : "";
            selected: !root.listing && index == root.selected;
            roving-focus: keys.has-focus && keys.cursor == index;
            trailing: root.listing ? IconSet.ChevronRight : { };
            clicked => {
                root.picked(page, false);
            }
        }

        MenuDivider {
            height: root.gap;
        }

        SettingsNavRow {
            height: root.row-height;
            icon: IconSet.UserRoundCog;
            label: root.account-label;
            description: @tr("Opens its own dialog");
            roving-focus: keys.has-focus && keys.cursor == root.account;
            trailing: IconSet.ArrowUpRight;
            clicked => {
                root.followed(true);
            }
        }

        SettingsNavRow {
            height: root.row-height;
            icon: EncryptionView.needs-you ? IconSet.ShieldAlert : IconSet.ShieldCheck;
            icon-tint: EncryptionView.needs-you ? AppStyle.warning : AppStyle.foreground-muted;
            label: root.encryption-label;
            description: @tr("Opens its own dialog");
            roving-focus: keys.has-focus && keys.cursor == root.encryption;
            trailing: IconSet.ArrowUpRight;
            clicked => {
                root.followed(false);
            }
        }

        SettingsNavRow {
            height: root.row-height;
            icon: SettingsPages.icon(SettingsPage.about);
            label: SettingsPages.title(SettingsPage.about);
            detail: root.listing ? SettingsPages.summary(SettingsPage.about) : "";
            selected: !root.listing && root.selected == root.about;
            roving-focus: keys.has-focus && keys.cursor == root.about;
            trailing: root.listing ? IconSet.ChevronRight : { };
            clicked => {
                root.picked(SettingsPage.about, false);
            }
        }
    }

    results := MenuScroll {
        y: root.list-top;
        height: root.height - root.list-top;
        visible: root.searching;

        count := HorizontalLayout {
            padding-left: Space.md;
            padding-right: Space.md;

            Text {
                text: root.found-words;
                font-size: Fonts.caption;
                color: AppStyle.foreground-muted;
                wrap: word-wrap;
                accessible-live-region: AccessibleLiveness.polite;
            }
        }

        for hit[position] in root.hits: SettingsNavRow {
            height: root.hit-height;
            icon: SettingsPages.icon(SettingsIndex.entries[hit].page);
            label: SettingsIndex.entries[hit].label;
            detail: SettingsIndex.entries[hit].page-title;
            roving-focus: found-keys.has-focus && found-keys.cursor == position;
            clicked => {
                root.open-hit(position, false);
            }
        }
    }
}

export component SettingsDialog inherits ModalHost {
    property <string> query;
    property <bool> asking-clear;
    property <int> picking-slot: -1;
    property <int> picker-peels;
    property <bool> wide: root.width >= Metrics.settings-split-min;
    property <bool> listing: !root.wide && SettingsView.listing;
    property <SettingsPage> page: SettingsView.page;
    property <bool> keyed;
    property <bool> arriving;
    property <bool> returning;
    property <length> pad: Space.xxl;
    property <length> nav-x: Space.lg;
    property <length> pane-x: root.wide ? root.pad + Metrics.settings-sidebar : root.pad;
    property <length> nav-width: root.wide
        ? Metrics.settings-sidebar
        : root.listing ? card.shown-width - 2 * root.nav-x : 0;
    property <int> reveal-serial: FocusReveal.serial;

    function reveal-focus() {
        let top = pane.absolute-position.y;
        let left = pane.absolute-position.x;
        let start = top + pane.content-y;
        let middle-x = FocusReveal.x + FocusReveal.width / 2;
        let middle-y = FocusReveal.y + FocusReveal.height / 2;
        if root.listing || header.holds-focus
            || middle-x < left || middle-x >= left + pane.width
            || middle-y < start || middle-y >= start + pane.content-height {
            return;
        }
        let above = top - FocusReveal.y;
        let below = FocusReveal.y + FocusReveal.height - top - pane.visible-height;
        if above > 0 {
            pane.content-y = min(0px, pane.content-y + above);
        } else if below > 0 {
            pane.content-y = max(pane.visible-height - pane.content-height, pane.content-y - min(below, -above));
        }
    }

    function report-layout() {
        Actions.settings-layout({ layout: root.wide ? SettingsLayout.side-by-side : SettingsLayout.stacked });
    }

    function park-focus() {
        if root.wide {
            nav.take-focus(false);
        } else {
            root.focus();
        }
    }

    function open-page(page: SettingsPage, by-keys: bool) {
        root.asking-clear = false;
        root.picking-slot = -1;
        root.keyed = by-keys;
        if !root.wide {
            root.focus();
            root.arriving = true;
        } else if !by-keys {
            nav.take-focus(false);
        }
        Actions.show-settings-page({ page: page });
    }

    function open-result(index: int, by-keys: bool) {
        root.asking-clear = false;
        root.picking-slot = -1;
        root.keyed = false;
        SettingsSearch.sought = SettingsIndex.entries[index].key;
        SettingsSearch.keyed = by-keys;
        SettingsSearch.serial += 1;
        if root.wide {
            nav.take-focus(false);
        } else {
            root.focus();
            root.arriving = true;
        }
        Actions.show-settings-page({ page: SettingsIndex.entries[index].page });
    }

    function follow-link(account: bool) {
        Actions.close-settings();
        if account {
            Actions.open-account();
        } else {
            Actions.open-encryption();
        }
    }

    function list(by-keys: bool) {
        root.focus();
        root.asking-clear = false;
        root.picking-slot = -1;
        root.keyed = by-keys;
        root.returning = true;
        Actions.show-settings-list();
    }

    changed page => {
        pane.content-y = 0;
    }

    changed picking-slot => {
        pane.content-y = 0;
    }

    changed reveal-serial => {
        root.reveal-focus();
    }

    changed wide => {
        root.focus();
        root.report-layout();
        if root.wide || SettingsView.listing {
            nav.take-focus(false);
        }
    }

    dim-opacity: AppStyle.dialog-scrim;
    label: @tr("Settings");
    dismissed => {
        if root.asking-clear && !root.dismissing-by-pointer {
            root.asking-clear = false;
            return;
        }
        if root.picking-slot >= 0 && !root.dismissing-by-pointer {
            root.focus();
            root.picking-slot = -1;
            root.picker-peels += 1;
            return;
        }
        if !root.wide && !SettingsView.listing && !root.dismissing-by-pointer {
            root.list(true);
            return;
        }
        if root.query != "" && !root.dismissing-by-pointer {
            root.query = "";
            nav.focus-search();
            return;
        }
        Actions.close-settings();
    }
    opened => {
        Reactions.close();
        MetaTip.clear();
        SettingsSearch.sought = SettingKey.none;
        root.keyed = SettingsEntry.by-keys;
        SettingsEntry.by-keys = false;
        root.report-layout();
        if root.wide || SettingsView.listing {
            nav.take-focus(root.keyed);
        } else {
            header.focus-back();
        }
    }
    reclaimed => {
        if root.wide || SettingsView.listing {
            nav.take-focus(true);
        } else {
            header.focus-back();
        }
    }

    if !root.wide && SettingsView.listing: Rectangle {
        width: 0;
        height: 0;
        init => {
            if root.returning {
                root.returning = false;
                nav.take-focus(root.keyed);
            }
        }
    }

    if !root.wide && !SettingsView.listing: Rectangle {
        width: 0;
        height: 0;
        init => {
            if root.arriving {
                root.arriving = false;
                if root.keyed {
                    header.focus-back();
                }
            }
        }
    }

    card := FixedDialogCard {
        card-width: root.wide ? Metrics.settings-width : AppStyle.card-width-wide;
        card-height: Metrics.settings-height;

        VerticalLayout {
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: Space.md;

                header := SettingsHeader {
                    wide: root.wide;
                    listing: SettingsView.listing;
                    title: SettingsPages.title(root.page);
                    back(by-keys) => {
                        root.list(by-keys);
                    }
                    close => {
                        Actions.close-settings();
                    }
                }
            }

            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;

                Hairline { }
            }

            if SettingsView.unsaved: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: Space.lg;

                UnsavedBanner { }
            }

            Rectangle {
                vertical-stretch: 1;

                nav := SettingsNav {
                    x: root.nav-x;
                    y: Space.md;
                    width: root.nav-width;
                    height: parent.height - Space.md;
                    visible: root.wide || root.listing;
                    listing: root.listing;
                    selected: SettingsPages.position(root.page);
                    query <=> root.query;
                    picked(page, by-keys) => {
                        root.open-page(page, by-keys);
                    }
                    followed(account) => {
                        root.follow-link(account);
                    }
                    found(index, by-keys) => {
                        root.open-result(index, by-keys);
                    }
                }

                pane := ScrollView {
                    x: root.pane-x - Metrics.ring-outset;
                    width: card.shown-width - root.pane-x + Metrics.ring-outset;
                    height: parent.height;
                    visible: !root.listing;
                    content-width: self.visible-width;
                    content-height: page-body.preferred-height;

                    page-body := VerticalLayout {
                        width: pane.visible-width;
                        padding-left: Metrics.ring-outset;
                        padding-top: Space.lg;
                        padding-right: root.pad;
                        padding-bottom: root.pad;

                        if !root.listing && root.page == SettingsPage.appearance: AppearancePage { }

                        if !root.listing && root.page == SettingsPage.messages: MessagesPage { }

                        if !root.listing && root.page == SettingsPage.reactions: ReactionsPage {
                            room: pane.height - Space.lg - root.pad;
                            peels: root.picker-peels;
                            picking <=> root.picking-slot;
                            park-focus => {
                                root.park-focus();
                            }
                        }

                        if !root.listing && root.page == SettingsPage.notifications: NotificationsPage { }

                        if !root.listing && root.page == SettingsPage.privacy: PrivacyPage {
                            park-focus => {
                                root.park-focus();
                            }
                        }

                        if !root.listing && root.page == SettingsPage.calls: CallsPage { }

                        if !root.listing && root.page == SettingsPage.media: MediaPage {
                            asking-clear <=> root.asking-clear;
                            park-focus => {
                                root.park-focus();
                            }
                        }

                        if !root.listing && root.page == SettingsPage.about: AboutPage { }

                    }
                }
            }
        }
    }
}
