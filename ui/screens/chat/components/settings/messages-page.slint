import { SwitchRow } from "../../../../components/switch-row.slint";
import { SendKey, SettingFlag, SettingKey } from "../../../../enums.slint";
import { SettingsView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { Space } from "../../../../theme.slint";
import { SegmentedRow, SettingsGroup } from "./group.slint";

export component MessagesPage inherits VerticalLayout {
    spacing: Space.xl;

    SettingsGroup {
        SegmentedRow {
            key: SettingKey.send-key;
            text: SettingsWords.label(SettingKey.send-key);
            options: [SettingsWords.send-key(SendKey.enter), SettingsWords.send-key(SendKey.ctrl-enter)];
            selected: SettingsView.send-key == SendKey.ctrl-enter ? 1 : 0;
            detail: SettingsWords.send-key-detail(SettingsView.send-key);
            chose(index) => {
                Actions.set-send-key({ choice: index == 1 ? SendKey.ctrl-enter : SendKey.enter });
            }
        }
    }

    SettingsGroup {
        label: @tr("TIMELINE");

        SwitchRow {
            key: SettingKey.joins-and-leaves;
            text: SettingsWords.label(SettingKey.joins-and-leaves);
            detail: SettingsWords.detail(SettingKey.joins-and-leaves);
            on: SettingsView.joins-and-leaves;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.joins-and-leaves, on: on });
            }
        }

        SwitchRow {
            key: SettingKey.profile-changes;
            text: SettingsWords.label(SettingKey.profile-changes);
            detail: SettingsWords.detail(SettingKey.profile-changes);
            on: SettingsView.profile-changes;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.profile-changes, on: on });
            }
        }
    }
}
