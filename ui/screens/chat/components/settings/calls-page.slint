import { ChoiceGroup } from "../../../../components/choice-group.slint";
import { SwitchRow } from "../../../../components/switch-row.slint";
import { CallLayout, SettingFlag, SettingKey } from "../../../../enums.slint";
import { SettingsView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { Space } from "../../../../theme.slint";
import { SettingsGroup } from "./group.slint";

export component CallsPage inherits VerticalLayout {
    pure function layout-at(index: int) -> CallLayout {
        return index == 1 ? CallLayout.call-and-chat
            : index == 2 ? CallLayout.call-only
            : index == 3 ? CallLayout.chat-only
            : CallLayout.automatic;
    }

    spacing: Space.xl;

    SettingsGroup {
        label: @tr("DEVICES");

        SwitchRow {
            key: SettingKey.remember-devices;
            text: SettingsWords.label(SettingKey.remember-devices);
            detail: SettingsWords.detail(SettingKey.remember-devices);
            on: SettingsView.remember-devices;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.remember-devices, on: on });
            }
        }

        SwitchRow {
            key: SettingKey.camera-on-join;
            text: SettingsWords.label(SettingKey.camera-on-join);
            detail: SettingsWords.detail(SettingKey.camera-on-join);
            on: SettingsView.camera-on-join;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.camera-on-join, on: on });
            }
        }
    }

    SettingsGroup {
        label: @tr("INCOMING CALLS");

        SwitchRow {
            key: SettingKey.ringtone;
            text: SettingsWords.label(SettingKey.ringtone);
            detail: SettingsWords.detail(SettingKey.ringtone);
            on: SettingsView.ringtone;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.ringtone, on: on });
            }
        }
    }

    SettingsGroup {
        label: @tr("DEFAULT LAYOUT");

        ChoiceGroup {
            key: SettingKey.call-layout;
            label: SettingsWords.label(SettingKey.call-layout);
            options: [
                {
                    text: SettingsWords.call-layout(CallLayout.automatic),
                    detail: @tr("Call and chat for video calls, Chat only for voice calls"),
                },
                { text: SettingsWords.call-layout(CallLayout.call-and-chat), detail: "" },
                { text: SettingsWords.call-layout(CallLayout.call-only), detail: "" },
                { text: SettingsWords.call-layout(CallLayout.chat-only), detail: "" },
            ];
            selected: SettingsView.call-layout == CallLayout.call-and-chat ? 1
                : SettingsView.call-layout == CallLayout.call-only ? 2
                : SettingsView.call-layout == CallLayout.chat-only ? 3
                : 0;
            chose(index) => {
                Actions.set-call-layout({ choice: root.layout-at(index) });
            }
        }
    }

    SettingsGroup {
        SwitchRow {
            key: SettingKey.follow-speaker;
            text: SettingsWords.label(SettingKey.follow-speaker);
            detail: SettingsWords.detail(SettingKey.follow-speaker);
            on: SettingsView.follow-speaker;
            toggled(on) => {
                Actions.set-setting-flag({ setting: SettingFlag.follow-speaker, on: on });
            }
        }
    }
}
