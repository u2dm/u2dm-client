import { ErrorBanner } from "../../../../components/banner.slint";
import { AppButton } from "../../../../components/button.slint";
import { SwitchRow } from "../../../../components/switch-row.slint";
import { SectionLabel } from "../../../../components/text-roles.slint";
import { DownloadedMedia, SettingFlag, UserMessageKind } from "../../../../enums.slint";
import { SettingsView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsWords } from "../../../../messages.slint";
import { AppStyle, Fonts, Space } from "../../../../theme.slint";

component SizeLine inherits Rectangle {
    in property <string> text;
    in property <string> size;

    height: line.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("{}: {}", root.text, root.size);

    line := HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.lg;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Fonts.label;
            wrap: word-wrap;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 0;
            text: root.size;
            font-size: Fonts.label;
            color: AppStyle.foreground-muted;
            accessible-role: none;
        }
    }
}

component StorageSection inherits VerticalLayout {
    in-out property <bool> asking;

    callback confirmed();

    property <DownloadedMedia> storage: SettingsView.downloaded-media;
    property <bool> clearing: root.storage == DownloadedMedia.clearing;
    property <bool> can-clear: root.storage == DownloadedMedia.measured && SettingsView.has-clearable-media;
    property <bool> refocus-button;
    property <string> question: @tr("Remove {} of images, videos and audio from this device?", SettingsView.clearable-size);

    spacing: Space.md;

    if SettingsView.media-clear-failed: ErrorBanner {
        messages: [{ kind: UserMessageKind.downloaded-media-not-cleared, detail: "" }];
    }

    SizeLine {
        text: @tr("Images, videos and audio");
        size: SettingsWords.storage-size(root.storage, SettingsView.clearable-size);
    }

    SizeLine {
        text: @tr("Profile pictures, sticker packs and custom emoji");
        size: SettingsWords.storage-size(root.storage, SettingsView.kept-size);
    }

    if !root.asking: HorizontalLayout {
        padding-left: Space.md;
        alignment: start;

        AppButton {
            above-modal: true;
            text: @tr("Clear downloaded media");
            description: @tr("Removes images, videos and audio from this device");
            tint: AppStyle.danger-muted;
            filled: false;
            enabled: root.can-clear || root.clearing;
            busy: root.clearing;
            init => {
                if root.refocus-button && root.can-clear {
                    self.take-focus();
                }
            }
            clicked => {
                root.refocus-button = true;
                root.asking = true;
            }
        }
    }

    if root.asking: Rectangle {
        height: question.preferred-height;

        question := VerticalLayout {
            padding-left: Space.md;
            padding-right: Space.md;
            spacing: Space.md;

            Text {
                text: root.question;
                font-size: Fonts.label;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Space.md;

                AppButton {
                    above-modal: true;
                    text: @tr("Cancel");
                    description: root.question;
                    filled: false;
                    init => {
                        self.take-focus();
                    }
                    clicked => {
                        root.asking = false;
                    }
                }

                AppButton {
                    above-modal: true;
                    text: @tr("Clear");
                    description: root.question;
                    tint: AppStyle.danger-muted;
                    clicked => {
                        root.refocus-button = false;
                        root.confirmed();
                        root.asking = false;
                        Actions.clear-downloaded-media();
                    }
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;

        Text {
            text: @tr("Anything you view again downloads again. Profile pictures, sticker packs, custom emoji and whatever is playing now stay.");
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            wrap: word-wrap;
        }
    }
}

export component MediaPage inherits VerticalLayout {
    in-out property <bool> asking-clear;

    callback park-focus();

    spacing: Space.lg;

    SectionLabel {
        text: @tr("DOWNLOADS");
    }

    SwitchRow {
        text: @tr("Load media automatically");
        detail: @tr("Images, stickers and video previews appear as they arrive. When off, you choose which to load. Profile pictures, custom emoji and your own messages always load");
        on: SettingsView.auto-load-media;
        toggled(on) => {
            Actions.set-setting-flag({ setting: SettingFlag.auto-load-media, on: on });
        }
    }

    SectionLabel {
        text: @tr("ANIMATION");
    }

    SwitchRow {
        text: @tr("Play animated images");
        detail: @tr("GIFs, stickers and custom emoji move. When off, they stay on their first frame");
        on: SettingsView.play-animations;
        toggled(on) => {
            Actions.set-setting-flag({ setting: SettingFlag.play-animations, on: on });
        }
    }

    SectionLabel {
        text: @tr("STORAGE");
    }

    StorageSection {
        asking <=> root.asking-clear;
        confirmed => {
            root.park-focus();
        }
    }
}
