import { SegmentedChoice } from "../../../../components/segmented-choice.slint";
import { SoughtTint } from "../../../../components/sought-tint.slint";
import { SectionLabel } from "../../../../components/text-roles.slint";
import { SettingKey } from "../../../../enums.slint";
import { AppStyle, Fonts, Metrics, Opacity, Radius, Space, Stroke, Weight } from "../../../../theme.slint";

export component GroupLabel inherits HorizontalLayout {
    in property <string> text;

    padding-left: Space.lg;
    padding-right: Space.lg;

    SectionLabel {
        text: root.text;
        overflow: elide;
    }
}

export component GroupNote inherits Rectangle {
    in property <string> text;

    height: note.preferred-height;

    note := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;

        Text {
            text: root.text;
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            wrap: word-wrap;
        }
    }
}

export component SettingsGroup inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    in property <SettingKey> key;

    callback arrived(bool);

    spacing: Space.sm;

    if root.label != "": GroupLabel {
        text: root.label;
    }

    Rectangle {
        height: rows.preferred-height;
        border-radius: Radius.md;
        clip: true;

        rows := VerticalLayout {
            spacing: Stroke.hairline;

            @children
        }

        SoughtTint {
            key: root.key;
            arrived(keyed) => {
                root.arrived(keyed);
            }
        }
    }

    if root.note != "": GroupNote {
        text: root.note;
    }
}

export component NoteRow inherits Rectangle {
    in property <string> text;

    height: max(Metrics.settings-row, line.preferred-height);
    background: AppStyle.control;

    line := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;
        padding-bottom: Space.md;

        Text {
            text: root.text;
            font-size: Fonts.label;
            color: AppStyle.overlay-foreground-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component ValueLine inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <SettingKey> key;

    height: max(Metrics.settings-row, line.preferred-height + Space.md);
    background: AppStyle.control;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("{}: {}", root.text, root.value);

    SoughtTint {
        key: root.key;
    }

    line := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Fonts.label;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 0;
            text: root.value;
            font-size: Fonts.label;
            color: AppStyle.overlay-foreground-muted;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component SegmentedRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    in property <string> reason;
    in property <SettingKey> key;

    callback chose(int);

    height: layout.preferred-height;
    background: AppStyle.control;

    SoughtTint {
        key: root.key;
        arrived(keyed) => {
            if keyed && root.enabled {
                choice.take-focus();
            }
        }
    }

    layout := VerticalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.sm;

        Text {
            text: root.text;
            font-size: Fonts.label;
            font-weight: Weight.semibold;
            wrap: word-wrap;
            opacity: root.enabled ? 1 : Opacity.disabled;
            accessible-role: none;
        }

        choice := SegmentedChoice {
            options: root.options;
            selected: root.selected;
            label: root.text;
            description: root.detail;
            reason: root.reason;
            enabled: root.enabled;
            above-modal: true;
            chose(index) => {
                root.chose(index);
            }
        }

        Text {
            text: root.detail;
            font-size: Fonts.body-small;
            color: AppStyle.overlay-foreground-muted;
            wrap: word-wrap;
            opacity: root.enabled ? 1 : Opacity.disabled;
            accessible-role: none;
        }
    }
}
