import { Palette, ScrollView, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

import { Avatar } from "../../../components/avatar.slint";
import { ClickArea, Interaction, ListItemArea } from "../../../components/a11y.slint";
import { CopyFeedback } from "../../../components/copier.slint";
import { CloseWatch } from "../../../components/close-watch.slint";
import { DialogCard, ModalHost, PickerCard, Placement } from "../../../components/overlay.slint";
import { ErrorBanner } from "../../../components/banner.slint";
import { RetryNotice } from "../../../components/retry-notice.slint";
import { ActionTile } from "./action-tile.slint";
import { DetailLine } from "./detail-line.slint";
import { CopyLinkTile, SheetCloseChip, SheetCover, TilePrompt, TileRow } from "./sheet.slint";
import { MemberRoles } from "./member-roles.slint";
import { SearchField } from "../../../components/search-field.slint";
import { NotifyModes } from "./notify-modes.slint";
import { MemberEntry } from "../../../types.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Size, Space, Stroke, Weight } from "../../../theme.slint";
import { MemberRowKind, RosterStatus, UserMessageKind } from "../../../enums.slint";
import { RoomInfoView } from "../../../views.slint";
import { Shell } from "../../../local.slint";
import { Actions } from "../../../actions.slint";

component NotifyRow inherits ListItemArea {
    in property <Icon> icon;
    in property <string> text;
    in property <bool> current;

    above-modal: true;
    label: root.text;
    selected: root.current;
    height: Metrics.room-info-picker-row;
    border-radius: Radius.sm;
    ring-radius: Radius.sm;
    background: self.has-hover ? AppStyle.overlay-hover : transparent;

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.md;
            stroke: AppStyle.foreground-muted;
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Fonts.body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        if root.current: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Check;
            size: IconSize.sm;
            stroke: Palette.accent-background;
        }
    }
}

component TopicText inherits Rectangle {
    in property <styled-text> styled;
    in property <string> plain;
    in property <bool> has-links;
    in property <bool> expanded;
    in-out property <bool> selecting;
    out property <bool> clamped: whole.preferred-height > clamp.preferred-height;

    height: content.preferred-height;
    accessible-role: text;
    accessible-label: root.plain;
    accessible-action-default => {
        root.selecting = true;
    }

    whole := StyledText {
        width: root.width;
        visible: false;
        text: root.styled;
        default-font-family: Fonts.emoji;
        default-font-size: Fonts.body;
    }

    clamp := StyledText {
        width: root.width;
        visible: false;
        text: root.styled;
        default-font-family: Fonts.emoji;
        default-font-size: Fonts.body;
        max-lines: Metrics.room-info-topic-lines;
    }

    content := VerticalLayout {
        if !root.selecting: StyledText {
            text: root.styled;
            default-font-family: Fonts.emoji;
            default-font-size: Fonts.body;
            default-color: Palette.foreground;
            link-color: AppStyle.link;
            max-lines: root.expanded ? 0 : Metrics.room-info-topic-lines;
            link-clicked(url) => {
                Actions.open-link(url);
            }
        }

        if root.selecting: TextInput {
            text: root.plain;
            font-family: Fonts.emoji;
            font-size: Fonts.body;
            color: Palette.foreground;
            wrap: word-wrap;
            read-only: true;
            single-line: false;
            selection-background-color: Palette.selection-background;
            selection-foreground-color: Palette.selection-foreground;
            accessible-label: @tr("Topic");

            init => {
                self.focus();
                self.select-all();
            }
            changed has-focus => {
                if !self.has-focus {
                    root.selecting = false;
                }
            }
        }
    }

    if !root.selecting && !root.has-links: TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: text;
        clicked => {
            root.selecting = true;
        }
    }
}

component TopicAction inherits ClickArea {
    in property <Icon> icon;
    in property <string> text;

    above-modal: true;
    label: root.text;
    width: content.preferred-width;
    height: Size.target-min;
    border-radius: Radius.xs;
    ring-radius: Radius.xs;
    background: self.has-hover ? AppStyle.overlay-hover : transparent;

    content := HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.xs;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.xs;
            stroke: AppStyle.link;
        }

        Text {
            text: root.text;
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.link;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component MemberRow inherits ListItemArea {
    in property <MemberEntry> entry;

    pure function describe(entry: MemberEntry) -> string {
        if entry.kind == MemberRowKind.invited-heading {
            return @tr("Invited");
        }
        if MemberRoles.label(entry.role) == "" {
            return @tr("{}, {}", entry.name, entry.user-id);
        }
        return @tr("{}, {}, {}", entry.name, entry.user-id, MemberRoles.label(entry.role));
    }

    enabled: root.entry.kind == MemberRowKind.member;
    label: root.describe(root.entry);
    background: root.has-hover && root.enabled ? AppStyle.overlay-hover : transparent;
    clicked => {
        Actions.open-user-info(root.entry.user-id);
    }

    if root.entry.kind == MemberRowKind.invited-heading: HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-bottom: Space.sm;

        Text {
            text: @tr("Invited");
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: bottom;
            accessible-role: none;
        }
    }

    if root.entry.kind == MemberRowKind.member: HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        spacing: Space.lg;

        Avatar {
            cross-axis-self-alignment: center;
            width: Metrics.room-info-member-avatar;
            height: Metrics.room-info-member-avatar;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xs;

            Text {
                text: root.entry.name;
                font-family: Fonts.emoji;
                font-size: Fonts.body;
                font-weight: Weight.semibold;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                text: root.entry.user-id;
                font-size: Fonts.body-small;
                color: AppStyle.foreground-muted;
                overflow: elide;
                accessible-role: none;
            }
        }

        if MemberRoles.label(root.entry.role) != "": Text {
            cross-axis-self-alignment: center;
            text: MemberRoles.label(root.entry.role);
            font-size: Fonts.caption;
            color: AppStyle.foreground-muted;
            accessible-role: none;
        }
    }
}

component NotifyPickerHost inherits ModalHost {
    in property <length> anchor-x;
    in property <length> anchor-y;

    dim: false;
    label: @tr("Notifications");

    PickerCard {
        x: Placement.fit(root.anchor-x - root.absolute-position.x, self.width, root.width, Space.md);
        y: min(
            root.anchor-y - root.absolute-position.y + Space.sm,
            max(Space.md, root.height - self.height - Space.md));
        width: Metrics.room-info-picker-width;
        height: picker-rows.preferred-height;

        picker-rows := VerticalLayout {
            padding: Space.sm;
            spacing: Space.xs;

            for mode[index] in NotifyModes.all: NotifyRow {
                index: index;
                icon: NotifyModes.icon(mode);
                text: NotifyModes.choice(mode);
                current: RoomInfoView.notify == mode;
                clicked => {
                    Actions.set-room-notify(RoomInfoView.room-id, mode);
                    root.dismissed();
                }
            }
        }
    }
}

component CompactRoomCover inherits HorizontalLayout {
    in property <length> reserve;

    padding-left: Space.xl;
    padding-right: root.reserve;
    spacing: Space.lg;

    Avatar {
        cross-axis-self-alignment: center;
        width: Metrics.room-info-avatar-compact;
        height: Metrics.room-info-avatar-compact;
        color-index: RoomInfoView.color-index;
        has-image: RoomInfoView.has-avatar;
        image: RoomInfoView.avatar;
        initial: RoomInfoView.initial;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Space.xs;

        Text {
            text: RoomInfoView.name;
            font-family: Fonts.emoji;
            font-size: Fonts.title;
            font-weight: Weight.bold;
            overflow: elide;
        }

        if !RoomInfoView.is-direct: Text {
            text: @tr("{n} member" | "{n} members" % RoomInfoView.members);
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            overflow: elide;
        }
    }
}

component RoomActionTiles inherits TileRow {
    in property <bool> above-modal;
    in property <bool> copied;
    in property <bool> asking-leave;
    out property <length> notify-x: notify-tile.absolute-position.x;
    out property <length> notify-bottom: notify-tile.absolute-position.y + notify-tile.height;

    callback notifications-clicked();
    callback leave-clicked();
    callback leave-confirmed();
    callback copy-clicked();

    height: Metrics.room-info-action;

    public function focus-notifications() {
        notify-tile.take-focus();
    }

    public function focus-leave() {
        leave-tile.take-focus();
    }

    Rectangle {
        width: root.slot-width;

        notify-tile := ActionTile {
            width: 100%;
            height: 100%;
            above-modal: root.above-modal;
            visible: !root.asking-leave;
            enabled: !root.asking-leave && !RoomInfoView.leaving && !RoomInfoView.notify-busy;
            busy: RoomInfoView.notify-busy;
            icon: NotifyModes.icon(RoomInfoView.notify);
            text: NotifyModes.state(RoomInfoView.notify);
            label: @tr("Notifications: {}", NotifyModes.state(RoomInfoView.notify));
            clicked => {
                root.notifications-clicked();
            }
        }

        if root.asking-leave: TilePrompt {
            width: 100%;
            height: 100%;
            text: @tr("Leave this room?");
            horizontal-alignment: center;
        }
    }

    Rectangle {
        width: root.slot-width;

        leave-tile := ActionTile {
            width: 100%;
            height: 100%;
            above-modal: root.above-modal;
            enabled: !RoomInfoView.leaving;
            icon: root.asking-leave ? IconSet.X : IconSet.LogOut;
            text: root.asking-leave ? @tr("Cancel") : @tr("Leave");
            label: root.asking-leave ? @tr("Stay in the room") : @tr("Leave the room");
            clicked => {
                root.leave-clicked();
            }
        }
    }

    Rectangle {
        width: root.slot-width;

        CopyLinkTile {
            width: 100%;
            height: 100%;
            above-modal: root.above-modal;
            visible: !root.asking-leave;
            enabled: !root.asking-leave && RoomInfoView.link != "";
            copied: root.copied;
            copy-label: @tr("Copy the room link");
            clicked => {
                root.copy-clicked();
            }
        }

        if root.asking-leave: ActionTile {
            width: 100%;
            height: 100%;
            above-modal: root.above-modal;
            destructive: true;
            enabled: !RoomInfoView.leaving;
            busy: RoomInfoView.leaving;
            icon: IconSet.LogOut;
            text: @tr("Leave");
            label: @tr("Confirm leaving the room");
            clicked => {
                root.leave-confirmed();
            }
        }
    }
}

component TopicSection inherits VerticalLayout {
    in property <bool> above-modal;
    in-out property <bool> expanded;
    in-out property <bool> selecting;

    spacing: Space.xs;

    topic-text := TopicText {
        styled: RoomInfoView.topic-styled;
        plain: RoomInfoView.topic;
        has-links: RoomInfoView.topic-has-links;
        expanded: root.expanded;
        selecting <=> root.selecting;
    }

    HorizontalLayout {
        spacing: Space.sm;

        Text {
            horizontal-stretch: 1;
            text: @tr("Topic");
            font-size: Fonts.caption;
            color: AppStyle.foreground-muted;
            vertical-alignment: center;
            accessible-role: none;
        }

        if RoomInfoView.topic-has-links && !root.selecting: TopicAction {
            above-modal: root.above-modal;
            icon: IconSet.TextCursor;
            text: @tr("Select text");
            label: @tr("Select the text of the topic");
            clicked => {
                root.selecting = true;
            }
        }

        if (topic-text.clamped || root.expanded) && !root.selecting: TopicAction {
            above-modal: root.above-modal;
            icon: root.expanded ? IconSet.ChevronUp : IconSet.ChevronDown;
            text: root.expanded ? @tr("Show less") : @tr("Show more");
            label: root.expanded ? @tr("Show less of the topic") : @tr("Show the whole topic");
            clicked => {
                root.expanded = !root.expanded;
            }
        }
    }
}

component MemberSection inherits VerticalLayout {
    in property <bool> above-modal;
    out property <length> search-top: search-row.y;
    out property <length> list-top: member-list.y;

    callback search-edited(string);

    spacing: Space.lg;

    public function clear-search() {
        search.query = "";
    }

    search-row := HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;

        search := SearchField {
            placeholder: @tr("Search members");
            above-modal: root.above-modal;
            enabled: Interaction.actionable(true, root.above-modal);
            edited(text) => {
                root.search-edited(text);
            }
        }
    }

    if RoomInfoView.roster == RosterStatus.loading: HorizontalLayout {
        alignment: center;
        padding: Space.xl;

        Spinner {
            indeterminate: true;
        }
    }

    if RoomInfoView.roster == RosterStatus.failed: RetryNotice {
        text: @tr("Couldn't load the members of this room.");
        failed: true;
        above-modal: root.above-modal;
        retry => {
            Actions.retry-room-members();
        }
    }

    if RoomInfoView.roster == RosterStatus.ready && RoomInfoView.rows.length == 0: RetryNotice {
        text: @tr("No member matches your search.");
    }

    member-list := Rectangle {
        height: member-rows.preferred-height;
        accessible-role: list;
        accessible-label: @tr("Members");
        accessible-item-count: RoomInfoView.rows.length;

        member-rows := VerticalLayout {
            for entry[idx] in RoomInfoView.rows: MemberRow {
                height: Metrics.room-info-row;
                index: idx;
                entry: entry;
                above-modal: root.above-modal;
            }
        }
    }
}

component RoomInfoSheet inherits Rectangle {
    in property <bool> above-modal;
    in property <brush> surface: AppStyle.card;
    out property <bool> notify-picker-open: false;
    out property <length> picker-x;
    out property <length> picker-y;

    callback dismissed();

    property <bool> roomy: root.height >= Metrics.room-info-roomy;

    property <string> shown-room: RoomInfoView.room-id;
    property <bool> asking-leave: false;
    property <bool> topic-expanded: false;
    property <bool> topic-selecting: false;

    property <length> rows-bottom: members.y + members.list-top + RoomInfoView.rows.length * Metrics.room-info-row;
    property <int> asked-after: -1;
    property <bool> wants-page: RoomInfoView.has-more
        && root.asked-after != RoomInfoView.pages-landed
        && root.rows-bottom + scroll.content-y - scroll.visible-height <= Metrics.room-info-page-ahead;

    forward-focus: keys;

    init => {
        root.page-if-wanted();
    }

    changed wants-page => {
        root.page-if-wanted();
    }

    changed shown-room => {
        root.notify-picker-open = false;
        root.asking-leave = false;
        link-copy.reset();
        root.topic-expanded = false;
        root.topic-selecting = false;
        root.asked-after = -1;
        members.clear-search();
        scroll.content-y = 0;
    }

    public function close-picker() {
        root.notify-picker-open = false;
        tiles.focus-notifications();
    }

    public function peel() -> bool {
        if root.notify-picker-open {
            root.close-picker();
            return true;
        }
        if root.topic-selecting {
            root.topic-selecting = false;
            root.focus();
            return true;
        }
        if root.asking-leave && !RoomInfoView.leaving {
            root.cancel-leave();
            return true;
        }
        return false;
    }

    function page-if-wanted() {
        if root.wants-page {
            root.asked-after = RoomInfoView.pages-landed;
            Actions.page-room-members();
        }
    }

    function open-picker() {
        root.picker-x = tiles.notify-x;
        root.picker-y = tiles.notify-bottom;
        root.notify-picker-open = true;
    }

    function cancel-leave() {
        root.asking-leave = false;
        tiles.focus-leave();
    }

    function scroll-search-into-view() {
        let top = members.y + members.search-top;
        if -scroll.content-y > top {
            scroll.content-y = -top;
        }
    }

    link-copy := CopyFeedback { }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape && root.peel() {
                return accept;
            }
            return reject;
        }

        scroll := ScrollView {
            width: 100%;
            height: 100%;
            content-width: self.visible-width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.visible-width;
                padding-top: Space.xl;
                padding-bottom: Space.md;
                spacing: Space.lg;

                head := VerticalLayout {
                    spacing: Space.lg;

                    if root.roomy: SheetCover {
                        avatar-size: Metrics.room-info-avatar;
                        color-index: RoomInfoView.color-index;
                        has-avatar: RoomInfoView.has-avatar;
                        avatar: RoomInfoView.avatar;
                        initial: RoomInfoView.initial;
                        name: RoomInfoView.name;

                        if !RoomInfoView.is-direct: Text {
                            text: @tr("{n} member" | "{n} members" % RoomInfoView.members);
                            font-size: Fonts.body-small;
                            color: AppStyle.foreground-muted;
                            horizontal-alignment: center;
                        }
                    }

                    if !root.roomy: CompactRoomCover {
                        reserve: close-chip.reserve;
                    }

                    tiles := RoomActionTiles {
                        above-modal: root.above-modal;
                        copied: link-copy.copied;
                        asking-leave: root.asking-leave;
                        notifications-clicked => {
                            root.open-picker();
                        }
                        leave-clicked => {
                            root.notify-picker-open = false;
                            root.asking-leave = !root.asking-leave;
                            tiles.focus-leave();
                        }
                        leave-confirmed => {
                            root.focus();
                            Actions.leave-room(RoomInfoView.room-id);
                        }
                        copy-clicked => {
                            link-copy.copy(RoomInfoView.link);
                        }
                    }

                    if RoomInfoView.error != UserMessageKind.none: HorizontalLayout {
                        padding-left: Space.xl;
                        padding-right: Space.xl;

                        ErrorBanner {
                            messages: [{ kind: RoomInfoView.error, detail: RoomInfoView.error-detail }];
                        }
                    }
                }

                details := VerticalLayout {
                    padding-left: Space.xl;
                    padding-right: Space.xl;
                    spacing: Space.lg;

                    if RoomInfoView.topic != "": TopicSection {
                        above-modal: root.above-modal;
                        expanded <=> root.topic-expanded;
                        selecting <=> root.topic-selecting;
                    }

                    if RoomInfoView.alias != "": DetailLine {
                        enabled: Interaction.actionable(true, root.above-modal);
                        value: RoomInfoView.alias;
                        caption: @tr("Address");
                    }

                    DetailLine {
                        enabled: Interaction.actionable(true, root.above-modal);
                        value: RoomInfoView.room-id;
                        caption: @tr("Room ID");
                    }

                    if RoomInfoView.joined-on != "": DetailLine {
                        value: RoomInfoView.joined-on;
                        caption: @tr("You joined");
                        selectable: false;
                    }
                }

                members := MemberSection {
                    above-modal: root.above-modal;
                    search-edited(text) => {
                        root.scroll-search-into-view();
                        Actions.filter-room-members(text);
                    }
                }
            }
        }

        close-chip := SheetCloseChip {
            x: parent.width - self.width - Space.md;
            y: Space.md;
            surface: root.surface;
            label: @tr("Close the room info");
            above-modal: root.above-modal;
            clicked => {
                root.dismissed();
            }
        }
    }
}

export component RoomInfoDialog inherits ModalHost {
    property <bool> covered: Shell.user-info-open || Shell.verification-open;

    dim-opacity: AppStyle.dialog-scrim;
    label: @tr("Room info");
    dismissed => {
        if Shell.user-info-open {
            Actions.close-user-info();
        } else if !sheet.peel() {
            Actions.close-room-info();
        }
    }

    CloseWatch {
        open: Shell.user-info-open;
        closed => {
            if !Shell.verification-open {
                root.focus();
            }
        }
    }

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(AppStyle.card-width-wide, root.width - AppStyle.card-inset);
        height: min(root.height - AppStyle.card-inset, Metrics.room-info-max-height);
        clip: true;

        sheet := RoomInfoSheet {
            width: 100%;
            height: 100%;
            above-modal: !root.covered;
            dismissed => {
                Actions.close-room-info();
            }
        }
    }

    if sheet.notify-picker-open: NotifyPickerHost {
        anchor-x: sheet.picker-x;
        anchor-y: sheet.picker-y;
        dismissed => {
            sheet.close-picker();
        }
    }
}

export component RoomInfoPane inherits RoomInfoSheet {
    in property <length> overlay-width;
    in property <length> overlay-height;

    background: Palette.alternate-background;
    surface: Palette.alternate-background;
    dismissed => {
        Shell.room-info-pane-open = false;
    }

    Rectangle {
        x: 0;
        width: Stroke.hairline;
        background: AppStyle.border;
    }

    if root.notify-picker-open: NotifyPickerHost {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: root.overlay-width;
        height: root.overlay-height;
        anchor-x: root.picker-x;
        anchor-y: root.picker-y;
        dismissed => {
            root.close-picker();
        }
    }
}
