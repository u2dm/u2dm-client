import { Avatar } from "../../../components/avatar.slint";
import { ListItemArea } from "../../../components/a11y.slint";
import { MemberRoles } from "./member-roles.slint";
import { MemberEntry } from "../../../types.slint";
import { MemberRowKind } from "../../../enums.slint";
import { FocusHome, FocusRegion, SheetReturn } from "../../../local.slint";
import { Actions } from "../../../actions.slint";
import { AppStyle, Fonts, Metrics, Space, Weight } from "../../../theme.slint";

export component MemberRow inherits ListItemArea {
    in property <MemberEntry> entry;

    property <string> key: "member:\{root.entry.user-id}";
    property <int> sheet-returns: SheetReturn.returns;
    property <int> focus-asks: FocusHome.asks;

    changed sheet-returns => {
        if SheetReturn.opener == root.key {
            root.take-focus();
        }
    }

    changed focus-asks => {
        if root.region != FocusRegion.none && FocusHome.asked == root.region && FocusHome.asked-place == root.key {
            root.take-focus();
        }
    }

    pure function describe(entry: MemberEntry) -> string {
        if entry.kind == MemberRowKind.invited-heading {
            return @tr("Invited");
        }
        if MemberRoles.label(entry.role) == "" {
            return entry.name == "" ? entry.user-id : @tr("{}, {}", entry.name, entry.user-id);
        }
        return entry.name == ""
            ? @tr("{}, {}", entry.user-id, MemberRoles.label(entry.role))
            : @tr("{}, {}, {}", entry.name, entry.user-id, MemberRoles.label(entry.role));
    }

    enabled: root.entry.kind == MemberRowKind.member;
    label: root.describe(root.entry);
    background: root.has-hover && root.enabled ? AppStyle.overlay-hover : transparent;
    place: root.key;
    clicked => {
        SheetReturn.opened-by(root.has-focus ? root.key : "");
        Actions.open-user-info(root.entry.user-id);
    }

    if root.entry.kind == MemberRowKind.invited-heading: HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-bottom: Space.sm;

        Text {
            text: @tr("Invited");
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: bottom;
            accessible-role: none;
        }
    }

    if root.entry.kind == MemberRowKind.member: HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        spacing: Space.lg;

        Avatar {
            cross-axis-self-alignment: center;
            width: Metrics.room-info-member-avatar;
            height: Metrics.room-info-member-avatar;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xs;

            Text {
                text: root.entry.name == "" ? root.entry.user-id : root.entry.name;
                font-family: Fonts.emoji;
                font-size: Fonts.body;
                font-weight: Weight.semibold;
                overflow: elide;
                accessible-role: none;
            }

            if root.entry.name != "": Text {
                text: root.entry.user-id;
                font-size: Fonts.body-small;
                color: AppStyle.foreground-muted;
                overflow: elide;
                accessible-role: none;
            }
        }

        if MemberRoles.label(root.entry.role) != "": Text {
            cross-axis-self-alignment: center;
            text: MemberRoles.label(root.entry.role);
            font-size: Fonts.caption;
            color: AppStyle.foreground-muted;
            accessible-role: none;
        }
    }
}
