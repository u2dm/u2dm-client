import { IconSet, Icon } from "@lucide";

import { NotifyModes } from "./notify-modes.slint";
import { Interaction, RovingKeys } from "../../../components/a11y.slint";
import { CopyNotifier } from "../../../components/copier.slint";
import { CopyNotice } from "../../../components/copy-notice.slint";
import { ConfirmChoice, Confirmations, MenuCard, MenuConfirmation } from "../../../components/menu.slint";
import { MenuRow } from "../../../components/menu-row.slint";
import { ModalHost, Placement } from "../../../components/overlay.slint";
import { LocalState, MessageMenu, RoomMenu, RoomMenuOrigin, Shell } from "../../../local.slint";
import { Actions } from "../../../actions.slint";
import { DirectoryView, RoomMenuView, SpaceIndexView } from "../../../views.slint";
import { NotifyMode } from "../../../enums.slint";
import { Metrics, Motion, Space } from "../../../theme.slint";

enum RoomMenuAction {
    info,
    mark-read,
    notifications,
    copy-link,
    logs,
    leave,
}

global RoomMenuActions {
    public pure function available(action: RoomMenuAction) -> bool {
        if action == RoomMenuAction.mark-read {
            return RoomMenuView.unread;
        }
        if action == RoomMenuAction.notifications {
            return !RoomMenuView.notify-busy && !RoomMenuView.leaving;
        }
        if action == RoomMenuAction.leave {
            return !RoomMenuView.leaving;
        }
        return true;
    }

    public pure function label(action: RoomMenuAction) -> string {
        if action == RoomMenuAction.info {
            return @tr("Room info");
        }
        if action == RoomMenuAction.mark-read {
            return @tr("Mark as read");
        }
        if action == RoomMenuAction.notifications {
            return @tr("Notifications");
        }
        if action == RoomMenuAction.copy-link {
            return @tr("Copy link");
        }
        if action == RoomMenuAction.logs {
            return @tr("Room logs");
        }
        return @tr("Leave");
    }

    public pure function spoken-label(action: RoomMenuAction) -> string {
        if action == RoomMenuAction.notifications {
            return @tr("Notifications: {}", NotifyModes.state(RoomMenuView.notify));
        }
        return root.label(action);
    }

    public pure function icon(action: RoomMenuAction) -> Icon {
        if action == RoomMenuAction.info {
            return IconSet.Info;
        }
        if action == RoomMenuAction.mark-read {
            return IconSet.CheckCheck;
        }
        if action == RoomMenuAction.notifications {
            return NotifyModes.icon(RoomMenuView.notify);
        }
        if action == RoomMenuAction.copy-link {
            return IconSet.Link;
        }
        if action == RoomMenuAction.logs {
            return IconSet.Logs;
        }
        return IconSet.LogOut;
    }

    public pure function destructive(action: RoomMenuAction) -> bool {
        return action == RoomMenuAction.leave;
    }
}

component NotifyFlyout inherits MenuCard {
    in property <int> cursor: -1;
    in property <bool> rings: false;
    out property <bool> hovered: area.has-hover;

    callback picked(NotifyMode);

    width: Metrics.room-menu-flyout-width;
    row-count: NotifyModes.all.length;
    row-height: Metrics.room-menu-row;

    area := TouchArea {
        VerticalLayout {
            padding: root.pad;

            for mode[index] in NotifyModes.all: MenuRow {
                height: root.row-height;
                icon: NotifyModes.icon(mode);
                label: NotifyModes.choice(mode);
                trailing: RoomMenuView.notify == mode ? IconSet.Check : { };
                above-modal: true;
                focusable: false;
                roving-focus: root.rings && root.cursor == index;
                clicked => {
                    root.picked(mode);
                }
            }
        }
    }
}

component RoomMenuCard inherits MenuCard {
    out property <length> notify-row-y: root.pad + max(root.notify-index, 0) * root.row-height;
    out property <bool> keys-focused: keys.has-focus;
    out property <bool> in-flyout: false;
    out property <int> flyout-cursor: -1;

    callback chose(RoomMenuAction);
    callback mode-chosen(NotifyMode);
    callback confirmed();
    callback cancelled();

    property <[RoomMenuAction]> offered;
    property <int> notify-index: -1;
    property <int> cursor: -1;
    property <bool> asking: RoomMenu.asking-leave;
    property <ConfirmChoice> confirm-cursor: ConfirmChoice.cancel;
    property <RoomMenuAction> intent: RoomMenuAction.info;
    property <bool> flyout-hovered: false;

    width: Metrics.room-menu-width;
    row-count: root.offered.length;
    row-height: Metrics.room-menu-row;

    changed asking => {
        root.confirm-cursor = ConfirmChoice.cancel;
    }

    public function open(keyboard: bool) {
        root.offered = [];
        root.offered.push(RoomMenuAction.info);
        if RoomMenuView.unread {
            root.offered.push(RoomMenuAction.mark-read);
        }
        root.notify-index = root.offered.length;
        root.offered.push(RoomMenuAction.notifications);
        root.offered.push(RoomMenuAction.copy-link);
        root.offered.push(RoomMenuAction.logs);
        if !RoomMenuView.leaving {
            root.offered.push(RoomMenuAction.leave);
        }
        root.cursor = keyboard ? 0 : -1;
        root.in-flyout = false;
        root.flyout-cursor = -1;
        keys.focus();
    }

    public function open-flyout(by-keys: bool) {
        hover-timer.running = false;
        if !RoomMenuActions.available(RoomMenuAction.notifications) {
            return;
        }
        RoomMenu.flyout-open = true;
        root.in-flyout = by-keys;
        root.flyout-cursor = by-keys ? NotifyModes.position(RoomMenuView.notify) : -1;
    }

    public function close-flyout() {
        hover-timer.running = false;
        RoomMenu.flyout-open = false;
        root.in-flyout = false;
        root.flyout-cursor = -1;
    }

    public function flyout-hover(on: bool) {
        root.flyout-hovered = on;
        if on {
            root.intent = RoomMenuAction.notifications;
            hover-timer.running = false;
        }
    }

    pure function spoken-label() -> string {
        if root.asking {
            return root.confirm-cursor == ConfirmChoice.confirm ? @tr("Leave") : @tr("Cancel");
        }
        if root.in-flyout && root.flyout-cursor >= 0 && root.flyout-cursor < NotifyModes.all.length {
            return NotifyModes.choice(NotifyModes.all[root.flyout-cursor]);
        }
        if root.cursor >= 0 && root.cursor < root.offered.length {
            return RoomMenuActions.spoken-label(root.offered[root.cursor]);
        }
        return @tr("Room actions");
    }

    function row-hovered(action: RoomMenuAction) {
        root.intent = action;
        if (action == RoomMenuAction.notifications) != RoomMenu.flyout-open {
            hover-timer.running = true;
            hover-timer.restart();
        } else {
            hover-timer.running = false;
        }
    }

    function cursor-moved(index: int) {
        if RoomMenu.flyout-open && index != root.notify-index {
            root.close-flyout();
        }
    }

    function choose(action: RoomMenuAction, by-keys: bool) {
        if !RoomMenuActions.available(action) {
            return;
        }
        if action == RoomMenuAction.notifications {
            root.open-flyout(by-keys);
            return;
        }
        if action == RoomMenuAction.leave {
            root.close-flyout();
        }
        root.chose(action);
    }

    function choose-at(index: int) {
        if index >= 0 && index < root.offered.length {
            root.choose(root.offered[index], true);
        }
    }

    function pick-at(index: int) {
        if index >= 0 && index < NotifyModes.all.length {
            root.mode-chosen(NotifyModes.all[index]);
        }
    }

    function answer(choice: ConfirmChoice) {
        if choice == ConfirmChoice.confirm {
            root.confirmed();
        } else {
            root.cancelled();
        }
    }

    function confirm-key(event: KeyEvent) -> EventResult {
        if event.text == Key.DownArrow || event.text == Key.UpArrow {
            root.confirm-cursor = Confirmations.other(root.confirm-cursor);
            return accept;
        }
        if Interaction.activates(event.text) {
            root.answer(root.confirm-cursor);
            return accept;
        }
        return reject;
    }

    function flyout-key(event: KeyEvent) -> EventResult {
        let count = NotifyModes.all.length;
        if event.text == Key.DownArrow {
            root.flyout-cursor = Interaction.next(root.flyout-cursor, count);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.flyout-cursor = Interaction.previous(root.flyout-cursor, count);
            return accept;
        }
        if event.text == Key.Home {
            root.flyout-cursor = 0;
            return accept;
        }
        if event.text == Key.End {
            root.flyout-cursor = count - 1;
            return accept;
        }
        if event.text == Key.LeftArrow {
            root.close-flyout();
            return accept;
        }
        if Interaction.activates(event.text) {
            root.pick-at(max(root.flyout-cursor, 0));
            return accept;
        }
        return reject;
    }

    function mode-key(event: KeyEvent) -> EventResult {
        if event.text == Key.Tab || event.text == Key.Backtab {
            return accept;
        }
        if root.asking {
            return root.confirm-key(event);
        }
        if root.in-flyout && RoomMenu.flyout-open {
            return root.flyout-key(event);
        }
        if event.text == Key.RightArrow && root.cursor == root.notify-index {
            root.open-flyout(true);
            return accept;
        }
        return reject;
    }

    hover-timer := Timer {
        interval: Motion.submenu-delay;
        running: false;
        triggered => {
            self.running = false;
            if root.intent == RoomMenuAction.notifications {
                if !RoomMenu.flyout-open {
                    root.open-flyout(false);
                }
            } else if RoomMenu.flyout-open && !root.flyout-hovered {
                root.close-flyout();
            }
        }
    }

    keys := RovingKeys {
        count: root.offered.length;
        cursor <=> root.cursor;
        paused: root.asking || (root.in-flyout && RoomMenu.flyout-open);
        accessible-label: root.spoken-label();
        accessible-checkable: root.in-flyout && !root.asking;
        accessible-checked: root.in-flyout
            && root.flyout-cursor >= 0
            && root.flyout-cursor == NotifyModes.position(RoomMenuView.notify);
        accessible-action-default => {
            if root.asking {
                root.answer(root.confirm-cursor);
            } else if root.in-flyout {
                root.pick-at(max(root.flyout-cursor, 0));
            } else {
                root.choose-at(max(root.cursor, 0));
            }
        }
        intercept(event) => {
            return root.mode-key(event);
        }
        moved(index) => {
            root.cursor-moved(index);
        }
        activated(index) => {
            root.choose-at(index);
        }
    }

    Rectangle {
        visible: !root.asking;

        VerticalLayout {
            padding: root.pad;

            for action[index] in root.offered: MenuRow {
                height: root.row-height;
                icon: RoomMenuActions.icon(action);
                label: RoomMenuActions.label(action);
                destructive: RoomMenuActions.destructive(action);
                trailing: action == RoomMenuAction.notifications ? IconSet.ChevronRight : { };
                busy: action == RoomMenuAction.notifications && RoomMenuView.notify-busy;
                enabled: RoomMenuActions.available(action);
                highlighted: action == RoomMenuAction.notifications && RoomMenu.flyout-open;
                above-modal: true;
                focusable: false;
                roving-focus: root.keys-focused && !root.in-flyout && root.cursor == index;
                changed has-hover => {
                    if self.has-hover {
                        root.row-hovered(action);
                    }
                }
                clicked => {
                    root.choose(action, false);
                }
            }
        }
    }

    if root.asking: MenuConfirmation {
        padding: root.pad;
        prompt: @tr("Leave {}?", RoomMenuView.name);
        confirm-icon: IconSet.LogOut;
        confirm-label: @tr("Leave");
        row-height: root.row-height;
        cursor: root.confirm-cursor;
        rings: root.keys-focused && root.cursor >= 0;
        above-modal: true;
        answered(choice) => {
            root.answer(choice);
        }
    }
}

export component RoomMenuOverlay inherits Rectangle {
    in property <bool> room-info-in-pane: false;

    property <length> edge: Space.md;
    property <length> gap: Space.xs;
    property <length> notice-x;
    property <length> notice-y;
    property <int> link-serial: RoomMenuView.link-serial;
    property <bool> covered: Shell.modal-over-nav;

    changed link-serial => {
        if RoomMenuView.link != "" {
            notifier.copy(RoomMenuView.link, @tr("Link copied"));
        }
    }

    changed covered => {
        if root.covered {
            RoomMenu.close();
        }
    }

    pure function card-left(width: length) -> length {
        if RoomMenu.origin == RoomMenuOrigin.header {
            return Placement.fit(RoomMenu.at-x - width, width, root.width, root.edge);
        }
        return Placement.flip(RoomMenu.at-x, width, root.width, root.edge);
    }

    pure function card-top(height: length) -> length {
        let below = RoomMenu.origin == RoomMenuOrigin.header ? RoomMenu.at-y + root.gap : RoomMenu.at-y;
        return Placement.fit(
            below + height + root.edge > root.height ? RoomMenu.at-y - height : below,
            height,
            root.height,
            root.edge);
    }

    pure function flyout-fits-right(card-x: length, card-width: length, width: length) -> bool {
        return card-x + card-width + root.gap + width + root.edge <= root.width;
    }

    pure function flyout-fits-left(card-x: length, width: length) -> bool {
        return card-x - root.gap - width >= root.edge;
    }

    pure function flyout-left(card-x: length, card-width: length, width: length) -> length {
        if root.flyout-fits-right(card-x, card-width, width) {
            return card-x + card-width + root.gap;
        }
        if root.flyout-fits-left(card-x, width) {
            return card-x - root.gap - width;
        }
        return Placement.fit(card-x + card-width - width, width, root.width, root.edge);
    }

    function run(action: RoomMenuAction) {
        let id = RoomMenu.key;
        if action == RoomMenuAction.info {
            if root.room-info-in-pane {
                RoomMenu.dismiss();
            } else {
                RoomMenu.close();
            }
            if id != DirectoryView.selected-room-id {
                Actions.select-room(id);
            } else if SpaceIndexView.visible {
                Actions.close-space-index();
            }
            Shell.nav-open = false;
            Actions.open-room-info(id);
            return;
        }
        if action == RoomMenuAction.logs {
            RoomMenu.close();
            Actions.open-room-log(id);
            return;
        }
        if action == RoomMenuAction.leave {
            RoomMenu.asking-leave = true;
            return;
        }
        if action == RoomMenuAction.mark-read {
            Actions.mark-room-read(id);
        } else if action == RoomMenuAction.copy-link {
            Actions.copy-room-link(id);
        }
        RoomMenu.dismiss();
    }

    function pick(mode: NotifyMode) {
        Actions.set-room-notify(RoomMenu.key, mode);
        RoomMenu.dismiss();
    }

    function leave() {
        Actions.leave-room(RoomMenu.key);
        RoomMenu.dismiss();
    }

    notifier := CopyNotifier { }

    if RoomMenu.visible: host := ModalHost {
        property <length> card-x: root.card-left(card.width);
        property <length> card-y: root.card-top(card.height);
        property <bool> beside: root.flyout-fits-right(self.card-x, card.width, Metrics.room-menu-flyout-width)
            || root.flyout-fits-left(self.card-x, Metrics.room-menu-flyout-width);

        width: 100%;
        height: 100%;
        dim: false;
        any-button-dismisses: true;
        label: @tr("Actions for {}", RoomMenuView.name);
        opened => {
            MessageMenu.close();
            LocalState.close-popovers();
            card.open(RoomMenu.by-keyboard);
        }
        dismissed => {
            if self.dismissing-by-pointer {
                RoomMenu.dismiss();
            } else if RoomMenu.flyout-open {
                card.close-flyout();
            } else if RoomMenu.asking-leave {
                RoomMenu.asking-leave = false;
            } else {
                RoomMenu.dismiss();
            }
        }

        card := RoomMenuCard {
            x: host.card-x;
            y: host.card-y;
            chose(action) => {
                if action == RoomMenuAction.copy-link {
                    root.notice-x = host.card-x + self.width / 2;
                    root.notice-y = host.card-y + self.height / 2;
                }
                root.run(action);
            }
            mode-chosen(mode) => {
                root.pick(mode);
            }
            confirmed => {
                root.leave();
            }
            cancelled => {
                RoomMenu.asking-leave = false;
            }
        }

        if RoomMenu.flyout-open: flyout := NotifyFlyout {
            x: root.flyout-left(host.card-x, card.width, self.width);
            y: Placement.fit(
                host.beside
                    ? host.card-y + card.notify-row-y - card.pad
                    : host.card-y + card.notify-row-y + card.row-height,
                self.height,
                root.height,
                root.edge);
            cursor: card.flyout-cursor;
            rings: card.keys-focused && card.in-flyout;
            picked(mode) => {
                root.pick(mode);
            }
            changed hovered => {
                card.flyout-hover(self.hovered);
            }
        }
    }

    if notifier.notice != "": CopyNotice {
        x: Placement.fit(root.notice-x - self.width / 2, self.width, root.width, root.edge);
        y: Placement.fit(root.notice-y - self.height / 2, self.height, root.height, root.edge);
        text: notifier.notice;
    }
}
