import {
    ListView,
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { SpaceRail } from "./space-rail.slint";
import { SubspaceRail } from "./subspace-rail.slint";
import { MessagePreview } from "./message-preview.slint";
import { ServiceLabel } from "./timeline/messages/service-message.slint";
import { Avatar } from "../../../components/avatar.slint";
import { ListItemArea } from "../../../components/a11y.slint";
import { UnreadDot } from "./tile.slint";
import { RoomEntry } from "./types.slint";
import { Avatars, Fonts, Metrics } from "../../../theme.slint";
import { ServiceKind } from "../../../enums.slint";
import { DirectoryView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";

export component Sidebar inherits Rectangle {
    background: Palette.alternate-background;

    in property <length> subrail-width: Metrics.subspace-rail;
    in property <bool> above-modal: false;

    callback room-selected();

    property <length> row-height: 64px;
    property <length> rail-width: Metrics.space-rail;
    property <length> avatar-size: 48px;

    public function focus-menu() {
        rail.focus-menu();
    }

    pure function row-background(selected: bool, hovered: bool) -> color {
        if selected {
            return Palette.background;
        }
        if hovered {
            return Palette.background.transparentize(0.5);
        }
        return transparent;
    }

    pure function row-label(entry: RoomEntry) -> string {
        if entry.mention {
            return @tr("{}, mentions you", entry.name);
        }
        if entry.alert {
            return @tr("{}, unread", entry.name);
        }
        if entry.muted && entry.hint {
            return @tr("{}, muted, new activity", entry.name);
        }
        if entry.muted {
            return @tr("{}, muted", entry.name);
        }
        if entry.hint {
            return @tr("{}, new activity", entry.name);
        }
        return entry.name;
    }

    HorizontalLayout {
        rail := SpaceRail {
            width: root.rail-width;
            above-modal: root.above-modal;
        }

        if DirectoryView.subspaces.length > 0: SubspaceRail {
            width: root.subrail-width;
            above-modal: root.above-modal;
        }

        room-column := Rectangle {
            VerticalLayout {
                Rectangle {
                    height: 52px;

                    search-field := Rectangle {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 16px;
                        height: 36px;
                        background: transparent;

                        Rectangle {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;

                            if search-input.text == "": Text {
                                x: 0;
                                width: 100%;
                                text: @tr("Search");
                                font-size: 14px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(0.5);
                            }

                            search-input := TextInput {
                                width: 100%;
                                height: 100%;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;
                                color: Palette.foreground;
                                text: "";
                                accessible-role: AccessibleRole.text-input;
                                accessible-label: @tr("Search rooms");
                                accessible-placeholder-text: @tr("Search");
                                accessible-value <=> self.text;
                            }
                        }

                        search-touch := TouchArea {
                            mouse-cursor: text;
                            clicked => {
                                search-input.focus();
                            }
                        }
                    }
                }

                ListView {
                    accessible-role: list;
                    accessible-label: @tr("Rooms");
                    accessible-item-count: DirectoryView.rooms.length;
                    for room[idx] in DirectoryView.rooms: ListItemArea {
                        height: root.row-height;
                        clip: true;
                        index: idx;
                        above-modal: root.above-modal;
                        selected: room.id == DirectoryView.selected-room-id;
                        label: root.row-label(room);
                        ring-inset: 2px;
                        background: root.row-background(self.selected, self.has-hover);
                        clicked => {
                            Actions.select-room(room.id);
                            root.room-selected();
                        }
                        init => {
                            if (!room.has-avatar) {
                                Actions.request-room-avatar(room.id);
                            }
                        }

                        property <string> sender-label: room.last-message-is-own
                            ? @tr("You")
                            : room.last-message-sender;
                        property <bool> is-service: room.last-message-service-kind != ServiceKind.none;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;

                                Avatar {
                                    width: root.avatar-size;
                                    height: root.avatar-size;
                                    background: Avatars.color(room.color-index);
                                    has-image: room.has-avatar;
                                    image: room.avatar;
                                    initial: room.initial;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: room.name;
                                        font-family: Fonts.emoji;
                                        font-size: 14px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if room.last-message-time != "": Text {
                                        text: room.last-message-time;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        color: Palette.foreground.transparentize(0.55);
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    HorizontalLayout {
                                        horizontal-stretch: 1;

                                        if !is-service && sender-label != "": Text {
                                            text: sender-label + ": ";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            color: Palette.accent-background;
                                            overflow: elide;
                                        }

                                        if !is-service && room.last-message-edited: Rectangle {
                                            width: 16px;

                                            IconDisplay {
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                                icon: IconSet.Pencil;
                                                size: 12px;
                                                stroke: Palette.foreground.transparentize(0.4);
                                            }
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: is-service
                                                ? ServiceLabel.label(room.last-message-service-kind, sender-label, room.last-message-service-target)
                                                : MessagePreview.label(room.last-message-kind, room.last-message-body);
                                            font-family: Fonts.emoji;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            color: Palette.foreground.transparentize(0.4);
                                        }
                                    }

                                    if room.muted: VerticalLayout {
                                        alignment: center;

                                        IconDisplay {
                                            icon: IconSet.BellOff;
                                            size: 14px;
                                            stroke: Palette.foreground.transparentize(0.55);
                                        }
                                    }

                                    if room.alert || room.mention || room.hint: VerticalLayout {
                                        alignment: center;

                                        UnreadDot {
                                            alert: room.alert;
                                            mention: room.mention;
                                            hint: room.hint;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
        }
        }
    }
}
