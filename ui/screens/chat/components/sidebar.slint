import {
    ListView,
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { SpaceRail } from "./space-rail.slint";
import { SubspaceRail } from "./subspace-rail.slint";
import { MessagePreview, ServiceLabel } from "../../../messages.slint";
import { HeaderTitle } from "./header-title.slint";
import { Avatar } from "../../../components/avatar.slint";
import { Interaction, ListItemArea } from "../../../components/a11y.slint";
import { UnreadDot } from "./unread-dot.slint";
import { SpaceBadge } from "./space-badge.slint";
import { RoomEntry } from "../../../types.slint";
import { HeaderIconButton } from "../../../components/button.slint";
import { RetryNotice } from "../../../components/retry-notice.slint";
import { PillSearchField } from "../../../components/search-field.slint";
import { ContextPress } from "./context-press.slint";
import { AppStyle, Fonts, IconSize, Metrics, Size, Space, Weight } from "../../../theme.slint";
import { RoomRowKind, RoomScope, ServiceKind } from "../../../enums.slint";
import { DirectoryView, SpaceIndexView } from "../../../views.slint";
import { Actions } from "../../../actions.slint";
import { RoomMenu, RoomMenuOrigin, RoomMenuReturn, RoomSearch } from "../../../local.slint";

component SidebarSearch inherits FocusScope {
    in property <bool> above-modal: false;
    out property <bool> field-focused: field.has-focus;

    callback accepted();

    height: Size.md;
    focus-on-click: false;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
        if event.text == Key.Escape && RoomSearch.query != "" {
            RoomSearch.clear();
            return accept;
        }
        return reject;
    }

    field := PillSearchField {
        width: 100%;
        height: 100%;
        placeholder: @tr("Search");
        label: DirectoryView.room-scope == RoomScope.direct
            ? @tr("Search direct messages")
            : @tr("Search rooms and spaces");
        query <=> RoomSearch.query;
        above-modal: root.above-modal;
        enabled: Interaction.actionable(true, root.above-modal);
        edited(text) => {
            Actions.filter-rooms(text);
        }
        accepted => {
            root.accepted();
        }
    }
}

component RoomSummary inherits VerticalLayout {
    in property <RoomEntry> entry;
    in property <bool> has-unread;

    property <string> sender-label: root.entry.last-message-is-own
        ? @tr("You")
        : root.entry.last-message-sender;
    property <bool> is-service: root.entry.last-message-service-kind != ServiceKind.none;

    alignment: center;
    spacing: Space.sm;

    HorizontalLayout {
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-family: Fonts.emoji;
            font-size: Fonts.body;
            font-weight: Weight.semibold;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.entry.last-message-time != "": Text {
            text: root.entry.last-message-time;
            font-size: Fonts.caption;
            vertical-alignment: center;
            color: AppStyle.foreground-muted;
        }
    }

    HorizontalLayout {
        spacing: Space.md;

        HorizontalLayout {
            horizontal-stretch: 1;

            if !root.is-service && root.sender-label != "": Text {
                text: root.sender-label + ": ";
                font-size: Fonts.body-small;
                vertical-alignment: center;
                color: Palette.accent-background;
                overflow: elide;
            }

            if !root.is-service && root.entry.last-message-edited: Rectangle {
                width: Size.xxs;

                IconDisplay {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Pencil;
                    size: IconSize.xs;
                    stroke: AppStyle.foreground-muted;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.is-service
                    ? ServiceLabel.label(root.entry.last-message-service-kind, root.sender-label, root.entry.last-message-service-target)
                    : MessagePreview.label(root.entry.last-message-kind, root.entry.last-message-body);
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                vertical-alignment: center;
                overflow: elide;
                color: AppStyle.foreground-muted;
            }
        }

        if root.entry.muted: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.BellOff;
            size: IconSize.sm;
            stroke: AppStyle.foreground-faint;
        }

        if root.has-unread: UnreadDot {
            cross-axis-self-alignment: center;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }
}

component SpaceSummary inherits VerticalLayout {
    in property <RoomEntry> entry;
    in property <bool> has-unread;

    alignment: center;
    spacing: Space.sm;

    Text {
        text: root.entry.name;
        font-family: Fonts.emoji;
        font-size: Fonts.body;
        font-weight: Weight.semibold;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: root.entry.space-parent == ""
                ? @tr("{n} room" | "{n} rooms" % root.entry.space-rooms)
                : @tr("In {} · {n} room" | "In {} · {n} rooms" % root.entry.space-rooms, root.entry.space-parent);
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            vertical-alignment: center;
            overflow: elide;
            color: AppStyle.foreground-muted;
        }

        if root.has-unread: UnreadDot {
            cross-axis-self-alignment: center;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }
}

component RoomRow inherits ListItemArea {
    in property <RoomEntry> entry;
    in property <bool> collapsed;
    in property <length> avatar-size;

    property <bool> is-room: root.entry.kind == RoomRowKind.room;
    property <bool> is-space: root.entry.kind == RoomRowKind.space;
    property <bool> is-heading: root.entry.kind == RoomRowKind.spaces-heading;
    property <bool> has-unread: root.entry.alert || root.entry.mention || root.entry.hint;
    property <int> menu-returns: RoomMenu.focus-returns;

    pure function describe(entry: RoomEntry) -> string {
        if entry.kind == RoomRowKind.spaces-heading {
            return @tr("Spaces");
        }
        if entry.kind == RoomRowKind.space && entry.space-parent != "" {
            return @tr("{}, space in {}", entry.name, entry.space-parent);
        }
        if entry.kind == RoomRowKind.space {
            return @tr("{}, space", entry.name);
        }
        if entry.mention {
            return @tr("{}, mentions you", entry.name);
        }
        if entry.alert {
            return @tr("{}, unread", entry.name);
        }
        if entry.muted && entry.hint {
            return @tr("{}, muted, new activity", entry.name);
        }
        if entry.muted {
            return @tr("{}, muted", entry.name);
        }
        if entry.hint {
            return @tr("{}, new activity", entry.name);
        }
        return entry.name;
    }

    pure function fill(selected: bool, hovered: bool) -> color {
        if selected {
            return Palette.background;
        }
        if hovered {
            return AppStyle.surface-raised;
        }
        return transparent;
    }

    clip: true;
    enabled: !root.is-heading;
    ring-inset: Space.xs;
    label: root.describe(root.entry);
    background: root.fill(
        root.selected,
        root.enabled && (root.has-hover || RoomMenu.shows(root.entry.id)));

    init => {
        if root.is-room && !root.entry.has-avatar {
            Actions.request-room-avatar(root.entry.id);
        }
    }

    changed menu-returns => {
        if RoomMenu.returns-to(RoomMenuReturn.row, root.entry.id) {
            root.take-focus();
        }
    }

    context-menu-requested => {
        if !root.is-room {
            return EventResult.reject;
        }
        RoomMenu.open(
            root.entry.id,
            RoomMenuOrigin.list,
            root.absolute-position.x + Space.lg,
            root.absolute-position.y + root.height,
            true);
        return EventResult.accept;
    }

    if root.is-room: ContextPress {
        hovered: root.has-hover && Interaction.actionable(root.enabled, root.above-modal);
        pressed => {
            RoomMenu.open(
                root.entry.id,
                RoomMenuOrigin.list,
                root.absolute-position.x + root.mouse-x,
                root.absolute-position.y + root.mouse-y,
                false);
        }
    }

    if root.collapsed && !root.is-heading: Rectangle {
        width: 100%;
        height: 100%;

        collapsed-avatar := Avatar {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.avatar-size;
            height: root.avatar-size;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        if root.has-unread: UnreadDot {
            x: collapsed-avatar.x + collapsed-avatar.width - self.width + Space.xs;
            y: collapsed-avatar.y + collapsed-avatar.height - self.height + Space.xs;
            ringed: true;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }

    if !root.collapsed && root.is-room: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Avatar {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        RoomSummary {
            entry: root.entry;
            has-unread: root.has-unread;
        }
    }

    if !root.collapsed && root.is-space: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Rectangle {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;

            Avatar {
                width: 100%;
                height: 100%;
                color-index: root.entry.color-index;
                has-image: root.entry.has-avatar;
                image: root.entry.avatar;
                initial: root.entry.initial;
            }

            SpaceBadge {
                x: parent.width - self.width + Space.xs;
                y: parent.height - self.height + Space.xs;
                cutout: Palette.alternate-background;
            }
        }

        SpaceSummary {
            entry: root.entry;
            has-unread: root.has-unread;
        }
    }

    if !root.collapsed && root.is-heading: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-bottom: Space.sm;

        Text {
            text: @tr("Spaces");
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: bottom;
            accessible-role: none;
        }
    }
}

component RoomColumnHeader inherits Rectangle {
    in property <bool> collapsed;
    in property <bool> above-modal;
    out property <bool> search-focused: search.visible && search.field-focused;

    callback search-accepted();

    property <bool> in-space: DirectoryView.room-scope == RoomScope.space;
    property <length> index-button-inset: Space.md;

    height: Metrics.header-row;

    search := SidebarSearch {
        x: Space.lg;
        y: (parent.height - self.height) / 2;
        width: parent.width - 2 * Space.lg;
        visible: !root.collapsed && !root.in-space;
        above-modal: root.above-modal;
        accepted => {
            root.search-accepted();
        }
    }

    if !root.collapsed && root.in-space: HeaderTitle {
        x: Space.lg;
        width: parent.width - self.x - Size.lg - 2 * root.index-button-inset;
        title: DirectoryView.listed-space-name;
        members: DirectoryView.listed-space-members;
    }

    if root.in-space: HeaderIconButton {
        x: root.collapsed
            ? (parent.width - self.width) / 2
            : parent.width - self.width - root.index-button-inset;
        y: (parent.height - self.height) / 2;
        icon: IconSet.Compass;
        tint: SpaceIndexView.visible ? Palette.accent-background : AppStyle.foreground-muted;
        above-modal: root.above-modal;
        label: SpaceIndexView.visible
            ? @tr("Close the room index")
            : @tr("Browse rooms in this space");
        clicked => {
            if SpaceIndexView.visible {
                Actions.close-space-index();
            } else {
                Actions.open-space-index();
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <length> subrail-width: Metrics.subspace-rail;
    in property <bool> above-modal: false;
    in property <bool> collapsed: false;

    callback room-selected();

    property <length> row-height: Metrics.sidebar-row;
    property <length> heading-height: Metrics.sidebar-heading;
    property <length> rail-width: Metrics.space-rail;
    property <length> avatar-size: Metrics.sidebar-avatar;
    property <bool> finds-nothing: RoomSearch.query != ""
        && !root.collapsed
        && DirectoryView.room-scope != RoomScope.space
        && DirectoryView.rooms.length == 0;

    background: Palette.alternate-background;

    function open-row(row: RoomEntry) {
        if row.kind == RoomRowKind.room {
            Actions.select-room(row.id);
            RoomSearch.clear();
            root.room-selected();
        }
        if row.kind == RoomRowKind.space {
            Actions.open-space(row.id);
            RoomSearch.clear();
        }
    }

    function open-first-match() {
        if RoomSearch.query == "" || DirectoryView.rooms.length == 0 {
            return;
        }
        let first = DirectoryView.rooms[0].kind == RoomRowKind.spaces-heading ? 1 : 0;
        if DirectoryView.rooms[first].kind == RoomRowKind.room {
            RoomSearch.opened-room = DirectoryView.rooms[first].id;
        }
        root.open-row(DirectoryView.rooms[first]);
    }

    HorizontalLayout {
        rail := SpaceRail {
            width: root.rail-width;
            above-modal: root.above-modal;
        }

        if DirectoryView.subspaces.length > 0: SubspaceRail {
            width: root.subrail-width;
            above-modal: root.above-modal;
        }

        room-column := Rectangle {
            VerticalLayout {
                header := RoomColumnHeader {
                    collapsed: root.collapsed;
                    above-modal: root.above-modal;
                    search-accepted => {
                        root.open-first-match();
                    }
                }

                if root.finds-nothing: RetryNotice {
                    text: DirectoryView.room-scope == RoomScope.direct
                        ? @tr("No direct messages match your search.")
                        : @tr("No rooms or spaces match your search.");
                    shows-icon: true;
                    icon: IconSet.SearchX;
                }

                ListView {
                    accessible-role: list;
                    accessible-label: @tr("Rooms");
                    accessible-item-count: DirectoryView.rooms.length;

                    for room[idx] in DirectoryView.rooms: RoomRow {
                        height: room.kind == RoomRowKind.spaces-heading ? root.heading-height : root.row-height;
                        index: idx;
                        above-modal: root.above-modal;
                        collapsed: root.collapsed;
                        avatar-size: root.avatar-size;
                        entry: room;
                        selected: room.kind == RoomRowKind.room && room.id == DirectoryView.selected-room-id;
                        clicked => {
                            if room.kind == RoomRowKind.room && header.search-focused {
                                RoomSearch.opened-room = room.id;
                            }
                            root.open-row(room);
                        }
                    }
                }
            }
        }
    }
}
