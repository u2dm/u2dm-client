import { FocusHome, FocusRegion, RoomMenu, RoomMenuOrigin, RoomSearch, Subspaces } from "../../../local.slint";
import { Shortcuts } from "../../../shortcuts.slint";

component SidebarSearch inherits FocusScope {
    in property <bool> above-modal: false;
    out property <bool> field-focused: field.has-focus;

    callback accepted();

    property <int> focus-asks: FocusHome.asks;
    property <int> seeks: RoomSearch.seeks;
    property <bool> reachable: root.visible && Interaction.actionable(true, root.above-modal);

    height: Size.md;
    focus-on-click: false;
    focus-on-tab-navigation: false;
    accessible-role: search;
    accessible-label: @tr("Room search");

    init => {
        root.take-seek();
    }

    changed field-focused => {
        if self.field-focused {
            FocusHome.entered(FocusRegion.rooms, "search");
        }
    }

    changed focus-asks => {
        if FocusHome.asked == FocusRegion.rooms && root.visible
            && (FocusHome.asked-place == "search"
                || (FocusHome.asked-place == "" && DirectoryView.selected-room-id == "")) {
            field.focus();
        }
    }

    changed seeks => {
        root.take-seek();
    }

    changed reachable => {
        root.take-seek();
    }

    function take-seek() {
        if RoomSearch.sought && root.reachable {
            RoomSearch.sought = false;
            field.seek();
        }
    }

    key-pressed(event) => {
        if event.text == Key.Escape && RoomSearch.query != "" {
            RoomSearch.clear();
            return accept;
        }
        return reject;
    }

    field := SearchField {
        width: 100%;
        height: 100%;
        shows-icon: false;
        placeholder: @tr("Search");
        label: DirectoryView.room-scope == RoomScope.direct
            ? @tr("Search direct messages")
            : @tr("Search rooms and spaces");
        description: Shortcuts.find-room.key == "" ? "" : @tr("Shortcut: {}", Shortcuts.label(Shortcuts.find-room));
        query <=> RoomSearch.query;
        above-modal: root.above-modal;
        enabled: Interaction.actionable(true, root.above-modal);
        edited(text) => {
            Actions.filter-rooms(text);
        }
        accepted => {
            root.accepted();
        }
    }
}

component RoomSummary inherits VerticalLayout {
    in property <RoomEntry> entry;
    in property <bool> has-unread;

    property <string> sender-label: root.entry.last-message-is-own
        ? @tr("You")
        : root.entry.last-message-sender;
    property <bool> is-service: root.entry.last-message-service-kind != ServiceKind.none;

    alignment: center;
    spacing: Space.sm;

    HorizontalLayout {
        spacing: Space.md;

        RowTitle {
            text: root.entry.name;
        }

        if root.entry.call != RoomCallMark.none: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.entry.call == RoomCallMark.video ? IconSet.Video : IconSet.Phone;
            size: IconSize.xs;
            stroke: AppStyle.call-live;
            accessible-role: image;
            accessible-label: CallWords.mark(root.entry.call);
        }

        if root.entry.last-message-time != "": Text {
            text: root.entry.last-message-time;
            font-size: Fonts.caption;
            vertical-alignment: center;
            color: AppStyle.foreground-muted;
        }
    }

    HorizontalLayout {
        spacing: Space.md;

        HorizontalLayout {
            horizontal-stretch: 1;

            if !root.is-service && root.sender-label != "": Text {
                text: root.sender-label + ": ";
                font-size: Fonts.body-small;
                vertical-alignment: center;
                color: Palette.accent-background;
                overflow: elide;
            }

            if !root.is-service && root.entry.last-message-edited: Rectangle {
                width: Size.xxs;

                IconDisplay {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Pencil;
                    size: IconSize.xs;
                    stroke: AppStyle.foreground-muted;
                }
            }

            SecondaryText {
                horizontal-stretch: 1;
                text: root.is-service
                    ? ServiceLabel.label(root.entry.last-message-service-kind, root.sender-label, root.entry.last-message-service-target)
                    : MessagePreview.label(root.entry.last-message-kind, root.entry.last-message-body);
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.entry.muted: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.BellOff;
            size: IconSize.sm;
            stroke: AppStyle.foreground-faint;
        }

        if root.has-unread: UnreadDot {
            cross-axis-self-alignment: center;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }
}

global InviteLine {
    public pure function from(entry: RoomEntry) -> string {
        if entry.invite-kind == InviteKind.direct && entry.inviter-id != "" {
            return entry.inviter-id;
        }
        if entry.inviter != "" {
            return @tr("Invited by {}", entry.inviter);
        }
        return @tr("Invitation");
    }

    public pure function describe(entry: RoomEntry) -> string {
        if entry.invite-kind == InviteKind.direct && entry.inviter-id != "" {
            return @tr("{}, chat invitation from {}", entry.name, entry.inviter-id);
        }
        if entry.invite-kind == InviteKind.space && entry.inviter != "" {
            return @tr("{}, space invitation from {}", entry.name, entry.inviter);
        }
        if entry.invite-kind == InviteKind.space {
            return @tr("{}, space invitation", entry.name);
        }
        if entry.inviter != "" {
            return @tr("{}, invitation from {}", entry.name, entry.inviter);
        }
        return @tr("{}, invitation", entry.name);
    }
}

global RemovalLine {
    public pure function from(entry: RoomEntry) -> string {
        if entry.removal == RemovalKind.banned {
            return @tr("Banned by {}", entry.removed-by);
        }
        return @tr("Removed by {}", entry.removed-by);
    }

    public pure function describe(entry: RoomEntry) -> string {
        if entry.removal == RemovalKind.banned {
            return @tr("{}, {} banned you", entry.name, entry.removed-by);
        }
        return @tr("{}, {} removed you", entry.name, entry.removed-by);
    }
}

global RowHeadings {
    public pure function is-heading(kind: RoomRowKind) -> bool {
        return kind == RoomRowKind.invites-heading
            || kind == RoomRowKind.rooms-heading
            || kind == RoomRowKind.spaces-heading;
    }

    public pure function folds-invites(kind: RoomRowKind) -> bool {
        return kind == RoomRowKind.invites-folded || kind == RoomRowKind.invites-unfolded;
    }

    public pure function is-short(kind: RoomRowKind) -> bool {
        return root.is-heading(kind) || root.folds-invites(kind);
    }

    public pure function text(kind: RoomRowKind) -> string {
        if kind == RoomRowKind.invites-heading || root.folds-invites(kind) {
            return @tr("RoomRow" => "Invites");
        }
        if kind == RoomRowKind.rooms-heading && DirectoryView.room-scope == RoomScope.direct {
            return @tr("RoomRow" => "Direct messages");
        }
        if kind == RoomRowKind.rooms-heading {
            return @tr("RoomRow" => "Rooms");
        }
        return @tr("RoomRow" => "Spaces");
    }
}

component RowHeading inherits Rectangle {
    in property <RoomRowKind> kind;
    in property <bool> collapsed;

    if !root.collapsed: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-bottom: Space.sm;

        Text {
            text: RowHeadings.text(root.kind);
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: bottom;
        }
    }
}

component InviteCount inherits Rectangle {
    in property <int> count;
    in property <bool> alert;

    height: Size.xs;
    width: max(self.height, digits.preferred-width + 2 * Space.sm);
    border-radius: self.height / 2;
    background: root.alert ? Palette.accent-background : AppStyle.overlay-hover;

    digits := Text {
        text: root.count;
        font-size: Fonts.caption;
        font-weight: Weight.semibold;
        color: root.alert ? Palette.accent-foreground : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component InviteSummary inherits VerticalLayout {
    in property <RoomEntry> entry;

    alignment: center;
    spacing: Space.sm;

    HorizontalLayout {
        spacing: Space.md;

        RowTitle {
            text: root.entry.name;
        }

        if root.entry.last-message-time != "": Text {
            text: root.entry.last-message-time;
            font-size: Fonts.caption;
            vertical-alignment: center;
            color: AppStyle.foreground-muted;
        }
    }

    HorizontalLayout {
        spacing: Space.md;

        SecondaryText {
            horizontal-stretch: 1;
            text: InviteLine.from(root.entry);
            vertical-alignment: center;
            overflow: elide;
        }

        UnreadDot {
            cross-axis-self-alignment: center;
            alert: true;
        }
    }
}

component RemovalSummary inherits VerticalLayout {
    in property <RoomEntry> entry;

    alignment: center;
    spacing: Space.sm;

    HorizontalLayout {
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            font-family: Fonts.emoji;
            font-size: Fonts.body;
            vertical-alignment: center;
            overflow: elide;
            color: AppStyle.foreground-muted;
        }

        if root.entry.last-message-time != "": Text {
            text: root.entry.last-message-time;
            font-size: Fonts.caption;
            vertical-alignment: center;
            color: AppStyle.foreground-muted;
        }
    }

    HorizontalLayout {
        spacing: Space.xs;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.entry.removal == RemovalKind.banned ? IconSet.Ban : IconSet.UserMinus;
            size: IconSize.xs;
            stroke: AppStyle.foreground-muted;
        }

        SecondaryText {
            horizontal-stretch: 1;
            text: RemovalLine.from(root.entry);
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component SpaceSummary inherits VerticalLayout {
    in property <RoomEntry> entry;
    in property <bool> has-unread;

    alignment: center;
    spacing: Space.sm;

    Text {
        text: root.entry.name;
        font-family: Fonts.emoji;
        font-size: Fonts.body;
        font-weight: Weight.semibold;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        spacing: Space.md;

        SecondaryText {
            horizontal-stretch: 1;
            text: root.entry.space-parent == ""
                ? @tr("{n} room" | "{n} rooms" % root.entry.space-rooms)
                : @tr("In {} · {n} room" | "In {} · {n} rooms" % root.entry.space-rooms, root.entry.space-parent);
            vertical-alignment: center;
            overflow: elide;
        }

        if root.has-unread: UnreadDot {
            cross-axis-self-alignment: center;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }
}

component SelectionCorner inherits Path {
    in property <bool> below;

    property <float> radius: Metrics.sidebar-tab-radius / 1px;
    property <float> overlap: Stroke.hairline / 1px;
    property <float> side: root.radius + root.overlap;

    width: Metrics.sidebar-tab-radius + Stroke.hairline;
    height: root.width;
    viewbox-width: root.side;
    viewbox-height: root.side;
    fill: AppStyle.canvas;
    commands: root.below
        ? "M 0 0 L \{root.side} 0 L \{root.side} \{root.side} L \{root.radius} \{root.side} A \{root.radius} \{root.radius} 0 0 0 0 \{root.overlap} Z"
        : "M 0 \{root.radius} A \{root.radius} \{root.radius} 0 0 0 \{root.radius} 0 L \{root.side} 0 L \{root.side} \{root.side} L 0 \{root.side} Z";
}

component RoomRow inherits ListItemArea {
    in property <RoomEntry> entry;
    in property <bool> collapsed;
    in property <bool> joins-timeline;
    in property <length> avatar-size;
    in property <bool> cursor-waits;

    property <bool> is-room: root.entry.kind == RoomRowKind.room;
    property <bool> is-invite: root.entry.kind == RoomRowKind.invite;
    property <bool> is-removal: root.entry.kind == RoomRowKind.removal;
    property <bool> is-space: root.entry.kind == RoomRowKind.space;
    property <bool> folds-invites: RowHeadings.folds-invites(root.entry.kind);
    property <bool> unfolded: root.entry.kind == RoomRowKind.invites-unfolded;
    property <bool> has-face: !root.folds-invites;
    property <bool> has-unread: root.entry.alert || root.entry.mention || root.entry.hint;
    property <bool> joined: root.selected && root.joins-timeline;

    pure function describe(entry: RoomEntry) -> string {
        if RowHeadings.folds-invites(entry.kind) {
            return @tr("{n} invite" | "{n} invites" % entry.invite-count);
        }
        if entry.kind == RoomRowKind.invite {
            return InviteLine.describe(entry);
        }
        if entry.kind == RoomRowKind.removal {
            return RemovalLine.describe(entry);
        }
        if entry.kind == RoomRowKind.space && entry.space-parent != "" {
            return @tr("{}, space in {}", entry.name, entry.space-parent);
        }
        if entry.kind == RoomRowKind.space {
            return @tr("{}, space", entry.name);
        }
        if entry.mention {
            return @tr("{}, mentions you", entry.name);
        }
        if entry.alert {
            return @tr("{}, unread", entry.name);
        }
        if entry.muted && entry.hint {
            return @tr("{}, muted, new activity", entry.name);
        }
        if entry.muted {
            return @tr("{}, muted", entry.name);
        }
        if entry.hint {
            return @tr("{}, new activity", entry.name);
        }
        return entry.name;
    }

    pure function fill(selected: bool, hovered: bool) -> color {
        if selected {
            return AppStyle.canvas;
        }
        if hovered {
            return AppStyle.nav-hover;
        }
        return transparent;
    }

    clip: true;
    ring-inset: Space.sm;
    ring-radius: Metrics.sidebar-tab-radius;
    region: FocusRegion.rooms;
    place: root.entry.id;
    region-row: true;
    label: root.describe(root.entry);
    accessible-expandable: root.folds-invites;
    accessible-expanded: root.unfolded;
    accessible-action-expand => {
        if root.folds-invites && !root.unfolded
            && Interaction.actionable(root.enabled, root.above-modal) {
            root.clicked();
        }
    }

    Rectangle {
        x: Space.sm;
        width: parent.width - self.x - (root.joined ? 0 : Space.sm);
        border-radius: Metrics.sidebar-tab-radius;
        border-top-right-radius: root.joined ? 0 : Metrics.sidebar-tab-radius;
        border-bottom-right-radius: root.joined ? 0 : Metrics.sidebar-tab-radius;
        background: root.fill(
            root.selected,
            root.enabled && (root.has-hover || RoomMenu.shows(root.entry.id)));
    }

    init => {
        if (root.is-room || root.is-invite || root.is-removal) && !root.entry.has-avatar {
            Actions.request-room-avatar(root.entry.id);
        }
        if root.cursor && root.cursor-waits {
            root.take-focus();
        }
    }

    context-menu-requested => {
        if !root.is-room {
            return EventResult.reject;
        }
        RoomMenu.open(
            root.entry.id,
            RoomMenuOrigin.list,
            root.absolute-position.x + Space.lg,
            root.absolute-position.y + root.height,
            true);
        return EventResult.accept;
    }

    if root.is-room: ContextPress {
        hovered: root.has-hover && Interaction.actionable(root.enabled, root.above-modal);
        pressed => {
            RoomMenu.open(
                root.entry.id,
                RoomMenuOrigin.list,
                root.absolute-position.x + root.mouse-x,
                root.absolute-position.y + root.mouse-y,
                false);
        }
    }

    if root.collapsed && root.has-face: Rectangle {
        width: 100%;
        height: 100%;

        collapsed-avatar := Avatar {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.avatar-size;
            height: root.avatar-size;
            opacity: root.is-removal ? Opacity.pending : 1;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        if root.has-unread: UnreadDot {
            x: collapsed-avatar.x + collapsed-avatar.width - self.width + Space.xs;
            y: collapsed-avatar.y + collapsed-avatar.height - self.height + Space.xs;
            ringed: true;
            alert: root.entry.alert;
            mention: root.entry.mention;
        }
    }

    if !root.collapsed && root.is-room: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Avatar {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;
            color-index: root.entry.color-index;
            has-image: root.entry.has-avatar;
            image: root.entry.avatar;
            initial: root.entry.initial;
        }

        RoomSummary {
            entry: root.entry;
            has-unread: root.has-unread;
        }
    }

    if !root.collapsed && root.is-invite: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Rectangle {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;

            Avatar {
                width: 100%;
                height: 100%;
                color-index: root.entry.color-index;
                has-image: root.entry.has-avatar;
                image: root.entry.avatar;
                initial: root.entry.initial;
            }

            if root.entry.invite-kind == InviteKind.space: SpaceBadge {
                x: parent.width - self.width + Space.xs;
                y: parent.height - self.height + Space.xs;
                cutout: AppStyle.nav;
            }
        }

        InviteSummary {
            entry: root.entry;
        }
    }

    if !root.collapsed && root.is-removal: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Rectangle {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;

            Avatar {
                width: 100%;
                height: 100%;
                opacity: Opacity.pending;
                color-index: root.entry.color-index;
                has-image: root.entry.has-avatar;
                image: root.entry.avatar;
                initial: root.entry.initial;
            }

            if root.entry.invite-kind == InviteKind.space: SpaceBadge {
                x: parent.width - self.width + Space.xs;
                y: parent.height - self.height + Space.xs;
                cutout: AppStyle.nav;
            }
        }

        RemovalSummary {
            entry: root.entry;
        }
    }

    if !root.collapsed && root.is-space: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        Rectangle {
            cross-axis-self-alignment: center;
            width: root.avatar-size;
            height: root.avatar-size;

            Avatar {
                width: 100%;
                height: 100%;
                color-index: root.entry.color-index;
                has-image: root.entry.has-avatar;
                image: root.entry.avatar;
                initial: root.entry.initial;
            }

            SpaceBadge {
                x: parent.width - self.width + Space.xs;
                y: parent.height - self.height + Space.xs;
                cutout: AppStyle.nav;
            }
        }

        SpaceSummary {
            entry: root.entry;
            has-unread: root.has-unread;
        }
    }

    if root.collapsed && root.folds-invites: HorizontalLayout {
        alignment: center;
        spacing: Space.xs;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.unfolded ? IconSet.ChevronDown : IconSet.ChevronRight;
            size: IconSize.xs;
            stroke: AppStyle.foreground-muted;
        }

        InviteCount {
            cross-axis-self-alignment: center;
            count: root.entry.invite-count;
            alert: !root.unfolded;
        }
    }

    if !root.collapsed && root.folds-invites: HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.sm;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.unfolded ? IconSet.ChevronDown : IconSet.ChevronRight;
            size: IconSize.sm;
            stroke: AppStyle.foreground-muted;
        }

        Text {
            horizontal-stretch: 1;
            text: RowHeadings.text(root.entry.kind);
            font-size: Fonts.label;
            font-weight: Weight.semibold;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        InviteCount {
            cross-axis-self-alignment: center;
            count: root.entry.invite-count;
            alert: !root.unfolded;
        }
    }
}

component RoomColumnHeader inherits Rectangle {
    in property <bool> collapsed;
    in property <bool> above-modal;
    out property <bool> search-focused: search.visible && search.field-focused;
    out property <bool> search-shown: search.visible;

    callback search-accepted();

    property <bool> in-space: DirectoryView.room-scope == RoomScope.space;
    property <length> index-button-inset: Space.md;
    property <length> button-pitch: Size.lg + root.index-button-inset;
    property <bool> offers-invite: !root.collapsed && root.in-space
        && DirectoryView.listed-space-may-invite;
    property <bool> offers-new-room: !root.collapsed && root.in-space
        && DirectoryView.listed-space-may-add-children;
    property <int> space-actions: (root.offers-invite ? 1 : 0) + (root.offers-new-room ? 1 : 0);

    height: Metrics.header-row;

    search := SidebarSearch {
        x: Space.lg;
        y: (parent.height - self.height) / 2;
        width: parent.width - 2 * Space.lg;
        visible: !root.collapsed && !root.in-space;
        above-modal: root.above-modal;
        accepted => {
            root.search-accepted();
        }
    }

    if !root.collapsed && root.in-space: ClickArea {
        property <int> focus-asks: FocusHome.asks;

        x: Space.sm;
        y: Space.sm;
        width: parent.width - self.x - Size.lg - 2 * root.index-button-inset
            - root.space-actions * root.button-pitch;
        height: parent.height - 2 * Space.sm;
        above-modal: root.above-modal;
        ring-radius: Metrics.sidebar-tab-radius;
        label: @tr("Actions for the space {}", DirectoryView.listed-space-name);
        region: FocusRegion.rooms;
        place: "space-header";
        changed focus-asks => {
            if FocusHome.asked == FocusRegion.rooms && FocusHome.asked-place == "space-header" {
                self.take-focus();
            }
        }
        clicked => {
            RoomMenu.open(
                DirectoryView.listed-space-id,
                RoomMenuOrigin.space-header,
                self.absolute-position.x,
                self.absolute-position.y + self.height + Space.xs,
                self.has-focus);
        }

        Rectangle {
            border-radius: Metrics.sidebar-tab-radius;
            background: parent.has-hover || RoomMenu.shows(DirectoryView.listed-space-id)
                ? AppStyle.overlay-hover
                : transparent;
        }

        HeaderTitle {
            x: Space.lg - Space.sm;
            width: parent.width - self.x - Space.sm;
            height: parent.height;
            title: DirectoryView.listed-space-name;
            members: DirectoryView.listed-space-members;
            opens-menu: true;
        }
    }

    if root.offers-new-room: HeaderIconButton {
        x: parent.width - (root.offers-invite ? 3 : 2) * root.button-pitch;
        y: (parent.height - self.height) / 2;
        icon: IconSet.MessageSquarePlus;
        tint: AppStyle.foreground-muted;
        above-modal: root.above-modal;
        label: @tr("New room in this space");
        region: FocusRegion.rooms;
        place: "new-room";
        property <int> focus-asks: FocusHome.asks;
        changed focus-asks => {
            if FocusHome.asked == FocusRegion.rooms && FocusHome.asked-place == "new-room" {
                self.take-focus();
            }
        }
        clicked => {
            Actions.open-create-room();
        }
    }

    if root.offers-invite: HeaderIconButton {
        x: parent.width - 2 * root.button-pitch;
        y: (parent.height - self.height) / 2;
        icon: IconSet.UserRoundPlus;
        tint: AppStyle.foreground-muted;
        above-modal: root.above-modal;
        label: @tr("Invite people to this space");
        region: FocusRegion.rooms;
        place: "invite";
        property <int> focus-asks: FocusHome.asks;
        changed focus-asks => {
            if FocusHome.asked == FocusRegion.rooms && FocusHome.asked-place == "invite" {
                self.take-focus();
            }
        }
        clicked => {
            Actions.open-invite-people(DirectoryView.listed-space-id);
        }
    }

    if root.in-space: HeaderIconButton {
        x: root.collapsed
            ? (parent.width - self.width) / 2
            : parent.width - self.width - root.index-button-inset;
        y: (parent.height - self.height) / 2;
        icon: IconSet.Compass;
        tint: SpaceIndexView.visible ? Palette.accent-background : AppStyle.foreground-muted;
        above-modal: root.above-modal;
        label: SpaceIndexView.visible
            ? @tr("Close the room index")
            : @tr("Browse rooms in this space");
        region: FocusRegion.rooms;
        place: "index";
        property <int> focus-asks: FocusHome.asks;
        changed focus-asks => {
            if FocusHome.asked == FocusRegion.rooms && FocusHome.asked-place == "index" {
                self.take-focus();
            }
        }
        clicked => {
            if SpaceIndexView.visible {
                Actions.close-space-index();
            } else {
                Actions.open-space-index();
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <length> subrail-width: Metrics.subspace-rail;
    in property <bool> above-modal: false;
    in property <bool> collapsed: false;
    in property <bool> joins-timeline: false;

    callback room-selected();

    property <length> row-height: Metrics.sidebar-row;
    property <length> heading-height: Metrics.sidebar-heading;
    property <length> rail-width: Metrics.space-rail;
    property <length> avatar-size: Metrics.sidebar-avatar;
    property <bool> finds-nothing: RoomSearch.query != ""
        && !root.collapsed
        && DirectoryView.room-scope != RoomScope.space
        && DirectoryView.rooms.length == 0;
    property <bool> invites-titled: DirectoryView.rooms.length > 0
        && DirectoryView.rooms[0].kind == RoomRowKind.invites-heading;
    property <int> listed: DirectoryView.rooms.length
        - (root.invites-titled ? 1 : 0)
        - (DirectoryView.rooms-heading-row >= 0 ? 1 : 0)
        - (DirectoryView.spaces-heading-row >= 0 ? 1 : 0);
    property <string> selected-room: DirectoryView.selected-room-id;
    property <int> focus-asks: FocusHome.asks;
    property <string> typed;

    background: AppStyle.nav;
    accessible-role: navigation;
    accessible-label: @tr("Spaces and rooms");

    pure function position(row: int) -> int {
        return row
            - (root.invites-titled && row > 0 ? 1 : 0)
            - (DirectoryView.rooms-heading-row >= 0 && row > DirectoryView.rooms-heading-row ? 1 : 0)
            - (DirectoryView.spaces-heading-row >= 0 && row > DirectoryView.spaces-heading-row ? 1 : 0);
    }

    function reveal-row(row: int) {
        let pitch = room-list.content-height / max(1, DirectoryView.rooms.length);
        room-list.content-y = -clamp(
            row * pitch - (room-list.visible-height - root.row-height) / 2,
            0px,
            max(0px, room-list.content-height - room-list.visible-height));
    }

    function type-ahead(event: KeyEvent) -> EventResult {
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta || event.text == ""
            || event.text == " " || event.text == Key.Escape {
            return EventResult.reject;
        }
        let typed = root.typed + event.text;
        let found = Actions.room-row-starting-with(
            typed,
            DirectoryView.rooms,
            root.typed == "" ? room-keys.cursor : room-keys.cursor - 1);
        if found < 0 {
            return EventResult.reject;
        }
        root.typed = typed;
        typing.running = true;
        typing.restart();
        room-keys.move-to(found, 1);
        return EventResult.accept;
    }

    init => {
        room-keys.cursor-key = root.selected-room;
    }

    changed selected-room => {
        if root.selected-room != "" {
            room-keys.cursor-key = root.selected-room;
        }
    }

    changed focus-asks => {
        if FocusHome.asked != FocusRegion.rooms {
            return;
        }
        let place = FocusHome.asked-place;
        if place != "" && Actions.room-row-of(place, DirectoryView.rooms) >= 0 {
            room-keys.cursor-key = place;
            room-keys.focus-cursor();
        } else if place == "" && DirectoryView.rooms.length > 0
            && (root.selected-room != "" || !header.search-shown) {
            room-keys.focus-cursor();
        }
    }

    typing := Timer {
        interval: Motion.typeahead-pause;
        running: false;
        triggered => {
            self.running = false;
            root.typed = "";
        }
    }

    function open-row(row: RoomEntry) {
        if row.kind == RoomRowKind.invites-folded {
            Actions.unfold-invites();
        }
        if row.kind == RoomRowKind.invites-unfolded {
            Actions.fold-invites();
        }
        if row.kind == RoomRowKind.room {
            Actions.select-room(row.id);
            RoomSearch.clear();
            root.room-selected();
        }
        if row.kind == RoomRowKind.invite {
            Actions.open-invite(row.id);
            RoomSearch.clear();
        }
        if row.kind == RoomRowKind.removal {
            Actions.open-removal(row.id);
            RoomSearch.clear();
        }
        if row.kind == RoomRowKind.space {
            Actions.open-space(row.id);
            RoomSearch.clear();
        }
    }

    function open-first-match() {
        if RoomSearch.query == "" || DirectoryView.rooms.length == 0 {
            return;
        }
        let first = RowHeadings.is-heading(DirectoryView.rooms[0].kind) ? 1 : 0;
        if DirectoryView.rooms[first].kind == RoomRowKind.room {
            RoomSearch.opened-room = DirectoryView.rooms[first].id;
        }
        root.open-row(DirectoryView.rooms[first]);
    }

    HorizontalLayout {

        RegionScope {
            width: root.rail-width;
            region: FocusRegion.rail;

            SpaceRail {
                above-modal: root.above-modal;
            }
        }

        if Subspaces.in-column(root.collapsed): RegionScope {
            width: root.subrail-width;
            region: FocusRegion.rail;

            SubspaceRail {
                above-modal: root.above-modal;
                offers-tabs: !root.collapsed;
            }
        }

        room-column := RegionScope {
            region: FocusRegion.rooms;

            property <length> selected-top: list-area.y + room-list.content-y
                + (DirectoryView.selected-room-row - DirectoryView.selected-room-headings) * root.row-height
                + DirectoryView.selected-room-headings * root.heading-height;
            property <length> selected-bottom: self.selected-top + root.row-height;
            property <length> list-bottom: list-area.y + list-area.height;
            property <bool> shows-junction: root.joins-timeline && DirectoryView.selected-room-row >= 0;
            property <bool> scrolled-lately: false;
            property <bool> pointer-at-scrollbar: list-area.has-hover
                && list-area.mouse-x >= list-area.width - Space.lg;

            scrollbar-linger := Timer {
                interval: Motion.scrollbar-linger;
                running: false;
                triggered => {
                    self.running = false;
                    room-column.scrolled-lately = false;
                }
            }

            if room-column.shows-junction
                && room-column.selected-top >= list-area.y
                && room-column.selected-top < room-column.list-bottom: SelectionCorner {
                x: room-column.width - Metrics.sidebar-tab-radius;
                y: room-column.selected-top - Metrics.sidebar-tab-radius;
            }

            if room-column.shows-junction
                && room-column.selected-bottom > list-area.y
                && room-column.selected-bottom <= room-column.list-bottom: SelectionCorner {
                x: room-column.width - Metrics.sidebar-tab-radius;
                y: room-column.selected-bottom - Stroke.hairline;
                below: true;
            }

            VerticalLayout {
                header := RoomColumnHeader {
                    collapsed: root.collapsed;
                    above-modal: root.above-modal;
                    search-accepted => {
                        root.open-first-match();
                    }
                }

                if Subspaces.in-tabs(root.collapsed): SubspaceTabs {
                    above-modal: root.above-modal;
                }

                if root.finds-nothing: RetryNotice {
                    text: DirectoryView.room-scope == RoomScope.direct
                        ? @tr("No direct messages match your search.")
                        : @tr("No rooms or spaces match your search.");
                    shows-icon: true;
                    icon: IconSet.SearchX;
                }

                list-area := TouchArea {
                    vertical-stretch: 1;

                    room-keys := RovingList {
                        count: DirectoryView.rooms.length;
                        unbuilt-rows: true;
                        above-modal: root.above-modal;
                        locates: true;
                        page: max(1, floor(room-list.visible-height / root.row-height));
                        locate(key) => {
                            return Actions.room-row-of(key, DirectoryView.rooms);
                        }
                        skips(row) => {
                            return RowHeadings.is-heading(DirectoryView.rooms[row].kind);
                        }
                        reveal(row) => {
                            root.reveal-row(row);
                        }
                        other-key(event) => {
                            return root.type-ahead(event);
                        }

                        room-list := ListView {
                            width: 100%;
                            height: 100%;
                            vertical-scrollbar-policy: room-column.scrolled-lately || room-column.pointer-at-scrollbar
                                ? ScrollBarPolicy.as-needed
                                : ScrollBarPolicy.always-off;
                            accessible-role: list;
                            accessible-label: @tr("Rooms");
                            accessible-item-count: root.listed;
                            scrolled => {
                                room-column.scrolled-lately = true;
                                scrollbar-linger.running = true;
                                scrollbar-linger.restart();
                            }

                            for room[idx] in DirectoryView.rooms: Rectangle {
                                height: RowHeadings.is-short(room.kind) ? root.heading-height : root.row-height;

                                if RowHeadings.is-heading(room.kind): RowHeading {
                                    kind: room.kind;
                                    collapsed: root.collapsed;
                                }

                                if !RowHeadings.is-heading(room.kind): RoomRow {
                                    index: root.position(idx);
                                    above-modal: root.above-modal;
                                    collapsed: root.collapsed;
                                    joins-timeline: root.joins-timeline;
                                    avatar-size: root.avatar-size;
                                    entry: room;
                                    selected: room.kind == RoomRowKind.room && room.id == DirectoryView.selected-room-id;
                                    tab-stop: room-keys.items-tab-stop;
                                    cursor: idx == room-keys.cursor;
                                    cursor-asks: room-keys.asks;
                                    cursor-waits: room-keys.waiting;
                                    cursor-taken => {
                                        room-keys.took(idx, room.id);
                                    }
                                    clicked => {
                                        if room.kind == RoomRowKind.room && (header.search-focused || self.has-focus) {
                                            RoomSearch.opened-room = room.id;
                                        }
                                        room-keys.took(idx, room.id);
                                        root.open-row(room);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
