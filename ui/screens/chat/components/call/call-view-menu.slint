import { ScrollView } from "std-widgets.slint";
import { Icon, IconSet } from "@lucide";

import { RovingKeys } from "../../../../components/a11y.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { CallMode, CallPanel } from "../../../../local.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Metrics, Space, Stroke } from "../../../../theme.slint";

enum CallViewChoice { call-and-chat, call-only, chat-only, gallery, focus, strip, self-view, fit }

export component CallViewMenu inherits PickerCard {
    in property <bool> beside-chat;
    in property <length> room;

    callback chose();

    property <bool> focused: CallView.stage.length > 0;
    property <[CallViewChoice]> modes: [CallViewChoice.call-and-chat, CallViewChoice.call-only, CallViewChoice.chat-only];
    property <[CallViewChoice]> views: root.focused
        ? [CallViewChoice.gallery, CallViewChoice.focus, CallViewChoice.strip, CallViewChoice.self-view, CallViewChoice.fit]
        : [CallViewChoice.gallery, CallViewChoice.focus, CallViewChoice.self-view, CallViewChoice.fit];
    property <int> cursor: -1;
    property <bool> keys-focused: keys.has-focus;

    public function open(by-keys: bool) {
        root.cursor = by-keys ? 0 : -1;
        keys.focus();
    }

    pure function icon(choice: CallViewChoice) -> Icon {
        if choice == CallViewChoice.call-and-chat {
            return root.beside-chat ? IconSet.LayoutPanelLeft : IconSet.LayoutPanelTop;
        }
        if choice == CallViewChoice.call-only {
            return CallView.active-video ? IconSet.Video : IconSet.Phone;
        }
        if choice == CallViewChoice.chat-only {
            return IconSet.MessageSquare;
        }
        if choice == CallViewChoice.gallery {
            return IconSet.LayoutGrid;
        }
        if choice == CallViewChoice.focus {
            return IconSet.Focus;
        }
        if choice == CallViewChoice.strip {
            return IconSet.UsersRound;
        }
        if choice == CallViewChoice.self-view {
            return CallView.self-view ? IconSet.EyeOff : IconSet.Eye;
        }
        return CallPanel.fits-videos ? IconSet.Expand : IconSet.Shrink;
    }

    pure function label(choice: CallViewChoice) -> string {
        if choice == CallViewChoice.call-and-chat {
            return @tr("Call and chat");
        }
        if choice == CallViewChoice.call-only {
            return @tr("Call only");
        }
        if choice == CallViewChoice.chat-only {
            return @tr("Chat only");
        }
        if choice == CallViewChoice.gallery {
            return @tr("Gallery");
        }
        if choice == CallViewChoice.focus {
            return @tr("Focus");
        }
        if choice == CallViewChoice.strip {
            return CallPanel.hides-strip ? @tr("Show everyone else") : @tr("Hide everyone else");
        }
        if choice == CallViewChoice.self-view {
            return CallView.self-view ? @tr("Hide self-view") : @tr("Show self-view");
        }
        return CallPanel.fits-videos ? @tr("Fill tiles with video") : @tr("Fit whole videos");
    }

    pure function checkable(choice: CallViewChoice) -> bool {
        return choice != CallViewChoice.strip && choice != CallViewChoice.self-view && choice != CallViewChoice.fit;
    }

    pure function checked(choice: CallViewChoice) -> bool {
        return (choice == CallViewChoice.call-and-chat && CallPanel.mode == CallMode.call-and-chat)
            || (choice == CallViewChoice.call-only && CallPanel.mode == CallMode.call-only)
            || (choice == CallViewChoice.chat-only && CallPanel.mode == CallMode.chat-only)
            || (choice == CallViewChoice.gallery && !root.focused)
            || (choice == CallViewChoice.focus && root.focused);
    }

    pure function choice-at(index: int) -> CallViewChoice {
        return index < root.modes.length ? root.modes[index] : root.views[index - root.modes.length];
    }

    pure function cursor-choice() -> CallViewChoice {
        return root.choice-at(max(root.cursor, 0));
    }

    function choose(choice: CallViewChoice) {
        if choice == CallViewChoice.call-and-chat {
            CallPanel.choose(CallMode.call-and-chat);
        } else if choice == CallViewChoice.call-only {
            CallPanel.choose(CallMode.call-only);
        } else if choice == CallViewChoice.chat-only {
            CallPanel.choose(CallMode.chat-only);
        } else if choice == CallViewChoice.gallery {
            Actions.show-call-gallery();
        } else if choice == CallViewChoice.focus {
            Actions.show-call-focus();
        } else if choice == CallViewChoice.strip {
            CallPanel.hides-strip = !CallPanel.hides-strip;
        } else if choice == CallViewChoice.self-view {
            Actions.show-self-view({ on: !CallView.self-view });
        } else {
            CallPanel.fits-videos = !CallPanel.fits-videos;
        }
        root.chose();
    }

    function reveal(top: length, size: length) {
        if top < -scroll.content-y {
            scroll.content-y = -top;
        } else if top + size > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -(top + size - scroll.visible-height);
        }
    }

    width: Metrics.call-menu-width;
    height: min(rows.preferred-height + 2 * Space.sm, root.room);

    TouchArea { }

    keys := RovingKeys {
        count: root.modes.length + root.views.length;
        cursor <=> root.cursor;
        accessible-label: root.cursor >= 0 ? root.label(root.cursor-choice()) : @tr("Call layout");
        accessible-checkable: root.cursor >= 0 && root.checkable(root.cursor-choice());
        accessible-checked: root.cursor >= 0 && root.checked(root.cursor-choice());
        accessible-action-default => {
            root.choose(root.cursor-choice());
        }
        intercept(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            return reject;
        }
        activated(index) => {
            root.choose(root.choice-at(index));
        }
    }

    scroll := ScrollView {
        x: 0;
        y: Space.sm;
        width: parent.width;
        height: parent.height - 2 * Space.sm;
        content-width: self.visible-width;
        content-height: rows.preferred-height;

        rows := VerticalLayout {
            width: scroll.visible-width;
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: Space.xs;

            for choice[index] in root.modes: MenuRow {
                height: Metrics.call-menu-row;
                icon: root.icon(choice);
                label: root.label(choice);
                checkable: true;
                checked: root.checked(choice);
                trailing: root.checked(choice) ? IconSet.Check : { };
                focusable: false;
                roving-focus: root.keys-focused && root.cursor == index;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(choice);
                }
            }

            Rectangle {
                height: Metrics.call-menu-group-gap;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: Stroke.hairline;
                    background: AppStyle.border;
                }
            }

            for choice[index] in root.views: MenuRow {
                height: Metrics.call-menu-row;
                icon: root.icon(choice);
                label: root.label(choice);
                checkable: root.checkable(choice);
                checked: root.checked(choice);
                trailing: root.checked(choice) ? IconSet.Check : { };
                focusable: false;
                roving-focus: root.keys-focused && root.cursor == root.modes.length + index;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(choice);
                }
            }
        }
    }
}
