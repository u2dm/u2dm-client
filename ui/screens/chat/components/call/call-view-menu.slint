import { IconSet } from "@lucide";

import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { CallPanel } from "../../../../local.slint";
import { CallView } from "../../../../views.slint";
import { Metrics, Space } from "../../../../theme.slint";

export component CallViewMenu inherits PickerCard {
    callback chose();

    property <bool> focused: CallView.stage.length > 0;

    width: Metrics.call-menu-width;
    height: layout.preferred-height;

    TouchArea { }

    layout := VerticalLayout {
        padding: Space.sm;
        spacing: Space.xs;

        MenuRow {
            height: Metrics.call-menu-row;
            icon: IconSet.LayoutGrid;
            label: @tr("Gallery");
            trailing: root.focused ? { } : IconSet.Check;
            clicked => {
                Actions.show-call-gallery();
                root.chose();
            }
        }

        MenuRow {
            height: Metrics.call-menu-row;
            icon: IconSet.Focus;
            label: @tr("Focus");
            trailing: root.focused ? IconSet.Check : { };
            clicked => {
                Actions.show-call-focus();
                root.chose();
            }
        }

        if root.focused: MenuRow {
            height: Metrics.call-menu-row;
            icon: IconSet.UsersRound;
            label: CallPanel.hides-strip ? @tr("Show everyone else") : @tr("Hide everyone else");
            clicked => {
                CallPanel.hides-strip = !CallPanel.hides-strip;
                root.chose();
            }
        }

        MenuRow {
            height: Metrics.call-menu-row;
            icon: CallView.self-view ? IconSet.EyeOff : IconSet.Eye;
            label: CallView.self-view ? @tr("Hide self-view") : @tr("Show self-view");
            clicked => {
                Actions.show-self-view({ on: !CallView.self-view });
                root.chose();
            }
        }

        MenuRow {
            height: Metrics.call-menu-row;
            icon: CallPanel.fits-videos ? IconSet.Expand : IconSet.Shrink;
            label: CallPanel.fits-videos ? @tr("Fill tiles with video") : @tr("Fit whole videos");
            clicked => {
                CallPanel.fits-videos = !CallPanel.fits-videos;
                root.chose();
            }
        }
    }
}
