import { ScrollView } from "std-widgets.slint";
import { Icon, IconSet } from "@lucide";

import { RovingKeys } from "../../../../components/a11y.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { CallScreen } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { CallMode, CallPanel } from "../../../../local.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, Metrics, Space, Stroke, Weight } from "../../../../theme.slint";

enum CallViewChoice { call-and-chat, call-only, chat-only, automatic, gallery, follow, pinned, strip, self-view, share-preview, fit }

export global CallViewWords {
    public pure function mode(mode: CallMode) -> string {
        if mode == CallMode.call-and-chat {
            return @tr("Call and chat");
        }
        if mode == CallMode.call-only {
            return @tr("Call only");
        }
        return @tr("Chat only");
    }

    public pure function stage() -> string {
        if CallView.stage-chosen && CallView.stage.length > 0 {
            return CallWords.pinned(CallWords.tile-title(CallView.stage[0]));
        }
        if CallView.view-chosen {
            return @tr("Gallery");
        }
        if CallView.follows-speaker {
            return CallWords.follow-speaker();
        }
        return @tr("Automatic");
    }

    public pure function now(mode: CallMode) -> string {
        return CallWords.listed(root.mode(mode), root.stage());
    }
}

export component MenuGroup inherits VerticalLayout {
    in property <string> heading;
    in property <bool> first;

    padding-top: root.first ? 0 : Space.xs;

    if !root.first: Rectangle {
        height: Metrics.call-menu-group-gap;

        Rectangle {
            y: (parent.height - self.height) / 2;
            height: Stroke.hairline;
            background: AppStyle.border;
        }
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;

        Text {
            height: Metrics.call-menu-heading;
            text: root.heading;
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component CallViewMenu inherits PickerCard {
    in property <bool> beside-chat;
    in property <length> room;

    callback chose();

    property <bool> focused: CallView.stage.length > 0;
    property <bool> pinned: CallView.stage-chosen && root.focused;
    property <bool> sharing: CallView.screen == CallScreen.on;
    property <string> staged-title: root.focused
        ? CallWords.tile-title(CallView.stage[0])
        : "";
    property <[CallViewChoice]> modes: [CallViewChoice.call-and-chat, CallViewChoice.call-only, CallViewChoice.chat-only];
    property <[CallViewChoice]> stages: root.pinned
        ? [CallViewChoice.automatic, CallViewChoice.gallery, CallViewChoice.follow, CallViewChoice.pinned]
        : [CallViewChoice.automatic, CallViewChoice.gallery, CallViewChoice.follow];
    property <[CallViewChoice]> views: root.focused && root.sharing
        ? [CallViewChoice.strip, CallViewChoice.self-view, CallViewChoice.share-preview, CallViewChoice.fit]
        : root.focused
        ? [CallViewChoice.strip, CallViewChoice.self-view, CallViewChoice.fit]
        : root.sharing
        ? [CallViewChoice.self-view, CallViewChoice.share-preview, CallViewChoice.fit]
        : [CallViewChoice.self-view, CallViewChoice.fit];
    property <int> cursor: -1;
    property <bool> keys-focused: keys.has-focus;

    public function open(by-keys: bool) {
        root.cursor = by-keys ? 0 : -1;
        keys.focus();
    }

    pure function icon(choice: CallViewChoice) -> Icon {
        if choice == CallViewChoice.call-and-chat {
            return root.beside-chat ? IconSet.LayoutPanelLeft : IconSet.LayoutPanelTop;
        }
        if choice == CallViewChoice.call-only {
            return CallView.active-video ? IconSet.Video : IconSet.Phone;
        }
        if choice == CallViewChoice.chat-only {
            return IconSet.MessageSquare;
        }
        if choice == CallViewChoice.automatic {
            return IconSet.LayoutDashboard;
        }
        if choice == CallViewChoice.gallery {
            return IconSet.LayoutGrid;
        }
        if choice == CallViewChoice.follow {
            return IconSet.AudioLines;
        }
        if choice == CallViewChoice.pinned {
            return IconSet.Pin;
        }
        if choice == CallViewChoice.strip {
            return IconSet.UsersRound;
        }
        if choice == CallViewChoice.self-view {
            return CallView.self-view ? IconSet.EyeOff : IconSet.Eye;
        }
        if choice == CallViewChoice.share-preview {
            return CallView.share-preview ? IconSet.EyeOff : IconSet.Eye;
        }
        return CallPanel.fits-videos ? IconSet.Expand : IconSet.Shrink;
    }

    pure function label(choice: CallViewChoice) -> string {
        if choice == CallViewChoice.call-and-chat {
            return CallViewWords.mode(CallMode.call-and-chat);
        }
        if choice == CallViewChoice.call-only {
            return CallViewWords.mode(CallMode.call-only);
        }
        if choice == CallViewChoice.chat-only {
            return CallViewWords.mode(CallMode.chat-only);
        }
        if choice == CallViewChoice.automatic {
            return @tr("Automatic");
        }
        if choice == CallViewChoice.gallery {
            return @tr("Gallery");
        }
        if choice == CallViewChoice.follow {
            return CallWords.follow-speaker();
        }
        if choice == CallViewChoice.pinned {
            return CallWords.pinned(root.staged-title);
        }
        if choice == CallViewChoice.strip {
            return CallPanel.hides-strip ? @tr("Show everyone else") : @tr("Hide everyone else");
        }
        if choice == CallViewChoice.self-view {
            return CallView.self-view ? @tr("Hide self-view") : @tr("Show self-view");
        }
        if choice == CallViewChoice.share-preview {
            return CallView.share-preview ? @tr("Hide your shared screen") : @tr("Show your shared screen");
        }
        return CallPanel.fits-videos ? @tr("Fill tiles with video") : @tr("Fit whole videos");
    }

    pure function detail(choice: CallViewChoice) -> string {
        if choice == CallViewChoice.automatic {
            return @tr("Shared screens first");
        }
        return "";
    }

    pure function checkable(choice: CallViewChoice) -> bool {
        return choice != CallViewChoice.strip && choice != CallViewChoice.self-view
            && choice != CallViewChoice.share-preview && choice != CallViewChoice.fit;
    }

    pure function checked(choice: CallViewChoice) -> bool {
        return (choice == CallViewChoice.call-and-chat && CallPanel.mode == CallMode.call-and-chat)
            || (choice == CallViewChoice.call-only && CallPanel.mode == CallMode.call-only)
            || (choice == CallViewChoice.chat-only && CallPanel.mode == CallMode.chat-only)
            || (choice == CallViewChoice.automatic && !CallView.view-chosen && !CallView.follows-speaker)
            || (choice == CallViewChoice.gallery && CallView.view-chosen && !root.focused)
            || (choice == CallViewChoice.follow && CallView.follows-speaker && !CallView.view-chosen)
            || (choice == CallViewChoice.pinned && root.pinned);
    }

    pure function choice-at(index: int) -> CallViewChoice {
        if index < root.modes.length {
            return root.modes[index];
        }
        if index < root.modes.length + root.stages.length {
            return root.stages[index - root.modes.length];
        }
        return root.views[index - root.modes.length - root.stages.length];
    }

    pure function cursor-choice() -> CallViewChoice {
        return root.choice-at(max(root.cursor, 0));
    }

    function choose(choice: CallViewChoice) {
        if choice == CallViewChoice.call-and-chat {
            CallPanel.choose(CallMode.call-and-chat);
        } else if choice == CallViewChoice.call-only {
            CallPanel.choose(CallMode.call-only);
        } else if choice == CallViewChoice.chat-only {
            CallPanel.choose(CallMode.chat-only);
        } else if choice == CallViewChoice.automatic {
            Actions.follow-speaker({ on: false });
            Actions.unpin-call-tile();
        } else if choice == CallViewChoice.gallery {
            Actions.show-call-gallery();
        } else if choice == CallViewChoice.follow {
            Actions.follow-speaker({ on: true });
        } else if choice == CallViewChoice.pinned {
            Actions.unpin-call-tile();
        } else if choice == CallViewChoice.strip {
            CallPanel.hides-strip = !CallPanel.hides-strip;
        } else if choice == CallViewChoice.self-view {
            Actions.show-self-view({ on: !CallView.self-view });
        } else if choice == CallViewChoice.share-preview {
            Actions.show-share-preview({ on: !CallView.share-preview });
        } else {
            CallPanel.fits-videos = !CallPanel.fits-videos;
        }
        root.chose();
    }

    function reveal(top: length, size: length) {
        if top < -scroll.content-y {
            scroll.content-y = -top;
        } else if top + size > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -(top + size - scroll.visible-height);
        }
    }

    width: Metrics.call-menu-width;
    height: min(rows.preferred-height + 2 * Space.sm, root.room);

    TouchArea { }

    keys := RovingKeys {
        count: root.modes.length + root.stages.length + root.views.length;
        cursor <=> root.cursor;
        accessible-label: root.cursor >= 0 ? root.label(root.cursor-choice()) : @tr("View");
        accessible-description: root.cursor >= 0 ? root.detail(root.cursor-choice()) : "";
        accessible-checkable: root.cursor >= 0 && root.checkable(root.cursor-choice());
        accessible-checked: root.cursor >= 0 && root.checked(root.cursor-choice());
        accessible-action-default => {
            root.choose(root.cursor-choice());
        }
        intercept(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            return reject;
        }
        activated(index) => {
            root.choose(root.choice-at(index));
        }
    }

    scroll := ScrollView {
        x: 0;
        y: Space.sm;
        width: parent.width;
        height: parent.height - 2 * Space.sm;
        content-width: self.visible-width;
        content-height: rows.preferred-height;

        rows := VerticalLayout {
            width: scroll.visible-width;
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: Space.xs;

            MenuGroup {
                heading: @tr("Layout");
                first: true;
            }

            for choice[index] in root.modes: MenuRow {
                height: Metrics.call-menu-row;
                icon: root.icon(choice);
                label: root.label(choice);
                checkable: true;
                checked: root.checked(choice);
                trailing: root.checked(choice) ? IconSet.Check : { };
                focusable: false;
                roving-focus: root.keys-focused && root.cursor == index;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(choice);
                }
            }

            MenuGroup {
                heading: @tr("Stage");
            }

            for choice[index] in root.stages: MenuRow {
                height: Metrics.call-menu-row;
                icon: root.icon(choice);
                label: root.label(choice);
                detail: root.detail(choice);
                checkable: true;
                checked: root.checked(choice);
                trailing: root.checked(choice) ? IconSet.Check : { };
                focusable: false;
                roving-focus: root.keys-focused && root.cursor == root.modes.length + index;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(choice);
                }
            }

            MenuGroup {
                heading: @tr("Display");
            }

            for choice[index] in root.views: MenuRow {
                height: Metrics.call-menu-row;
                icon: root.icon(choice);
                label: root.label(choice);
                checkable: root.checkable(choice);
                checked: root.checked(choice);
                trailing: root.checked(choice) ? IconSet.Check : { };
                focusable: false;
                roving-focus: root.keys-focused && root.cursor == root.modes.length + root.stages.length + index;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(choice);
                }
            }
        }
    }
}
