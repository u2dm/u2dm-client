import { Icon, IconDisplay, IconSet } from "@lucide";

import { Avatar } from "../../../../components/avatar.slint";
import { AppButton, IconButton, LinkButton } from "../../../../components/button.slint";
import { TipSource } from "../../../../components/tip.slint";
import { Actions } from "../../../../actions.slint";
import { CallStates } from "../../../../call-states.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPanel, CallSize, TipScope } from "../../../../local.slint";
import { CallTileEntry } from "../../../../types.slint";
import { CallView, DirectoryView } from "../../../../views.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallKey, CallKeys } from "./call-controls.slint";
import { CallStage } from "./call-stage.slint";
import { CallViewWords } from "./call-view-menu.slint";

component ShareOffer inherits HorizontalLayout {
    in property <string> name;

    callback view();

    spacing: Space.sm;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: CallWords.sharing(root.name);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-strong;
        vertical-alignment: center;
        overflow: elide;
    }

    LinkButton {
        min-height: Size.sm;
        text: @tr("View");
        label: CallWords.view-share(root.name);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            root.view();
        }
    }
}

component SelfChip inherits Rectangle {
    in property <CallTileEntry> tile;

    property <string> words: CallWords.listed(
        CallWords.listed(
            CallWords.self-chip(root.tile.muted, root.tile.speaking),
            root.tile.hand > 0 ? CallWords.hand-raised(root.tile.hand, CallView.hands-raised) : ""),
        root.tile.reaction != "" ? CallWords.reacted(root.tile.reaction-name, root.tile.reaction) : "");

    width: Metrics.call-self-chip;
    height: self.width;
    accessible-role: image;
    accessible-label: root.words;

    touch := TouchArea { }

    Avatar {
        width: root.width;
        height: root.height;
        color-index: root.tile.color-index;
        has-image: root.tile.has-avatar;
        image: root.tile.avatar;
        initial: root.tile.initial;
        initial-size: Glyph.xs;
        opacity: CallStates.flows(root.tile.state) ? 1 : 0.5;
        accessible-role: none;
    }

    if root.tile.reaction != "": Rectangle {
        border-radius: root.width / 2;
        background: AppStyle.elevated;

        Text {
            text: root.tile.reaction;
            font-family: Fonts.emoji;
            font-size: Glyph.md;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    Rectangle {
        border-radius: root.width / 2;
        border-width: root.tile.speaking ? Metrics.call-speaking-ring : 0;
        border-color: AppStyle.call-speaking;
    }

    if root.tile.muted: Rectangle {
        x: root.width - self.width + Space.xs;
        y: root.height - self.height + Space.xs;
        width: Metrics.call-badge;
        height: self.width;
        border-radius: self.width / 2;
        background: AppStyle.call-band;

        IconDisplay {
            icon: IconSet.MicOff;
            size: IconSize.xs;
            stroke: AppStyle.foreground-strong;
            accessible-role: none;
        }
    }

    if root.tile.hand > 0: Rectangle {
        x: root.width - self.width + Space.xs;
        y: -Space.xs;
        width: Metrics.call-badge;
        height: self.width;
        border-radius: self.width / 2;
        background: AppStyle.call-hand;

        IconDisplay {
            icon: IconSet.Hand;
            size: IconSize.xs;
            stroke: AppStyle.on-call-hand;
            accessible-role: none;
        }
    }

    TipSource {
        width: root.width;
        height: root.height;
        text: root.words;
        hovered: touch.has-hover;
        pressed: touch.pressed;
        below: true;
        scope: TipScope.call;
    }
}

export component CallBand inherits Rectangle {
    in property <CallSize> size;
    in property <bool> beside-chat;
    in property <length> top-row;
    in property <length> lead-inset;

    out property <length> menu-right: root.view-worded
        ? view-button.absolute-position.x + view-button.width
        : view-icon.absolute-position.x + view-icon.width;
    out property <length> menu-bottom: view-icon.absolute-position.y + view-icon.height;

    property <bool> covers-chat: root.size == CallSize.full;
    property <bool> shows-chat-button;
    property <bool> staged: CallView.stage.length > 0;
    property <string> staged-title: CallWords.tile-title(CallView.stage[0]);
    property <bool> follows-back: CallView.follows-speaker && CallView.view-chosen;
    property <bool> pinned: CallView.stage-chosen && root.staged;
    property <Icon> return-icon: root.pinned ? IconSet.PinOff : root.follows-back ? IconSet.AudioLines : IconSet.LayoutGrid;
    property <string> return-text: root.pinned ? @tr("Unpin") : root.follows-back ? @tr("Follow speaker") : @tr("Gallery");
    property <string> return-label: root.pinned ? CallWords.unpin(root.staged-title)
        : root.follows-back ? CallWords.follow-speaker()
        : CallWords.show-gallery();
    property <bool> offers-return: root.staged || root.follows-back;
    property <bool> compact-self: CallView.compact-self.length > 0;
    property <length> lead: max(0px, root.lead-inset - Space.md);
    property <bool> elsewhere: CallView.active-room-id != DirectoryView.selected-room-id;
    property <bool> offers-share: CallView.offered-share != "";
    property <length> words-least: root.elsewhere || root.offers-share ? Metrics.call-header-label-min : 0px;
    property <length> view-right: root.shows-chat-button ? chat-button.x - Space.sm : row.width;
    property <length> chip-room: root.compact-self ? Metrics.call-self-chip + Space.sm : 0px;
    property <bool> return-fits: root.view-right - Size.md - Space.sm - gallery-button.preferred-width
        - root.chip-room - Space.md - root.lead
        >= root.words-least;
    property <length> return-room: !root.offers-return ? 0px
        : (root.return-fits ? gallery-button.preferred-width : Size.md) + Space.sm;
    property <bool> view-fits: root.view-right - view-button.preferred-width - root.return-room
        - root.chip-room - Space.md - root.lead
        >= root.words-least;
    property <bool> return-worded;
    property <bool> view-worded;
    property <length> view-x: root.view-right - (root.view-worded ? view-button.preferred-width : Size.md);
    property <length> return-x: root.return-worded ? gallery-button.x : gallery-icon.x;
    property <length> buttons-x: root.compact-self ? self-chip.x
        : root.offers-return ? root.return-x
        : root.view-x;
    property <string> view-now: CallViewWords.now(CallPanel.mode);
    property <int> band-takes-focus: CallPanel.band-takes-focus;
    property <int> gallery-takes-focus: CallPanel.gallery-takes-focus;
    property <length> name-room: max(0px, root.buttons-x - Space.md - root.lead);
    property <length> name-width: !root.elsewhere ? 0px
        : root.offers-share ? min(room-name.preferred-width, root.name-room / 2)
        : min(room-name.preferred-width, root.name-room);
    property <length> rest-x: root.lead + (root.elsewhere ? root.name-width + Space.sm : 0px);
    property <length> rest-width: max(0px, root.buttons-x - Space.md - root.rest-x);

    public function focus-menu() {
        if root.view-worded {
            view-button.take-focus();
        } else {
            view-icon.take-focus();
        }
    }

    public function focus-chat() {
        if root.covers-chat {
            chat-button.take-focus();
        } else {
            root.focus-menu();
        }
    }

    function follow-cover() {
        if root.shows-chat-button && !root.covers-chat && root.size != CallSize.hidden && chat-button.has-focus {
            root.focus-menu();
        }
        root.shows-chat-button = root.covers-chat;
    }

    function focus-return() {
        if root.return-worded {
            gallery-button.take-focus();
        } else {
            gallery-icon.take-focus();
        }
    }

    function follow-words() {
        let view-focused = view-button.has-focus || view-icon.has-focus;
        let return-focused = gallery-button.has-focus || gallery-icon.has-focus;
        root.view-worded = root.view-fits;
        root.return-worded = root.return-fits;
        if view-focused {
            root.focus-menu();
        }
        if return-focused {
            root.focus-return();
        }
    }

    function open-menu(by-keys: bool) {
        CallPanel.menu-by-keys = by-keys;
        CallPanel.menu-open = true;
    }

    init => {
        root.view-worded = root.view-fits;
        root.return-worded = root.return-fits;
        root.follow-cover();
    }

    changed covers-chat => {
        root.follow-cover();
    }

    changed view-fits => {
        root.follow-words();
    }

    changed return-fits => {
        root.follow-words();
    }

    changed band-takes-focus => {
        root.focus-chat();
    }

    changed gallery-takes-focus => {
        if root.offers-return {
            root.focus-return();
        }
    }

    function take-return(by-keys: bool) {
        if root.pinned {
            if by-keys {
                root.focus-menu();
            }
            Actions.unpin-call-tile();
        } else if root.follows-back {
            if by-keys {
                root.focus-menu();
            }
            Actions.follow-speaker({ on: true });
        } else {
            CallPanel.focus-tile = by-keys ? CallView.stage[0].key : "";
            Actions.show-call-gallery();
        }
    }

    background: root.lead-inset > 0 ? transparent : AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    if root.lead-inset > 0: Rectangle {
        x: root.lead-inset;
        width: parent.width - self.x;
        height: root.top-row;
        background: AppStyle.call-band;
    }

    if root.lead-inset > 0: Rectangle {
        y: root.top-row;
        height: parent.height - self.y;
        background: AppStyle.call-band;
    }

    VerticalLayout {
        padding: Space.md;
        padding-top: root.top-row > 0 ? (root.top-row - Size.md) / 2 : Space.md;
        spacing: Space.sm;

        row := Rectangle {
            height: Size.md;

            chat-button := AppButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.shows-chat-button;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: IconSet.MessageSquare;
                text: @tr("Chat");
                label: @tr("Show the chat");
                description: @tr("Shortcut: {}", CallKeys.binding(CallKey.chat));
                clicked => {
                    CallPanel.show-chat();
                }
            }

            view-button := AppButton {
                x: root.view-x;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.view-worded;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: IconSet.PanelsTopLeft;
                text: @tr("View");
                description: root.view-now;
                clicked => {
                    root.open-menu(self.has-focus);
                }
            }

            view-icon := IconButton {
                x: root.view-x;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: !root.view-worded;
                icon: IconSet.PanelsTopLeft;
                label: @tr("View");
                description: root.view-now;
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    root.open-menu(self.has-focus);
                }
            }

            gallery-button := AppButton {
                x: root.view-x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.offers-return && root.return-worded;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: root.return-icon;
                text: root.return-text;
                label: root.return-label;
                description: root.pinned ? CallWords.pinned(root.staged-title)
                    : root.staged ? CallWords.in-focus(root.staged-title)
                    : "";
                clicked => {
                    root.take-return(self.has-focus);
                }
            }

            gallery-icon := IconButton {
                x: root.view-x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: root.offers-return && !root.return-worded;
                icon: root.return-icon;
                label: root.return-label;
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    root.take-return(self.has-focus);
                }
            }

            self-chip := SelfChip {
                x: (root.offers-return ? root.return-x : root.view-x) - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.compact-self;
                tile: CallView.compact-self[0];
            }

            room-name := Text {
                x: root.lead;
                width: root.name-width;
                height: parent.height;
                visible: root.elsewhere;
                text: @tr("Call in {}", CallView.active-room-name);
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-strong;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.offers-share: ShareOffer {
                x: root.rest-x;
                width: root.rest-width;
                name: CallView.offered-share;
                view => {
                    Actions.view-call-share();
                }
            }
        }

        CallStage {
            vertical-stretch: 1;
            preferred-height: 0;
            fits-videos: CallPanel.fits-videos;
            hides-strip: CallPanel.hides-strip;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        visible: root.size == CallSize.stage && !root.beside-chat;
        background: AppStyle.border;
    }
}
