import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { ClickArea } from "../../../../components/a11y.slint";
import { AppButton, IconButton, LinkButton } from "../../../../components/button.slint";
import { StateLayer } from "../../../../components/state-layer.slint";
import { Actions } from "../../../../actions.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPanel, CallSize, TipScope } from "../../../../local.slint";
import { CallView, DirectoryView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallKey, CallKeys } from "./call-controls.slint";
import { CallStage } from "./call-stage.slint";

component ShareOffer inherits HorizontalLayout {
    in property <string> name;

    callback view();

    spacing: Space.sm;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: CallWords.sharing(root.name);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-strong;
        vertical-alignment: center;
        overflow: elide;
    }

    LinkButton {
        min-height: Size.sm;
        text: @tr("View");
        label: CallWords.view-share(root.name);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            root.view();
        }
    }
}

component CallRoomLink inherits ClickArea {
    out property <length> text-width: caption.preferred-width + 2 * Space.sm;

    ring-radius: Radius.sm;
    label: CallWords.open-call-chat(CallView.active-room-name);

    StateLayer {
        border-radius: Radius.sm;
        ink: Palette.accent-background;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    caption := Text {
        x: Space.sm;
        width: parent.width - 2 * Space.sm;
        text: CallView.active-room-name;
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: Palette.accent-background;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CallBand inherits Rectangle {
    in property <CallSize> size;
    in property <bool> beside-chat;

    callback chat-opened();

    out property <length> menu-x: menu-button.absolute-position.x;
    out property <length> menu-y: menu-button.absolute-position.y;
    out property <length> menu-size: menu-button.height;

    property <bool> covers-chat: root.size == CallSize.full;
    property <bool> shows-chat-button;
    property <bool> elsewhere: CallView.active-room-id != DirectoryView.selected-room-id;
    property <string> people: CallWords.people(CallView.people-first, CallView.people-second, CallView.people-more);
    property <int> band-takes-focus: CallPanel.band-takes-focus;
    property <length> name-room: max(0px, menu-button.x - Space.md);
    property <length> name-width: min(root.elsewhere ? room-link.text-width : room-name.preferred-width, root.name-room / 2);
    property <length> rest-x: root.name-width + Space.sm;
    property <length> rest-width: max(0px, menu-button.x - Space.md - root.rest-x);

    public function focus-menu() {
        menu-button.take-focus();
    }


    public function focus-chat() {
        if root.covers-chat {
            chat-button.take-focus();
        } else {
            menu-button.take-focus();
        }
    }

    function follow-cover() {
        if root.shows-chat-button && !root.covers-chat && root.size != CallSize.hidden && chat-button.has-focus {
            menu-button.take-focus();
        }
        root.shows-chat-button = root.covers-chat;
    }

    function open-chat(by-keys: bool) {
        Actions.select-room(CallView.active-room-id);
        if !root.covers-chat {
            root.chat-opened();
        } else if by-keys {
            chat-button.take-focus();
        }
    }

    init => {
        root.follow-cover();
    }

    changed covers-chat => {
        root.follow-cover();
    }

    changed band-takes-focus => {
        root.focus-chat();
    }

    background: AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        Rectangle {
            height: Size.md;

            chat-button := AppButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.shows-chat-button;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: IconSet.MessageSquare;
                text: @tr("Chat");
                label: @tr("Show the chat");
                description: @tr("Shortcut: {}", CallKeys.binding(CallKey.chat));
                clicked => {
                    CallPanel.show-chat();
                }
            }

            menu-button := IconButton {
                x: (root.shows-chat-button ? chat-button.x - Space.sm : parent.width) - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                icon: IconSet.LayoutDashboard;
                label: @tr("Call layout");
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    CallPanel.menu-by-keys = self.has-focus;
                    CallPanel.menu-open = true;
                }
            }

            room-link := CallRoomLink {
                x: 0;
                width: root.name-width;
                height: parent.height;
                visible: root.elsewhere;
                clicked => {
                    root.open-chat(self.has-focus);
                }
            }

            room-name := Text {
                x: 0;
                width: root.name-width;
                height: parent.height;
                visible: !root.elsewhere;
                text: CallView.active-room-name;
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-strong;
                vertical-alignment: center;
                overflow: elide;
            }

            if CallView.offered-share != "": ShareOffer {
                x: root.rest-x;
                width: root.rest-width;
                name: CallView.offered-share;
                view => {
                    Actions.view-call-share();
                }
            }

            if CallView.offered-share == "": Text {
                x: root.rest-x;
                width: root.rest-width;
                text: root.people == "" ? "" : @tr("· {}", root.people);
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        CallStage {
            vertical-stretch: 1;
            preferred-height: 0;
            fits-videos: CallPanel.fits-videos;
            hides-strip: CallPanel.hides-strip;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        visible: root.size == CallSize.stage && !root.beside-chat;
        background: AppStyle.border;
    }
}
