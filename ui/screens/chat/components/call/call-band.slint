import { IconDisplay, IconSet } from "@lucide";

import { IconButton, LinkButton } from "../../../../components/button.slint";
import { Actions } from "../../../../actions.slint";
import { CallNotice, CallScreen } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPanel, CallSize } from "../../../../local.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallCameraButton, CallLeaveButton, CallMicButton, CallShareButton } from "./call-controls.slint";
import { CallStage } from "./call-stage.slint";
import { CallStatus } from "./call-status.slint";

component SharingLine inherits HorizontalLayout {
    spacing: Space.md;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: @tr("You are sharing your screen");
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-strong;
        vertical-alignment: center;
        overflow: elide;
    }

    LinkButton {
        min-height: Size.sm;
        text: CallWords.stop-sharing(CallScreen.on);
        label: CallWords.share(CallScreen.on, CallView.screen-refusal);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            Actions.share-screen({ on: false });
        }
    }
}

export component CallBand inherits Rectangle {
    in property <CallSize> size;
    in property <bool> stage-fits;

    out property <length> natural-height: layout.preferred-height;
    out property <length> menu-x: menu-button.absolute-position.x;
    out property <length> menu-y: menu-button.absolute-position.y;
    out property <length> menu-size: menu-button.height;

    property <bool> compact: root.size == CallSize.compact;
    property <bool> forced-full: root.size == CallSize.full && CallPanel.chosen == CallSize.stage;
    property <bool> offers-chat: !root.compact && !root.forced-full;
    property <bool> explains-share;
    property <bool> tells-share-ended;
    property <int> ended-share-serial: CallView.ended-share-serial;
    property <bool> has-status: CallView.notice != CallNotice.none
        || (root.explains-share && CallView.screen == CallScreen.unavailable)
        || (root.tells-share-ended && !root.compact);
    property <string> people: CallWords.people(CallView.people-first, CallView.people-second, CallView.people-more);
    property <string> phase: CallWords.phase(CallView.phase, CallView.elapsed);
    property <bool> stage-shows-share: CallView.stage.length > 0 && CallView.stage[0].screen;
    property <string> share-to-view: root.compact && root.stage-shows-share
        ? CallView.stage[0].name
        : CallView.offered-share;

    public function focus-menu() {
        menu-button.take-focus();
    }

    function view-share() {
        if !root.compact || !root.stage-shows-share {
            Actions.view-call-share();
        }
        if root.compact {
            CallPanel.chosen = CallSize.stage;
        }
    }

    changed ended-share-serial => {
        if root.ended-share-serial != 0 {
            root.tells-share-ended = true;
            ended-timer.running = false;
            ended-timer.running = true;
        }
    }

    ended-timer := Timer {
        interval: Motion.notice-hold;
        running: false;
        triggered => {
            root.tells-share-ended = false;
            self.running = false;
        }
    }

    background: AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    layout := VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        Rectangle {
            height: Size.md;

            chat-toggle := IconButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: root.offers-chat;
                icon: root.size == CallSize.full ? IconSet.Minimize2 : IconSet.Maximize2;
                label: root.size == CallSize.full ? @tr("Show the chat") : @tr("Hide the chat");
                clicked => {
                    CallPanel.chosen = root.size == CallSize.full
                        ? (root.stage-fits ? CallSize.stage : CallSize.compact)
                        : CallSize.full;
                }
            }

            size-toggle := IconButton {
                x: (root.offers-chat ? chat-toggle.x - Space.sm : parent.width) - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                icon: root.compact ? IconSet.ChevronDown
                    : root.forced-full ? IconSet.Minimize2
                    : IconSet.ChevronUp;
                label: root.compact ? @tr("Expand the call")
                    : root.forced-full ? @tr("Show the chat")
                    : @tr("Collapse the call");
                clicked => {
                    CallPanel.chosen = root.compact ? CallSize.stage : CallSize.compact;
                }
            }

            menu-button := IconButton {
                x: size-toggle.x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: !root.compact;
                icon: IconSet.LayoutDashboard;
                label: @tr("Call layout");
                clicked => {
                    CallPanel.menu-open = true;
                }
            }

            view-share := LinkButton {
                x: (root.compact ? size-toggle.x : menu-button.x) - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                height: Size.sm;
                visible: root.share-to-view != "";
                text: CallWords.view-share(root.share-to-view);
                label: self.text;
                font-size: Fonts.body-small;
                pad: 2 * Space.sm;
                clicked => {
                    root.view-share();
                }
            }

            HorizontalLayout {
                x: 0;
                width: (view-share.visible ? view-share.x : root.compact ? size-toggle.x : menu-button.x) - Space.sm;
                spacing: Space.sm;

                if CallView.active-encrypted: IconDisplay {
                    cross-axis-self-alignment: center;
                    icon: IconSet.Lock;
                    size: IconSize.xs;
                    stroke: AppStyle.foreground-muted;
                    accessible-role: image;
                    accessible-label: @tr("The call is end-to-end encrypted");
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.people == "" ? root.phase : @tr("{} · {}", root.phase, root.people);
                    font-family: Fonts.emoji;
                    font-size: Fonts.body-small;
                    font-weight: Weight.semibold;
                    color: AppStyle.foreground-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-live-region: AccessibleLiveness.polite;
                }
            }
        }

        if CallView.screen == CallScreen.on: SharingLine { }

        if !root.compact: CallStage {
            vertical-stretch: 1;
            preferred-height: 0;
            fits-videos: CallPanel.fits-videos;
            hides-strip: CallPanel.hides-strip;
        }

        HorizontalLayout {
            alignment: center;
            spacing: Space.lg;

            CallMicButton { }

            CallCameraButton { }

            CallShareButton {
                explain => {
                    root.explains-share = !root.explains-share;
                }
            }

            CallLeaveButton { }
        }

        if root.has-status: CallStatus {
            explains-share: root.explains-share && CallView.screen == CallScreen.unavailable;
            tells-share-ended: root.tells-share-ended && !root.compact;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        background: AppStyle.border;
    }
}
