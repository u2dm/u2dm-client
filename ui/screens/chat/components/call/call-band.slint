import { Palette } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { ClickArea } from "../../../../components/a11y.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { AppButton, IconButton, LinkButton } from "../../../../components/button.slint";
import { StateLayer } from "../../../../components/state-layer.slint";
import { TipSource } from "../../../../components/tip.slint";
import { Actions } from "../../../../actions.slint";
import { CallStates } from "../../../../call-states.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPanel, CallSize, TipScope } from "../../../../local.slint";
import { CallTileEntry } from "../../../../types.slint";
import { CallView, DirectoryView } from "../../../../views.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallKey, CallKeys } from "./call-controls.slint";
import { CallStage } from "./call-stage.slint";

component ShareOffer inherits HorizontalLayout {
    in property <string> name;

    callback view();

    spacing: Space.sm;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: CallWords.sharing(root.name);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-strong;
        vertical-alignment: center;
        overflow: elide;
    }

    LinkButton {
        min-height: Size.sm;
        text: @tr("View");
        label: CallWords.view-share(root.name);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            root.view();
        }
    }
}

component SelfChip inherits Rectangle {
    in property <CallTileEntry> tile;

    property <string> words: CallWords.self-chip(root.tile.muted, root.tile.speaking);

    width: Metrics.call-self-chip;
    height: self.width;
    accessible-role: image;
    accessible-label: root.words;

    touch := TouchArea { }

    Avatar {
        width: root.width;
        height: root.height;
        color-index: root.tile.color-index;
        has-image: root.tile.has-avatar;
        image: root.tile.avatar;
        initial: root.tile.initial;
        initial-size: Glyph.xs;
        opacity: CallStates.flows(root.tile.state) ? 1 : 0.5;
        accessible-role: none;
    }

    Rectangle {
        border-radius: root.width / 2;
        border-width: root.tile.speaking ? Metrics.call-speaking-ring : 0;
        border-color: AppStyle.call-speaking;
    }

    if root.tile.muted: Rectangle {
        x: root.width - self.width + Space.xs;
        y: root.height - self.height + Space.xs;
        width: Metrics.call-badge;
        height: self.width;
        border-radius: self.width / 2;
        background: AppStyle.call-band;

        IconDisplay {
            icon: IconSet.MicOff;
            size: IconSize.xs;
            stroke: AppStyle.foreground-strong;
            accessible-role: none;
        }
    }

    TipSource {
        width: root.width;
        height: root.height;
        text: root.words;
        hovered: touch.has-hover;
        pressed: touch.pressed;
        below: true;
        scope: TipScope.call;
    }
}

component CallRoomLink inherits ClickArea {
    out property <length> text-width: caption.preferred-width + 2 * Space.sm;

    ring-radius: Radius.sm;
    label: CallWords.open-call-chat(CallView.active-room-name);

    StateLayer {
        border-radius: Radius.sm;
        ink: Palette.accent-background;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    caption := Text {
        x: Space.sm;
        width: parent.width - 2 * Space.sm;
        text: @tr("Call in {}", CallView.active-room-name);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: Palette.accent-background;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CallBand inherits Rectangle {
    in property <CallSize> size;
    in property <bool> beside-chat;
    in property <length> top-row;
    in property <length> lead-inset;

    callback chat-opened();

    out property <length> menu-x: menu-button.absolute-position.x;
    out property <length> menu-y: menu-button.absolute-position.y;
    out property <length> menu-size: menu-button.height;

    property <bool> covers-chat: root.size == CallSize.full;
    property <bool> shows-chat-button;
    property <bool> staged: CallView.stage.length > 0;
    property <string> staged-title: CallWords.tile-title(CallView.stage[0]);
    property <bool> follows-back: CallView.follows-speaker && CallView.view-chosen;
    property <bool> pinned: CallView.stage-chosen && root.staged;
    property <Icon> return-icon: root.pinned ? IconSet.PinOff : root.follows-back ? IconSet.AudioLines : IconSet.LayoutGrid;
    property <string> return-text: root.pinned ? @tr("Unpin") : root.follows-back ? @tr("Follow speaker") : @tr("Gallery");
    property <string> return-label: root.pinned ? CallWords.unpin(root.staged-title)
        : root.follows-back ? CallWords.follow-speaker()
        : CallWords.show-gallery();
    property <bool> offers-return: root.staged || root.follows-back;
    property <bool> compact-self: CallView.compact-self.length > 0;
    property <length> lead: max(0px, root.lead-inset - Space.md);
    property <bool> return-worded: menu-button.x - Space.sm - gallery-button.preferred-width
        - (root.compact-self ? Metrics.call-self-chip + Space.sm : 0px) - Space.md - root.lead
        >= Metrics.call-header-label-min;
    property <length> return-x: root.return-worded ? gallery-button.x : gallery-icon.x;
    property <length> buttons-x: root.compact-self ? self-chip.x
        : root.offers-return ? root.return-x
        : menu-button.x;
    property <bool> elsewhere: CallView.active-room-id != DirectoryView.selected-room-id;
    property <string> people: CallWords.people(CallView.people-first, CallView.people-second, CallView.people-more);
    property <int> band-takes-focus: CallPanel.band-takes-focus;
    property <int> gallery-takes-focus: CallPanel.gallery-takes-focus;
    property <length> name-room: max(0px, root.buttons-x - Space.md - root.lead);
    property <length> name-width: root.elsewhere && CallView.offered-share == "" ? min(room-link.text-width, root.name-room)
        : min(root.elsewhere ? room-link.text-width : room-name.preferred-width, root.name-room / 2);
    property <length> rest-x: root.lead + root.name-width + Space.sm;
    property <length> rest-width: max(0px, root.buttons-x - Space.md - root.rest-x);

    public function focus-menu() {
        menu-button.take-focus();
    }


    public function focus-chat() {
        if root.covers-chat {
            chat-button.take-focus();
        } else {
            menu-button.take-focus();
        }
    }

    function follow-cover() {
        if root.shows-chat-button && !root.covers-chat && root.size != CallSize.hidden && chat-button.has-focus {
            menu-button.take-focus();
        }
        root.shows-chat-button = root.covers-chat;
    }

    function open-chat() {
        Actions.select-room(CallView.active-room-id);
        CallPanel.show-chat();
        if !root.covers-chat {
            root.chat-opened();
        }
    }

    init => {
        root.follow-cover();
    }

    changed covers-chat => {
        root.follow-cover();
    }

    changed band-takes-focus => {
        root.focus-chat();
    }

    changed gallery-takes-focus => {
        if root.offers-return && root.return-worded {
            gallery-button.take-focus();
        } else if root.offers-return {
            gallery-icon.take-focus();
        }
    }

    function take-return(by-keys: bool) {
        if root.pinned {
            if by-keys {
                menu-button.take-focus();
            }
            Actions.unpin-call-tile();
        } else if root.follows-back {
            if by-keys {
                menu-button.take-focus();
            }
            Actions.follow-speaker({ on: true });
        } else {
            CallPanel.focus-tile = by-keys ? CallView.stage[0].key : "";
            Actions.show-call-gallery();
        }
    }

    background: root.lead-inset > 0 ? transparent : AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    if root.lead-inset > 0: Rectangle {
        x: root.lead-inset;
        width: parent.width - self.x;
        height: root.top-row;
        background: AppStyle.call-band;
    }

    if root.lead-inset > 0: Rectangle {
        y: root.top-row;
        height: parent.height - self.y;
        background: AppStyle.call-band;
    }

    VerticalLayout {
        padding: Space.md;
        padding-top: root.top-row > 0 ? (root.top-row - Size.md) / 2 : Space.md;
        spacing: Space.sm;

        Rectangle {
            height: Size.md;

            chat-button := AppButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.shows-chat-button;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: IconSet.MessageSquare;
                text: @tr("Chat");
                label: @tr("Show the chat");
                description: @tr("Shortcut: {}", CallKeys.binding(CallKey.chat));
                clicked => {
                    CallPanel.show-chat();
                }
            }

            menu-button := IconButton {
                x: (root.shows-chat-button ? chat-button.x - Space.sm : parent.width) - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                icon: IconSet.LayoutDashboard;
                label: @tr("Call layout");
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    CallPanel.menu-by-keys = self.has-focus;
                    CallPanel.menu-open = true;
                }
            }

            gallery-button := AppButton {
                x: menu-button.x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.md;
                visible: root.offers-return && root.return-worded;
                filled: false;
                tint: AppStyle.foreground-strong;
                icon: root.return-icon;
                text: root.return-text;
                label: root.return-label;
                description: root.pinned ? CallWords.pinned(root.staged-title)
                    : root.staged ? CallWords.in-focus(root.staged-title)
                    : "";
                clicked => {
                    root.take-return(self.has-focus);
                }
            }

            gallery-icon := IconButton {
                x: menu-button.x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: root.offers-return && !root.return-worded;
                icon: root.return-icon;
                label: root.return-label;
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    root.take-return(self.has-focus);
                }
            }

            self-chip := SelfChip {
                x: (root.offers-return ? root.return-x : menu-button.x) - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.compact-self;
                tile: CallView.compact-self[0];
            }

            room-link := CallRoomLink {
                x: root.lead;
                width: root.name-width;
                height: parent.height;
                visible: root.elsewhere;
                clicked => {
                    root.open-chat();
                }
            }

            room-name := Text {
                x: root.lead;
                width: root.name-width;
                height: parent.height;
                visible: !root.elsewhere;
                text: CallView.active-room-name;
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-strong;
                vertical-alignment: center;
                overflow: elide;
            }

            if CallView.offered-share != "": ShareOffer {
                x: root.rest-x;
                width: root.rest-width;
                name: CallView.offered-share;
                view => {
                    Actions.view-call-share();
                }
            }

            if CallView.offered-share == "": Text {
                x: root.rest-x;
                width: root.rest-width;
                visible: !root.elsewhere || self.preferred-width <= root.rest-width;
                text: root.people == "" ? "" : @tr("· {}", root.people);
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        CallStage {
            vertical-stretch: 1;
            preferred-height: 0;
            fits-videos: CallPanel.fits-videos;
            hides-strip: CallPanel.hides-strip;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        visible: root.size == CallSize.stage && !root.beside-chat;
        background: AppStyle.border;
    }
}
