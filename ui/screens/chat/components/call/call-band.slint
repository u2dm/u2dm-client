import { IconDisplay, IconSet } from "@lucide";

import { IconButton, LinkButton } from "../../../../components/button.slint";
import { Actions } from "../../../../actions.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPanel, CallSize, TipScope } from "../../../../local.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallKey, CallKeys } from "./call-controls.slint";
import { CallStage } from "./call-stage.slint";

component ShareOffer inherits HorizontalLayout {
    in property <string> name;

    callback view();

    spacing: Space.sm;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: @tr("{} is sharing their screen", root.name);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-strong;
        vertical-alignment: center;
        overflow: elide;
    }

    LinkButton {
        min-height: Size.sm;
        text: @tr("View");
        label: CallWords.view-share(root.name);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            root.view();
        }
    }
}

export component CallBand inherits Rectangle {
    in property <CallSize> size;
    in property <bool> stage-fits;

    out property <length> menu-x: menu-button.absolute-position.x;
    out property <length> menu-y: menu-button.absolute-position.y;
    out property <length> menu-size: menu-button.height;

    property <bool> forced-full: root.size == CallSize.full && CallPanel.chosen == CallSize.stage;
    property <bool> offers-chat: !root.forced-full;
    property <string> people: CallWords.people(CallView.people-first, CallView.people-second, CallView.people-more);
    property <int> band-takes-focus: CallPanel.band-takes-focus;

    public function focus-menu() {
        menu-button.take-focus();
    }

    public function focus-chat() {
        if root.offers-chat {
            chat-toggle.take-focus();
        } else {
            size-toggle.take-focus();
        }
    }

    changed band-takes-focus => {
        size-toggle.take-focus();
    }

    background: AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        Rectangle {
            height: Size.md;

            chat-toggle := IconButton {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                visible: root.offers-chat;
                icon: root.size == CallSize.full ? IconSet.Minimize2 : IconSet.Maximize2;
                label: root.size == CallSize.full ? @tr("Show the chat") : @tr("Hide the chat");
                tip: self.label;
                tip-keys: root.size == CallSize.full ? CallKeys.binding(CallKey.chat) : "";
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    if root.size == CallSize.full {
                        CallPanel.show-chat(root.stage-fits);
                    } else {
                        CallPanel.chosen = CallSize.full;
                    }
                }
            }

            size-toggle := IconButton {
                x: (root.offers-chat ? chat-toggle.x - Space.sm : parent.width) - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                icon: root.forced-full ? IconSet.Minimize2 : IconSet.PanelTopClose;
                label: root.forced-full ? @tr("Show the chat") : @tr("Hide the call");
                tip: self.label;
                tip-keys: root.forced-full ? CallKeys.binding(CallKey.chat) : "";
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    let by-keys = self.has-focus;
                    if root.forced-full {
                        CallPanel.show-chat(root.stage-fits);
                    } else {
                        CallPanel.chosen = CallSize.hidden;
                        if by-keys {
                            CallPanel.dock-takes-focus += 1;
                        }
                    }
                }
            }

            menu-button := IconButton {
                x: size-toggle.x - Space.sm - self.width;
                y: (parent.height - self.height) / 2;
                size: Size.md;
                icon: IconSet.LayoutDashboard;
                label: @tr("Call layout");
                tip: self.label;
                tip-below: true;
                tip-scope: TipScope.call;
                clicked => {
                    CallPanel.menu-by-keys = self.has-focus;
                    CallPanel.menu-open = true;
                }
            }

            if CallView.offered-share != "": ShareOffer {
                x: 0;
                width: max(0px, menu-button.x - Space.md);
                name: CallView.offered-share;
                view => {
                    Actions.view-call-share();
                }
            }

            if CallView.offered-share == "": Text {
                x: 0;
                width: max(0px, menu-button.x - Space.md);
                text: root.people;
                font-family: Fonts.emoji;
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        CallStage {
            vertical-stretch: 1;
            preferred-height: 0;
            fits-videos: CallPanel.fits-videos;
            hides-strip: CallPanel.hides-strip;
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        background: AppStyle.border;
    }
}
