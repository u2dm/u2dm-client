import { ScrollView } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { RovingKeys } from "../../../../components/a11y.slint";
import { ChoiceRow } from "../../../../components/choice-row.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { CallDeviceKind } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { CallDeviceEntry } from "../../../../types.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Metrics, Space, Stroke, Weight } from "../../../../theme.slint";

component DeviceHeading inherits HorizontalLayout {
    in property <Icon> icon;
    in property <string> text;

    min-height: Metrics.call-devices-heading;
    padding-left: Space.md;
    padding-right: Space.md;
    spacing: Space.md;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: root.icon;
        size: IconSize.sm;
        stroke: AppStyle.foreground-muted;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: Fonts.caption;
        font-weight: Weight.semibold;
        color: AppStyle.foreground-muted;
        vertical-alignment: center;
        overflow: elide;
    }
}

component DeviceChoice inherits ChoiceRow {
    in property <CallDeviceKind> kind;
    in property <CallDeviceEntry> entry;

    callback roved(length, length);

    height: max(root.detail == "" ? Metrics.call-device-row : Metrics.choice-row, self.content-height + Space.md);
    wraps: true;
    text: CallWords.device-name(root.entry.status, root.entry.name);
    detail: CallWords.device-detail(root.entry.status, root.entry.name);
    checked: root.entry.chosen;
    label: CallWords.device-label(root.kind, root.entry.status, root.entry.name);
    focusable: false;
    changed roving-focus => {
        if self.roving-focus {
            root.roved(self.y, self.height);
        }
    }
    clicked => {
        Actions.use-call-device({ kind: root.kind, key: root.entry.key });
    }
}

component MicrophoneMeter inherits HorizontalLayout {
    padding-left: Space.md + IconSize.sm + Space.md;
    padding-right: Space.md;
    padding-bottom: Space.xs;

    Rectangle {
        height: Metrics.call-test-meter-height;
        border-radius: self.height / 2;
        background: AppStyle.control;
        accessible-role: none;

        Rectangle {
            x: 0;
            width: parent.width * clamp(CallView.microphone-level / 100, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: AppStyle.call-live;
        }
    }
}

export component CallDevicesMenu inherits PickerCard {
    in property <length> room;
    in property <bool> above-modal;
    in property <bool> in-call;

    callback details(bool);

    property <int> cursor: -1;
    property <int> microphones: CallView.microphones.length;
    property <int> speakers: CallView.speakers.length;
    property <int> devices: root.microphones + root.speakers + CallView.cameras.length;
    property <int> count: root.devices + (root.in-call ? 1 : 0);
    property <bool> keys-focused: keys.has-focus;
    property <string> details-label: @tr("Connection details…");

    public function open(by-keys: bool) {
        root.open-at(CallDeviceKind.microphone, by-keys);
    }

    public function open-at(kind: CallDeviceKind, by-keys: bool) {
        let first = kind == CallDeviceKind.camera ? root.microphones + root.speakers
            : kind == CallDeviceKind.speaker ? root.microphones
            : 0;
        root.cursor = by-keys && root.count > first ? first : -1;
        keys.focus();
    }

    pure function kind-at(index: int) -> CallDeviceKind {
        if index < root.microphones {
            return CallDeviceKind.microphone;
        }
        if index < root.microphones + root.speakers {
            return CallDeviceKind.speaker;
        }
        return CallDeviceKind.camera;
    }

    pure function entry-at(index: int) -> CallDeviceEntry {
        if index < root.microphones {
            return CallView.microphones[index];
        }
        if index < root.microphones + root.speakers {
            return CallView.speakers[index - root.microphones];
        }
        return CallView.cameras[index - root.microphones - root.speakers];
    }

    pure function spoken-label() -> string {
        if root.cursor < 0 || root.cursor >= root.count {
            return @tr("Devices");
        }
        if root.cursor >= root.devices {
            return root.details-label;
        }
        let entry = root.entry-at(root.cursor);
        return CallWords.device-label(root.kind-at(root.cursor), entry.status, entry.name);
    }

    function choose-at(index: int) {
        if index >= root.devices && index < root.count {
            root.details(true);
        } else if index >= 0 && index < root.devices {
            Actions.use-call-device({ kind: root.kind-at(index), key: root.entry-at(index).key });
        }
    }

    function reveal(top: length, size: length) {
        if top < -scroll.content-y {
            scroll.content-y = -top;
        } else if top + size > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -(top + size - scroll.visible-height);
        }
    }

    width: Metrics.call-devices-width;
    height: min(rows.preferred-height + 2 * Space.sm, root.room);

    TouchArea { }

    keys := RovingKeys {
        count: root.count;
        cursor <=> root.cursor;
        accessible-label: root.spoken-label();
        accessible-checkable: root.cursor >= 0 && root.cursor < root.devices;
        accessible-checked: root.cursor >= 0 && root.cursor < root.devices && root.entry-at(root.cursor).chosen;
        accessible-action-default => {
            root.choose-at(max(root.cursor, 0));
        }
        intercept(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            return reject;
        }
        activated(index) => {
            root.choose-at(index);
        }
    }

    scroll := ScrollView {
        x: 0;
        y: Space.sm;
        width: parent.width;
        height: parent.height - 2 * Space.sm;
        content-width: self.visible-width;
        content-height: rows.preferred-height;

        rows := VerticalLayout {
            width: scroll.visible-width;
            padding-left: Space.sm;
            padding-right: Space.sm;
            spacing: Space.xs;

            DeviceHeading {
                icon: IconSet.Mic;
                text: CallWords.device-kind(CallDeviceKind.microphone);
            }

            if root.in-call && CallView.microphone-metered: MicrophoneMeter { }

            for entry[index] in CallView.microphones: DeviceChoice {
                kind: CallDeviceKind.microphone;
                entry: entry;
                above-modal: root.above-modal;
                roving-focus: root.keys-focused && root.cursor == index;
                roved(top, size) => {
                    root.reveal(top, size);
                }
            }

            DeviceHeading {
                icon: IconSet.Volume2;
                text: CallWords.device-kind(CallDeviceKind.speaker);
            }

            for entry[index] in CallView.speakers: DeviceChoice {
                kind: CallDeviceKind.speaker;
                entry: entry;
                above-modal: root.above-modal;
                roving-focus: root.keys-focused && root.cursor == root.microphones + index;
                roved(top, size) => {
                    root.reveal(top, size);
                }
            }

            DeviceHeading {
                icon: IconSet.Video;
                text: CallWords.device-kind(CallDeviceKind.camera);
            }

            if CallView.cameras.length == 0: Text {
                min-height: Metrics.call-devices-heading;
                text: @tr("No camera was found");
                font-size: Fonts.body-small;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            for entry[index] in CallView.cameras: DeviceChoice {
                kind: CallDeviceKind.camera;
                entry: entry;
                above-modal: root.above-modal;
                roving-focus: root.keys-focused && root.cursor == root.microphones + root.speakers + index;
                roved(top, size) => {
                    root.reveal(top, size);
                }
            }

            if root.in-call: Rectangle {
                height: Space.md;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: Stroke.hairline;
                    background: AppStyle.border;
                }
            }

            if root.in-call: MenuRow {
                height: Metrics.call-device-row;
                icon: IconSet.Activity;
                label: root.details-label;
                focusable: false;
                above-modal: root.above-modal;
                roving-focus: root.keys-focused && root.cursor == root.devices;
                changed roving-focus => {
                    if self.roving-focus {
                        root.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.details(false);
                }
            }
        }
    }
}
