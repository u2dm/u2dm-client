import { IconDisplay, IconSet } from "@lucide";

import { AppButton, IconButton } from "../../../../components/button.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { StateLayer } from "../../../../components/state-layer.slint";
import { CallNotice, CallPhase, CallScreen } from "../../../../enums.slint";
import { CallWords, UserMessages } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { CallMenuOpener, CallMode, CallPanel, Shell, TipScope } from "../../../../local.slint";
import { CallView, DirectoryView, SpaceIndexView, WindowView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { CallCameraButton, CallHandButton, CallKey, CallLeaveButton, CallMicButton, CallMoreButton, CallReactButton, CallShareButton } from "./call-controls.slint";
import { CallStatus, ShareStatus } from "./call-status.slint";
import { UnreadDot } from "../unread-dot.slint";

component LineTarget inherits ClickArea {
    in property <string> text;
    in property <color> tint;
    in property <int> weight: Weight.regular;
    in property <bool> alert;
    in property <bool> mention;
    in property <bool> hint;
    out property <length> text-width: words.preferred-width + 2 * Space.xs + root.mark-room;

    property <bool> marked: root.alert || root.mention || root.hint;
    property <length> mark-room: root.marked ? mark.width + Space.sm : 0px;

    ring-radius: Radius.sm;

    StateLayer {
        border-radius: Radius.sm;
        ink: root.tint;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    words := Text {
        x: Space.xs;
        width: max(0px, parent.width - 2 * Space.xs - root.mark-room);
        text: root.text;
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: root.weight;
        color: root.tint;
        vertical-alignment: center;
        overflow: elide;
    }

    mark := UnreadDot {
        x: words.x + min(words.preferred-width, words.width) + Space.sm;
        y: (parent.height - self.height) / 2;
        visible: root.marked;
        alert: root.alert;
        mention: root.mention;
        accessible-role: none;
    }
}

component CallLine inherits Rectangle {
    in property <bool> above-modal;
    in property <bool> tells-news;

    callback open-chat();
    callback open-people(bool);
    callback change-share(bool);

    out property <length> people-left: people.absolute-position.x;
    out property <length> people-right: people.absolute-position.x + people.width;
    out property <length> people-top: people.absolute-position.y;
    out property <length> people-bottom: people.absolute-position.y + people.height;
    in property <bool> share-apart;
    out property <length> least-alone: root.lead + root.room-least + (root.clock ? 0px : root.phase-room) + root.gap + root.people-tail;
    out property <length> whole-alone: root.lead + room.text-width + root.phase-room + root.gap + root.people-tail;
    out property <length> share-width: root.gap + sharing.preferred-width + root.gap + change.text-width - Space.xs;

    property <bool> shows-sharing: CallView.screen == CallScreen.on && !root.share-apart;
    property <string> sharing-words: @tr("Sharing your screen");
    property <string> bridges: CallWords.bridges(CallView.bridges-first, CallView.bridges-second, CallView.bridges-more);
    property <bool> clock: CallView.phase == CallPhase.live;
    property <length> gap: Space.sm;
    property <length> lead: Space.sm + IconSize.sm + Space.md + (CallView.active-encrypted ? IconSize.xs + Space.md : 0px);
    property <length> phase-room: root.gap + phase.preferred-width;
    property <length> people-tail: dot.preferred-width + root.gap + people.text-width + Space.sm;
    property <length> tail: root.people-tail + (root.shows-sharing ? root.share-width : 0px);
    property <length> room-least: min(room.text-width, Metrics.call-dock-room-min);
    property <bool> keeps-phase: !root.clock
        || root.width >= root.lead + root.room-least + root.phase-room + root.gap + root.tail;
    property <length> phase-width: root.keeps-phase
        ? clamp(root.width - root.lead - root.room-least - root.gap - root.gap - root.tail, 0px, phase.preferred-width)
        : 0px;
    property <length> room-width: clamp(
        root.width - root.lead - (root.keeps-phase ? root.gap + root.phase-width : 0px) - root.gap - root.tail,
        0px,
        room.text-width);

    public function focus-room() {
        room.take-focus();
    }

    public function focus-people() {
        people.take-focus();
    }

    IconDisplay {
        x: Space.sm;
        icon: CallView.active-video ? IconSet.Video : IconSet.Phone;
        size: IconSize.sm;
        stroke: AppStyle.call-live;
        accessible-role: none;
    }

    if CallView.active-encrypted: IconDisplay {
        x: Space.sm + IconSize.sm + Space.md;
        icon: root.bridges == "" ? IconSet.Lock : IconSet.ShieldAlert;
        size: IconSize.xs;
        stroke: AppStyle.foreground-muted;
        accessible-role: image;
        accessible-label: CallWords.encryption(root.bridges);
    }

    room := LineTarget {
        x: root.lead - Space.xs;
        width: root.room-width;
        height: root.height;
        above-modal: root.above-modal;
        text: CallView.active-room-name;
        tint: AppStyle.call-live;
        weight: Weight.semibold;
        alert: root.tells-news && CallView.active-room-alert;
        mention: root.tells-news && CallView.active-room-mention;
        hint: root.tells-news && CallView.active-room-hint;
        label: CallWords.open-call-chat(CallView.active-room-name);
        accessible-description: root.tells-news
            ? CallWords.room-news(CallView.active-room-alert, CallView.active-room-mention, CallView.active-room-hint)
            : "";
        clicked => {
            root.open-chat();
        }
    }

    phase := Text {
        x: room.x + room.width - Space.xs + root.gap;
        width: root.phase-width;
        visible: root.keeps-phase;
        text: @tr("· {}", CallWords.phase(CallView.phase, CallView.elapsed));
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    dot := Text {
        x: (root.keeps-phase ? phase.x + phase.width : room.x + room.width - Space.xs) + root.gap;
        width: self.preferred-width;
        text: "·";
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        vertical-alignment: center;
        accessible-role: none;
    }

    people := LineTarget {
        x: dot.x + dot.width + root.gap - Space.xs;
        width: self.text-width;
        height: root.height;
        above-modal: root.above-modal;
        text: CallWords.people-count(CallView.people.length);
        tint: AppStyle.foreground-muted;
        label: CallWords.in-call(CallView.people.length);
        accessible-description: @tr("Shows who is in the call");
        clicked => {
            root.open-people(self.has-focus);
        }
    }

    sharing := Text {
        x: people.x + people.width - Space.xs + root.gap;
        width: self.preferred-width;
        visible: root.shows-sharing;
        text: @tr("· {}", root.sharing-words);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: AppStyle.call-sharing;
        vertical-alignment: center;
    }

    change := LineTarget {
        x: sharing.x + sharing.width + root.gap - Space.xs;
        width: root.shows-sharing ? self.text-width : 0;
        height: root.height;
        visible: root.shows-sharing;
        above-modal: root.above-modal;
        text: @tr("Change…");
        tint: AppStyle.call-sharing;
        label: @tr("Change shared screen…");
        clicked => {
            root.change-share(self.has-focus);
        }
    }
}

component FailedCallLabel inherits Rectangle {
    out property <length> label-width: row.preferred-width;
    out property <string> text: UserMessages.text(CallView.failure, CallView.failure-detail);

    row := HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.md;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.CircleAlert;
            size: IconSize.sm;
            stroke: AppStyle.danger-muted;
        }

        Text {
            text: root.text;
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            font-weight: Weight.semibold;
            color: AppStyle.danger-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component CallDock inherits Rectangle {
    in property <bool> above-modal;
    in property <bool> stage-shown;
    in property <bool> chat-shown;

    callback returned();

    out property <length> devices-x: root.devices-shown ? devices.absolute-position.x : more.absolute-position.x;
    out property <length> devices-y: root.devices-shown ? devices.absolute-position.y : more.absolute-position.y;
    out property <length> devices-size: devices.height;
    out property <length> react-x: root.react-shown ? react.absolute-position.x : more.absolute-position.x;
    out property <length> react-y: root.react-shown ? react.absolute-position.y : more.absolute-position.y;
    out property <length> react-size: react.height;
    out property <length> more-x: more.absolute-position.x;
    out property <length> more-y: more.absolute-position.y;
    out property <length> more-size: more.height;

    property <length> pad: Space.md;
    property <length> gap: Space.md;
    property <bool> failed: !CallView.active && CallView.failed;
    property <bool> offers-stage: CallView.active && (!root.stage-shown || WindowView.call-windowed) && !root.failed;
    property <bool> explains-share;
    property <bool> tells-share-ended;
    property <bool> tells-change-cancelled;
    property <bool> tells-device-news;
    property <int> ended-share-serial: CallView.ended-share-serial;
    property <int> change-cancelled: CallView.share-change-cancelled;
    property <int> share-takes-focus: CallPanel.share-takes-focus;
    property <int> device-news-serial: CallView.device-news-serial;
    property <int> dock-takes-focus: CallPanel.dock-takes-focus;
    property <int> people-returns: CallPanel.people-returns;
    property <bool> status-taken: !root.failed
        && (CallView.notice != CallNotice.none
            || (root.explains-share && share.refused)
            || root.tells-device-news
            || root.tells-change-cancelled
            || (root.tells-share-ended && root.stage-shown));
    property <bool> shares-unseen: !root.failed && CallView.share-count > 0 && !root.stage-shown;
    property <bool> tells-shares: root.shares-unseen && !root.status-taken;
    property <bool> offers-share: root.shares-unseen && root.status-taken;
    property <bool> offers-button: root.offers-stage || root.offers-share;
    property <bool> shows-shares;
    property <bool> shows-button;
    property <bool> button-views;
    property <length> status-extra: root.status-taken ? status.preferred-height + root.gap
        : root.tells-shares ? shares.preferred-height + root.gap
        : 0px;
    property <length> show-width: root.offers-button ? show-call.preferred-width + root.gap : 0px;
    property <length> extra-width: Metrics.call-control + root.gap;
    property <length> base-controls: 4 * (Metrics.call-control + root.gap) + leave.preferred-width;
    property <length> controls-least: root.failed
        ? (CallView.failure-retry ? retry.preferred-width + root.gap : 0px) + dismiss.width
        : root.base-controls;
    property <length> beside-controls: 2 * root.pad + root.line-least + root.show-width + root.gap;
    property <length> extra-room: root.failed ? 0px
        : root.stacked ? root.width - 2 * root.pad - root.base-controls
        : root.width - root.beside-controls - root.base-controls;
    property <length> line-whole: line.whole-alone + (root.sharing && !root.share-apart ? line.share-width : 0px);
    property <length> spare-room: root.failed ? 0px
        : root.stacked ? root.extra-room
        : root.width - 2 * root.pad - root.line-whole - root.show-width - root.gap - root.base-controls;
    property <bool> react-fits: root.extra-room >= root.extra-width;
    property <bool> hand-fits: root.extra-room >= 2 * root.extra-width;
    property <bool> devices-fits: root.spare-room >= 3 * root.extra-width;
    property <bool> react-shown;
    property <bool> hand-shown;
    property <bool> devices-shown;
    property <int> extras: (root.react-shown ? 1 : 0) + (root.hand-shown ? 1 : 0) + (root.devices-shown ? 1 : 0);
    property <length> controls-width: root.failed ? root.controls-least
        : root.base-controls + root.extras * root.extra-width;
    property <bool> sharing: !root.failed && CallView.screen == CallScreen.on;
    property <length> line-with-share: line.least-alone + (root.sharing ? line.share-width : 0px);
    property <bool> share-apart: root.sharing && root.width - 2 * root.pad - root.show-width < root.line-with-share;
    property <length> share-extra: root.share-apart ? Size.sm + root.gap : 0px;
    property <length> line-least: root.failed ? min(failure.label-width, Metrics.call-dock-label-min)
        : root.share-apart ? line.least-alone
        : root.line-with-share;
    property <bool> stacked: root.width < root.beside-controls + root.controls-least;
    property <length> row-height: root.stacked ? Metrics.call-dock-stacked : Metrics.call-dock;
    property <bool> status-taken-with-stage: !root.failed
        && (CallView.notice != CallNotice.none
            || (root.explains-share && share.refused)
            || root.tells-device-news
            || root.tells-change-cancelled
            || root.tells-share-ended);
    property <bool> share-apart-with-stage: root.sharing && root.width - 2 * root.pad < root.line-with-share;
    property <length> line-least-with-stage: root.failed ? root.line-least
        : root.share-apart-with-stage ? line.least-alone
        : root.line-with-share;
    property <bool> stacked-with-stage: root.width < 2 * root.pad + root.line-least-with-stage + root.gap + root.controls-least;
    out property <length> height-with-stage: (root.status-taken-with-stage ? status.preferred-height + root.gap : 0px)
        + (root.share-apart-with-stage ? Size.sm + root.gap : 0px)
        + (root.stacked-with-stage ? Metrics.call-dock-stacked : Metrics.call-dock);
    property <length> label-span: max(0px, root.stacked
        ? root.width - 2 * root.pad - root.show-width
        : root.width - 2 * root.pad - root.show-width - root.gap - root.controls-width);
    property <length> label-y: root.status-extra + root.share-extra + root.pad;
    property <length> label-height: root.stacked ? Size.md : Metrics.call-control;
    property <length> controls-y: root.height - root.pad - Metrics.call-control;

    public function focus-devices-opener(opener: CallMenuOpener) {
        if opener == CallMenuOpener.status && status.offers-details {
            status.focus-details();
        } else if opener == CallMenuOpener.control && root.devices-shown {
            devices.take-focus();
        } else {
            more.take-focus();
        }
    }

    public function focus-react-opener() {
        if CallPanel.reactions-opener == CallMenuOpener.control && root.react-shown {
            react.take-focus();
        } else {
            more.take-focus();
        }
    }

    public function focus-more() {
        more.take-focus();
    }

    public pure function focuses(key: CallKey) -> bool {
        return (key == CallKey.microphone && mic.has-focus) || (key == CallKey.camera && camera.has-focus);
    }

    function focus-line() {
        line.focus-room();
    }

    function focus-control-for(notice: CallNotice) {
        if notice == CallNotice.microphone-failed {
            mic.take-focus();
        } else if notice == CallNotice.camera-failed {
            camera.take-focus();
        } else if notice == CallNotice.screen-failed || notice == CallNotice.choosing-screen {
            share.take-focus();
        }
    }

    function uncover-call() {
        Shell.nav-open = false;
        if SpaceIndexView.visible {
            Actions.close-space-index();
        }
        if DirectoryView.selected-room-id == "" {
            Actions.select-room(CallView.active-room-id);
        }
    }

    function show-stage(by-keys: bool) {
        if WindowView.call-windowed {
            Actions.show-call-window();
            return;
        }
        root.uncover-call();
        CallPanel.show-call();
        if by-keys {
            CallPanel.band-takes-focus += 1;
        }
    }

    public function choose-mode(mode: CallMode) {
        if mode != CallMode.chat-only {
            root.uncover-call();
        }
        CallPanel.choose(mode);
        more.take-focus();
    }

    function view-shares(by-keys: bool) {
        if !(CallView.stage.length > 0 && CallView.stage[0].screen) {
            Actions.view-call-share();
        }
        root.show-stage(by-keys);
    }

    public function change-share(by-keys: bool) {
        if by-keys {
            CallPanel.share-takes-focus += 1;
        }
        Actions.change-screen-share();
    }

    public function open-call-chat() {
        if CallPanel.own-window {
            Actions.show-call-chat();
            return;
        }
        Shell.nav-open = false;
        if CallView.active-room-id != DirectoryView.selected-room-id {
            Actions.select-room(CallView.active-room-id);
        } else if SpaceIndexView.visible {
            Actions.close-space-index();
        }
        CallPanel.show-chat();
        root.returned();
    }

    changed dock-takes-focus => {
        show-call.take-focus();
    }

    function follow-shares() {
        let moving = !root.failed && !root.stage-shown;
        let line-view-goes = moving && root.shows-shares && !root.tells-shares && shares.view-focused;
        let button-view-goes = moving && root.button-views && !root.offers-share && show-call.has-focus;
        let button-goes = !root.failed && root.shows-button && !root.offers-button && show-call.has-focus;
        root.shows-shares = root.shows-shares || root.tells-shares;
        root.shows-button = root.shows-button || root.offers-button;
        root.button-views = root.offers-share;
        if line-view-goes {
            if root.offers-share {
                show-call.take-focus();
            } else {
                root.focus-line();
            }
        } else if button-view-goes {
            if root.tells-shares {
                shares.focus-view();
            } else if !root.offers-stage {
                root.focus-line();
            }
        } else if button-goes {
            root.focus-line();
        }
        root.shows-shares = root.tells-shares;
        root.shows-button = root.offers-button;
    }

    function follow-extras() {
        if !root.failed
            && ((root.react-shown && !root.react-fits && react.has-focus)
                || (root.hand-shown && !root.hand-fits && hand.has-focus)
                || (root.devices-shown && !root.devices-fits && devices.has-focus)) {
            more.take-focus();
        }
        root.react-shown = root.react-fits;
        root.hand-shown = root.hand-fits;
        root.devices-shown = root.devices-fits;
    }

    init => {
        root.follow-shares();
        root.follow-extras();
    }

    changed react-fits => {
        root.follow-extras();
    }

    changed hand-fits => {
        root.follow-extras();
    }

    changed devices-fits => {
        root.follow-extras();
    }

    changed tells-shares => {
        root.follow-shares();
    }

    changed offers-share => {
        root.follow-shares();
    }

    changed offers-button => {
        root.follow-shares();
    }

    changed people-returns => {
        line.focus-people();
    }

    changed ended-share-serial => {
        if root.ended-share-serial != 0 {
            root.tells-share-ended = true;
            ended-timer.running = false;
            ended-timer.running = true;
        }
    }

    ended-timer := Timer {
        interval: Motion.notice-hold;
        running: false;
        triggered => {
            root.tells-share-ended = false;
            self.running = false;
        }
    }

    changed change-cancelled => {
        if root.change-cancelled != 0 {
            root.tells-change-cancelled = true;
            cancelled-timer.running = false;
            cancelled-timer.running = true;
        }
    }

    cancelled-timer := Timer {
        interval: Motion.notice-hold;
        running: false;
        triggered => {
            root.tells-change-cancelled = false;
            self.running = false;
        }
    }

    changed share-takes-focus => {
        share.take-focus();
    }

    changed device-news-serial => {
        if root.device-news-serial != 0 {
            root.tells-device-news = true;
            news-timer.running = false;
            news-timer.running = true;
        }
    }

    news-timer := Timer {
        interval: Motion.notice-hold;
        running: false;
        triggered => {
            root.tells-device-news = false;
            self.running = false;
        }
    }

    height: root.status-extra + root.share-extra + root.row-height;
    background: root.failed ? AppStyle.danger-background : AppStyle.call-band;
    accessible-role: groupbox;
    accessible-label: root.failed ? failure.text : @tr("Call in {}", CallView.active-room-name);

    status := CallStatus {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: self.preferred-height;
        visible: root.status-taken;
        above-modal: root.above-modal;
        explains-share: root.explains-share && share.refused;
        tells-change-cancelled: root.tells-change-cancelled;
        tells-device-news: root.tells-device-news;
        tells-share-ended: root.tells-share-ended && root.stage-shown;
        acted-by-keys(notice) => {
            root.focus-control-for(notice);
        }
    }

    shares := ShareStatus {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: self.preferred-height;
        visible: root.shows-shares;
        above-modal: root.above-modal;
        view(by-keys) => {
            root.view-shares(by-keys);
        }
    }

    share-row := HorizontalLayout {
        x: root.pad;
        y: root.status-extra + root.pad;
        width: root.width - 2 * root.pad;
        height: Size.sm;
        visible: root.share-apart;
        padding-left: Space.sm;
        spacing: Space.md;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.ScreenShare;
            size: IconSize.sm;
            stroke: AppStyle.call-sharing;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 1;
            text: @tr("Sharing your screen");
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            font-weight: Weight.semibold;
            color: AppStyle.call-sharing;
            vertical-alignment: center;
            overflow: elide;
        }

        row-change := LineTarget {
            width: self.text-width;
            above-modal: root.above-modal;
            text: @tr("Change…");
            tint: AppStyle.call-sharing;
            label: @tr("Change shared screen…");
            clicked => {
                root.change-share(self.has-focus);
            }
        }
    }

    line := CallLine {
        x: root.pad;
        y: root.label-y;
        width: root.label-span;
        height: root.label-height;
        visible: !root.failed;
        above-modal: root.above-modal;
        tells-news: !root.chat-shown;
        share-apart: root.share-apart;
        open-chat => {
            root.open-call-chat();
        }
        open-people(by-keys) => {
            CallPanel.open-people(by-keys, self.people-left, self.people-right, self.people-top, self.people-bottom);
        }
        change-share(by-keys) => {
            root.change-share(by-keys);
        }
    }

    failure := FailedCallLabel {
        x: root.pad;
        y: root.label-y;
        width: root.label-span;
        height: root.label-height;
        visible: root.failed;
    }

    show-call := AppButton {
        x: root.pad + root.label-span + root.gap;
        y: root.label-y + (root.label-height - self.height) / 2;
        width: self.preferred-width;
        height: Metrics.call-control;
        visible: root.shows-button;
        above-modal: root.above-modal;
        filled: false;
        tint: AppStyle.foreground-strong;
        icon: root.offers-share ? IconSet.MonitorPlay
            : CallView.active-video ? IconSet.Video
            : IconSet.Phone;
        text: root.offers-share ? @tr("View") : @tr("Call");
        label: root.offers-share
            ? CallWords.view-shares(CallView.first-sharer, CallView.share-count)
            : WindowView.call-windowed ? @tr("Show the call window")
            : @tr("Show the call");
        clicked => {
            if root.offers-share {
                root.view-shares(self.has-focus);
            } else {
                root.show-stage(self.has-focus);
            }
        }
    }

    mic := CallMicButton {
        x: camera.x - root.gap - self.width;
        y: root.controls-y;
        visible: !root.failed;
        above-modal: root.above-modal;
    }

    camera := CallCameraButton {
        x: share.x - root.gap - self.width;
        y: root.controls-y;
        visible: !root.failed;
        above-modal: root.above-modal;
    }

    share := CallShareButton {
        x: (root.react-shown ? react.x : more.x) - root.gap - self.width;
        y: root.controls-y;
        visible: !root.failed;
        above-modal: root.above-modal;
        explain => {
            root.explains-share = !root.explains-share;
        }
    }

    react := CallReactButton {
        x: (root.hand-shown ? hand.x : more.x) - root.gap - self.width;
        y: root.controls-y;
        visible: root.react-shown;
        above-modal: root.above-modal;
    }

    hand := CallHandButton {
        x: (root.devices-shown ? devices.x : more.x) - root.gap - self.width;
        y: root.controls-y;
        visible: root.hand-shown;
        above-modal: root.above-modal;
    }

    devices := IconButton {
        x: more.x - root.gap - self.width;
        y: root.controls-y;
        size: Metrics.call-control;
        visible: root.devices-shown;
        above-modal: root.above-modal;
        fill: AppStyle.control;
        tint: AppStyle.foreground-strong;
        icon: IconSet.Settings;
        label: @tr("Choose your microphone, speaker and camera");
        tip: self.label;
        tip-scope: TipScope.call;
        clicked => {
            CallPanel.open-devices(self.has-focus, CallMenuOpener.control);
        }
    }

    more := CallMoreButton {
        x: leave.x - root.gap - self.width;
        y: root.controls-y;
        visible: !root.failed;
        above-modal: root.above-modal;
    }

    leave := CallLeaveButton {
        x: root.width - root.pad - self.width;
        y: root.controls-y;
        width: self.preferred-width;
        visible: !root.failed;
        above-modal: root.above-modal;
    }

    retry := AppButton {
        x: dismiss.x - root.gap - self.width;
        y: root.controls-y;
        width: self.preferred-width;
        height: Metrics.call-control;
        visible: root.failed && CallView.failure-retry;
        above-modal: root.above-modal;
        text: @tr("Try again");
        icon: IconSet.RotateCw;
        tint: AppStyle.call-accept;
        clicked => {
            Actions.retry-failed-call();
        }
    }

    dismiss := IconButton {
        x: root.width - root.pad - self.width;
        y: root.controls-y;
        size: Metrics.call-control;
        visible: root.failed;
        above-modal: root.above-modal;
        icon: IconSet.X;
        tint: AppStyle.foreground-strong;
        label: @tr("Dismiss");
        tip: self.label;
        tip-scope: TipScope.call;
        clicked => {
            Actions.dismiss-failed-call();
        }
    }

    Rectangle {
        y: 0;
        height: Stroke.hairline;
        background: AppStyle.border;
    }
}
