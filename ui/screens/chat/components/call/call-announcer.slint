import { Announcer } from "../../../../components/a11y.slint";
import { CallCamera, CallDeviceTrouble, CallMic, CallNotice, CallPhase } from "../../../../enums.slint";
import { CallWords, UserMessages } from "../../../../messages.slint";
import { CallView } from "../../../../views.slint";
import { CallKey, CallKeys } from "./call-controls.slint";

export component CallAnnouncer {
    property <bool> active: CallView.active;
    property <CallPhase> phase: CallView.phase;
    property <CallNotice> notice: CallView.notice;
    property <bool> failed: CallView.failed;
    property <int> ring: CallView.ring-visible ? CallView.ring-serial : 0;
    property <int> device-news: CallView.device-news-serial;
    property <int> started-share: CallView.started-share-serial;
    property <int> ended-share: CallView.ended-share-serial;
    property <CallMic> mic: CallView.mic;
    property <CallCamera> camera: CallView.camera;
    property <bool> mic-keyed;
    property <bool> mic-wanted;
    property <bool> camera-keyed;
    property <bool> camera-wanted;

    public function expect(key: CallKey) {
        if key == CallKey.microphone {
            root.mic-keyed = true;
            root.mic-wanted = CallKeys.turns-on(key);
        } else if key == CallKey.camera {
            root.camera-keyed = true;
            root.camera-wanted = CallKeys.turns-on(key);
        }
    }

    width: 0;
    height: 0;

    pure function troubles(notice: CallNotice) -> bool {
        return notice == CallNotice.not-called
            || notice == CallNotice.not-announced
            || notice == CallNotice.microphone-failed
            || notice == CallNotice.camera-failed
            || notice == CallNotice.screen-failed;
    }

    function say-phase() {
        if root.active {
            calm.say(CallWords.phase-said(root.phase));
        }
    }

    changed active => {
        root.mic-keyed = false;
        root.camera-keyed = false;
        root.say-phase();
    }

    changed mic => {
        if !root.mic-keyed || root.mic == CallMic.starting {
            return;
        }
        root.mic-keyed = false;
        if root.mic != CallMic.failed && (root.mic == CallMic.on) == root.mic-wanted {
            calm.say(CallWords.microphone-state(root.mic));
        }
    }

    changed camera => {
        if !root.camera-keyed || root.camera == CallCamera.starting {
            return;
        }
        root.camera-keyed = false;
        if root.camera != CallCamera.failed && (root.camera == CallCamera.on) == root.camera-wanted {
            calm.say(CallWords.camera-state(root.camera));
        }
    }

    changed phase => {
        root.say-phase();
    }

    changed notice => {
        if !root.active || root.notice == CallNotice.none {
            return;
        }
        let words = CallWords.notice(root.notice, CallView.active-room-name, CallView.notice-name, CallView.notice-others);
        if root.troubles(root.notice) {
            urgent.say(words);
        } else {
            calm.say(words);
        }
    }

    changed failed => {
        if root.failed {
            urgent.say(UserMessages.text(CallView.failure, CallView.failure-detail));
        }
    }

    changed ring => {
        if root.ring == 0 {
            return;
        }
        let words = CallWords.ring-said(CallView.ring-video, CallView.ring-direct, CallView.ring-caller, CallView.ring-room-name);
        if CallView.ring-quiet {
            calm.say(words);
        } else {
            urgent.say(words);
        }
    }

    changed device-news => {
        if root.device-news == 0 || !root.active {
            return;
        }
        let words = CallWords.device-news(CallView.device-news-trouble, CallView.device-news-kind, CallView.device-news-name);
        if CallView.device-news-trouble == CallDeviceTrouble.disconnected {
            calm.say(words);
        } else {
            urgent.say(words);
        }
    }

    changed started-share => {
        if root.started-share != 0 && root.active {
            calm.say(CallWords.sharing(CallView.started-share));
        }
    }

    changed ended-share => {
        if root.ended-share != 0 && root.active {
            calm.say(CallWords.share-ended(CallView.ended-share));
        }
    }

    calm := Announcer { }

    urgent := Announcer {
        urgent: true;
    }
}
