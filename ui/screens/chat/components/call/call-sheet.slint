import { Palette, ScrollView } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { AppButton, LinkButton } from "../../../../components/button.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { DialogCard, ModalHost, Placement } from "../../../../components/overlay.slint";
import { StateLayer } from "../../../../components/state-layer.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Size, Space, Weight } from "../../../../theme.slint";
import { CallDeviceKind, CallDeviceStatus, CallOffer, CallSheetPreview, CallTestPhase } from "../../../../enums.slint";
import { CallDeviceEntry } from "../../../../types.slint";
import { CallDevicesMenu } from "./call-devices-menu.slint";
import { CallView, DirectoryView, SpaceIndexView } from "../../../../views.slint";
import { CallWords } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { CallPanel, MetaTip, Reactions, Shell } from "../../../../local.slint";
import { DialogNote } from "../verification.slint";

component BridgeNote inherits HorizontalLayout {
    in property <string> text;

    alignment: center;
    spacing: Space.sm;

    IconDisplay {
        cross-axis-self-alignment: start;
        icon: IconSet.ShieldAlert;
        size: IconSize.sm;
        stroke: AppStyle.foreground-muted;
        accessible-role: none;
    }

    DialogNote {
        horizontal-stretch: 1;
        text: root.text;
        horizontal-alignment: left;
    }
}

component MediaChoiceRow inherits HorizontalLayout {
    in property <Icon> on-icon;
    in property <Icon> off-icon;
    in property <string> label;
    in property <string> text;
    in property <string> detail;
    in property <CallDeviceKind> kind;
    in property <int> index;
    in property <bool> lists-devices;
    in-out property <bool> on;

    out property <bool> has-focus: choice.has-focus || change.has-focus;
    out property <length> change-x: change.absolute-position.x;
    out property <length> change-y: change.absolute-position.y;
    out property <length> change-width: change.width;
    out property <length> change-height: change.height;

    callback change(bool);

    property <CallDeviceEntry> entry: root.kind == CallDeviceKind.camera ? CallView.cameras[root.index]
        : CallView.microphones[root.index];
    property <string> device: !root.lists-devices ? ""
        : root.index >= 0 ? CallWords.device-chosen(root.entry.status, root.entry.name)
        : root.kind == CallDeviceKind.camera ? @tr("No camera was found")
        : "";

    public function take-focus() {
        choice.take-focus();
    }

    public function focus-change() {
        change.take-focus();
    }

    spacing: Space.sm;

    choice := ClickArea {
        horizontal-stretch: 1;
        height: Metrics.choice-row;
        border-radius: Radius.md;
        ring-radius: Radius.md;
        above-modal: true;
        label: root.label;
        accessible-role: switch;
        accessible-checkable: true;
        accessible-checked: root.on;
        accessible-description: root.device == "" ? root.detail : @tr("{}. {}", root.detail, root.device);
        clicked => {
            root.on = !root.on;
        }

        StateLayer {
            border-radius: parent.border-radius;
            hovered: parent.has-hover && parent.enabled;
            pressed: parent.pressed && parent.enabled;
        }

        HorizontalLayout {
            padding-left: Space.md;
            padding-right: Space.md;
            spacing: Space.lg;

            Rectangle {
                cross-axis-self-alignment: center;
                width: Metrics.call-control;
                height: Metrics.call-control;
                border-radius: self.width / 2;
                background: AppStyle.control;

                IconDisplay {
                    icon: root.on ? root.on-icon : root.off-icon;
                    size: IconSize.md;
                    stroke: AppStyle.foreground-strong;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Space.xs;

                Text {
                    text: root.text;
                    font-size: Fonts.label;
                    font-weight: Weight.semibold;
                    overflow: elide;
                    accessible-role: none;
                }

                Text {
                    text: root.device == "" ? root.detail : root.device;
                    font-family: Fonts.emoji;
                    font-size: Fonts.body-small;
                    color: AppStyle.foreground-muted;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }
    }

    change := LinkButton {
        width: root.lists-devices ? self.preferred-width : 0;
        cross-axis-self-alignment: center;
        min-height: Size.sm;
        visible: root.lists-devices;
        above-modal: true;
        text: @tr("Change");
        label: CallWords.device-change(root.kind);
        accessible-description: root.device;
        pad: 2 * Space.sm;
        clicked => {
            root.change(self.has-focus);
        }
    }
}

component DeviceLine inherits Rectangle {
    in property <CallDeviceKind> kind;
    in property <int> index;
    in property <length> inset: Space.md + Metrics.call-control + Space.lg;

    out property <length> change-x: change.absolute-position.x;
    out property <length> change-y: change.absolute-position.y;
    out property <length> change-width: change.width;
    out property <length> change-height: change.height;

    callback change(bool);

    property <CallDeviceEntry> entry: root.kind == CallDeviceKind.camera ? CallView.cameras[root.index]
        : root.kind == CallDeviceKind.speaker ? CallView.speakers[root.index]
        : CallView.microphones[root.index];
    property <string> shown: root.index >= 0 ? CallWords.device-chosen(root.entry.status, root.entry.name)
        : root.kind == CallDeviceKind.camera ? @tr("No camera was found")
        : "";

    public function focus-change() {
        change.take-focus();
    }

    HorizontalLayout {
        padding-left: root.inset;
        padding-right: Space.md;
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: root.shown;
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            vertical-alignment: center;
            overflow: elide;
        }

        change := LinkButton {
            min-height: Size.sm;
            above-modal: true;
            text: @tr("Change");
            label: CallWords.device-change(root.kind);
            accessible-description: root.shown;
            pad: 2 * Space.sm;
            clicked => {
                root.change(self.has-focus);
            }
        }
    }
}

component DeviceTestLine inherits VerticalLayout {
    in property <CallDeviceKind> kind;

    property <bool> mine: CallView.sheet-test-kind == root.kind && CallView.sheet-test-phase != CallTestPhase.none;
    property <CallTestPhase> phase: root.mine ? CallView.sheet-test-phase : CallTestPhase.none;
    property <bool> testing: root.phase == CallTestPhase.starting || root.phase == CallTestPhase.running;
    property <bool> metered: root.kind == CallDeviceKind.microphone && root.phase == CallTestPhase.running;

    padding-left: Space.md + Metrics.call-control + Space.lg;
    padding-right: Space.md;
    spacing: Space.xs;

    HorizontalLayout {
        min-height: Size.sm;
        spacing: Space.md;

        Text {
            horizontal-stretch: 1;
            text: CallWords.test-status(root.kind, root.phase);
            font-size: Fonts.body-small;
            color: root.phase == CallTestPhase.failed || root.phase == CallTestPhase.lost ? AppStyle.danger-muted : AppStyle.foreground-muted;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-live-region: AccessibleLiveness.polite;
        }

        LinkButton {
            min-height: Size.sm;
            above-modal: true;
            text: CallWords.test-action(root.kind, root.testing);
            label: CallWords.test-action-label(root.kind, root.testing);
            pad: 2 * Space.sm;
            clicked => {
                Actions.test-call-device({ kind: root.kind, on: !root.testing });
            }
        }
    }

    if root.metered: Rectangle {
        height: Metrics.call-test-meter-height;
        border-radius: self.height / 2;
        background: AppStyle.control;
        accessible-role: none;

        Rectangle {
            x: 0;
            width: parent.width * clamp(CallView.sheet-test-level / 100, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: AppStyle.call-live;
        }
    }
}

component SpeakerLine inherits Rectangle {
    out property <length> change-x: line.change-x;
    out property <length> change-y: line.change-y;
    out property <length> change-width: line.change-width;
    out property <length> change-height: line.change-height;

    callback change(bool);

    public function focus-change() {
        line.focus-change();
    }

    height: Metrics.choice-row;

    HorizontalLayout {
        padding-left: Space.md;
        spacing: Space.lg;

        Rectangle {
            width: Metrics.call-control;

            IconDisplay {
                icon: IconSet.Volume2;
                size: IconSize.md;
                stroke: AppStyle.foreground-muted;
                accessible-role: none;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: CallWords.device-kind(CallDeviceKind.speaker);
                font-size: Fonts.label;
                font-weight: Weight.semibold;
                overflow: elide;
            }

            line := DeviceLine {
                height: Size.sm;
                kind: CallDeviceKind.speaker;
                index: CallView.speaker-chosen;
                inset: 0;
                change(by-keys) => {
                    root.change(by-keys);
                }
            }
        }
    }
}

component DeviceChecks inherits VerticalLayout {
    in property <int> serial;
    in property <bool> tests;

    out property <length> change-x: speaker-line.change-x;
    out property <length> change-y: speaker-line.change-y;
    out property <length> change-width: speaker-line.change-width;
    out property <length> change-height: speaker-line.change-height;

    callback change-speaker(bool);
    callback unfolded();

    property <bool> open;
    property <CallDeviceEntry> speaker: CallView.speakers[CallView.speaker-chosen];
    property <bool> speaker-trouble: CallView.speaker-chosen >= 0
        && (root.speaker.status == CallDeviceStatus.missing || root.speaker.status == CallDeviceStatus.failed);
    property <bool> shown: root.open || root.speaker-trouble;
    property <bool> testing: CallView.sheet-test-phase == CallTestPhase.starting
        || CallView.sheet-test-phase == CallTestPhase.running;

    public function focus-change() {
        speaker-line.focus-change();
    }

    changed serial => {
        root.open = false;
    }

    function toggle() {
        if root.shown && root.testing {
            Actions.test-call-device({ kind: CallView.sheet-test-kind, on: false });
        }
        root.open = !root.shown;
        if root.open {
            root.unfolded();
        }
    }

    spacing: Space.xs;

    ClickArea {
        height: Size.lg;
        border-radius: Radius.md;
        ring-radius: Radius.md;
        enabled: !root.speaker-trouble;
        above-modal: true;
        label: @tr("Check devices");
        accessible-expandable: true;
        accessible-expanded: root.shown;
        clicked => {
            root.toggle();
        }

        StateLayer {
            border-radius: parent.border-radius;
            hovered: parent.has-hover && parent.enabled;
            pressed: parent.pressed && parent.enabled;
        }

        HorizontalLayout {
            padding-left: Space.md;
            padding-right: Space.md;
            spacing: Space.md;

            IconDisplay {
                cross-axis-self-alignment: center;
                icon: root.shown ? IconSet.ChevronDown : IconSet.ChevronRight;
                size: IconSize.sm;
                stroke: AppStyle.foreground-muted;
                accessible-role: none;
            }

            Text {
                horizontal-stretch: 1;
                text: @tr("Check devices");
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }

    VerticalLayout {
        height: root.shown ? self.preferred-height : 0;
        visible: root.shown;
        spacing: Space.xs;

        speaker-line := SpeakerLine {
            change(by-keys) => {
                root.change-speaker(by-keys);
            }
        }

        DeviceTestLine {
            height: root.tests ? self.preferred-height : 0;
            visible: root.tests;
            kind: CallDeviceKind.microphone;
        }

        DeviceTestLine {
            height: root.tests ? self.preferred-height : 0;
            visible: root.tests;
            kind: CallDeviceKind.speaker;
        }
    }
}

component CameraPreview inherits Rectangle {
    out property <length> change-x: change.absolute-position.x;
    out property <length> change-y: change.absolute-position.y;
    out property <length> change-width: change.width;
    out property <length> change-height: change.height;
    out property <bool> boxed: root.state == CallSheetPreview.starting || root.live;

    callback change-camera(bool);
    callback without-camera();
    callback appeared();

    property <CallSheetPreview> state: CallView.sheet-preview;
    property <bool> live: root.state == CallSheetPreview.local || root.state == CallSheetPreview.in-call;
    property <bool> failed: root.state == CallSheetPreview.failed;
    property <bool> pictured: root.live && CallView.sheet-preview-has-frame;
    property <string> feed: CallView.sheet-preview-feed;
    property <string> note: CallWords.preview-note(root.state, CallView.sheet-preview-call);

    public function focus-change() {
        change.take-focus();
    }

    function report() {
        if root.feed != "" {
            Actions.call-preview-seen(
                root.feed,
                round(picture.width / 1phx),
                round(picture.height / 1phx),
                root.live);
        }
    }

    init => {
        root.report();
    }
    changed feed => {
        root.report();
    }
    changed live => {
        root.report();
    }
    changed boxed => {
        if root.boxed {
            root.appeared();
        }
    }

    height: root.state == CallSheetPreview.none ? 0 : layout.preferred-height;
    visible: root.state != CallSheetPreview.none;

    layout := VerticalLayout {
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: Space.sm;

        picture := Rectangle {
            height: root.boxed ? self.width * 9 / 16 : 0;
            visible: root.boxed;
            border-radius: Radius.md;
            background: AppStyle.control;
            clip: true;
            accessible-role: image;
            accessible-label: @tr("Camera preview");

            changed width => {
                root.report();
            }

            if root.pictured: Image {
                width: parent.width;
                height: parent.height;
                source: CallView.sheet-preview-frame;
                image-fit: cover;
                transform-scale-x: -1;
                accessible-role: none;
            }

            if !root.pictured: IconDisplay {
                icon: IconSet.Video;
                size: IconSize.lg;
                stroke: AppStyle.foreground-faint;
                accessible-role: none;
            }
        }

        Text {
            height: root.note != "" && !root.failed ? self.preferred-height : 0;
            visible: root.note != "" && !root.failed;
            text: root.note;
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            height: root.failed ? self.preferred-height : 0;
            visible: root.failed;
            spacing: Space.sm;

            Text {
                text: CallWords.preview-trouble(CallView.sheet-preview-trouble);
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.danger-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
                accessible-live-region: AccessibleLiveness.polite;
            }

            HorizontalLayout {
                alignment: center;
                spacing: Space.lg;

                change := LinkButton {
                    min-height: Size.sm;
                    above-modal: true;
                    text: @tr("Change camera");
                    label: self.text;
                    pad: 2 * Space.sm;
                    clicked => {
                        root.change-camera(self.has-focus);
                    }
                }

                LinkButton {
                    min-height: Size.sm;
                    above-modal: true;
                    text: @tr("Continue without camera");
                    label: self.text;
                    pad: 2 * Space.sm;
                    clicked => {
                        root.without-camera();
                    }
                }
            }
        }
    }
}

export component CallSheet inherits ModalHost {
    property <length> card-width: min(AppStyle.card-width, root.width - AppStyle.card-inset);
    property <length> body-height: body.preferred-height;
    property <length> actions-height: actions.preferred-height;
    property <length> card-height: min(root.body-height + root.actions-height, root.height - AppStyle.card-inset);
    property <int> serial: CallView.sheet-serial;
    property <bool> joining: CallView.sheet-people > 0;
    property <bool> refused: CallView.sheet-offer == CallOffer.refused;
    property <string> remedy: CallWords.refusal-action(CallView.sheet-refusal);
    property <string> bridges: CallWords.bridges(CallView.sheet-bridges-first, CallView.sheet-bridges-second, CallView.sheet-bridges-more);
    property <bool> leaving: CallView.sheet-leaving-id != "";
    property <bool> microphone: CallView.sheet-microphone;
    property <bool> camera: CallView.sheet-camera;
    property <bool> lists-devices: CallView.microphones.length > 0;
    property <bool> offers-tests: CallView.sheet-tests && root.lists-devices;
    property <bool> devices-open;
    property <bool> devices-by-keys;
    property <CallDeviceKind> devices-kind: CallDeviceKind.microphone;
    property <bool> devices-from-preview;
    property <length> anchor-x: root.devices-from-preview ? preview.change-x
        : root.devices-kind == CallDeviceKind.camera ? camera-row.change-x
        : root.devices-kind == CallDeviceKind.speaker ? checks.change-x
        : microphone-row.change-x;
    property <length> anchor-y: root.devices-from-preview ? preview.change-y
        : root.devices-kind == CallDeviceKind.camera ? camera-row.change-y
        : root.devices-kind == CallDeviceKind.speaker ? checks.change-y
        : microphone-row.change-y;
    property <length> anchor-width: root.devices-from-preview ? preview.change-width
        : root.devices-kind == CallDeviceKind.camera ? camera-row.change-width
        : root.devices-kind == CallDeviceKind.speaker ? checks.change-width
        : microphone-row.change-width;
    property <length> anchor-height: root.devices-from-preview ? preview.change-height
        : root.devices-kind == CallDeviceKind.camera ? camera-row.change-height
        : root.devices-kind == CallDeviceKind.speaker ? checks.change-height
        : microphone-row.change-height;
    property <length> devices-room-above: root.anchor-y - Space.xs - Space.md;
    property <length> devices-room-below: root.height - root.anchor-y - root.anchor-height - Space.xs - Space.md;
    property <bool> devices-above: root.devices-room-above > root.devices-room-below;
    property <string> title: CallWords.sheet-title(
        CallView.sheet-direct,
        root.joining,
        CallView.sheet-video,
        CallView.sheet-room-name,
        CallView.sheet-leaving-name);

    dim-opacity: AppStyle.dialog-scrim;
    label: root.title;
    dismissed => {
        if root.devices-open {
            root.close-devices();
        } else {
            CallPanel.dismiss-sheet();
        }
    }
    opened => {
        Reactions.close();
        MetaTip.clear();
        root.focus-first();
    }

    changed serial => {
        root.microphone = CallView.sheet-microphone;
        root.camera = CallView.sheet-camera;
    }

    changed camera => {
        Actions.sheet-camera({ on: root.camera });
    }

    changed refused => {
        if root.refused && (microphone-row.has-focus || camera-row.has-focus) {
            root.focus-first();
        } else if !root.refused && remedy-button.has-focus {
            root.focus-first();
        }
    }

    function open-devices(kind: CallDeviceKind, by-keys: bool, from-preview: bool) {
        root.devices-kind = kind;
        root.devices-by-keys = by-keys;
        root.devices-from-preview = from-preview;
        Actions.refresh-call-devices();
        root.devices-open = true;
    }

    function close-devices() {
        root.devices-open = false;
        if root.devices-from-preview && CallView.sheet-preview == CallSheetPreview.failed {
            preview.focus-change();
        } else if root.devices-kind == CallDeviceKind.camera {
            camera-row.focus-change();
        } else if root.devices-kind == CallDeviceKind.speaker {
            checks.focus-change();
        } else {
            microphone-row.focus-change();
        }
    }

    function reveal(top: length, size: length) {
        if top < -scroll.content-y {
            scroll.content-y = -top;
        } else if top + size > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -(top + size - scroll.visible-height);
        }
    }

    function focus-first() {
        if !root.refused {
            microphone-row.take-focus();
        } else if root.remedy != "" {
            remedy-button.take-focus();
        } else {
            cancel-button.take-focus();
        }
    }

    function confirm() {
        Shell.close-overlays();
        if CallView.sheet-room-id != DirectoryView.selected-room-id {
            Actions.select-room(CallView.sheet-room-id);
        } else if SpaceIndexView.visible {
            Actions.close-space-index();
        }
        if CallView.sheet-offer == CallOffer.join {
            Actions.join-call({
                room-id: CallView.sheet-room-id,
                microphone: root.microphone,
                camera: root.camera,
                leaving: CallView.sheet-leaving-id,
            });
        } else {
            Actions.start-call({
                room-id: CallView.sheet-room-id,
                video: CallView.sheet-video,
                microphone: root.microphone,
                camera: root.camera,
                leaving: CallView.sheet-leaving-id,
            });
        }
    }

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;
        clip: true;

        scroll := ScrollView {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height - root.actions-height;
            content-width: root.card-width;
            content-height: root.body-height;

            body := VerticalLayout {
                width: root.card-width;
                padding-top: Space.xxl;
                padding-left: Space.xxl;
                padding-right: Space.xxl;
                padding-bottom: Space.xl;
                spacing: Space.xl;

                VerticalLayout {
                    spacing: Space.sm;

                    HorizontalLayout {
                        alignment: center;

                        IconDisplay {
                            icon: CallView.sheet-video ? IconSet.Video : IconSet.Phone;
                            size: IconSize.lg;
                            stroke: AppStyle.call-accept;
                        }
                    }

                    Text {
                        text: root.title;
                        font-size: Fonts.title;
                        font-weight: Weight.semibold;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }

                    if root.joining && !root.refused: DialogNote {
                        text: CallWords.in-call-named(
                            CallView.sheet-people-first,
                            CallView.sheet-people-second,
                            CallView.sheet-people-more,
                            CallView.sheet-people);
                    }

                    if root.joining && !root.refused && root.bridges != "": BridgeNote {
                        text: root.bridges;
                    }
                }

                VerticalLayout {
                    VerticalLayout {
                        height: root.refused ? 0 : self.preferred-height;
                        visible: !root.refused;
                        spacing: Space.xs;

                        microphone-row := MediaChoiceRow {
                            label: @tr("Microphone");
                            on-icon: IconSet.Mic;
                            off-icon: IconSet.MicOff;
                            text: CallWords.microphone-choice(self.on);
                            detail: CallWords.microphone-effect(self.on);
                            kind: CallDeviceKind.microphone;
                            index: CallView.microphone-chosen;
                            lists-devices: root.lists-devices;
                            on <=> root.microphone;
                            change(by-keys) => {
                                root.open-devices(CallDeviceKind.microphone, by-keys, false);
                            }
                        }

                        camera-row := MediaChoiceRow {
                            label: @tr("Camera");
                            on-icon: IconSet.Video;
                            off-icon: IconSet.VideoOff;
                            text: CallWords.camera-choice(self.on);
                            detail: CallWords.camera-effect(self.on);
                            kind: CallDeviceKind.camera;
                            index: CallView.camera-chosen;
                            lists-devices: root.lists-devices;
                            on <=> root.camera;
                            change(by-keys) => {
                                root.open-devices(CallDeviceKind.camera, by-keys, false);
                            }
                        }

                        preview := CameraPreview {
                            change-camera(by-keys) => {
                                root.open-devices(CallDeviceKind.camera, by-keys, true);
                            }
                            without-camera => {
                                camera-row.take-focus();
                                root.camera = false;
                            }
                            appeared => {
                                root.reveal(self.absolute-position.y - body.absolute-position.y, self.height);
                            }
                        }

                        checks := DeviceChecks {
                            height: root.lists-devices ? self.preferred-height : 0;
                            visible: root.lists-devices;
                            serial: root.serial;
                            tests: root.offers-tests;
                            change-speaker(by-keys) => {
                                root.open-devices(CallDeviceKind.speaker, by-keys, false);
                            }
                            unfolded => {
                                root.reveal(self.absolute-position.y - body.absolute-position.y, min(self.height, scroll.visible-height));
                            }
                        }
                    }

                    VerticalLayout {
                        height: root.refused ? self.preferred-height : 0;
                        visible: root.refused;

                        Text {
                            text: CallWords.refusal(CallView.sheet-refusal);
                            font-size: Fonts.body-small;
                            font-weight: Weight.semibold;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            color: AppStyle.danger-muted;
                            accessible-live-region: AccessibleLiveness.assertive;
                        }

                        HorizontalLayout {
                            height: root.remedy != "" ? self.preferred-height : 0;
                            visible: root.remedy != "";
                            padding-top: Space.xl;
                            alignment: center;

                            remedy-button := LinkButton {
                                min-height: Size.sm;
                                above-modal: true;
                                text: root.remedy;
                                label: root.remedy;
                                pad: 2 * Space.sm;
                                clicked => {
                                    Actions.close-call-sheet();
                                    Actions.open-encryption();
                                }
                            }
                        }
                    }
                }

                if CallView.sheet-ended && !root.refused: DialogNote {
                    text: @tr("The call ended before you joined it");
                    accessible-live-region: AccessibleLiveness.polite;
                }
            }
        }

        actions := HorizontalLayout {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: root.actions-height;
            padding-left: Space.xxl;
            padding-right: Space.xxl;
            padding-bottom: Space.xxl;
            spacing: Space.lg;

            cancel-button := AppButton {
                horizontal-stretch: 1;
                above-modal: true;
                text: @tr("Cancel");
                filled: false;
                clicked => {
                    CallPanel.dismiss-sheet();
                }
            }

            AppButton {
                horizontal-stretch: 1;
                above-modal: true;
                enabled: !root.refused;
                text: CallWords.sheet-action(root.joining, root.leaving);
                icon: CallView.sheet-video ? IconSet.Video : IconSet.Phone;
                tint: AppStyle.call-accept;
                clicked => {
                    root.confirm();
                }
            }
        }
    }

    if root.devices-open: ModalHost {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        dim: false;
        label: @tr("Devices");
        dismissed => {
            root.close-devices();
        }
        opened => {
            sheet-devices.open-at(root.devices-kind, root.devices-by-keys);
        }

        sheet-devices := CallDevicesMenu {
            x: Placement.fit(root.anchor-x + root.anchor-width - self.width, self.width, root.width, Space.md);
            y: root.devices-above
                ? root.anchor-y - Space.xs - self.height
                : root.anchor-y + root.anchor-height + Space.xs;
            room: root.devices-above ? root.devices-room-above : root.devices-room-below;
            above-modal: true;
        }
    }
}
