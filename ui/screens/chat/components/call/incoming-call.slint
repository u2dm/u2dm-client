import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { AppButton, IconButton, LinkButton } from "../../../../components/button.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Size, Space, Weight } from "../../../../theme.slint";
import { CallView } from "../../../../views.slint";
import { CallWords } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { Shell, TipScope } from "../../../../local.slint";

export component IncomingCallCard inherits PickerCard {
    in property <length> available-width;

    property <int> serial: CallView.ring-serial;
    property <bool> confirming: false;
    property <bool> with-camera: false;
    property <bool> asks-to-leave: root.confirming && CallView.active;
    property <string> remedy: CallWords.refusal-action(CallView.ring-refusal);

    width: min(Metrics.incoming-call-width, root.available-width - 2 * Metrics.incoming-call-inset);
    height: card-layout.preferred-height;
    accessible-role: groupbox;
    accessible-label: CallWords.incoming(CallView.ring-video);

    changed serial => {
        root.confirming = false;
        root.with-camera = false;
    }

    function answer(camera: bool) {
        if CallView.active {
            root.with-camera = camera;
            root.confirming = true;
            return;
        }
        root.accept(camera);
    }

    function accept(camera: bool) {
        Shell.close-overlays();
        Actions.select-room(CallView.ring-room-id);
        Actions.answer-call({
            room-id: CallView.ring-room-id,
            camera: camera,
            leaving: CallView.active ? CallView.active-room-id : "",
        });
    }

    TouchArea { }

    card-layout := VerticalLayout {
        padding: Space.xl;
        spacing: Space.xl;

        HorizontalLayout {
            spacing: Space.lg;

            Avatar {
                cross-axis-self-alignment: center;
                width: Metrics.incoming-call-avatar;
                height: Metrics.incoming-call-avatar;
                color-index: CallView.ring-color-index;
                has-image: CallView.ring-has-avatar;
                image: CallView.ring-avatar;
                initial: CallView.ring-initial;
                initial-size: Glyph.lg;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Space.xs;

                Text {
                    text: CallView.ring-caller;
                    font-family: Fonts.emoji;
                    font-size: Fonts.title;
                    font-weight: Weight.bold;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: Space.sm;

                    if !CallView.ring-quiet: IconDisplay {
                        cross-axis-self-alignment: center;
                        icon: CallView.ring-video ? IconSet.Video : IconSet.PhoneIncoming;
                        size: IconSize.xs;
                        stroke: AppStyle.foreground-muted;
                    }

                    if CallView.ring-quiet: IconDisplay {
                        cross-axis-self-alignment: center;
                        icon: IconSet.BellOff;
                        size: IconSize.xs;
                        stroke: AppStyle.foreground-muted;
                        accessible-role: image;
                        accessible-label: @tr("The room is muted, so the call rings without sound");
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: CallView.ring-direct
                            ? CallWords.incoming(CallView.ring-video)
                            : @tr("{} in {}", CallWords.incoming(CallView.ring-video), CallView.ring-room-name);
                        font-family: Fonts.emoji;
                        font-size: Fonts.body-small;
                        color: AppStyle.foreground-muted;
                        overflow: elide;
                    }
                }
            }

            IconButton {
                cross-axis-self-alignment: start;
                icon: IconSet.X;
                size: Size.md;
                above-modal: true;
                label: CallWords.stop-ring(CallView.ring-quiet);
                tip: self.label;
                tip-scope: TipScope.ring;
                clicked => {
                    Actions.silence-ring();
                }
            }
        }

        if !CallView.ring-answerable: HorizontalLayout {
            spacing: Space.md;

            Text {
                horizontal-stretch: 1;
                text: CallWords.refusal(CallView.ring-refusal);
                font-size: Fonts.body-small;
                color: AppStyle.danger-muted;
                vertical-alignment: center;
                wrap: word-wrap;
                accessible-live-region: AccessibleLiveness.polite;
            }

            if root.remedy != "": LinkButton {
                min-height: Size.sm;
                above-modal: true;
                text: root.remedy;
                label: root.remedy;
                pad: 2 * Space.sm;
                clicked => {
                    Actions.open-encryption();
                }
            }
        }

        if root.asks-to-leave: Text {
            text: CallWords.leave-and-answer(CallView.active-room-name, CallView.ring-caller);
            font-family: Fonts.emoji;
            font-size: Fonts.body;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if root.asks-to-leave: HorizontalLayout {
            spacing: Space.md;

            AppButton {
                horizontal-stretch: 1;
                text: @tr("Cancel");
                filled: false;
                above-modal: true;
                clicked => {
                    root.confirming = false;
                }
            }

            AppButton {
                horizontal-stretch: 1;
                text: @tr("Leave and answer");
                icon: root.with-camera ? IconSet.Video : IconSet.Phone;
                tint: AppStyle.call-accept;
                above-modal: true;
                clicked => {
                    root.accept(root.with-camera);
                }
            }
        }

        if !root.asks-to-leave: VerticalLayout {
            spacing: Space.md;

            HorizontalLayout {
                spacing: Space.md;

                AppButton {
                    horizontal-stretch: 1;
                    text: @tr("Decline");
                    icon: IconSet.PhoneOff;
                    tint: AppStyle.call-decline;
                    above-modal: true;
                    clicked => {
                        Actions.decline-call(CallView.ring-room-id);
                    }
                }

                IconButton {
                    cross-axis-self-alignment: center;
                    icon: IconSet.MessageCircle;
                    size: Size.lg;
                    above-modal: true;
                    label: @tr("Open the chat");
                    tip: self.label;
                    tip-scope: TipScope.ring;
                    clicked => {
                        Shell.close-overlays();
                        Actions.select-room(CallView.ring-room-id);
                    }
                }

                if CallView.ring-answerable && !CallView.ring-video: AppButton {
                    horizontal-stretch: 1;
                    text: @tr("Answer");
                    icon: IconSet.Phone;
                    tint: AppStyle.call-accept;
                    above-modal: true;
                    clicked => {
                        root.answer(false);
                    }
                }
            }

            if CallView.ring-answerable && CallView.ring-video: AppButton {
                text: @tr("Answer without camera");
                icon: IconSet.Phone;
                tint: AppStyle.call-accept;
                above-modal: true;
                clicked => {
                    root.answer(false);
                }
            }

            if CallView.ring-answerable && CallView.ring-video: AppButton {
                text: @tr("Answer with camera");
                icon: IconSet.Video;
                filled: false;
                above-modal: true;
                clicked => {
                    root.answer(true);
                }
            }
        }
    }
}
