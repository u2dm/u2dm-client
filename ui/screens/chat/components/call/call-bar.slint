import { IconDisplay, IconSet } from "@lucide";

import { ClickArea } from "../../../../components/a11y.slint";
import { IconButton } from "../../../../components/button.slint";
import { CallMic } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";

export component CallBar inherits Rectangle {
    height: Metrics.call-bar;
    background: AppStyle.call-live-background;
    accessible-role: groupbox;
    accessible-label: @tr("Call in {}", CallView.active-room-name);

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        spacing: Space.md;

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: CallView.active-video ? IconSet.Video : IconSet.Phone;
            size: IconSize.sm;
            stroke: AppStyle.call-live;
        }

        ClickArea {
            horizontal-stretch: 1;
            min-width: 0;
            ring-radius: Radius.xs;
            label: @tr("Go back to the call in {}", CallView.active-room-name);
            clicked => {
                Actions.select-room(CallView.active-room-id);
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;

                Text {
                    text: CallView.active-room-name;
                    font-size: Fonts.body-small;
                    font-weight: Weight.semibold;
                    color: AppStyle.call-live;
                    overflow: elide;
                }

                Text {
                    text: CallWords.phase(CallView.phase, CallView.elapsed);
                    font-size: Fonts.caption;
                    color: AppStyle.foreground-muted;
                    overflow: elide;
                }
            }
        }

        IconButton {
            cross-axis-self-alignment: center;
            size: Size.md;
            icon: CallView.mic == CallMic.on ? IconSet.Mic : IconSet.MicOff;
            tint: CallView.mic == CallMic.on ? AppStyle.foreground-strong : AppStyle.call-decline;
            label: CallView.mic == CallMic.on ? @tr("Mute your microphone") : @tr("Unmute your microphone");
            clicked => {
                Actions.set-microphone({ on: CallView.mic != CallMic.on });
            }
        }

        IconButton {
            cross-axis-self-alignment: center;
            size: Size.md;
            icon: IconSet.PhoneOff;
            tint: AppStyle.call-decline;
            label: @tr("Leave the call");
            clicked => {
                Actions.leave-call();
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Stroke.hairline;
        background: AppStyle.border;
    }
}
