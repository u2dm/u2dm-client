import { IconDisplay, IconSet } from "@lucide";

import { LinkButton } from "../../../../components/button.slint";
import { DotPulse } from "../../../../components/dot-pulse.slint";
import { CallStates } from "../../../../call-states.slint";
import { CallDeviceTrouble, CallNotice, CallPhase } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Size, Space } from "../../../../theme.slint";

export component CallStatus inherits VerticalLayout {
    in property <bool> above-modal;
    in property <bool> explains-share;
    in property <bool> tells-change-cancelled;
    in property <bool> tells-device-news;
    in property <bool> tells-share-ended;

    callback acted-by-keys(CallNotice);

    property <CallNotice> notice: CallView.notice;
    property <bool> noticed: root.notice != CallNotice.none;
    property <bool> pending: root.notice == CallNotice.choosing-screen;
    property <bool> about-others: root.notice == CallNotice.cant-decrypt
        || root.notice == CallNotice.unverified-device;
    property <bool> undiagnosed: root.notice == CallNotice.sharing-never-started;
    property <bool> not-received: CallStates.not-received(root.notice);
    property <bool> own-poor: root.notice == CallNotice.connection-poor;
    property <bool> change-cancelled: !root.noticed && !root.explains-share && root.tells-change-cancelled;
    property <bool> device-news: !root.noticed && !root.explains-share && !root.change-cancelled
        && root.tells-device-news;
    property <bool> unplugged: root.device-news && CallView.device-news-trouble == CallDeviceTrouble.disconnected;
    property <bool> trouble: (root.noticed && !root.pending && !root.about-others && !root.undiagnosed
        && !root.not-received && !root.own-poor)
        || (root.device-news && !root.unplugged);
    property <string> action: CallWords.notice-action(root.notice);
    property <string> way-out: CallWords.notice-way-out(root.notice);
    property <bool> share-waits: CallView.phase == CallPhase.joining || CallView.phase == CallPhase.connecting;

    function act() {
        if root.notice == CallNotice.choosing-screen {
            Actions.share-screen({ on: false });
        } else if root.notice == CallNotice.sharing-never-started || root.not-received {
            Actions.open-room-log(CallView.active-room-id);
        } else if root.notice == CallNotice.not-called || root.notice == CallNotice.not-announced {
            Actions.announce-call-again();
        } else if root.notice == CallNotice.microphone-failed {
            Actions.set-microphone({ on: true });
        } else if root.notice == CallNotice.camera-failed {
            Actions.set-camera({ on: true });
        } else if root.notice == CallNotice.screen-failed {
            Actions.share-screen({ on: true });
        }
    }

    function go-without() {
        if root.notice == CallNotice.microphone-failed {
            Actions.set-microphone({ on: false });
        } else if root.notice == CallNotice.camera-failed {
            Actions.set-camera({ on: false });
        }
    }

    spacing: Space.xs;

    HorizontalLayout {
        min-height: Size.sm;
        alignment: center;
        spacing: Space.md;

        if root.pending: DotPulse {
            tint: AppStyle.foreground-muted;
            dot-size: Space.sm;
        }

        if !root.pending: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.trouble ? IconSet.CircleAlert
                : root.about-others ? IconSet.ShieldAlert
                : root.not-received || root.own-poor ? IconSet.CircleAlert
                : root.unplugged ? IconSet.Unplug
                : IconSet.Info;
            size: IconSize.sm;
            stroke: root.trouble ? AppStyle.danger-muted : AppStyle.foreground-faint;
        }

        Text {
            text: root.noticed
                ? CallWords.notice(root.notice, CallView.active-room-name, CallView.notice-name, CallView.notice-others)
                : root.explains-share
                ? CallWords.share-state(CallView.screen, CallView.screen-refusal, root.share-waits)
                : root.change-cancelled
                ? CallWords.share-change-cancelled()
                : root.device-news
                ? CallWords.device-news(CallView.device-news-trouble, CallView.device-news-kind, CallView.device-news-name)
                : CallWords.share-ended(CallView.ended-share);
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            color: root.trouble ? AppStyle.danger-muted : AppStyle.foreground-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if root.action != "" && root.way-out == "": LinkButton {
            min-height: Size.sm;
            above-modal: root.above-modal;
            text: root.action;
            label: CallWords.notice-action-label(root.notice, CallView.active-room-name);
            font-size: Fonts.body-small;
            pad: 2 * Space.sm;
            clicked => {
                let by-keys = self.has-focus;
                root.act();
                if by-keys {
                    root.acted-by-keys(root.notice);
                }
            }
        }
    }

    if root.way-out != "": HorizontalLayout {
        alignment: center;
        spacing: Space.md;

        LinkButton {
            min-height: Size.sm;
            above-modal: root.above-modal;
            text: root.action;
            label: CallWords.notice-action-label(root.notice, CallView.active-room-name);
            font-size: Fonts.body-small;
            pad: 2 * Space.sm;
            clicked => {
                let by-keys = self.has-focus;
                root.act();
                if by-keys {
                    root.acted-by-keys(root.notice);
                }
            }
        }

        LinkButton {
            min-height: Size.sm;
            above-modal: root.above-modal;
            text: root.way-out;
            label: CallWords.notice-way-out-label(root.notice);
            font-size: Fonts.body-small;
            pad: 2 * Space.sm;
            clicked => {
                let by-keys = self.has-focus;
                root.go-without();
                if by-keys {
                    root.acted-by-keys(root.notice);
                }
            }
        }
    }
}

export component ShareStatus inherits HorizontalLayout {
    in property <bool> above-modal;

    callback view(bool);

    out property <bool> view-focused: view-link.has-focus;

    public function focus-view() {
        view-link.take-focus();
    }

    min-height: Size.sm;
    alignment: center;
    spacing: Space.md;

    IconDisplay {
        cross-axis-self-alignment: center;
        icon: IconSet.ScreenShare;
        size: IconSize.sm;
        stroke: AppStyle.call-sharing;
        accessible-role: none;
    }

    Text {
        text: CallWords.unseen-shares(CallView.first-sharer, CallView.share-count);
        font-family: Fonts.emoji;
        font-size: Fonts.body-small;
        color: AppStyle.foreground-muted;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    view-link := LinkButton {
        min-height: Size.sm;
        above-modal: root.above-modal;
        text: @tr("View");
        label: CallWords.view-shares(CallView.first-sharer, CallView.share-count);
        font-size: Fonts.body-small;
        pad: 2 * Space.sm;
        clicked => {
            root.view(self.has-focus);
        }
    }
}
