import { IconSet } from "@lucide";

import { ClickArea, RovingKeys } from "../../../../components/a11y.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { StateLayer } from "../../../../components/state-layer.slint";
import { TipSource } from "../../../../components/tip.slint";
import { Actions } from "../../../../actions.slint";
import { CallHand, CallReaction } from "../../../../enums.slint";
import { TipScope } from "../../../../local.slint";
import { CallWords } from "../../../../messages.slint";
import { CallReactionOption } from "../../../../types.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, Glyph, Metrics, Space, Stroke } from "../../../../theme.slint";

global CallReactions {
    out property <[CallReactionOption]> options: [
        { name: "thumbsup", emoji: "\u{1f44d}" },
        { name: "party", emoji: "\u{1f389}" },
        { name: "clapping", emoji: "\u{1f44f}" },
        { name: "dog", emoji: "\u{1f436}" },
        { name: "cat", emoji: "\u{1f431}" },
        { name: "lightbulb", emoji: "\u{1f4a1}" },
        { name: "crickets", emoji: "\u{1f997}" },
        { name: "thumbsdown", emoji: "\u{1f44e}" },
        { name: "dizzy", emoji: "\u{1f635}\u{200d}\u{1f4ab}" },
        { name: "ok", emoji: "\u{1f44c}" },
        { name: "heart", emoji: "\u{1f970}" },
        { name: "laugh", emoji: "\u{1f604}" },
        { name: "deer", emoji: "\u{1f98c}" },
        { name: "rock", emoji: "\u{1f918}" },
        { name: "wave", emoji: "\u{1f44b}" },
        { name: "drum", emoji: "\u{1f941}" },
        { name: "bell", emoji: "\u{1f6ce}\u{fe0f}" },
    ];
}

component ReactionCell inherits ClickArea {
    in property <CallReactionOption> option;

    width: Metrics.call-reaction-cell;
    height: Metrics.call-reaction-cell;
    border-radius: self.width / 2;
    ring-radius: self.width / 2;
    label: CallWords.reaction-name(root.option.name, root.option.emoji);
    focusable: false;
    opacity: root.enabled ? 1 : 0.4;

    StateLayer {
        border-radius: root.border-radius;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    Text {
        text: root.option.emoji;
        font-family: Fonts.emoji;
        font-size: Glyph.xl;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    TipSource {
        width: root.width;
        height: root.height;
        text: root.label;
        hovered: root.has-hover;
        pressed: root.pressed;
        above-modal: root.above-modal;
        scope: TipScope.call;
    }
}

export component CallReactionsMenu inherits PickerCard {
    in property <length> room;
    in property <bool> above-modal;

    callback sent();

    property <int> columns: Metrics.call-reaction-columns;
    property <int> options: CallReactions.options.length;
    property <int> count: root.options + 1;
    property <int> grid-rows: ceil(root.options / root.columns);
    property <length> grid-width: root.columns * Metrics.call-reaction-cell + (root.columns - 1) * Space.xs;
    property <int> cursor: -1;
    property <bool> keys-focused: keys.has-focus;
    property <bool> offers-hand: CallView.hand != CallHand.unavailable;
    property <bool> hand-up: CallView.hand == CallHand.up || CallView.hand == CallHand.lowering
        || CallView.hand == CallHand.lower-failed;
    property <bool> reacts: CallView.reaction == CallReaction.ready || CallView.reaction == CallReaction.failed;
    property <string> state-text: CallWords.reaction-state(CallView.reaction);

    public function open(by-keys: bool) {
        root.cursor = by-keys ? (root.reacts ? 1 : 0) : -1;
        keys.focus();
    }

    pure function row-of(index: int) -> int {
        return floor((index - 1) / root.columns);
    }

    function step(to: int) {
        root.cursor = clamp(to, 0, root.count - 1);
    }

    function down() {
        if root.cursor < 1 {
            root.step(1);
        } else if root.cursor + root.columns < root.count {
            root.step(root.cursor + root.columns);
        } else if root.row-of(root.cursor) < root.row-of(root.count - 1) {
            root.step(root.count - 1);
        }
    }

    function up() {
        if root.cursor <= root.columns {
            root.step(0);
        } else {
            root.step(root.cursor - root.columns);
        }
    }

    function react(index: int) {
        if !root.reacts || index < 0 || index >= root.options {
            return;
        }
        Actions.send-call-reaction({ name: CallReactions.options[index].name });
        root.sent();
    }

    function act(index: int) {
        if index == 0 {
            if root.offers-hand {
                Actions.raise-hand({ on: !root.hand-up });
            }
        } else {
            root.react(index - 1);
        }
    }

    pure function spoken-label() -> string {
        if root.cursor < 0 || root.cursor >= root.count {
            return @tr("Reactions");
        }
        if root.cursor == 0 {
            return CallWords.raise-your-hand();
        }
        return CallWords.reaction-name(CallReactions.options[root.cursor - 1].name, CallReactions.options[root.cursor - 1].emoji);
    }

    width: Metrics.call-reactions-width;
    height: min(rows.preferred-height, root.room);

    TouchArea { }

    keys := RovingKeys {
        count: root.count;
        horizontal: true;
        cursor <=> root.cursor;
        accessible-label: root.spoken-label();
        accessible-description: root.cursor > 0 ? root.state-text : "";
        accessible-enabled: root.cursor == 0 ? root.offers-hand : root.reacts;
        accessible-checkable: root.cursor == 0;
        accessible-checked: root.cursor == 0 && root.hand-up;
        accessible-action-default => {
            root.act(max(root.cursor, 0));
        }
        intercept(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            if event.text == Key.DownArrow {
                root.down();
                return accept;
            }
            if event.text == Key.UpArrow {
                root.up();
                return accept;
            }
            return reject;
        }
        activated(index) => {
            root.act(index);
        }
    }

    rows := VerticalLayout {
        padding: Space.sm;
        spacing: Space.xs;

        MenuRow {
            height: Metrics.call-menu-row;
            icon: IconSet.Hand;
            label: CallWords.raise-your-hand();
            enabled: root.offers-hand;
            busy: CallView.hand == CallHand.raising || CallView.hand == CallHand.lowering;
            checkable: true;
            checked: root.hand-up;
            trailing: root.hand-up ? IconSet.Check : { };
            focusable: false;
            above-modal: root.above-modal;
            roving-focus: root.keys-focused && root.cursor == 0;
            clicked => {
                root.act(0);
            }
        }

        Rectangle {
            height: Space.md;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: Stroke.hairline;
                background: AppStyle.border;
            }
        }

        Rectangle {
            height: root.grid-rows * Metrics.call-reaction-cell + (root.grid-rows - 1) * Space.xs;

            for option[index] in CallReactions.options: ReactionCell {
                x: (parent.width - root.grid-width) / 2 + mod(index, root.columns) * (Metrics.call-reaction-cell + Space.xs);
                y: floor(index / root.columns) * (Metrics.call-reaction-cell + Space.xs);
                option: option;
                enabled: root.reacts;
                above-modal: root.above-modal;
                roving-focus: root.keys-focused && root.cursor == index + 1;
                clicked => {
                    root.react(index);
                }
            }
        }

        if root.state-text != "" && CallView.reaction != CallReaction.ready: Text {
            text: root.state-text;
            font-size: Fonts.caption;
            color: CallView.reaction == CallReaction.failed ? AppStyle.danger-muted : AppStyle.foreground-muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
