import { IconDisplay, IconSet } from "@lucide";

import { ClickArea, RovingKeys } from "../../../../components/a11y.slint";
import { MenuScroll } from "../../../../components/menu.slint";
import { Actions } from "../../../../actions.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { ShadedClickArea, StateLayer } from "../../../../components/state-layer.slint";
import { CallStates } from "../../../../call-states.slint";
import { CallHand } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { CallPersonEntry } from "../../../../types.slint";
import { CallView } from "../../../../views.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Radius, Space, Weight } from "../../../../theme.slint";
import { SharingMark } from "./sharing-mark.slint";

component PersonRow inherits Rectangle {
    in property <CallPersonEntry> person;
    in property <string> detail;
    in property <string> label;
    in property <bool> roving-focus;
    in property <bool> action-focus;
    in property <bool> above-modal;
    in property <bool> offers-hand;
    in property <bool> hand-up;
    in property <int> index: -1;

    callback picked();
    callback toggled();
    callback roved(length, length);

    property <bool> troubled: CallStates.troubled(root.person.state);

    height: max(Metrics.call-person-row, row.preferred-height);
    border-radius: Radius.sm;

    changed roving-focus => {
        if self.roving-focus {
            root.roved(self.y, self.height);
        }
    }

    changed action-focus => {
        if self.action-focus {
            root.roved(self.y, self.height);
        }
    }

    StateLayer {
        border-radius: root.border-radius;
        hovered: touch.has-hover && touch.enabled;
        pressed: touch.pressed && touch.enabled;
    }

    touch := ClickArea {
        enabled: root.person.key != "";
        above-modal: root.above-modal;
        label: root.label;
        accessible-description: !root.person.you ? @tr("Right arrow reaches Mute for you")
            : root.offers-hand ? @tr("Right arrow reaches Raise your hand")
            : "";
        accessible-item-index: root.index;
        ring-radius: Radius.sm;
        focusable: false;
        roving-focus: root.roving-focus;
        clicked => {
            root.picked();
        }
    }

    row := HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: Space.md;

        Avatar {
            cross-axis-self-alignment: center;
            width: Metrics.call-person-avatar;
            height: Metrics.call-person-avatar;
            color-index: root.person.color-index;
            has-image: root.person.has-avatar;
            image: root.person.avatar;
            initial: root.person.initial;
            initial-size: Glyph.xs;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: CallWords.person-name(root.person.name, root.person.you);
                font-family: Fonts.emoji;
                font-size: Fonts.body;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-strong;
                overflow: elide;
                accessible-role: none;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-size: Fonts.caption;
                color: root.troubled ? AppStyle.danger-muted : AppStyle.foreground-muted;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        if root.person.reaction != "": Text {
            cross-axis-self-alignment: center;
            text: root.person.reaction;
            font-family: Fonts.emoji;
            font-size: Glyph.md;
            accessible-role: none;
        }

        if !root.person.you && root.person.hand > 0: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Hand;
            size: IconSize.sm;
            stroke: AppStyle.call-hand;
            accessible-role: none;
        }

        if root.person.muted && CallStates.hears(root.person.state): IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.MicOff;
            size: IconSize.sm;
            stroke: AppStyle.foreground-muted;
            accessible-role: none;
        }

        if root.person.sharing: SharingMark {
            cross-axis-self-alignment: center;
        }

        if root.troubled: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.CircleAlert;
            size: IconSize.sm;
            stroke: AppStyle.danger-muted;
            accessible-role: none;
        }

        if !root.person.you: mute := ShadedClickArea {
            cross-axis-self-alignment: center;
            width: Metrics.call-person-action;
            height: Metrics.call-person-action;
            border-radius: self.width / 2;
            ring-radius: self.width / 2;
            above-modal: root.above-modal;
            focusable: false;
            roving-focus: root.action-focus;
            label: CallWords.mute-for-me(root.person.name);
            accessible-description: @tr("Left arrow goes back to the person");
            accessible-role: switch;
            accessible-checkable: true;
            accessible-checked: root.person.muted-for-you;
            clicked => {
                root.toggled();
            }

            IconDisplay {
                icon: root.person.muted-for-you ? IconSet.VolumeOff : IconSet.Volume2;
                size: IconSize.sm;
                stroke: root.person.muted-for-you ? AppStyle.foreground-strong : AppStyle.foreground-muted;
                accessible-role: none;
            }
        }

        if root.person.you && root.offers-hand: hand := ShadedClickArea {
            cross-axis-self-alignment: center;
            width: Metrics.call-person-action;
            height: Metrics.call-person-action;
            border-radius: self.width / 2;
            ring-radius: self.width / 2;
            background: root.hand-up ? AppStyle.call-hand : transparent;
            ink: root.hand-up ? AppStyle.on-call-hand : AppStyle.foreground-strong;
            above-modal: root.above-modal;
            focusable: false;
            roving-focus: root.action-focus;
            label: CallWords.raise-your-hand();
            accessible-description: @tr("Left arrow goes back to the person");
            accessible-role: switch;
            accessible-checkable: true;
            accessible-checked: root.hand-up;
            clicked => {
                root.toggled();
            }

            IconDisplay {
                icon: IconSet.Hand;
                size: IconSize.sm;
                stroke: root.hand-up ? AppStyle.on-call-hand : AppStyle.foreground-muted;
                accessible-role: none;
            }
        }
    }
}

export component CallPeopleMenu inherits PickerCard {
    in property <length> room;
    in property <bool> above-modal;

    callback picked(string, bool);

    property <int> cursor: -1;
    property <int> count: CallView.people.length;
    property <bool> keys-focused: keys.has-focus;
    property <bool> on-action;
    property <bool> offers-hand: CallView.hand != CallHand.unavailable;
    property <bool> hand-up: CallView.hand == CallHand.up || CallView.hand == CallHand.lowering
        || CallView.hand == CallHand.lower-failed;
    property <bool> acts: root.on-action && root.cursor >= 0 && root.cursor < root.count
        && root.has-action(root.cursor);
    property <bool> you-first: root.count > 0 && CallView.people[0].you;
    out property <int> spoken-count: root.count;
    out property <int> spoken-index: root.cursor < 0 || root.cursor >= root.count ? -1
        : root.node-of(root.cursor) + (root.acts ? 1 : 0);

    public function open(by-keys: bool) {
        root.cursor = by-keys && root.count > 0 ? 0 : -1;
        root.on-action = false;
        keys.focus();
    }

    pure function has-action(index: int) -> bool {
        return !CallView.people[index].you || root.offers-hand;
    }

    pure function node-of(index: int) -> int {
        return 2 * index - (root.you-first && !root.offers-hand && index > 0 ? 1 : 0);
    }

    function toggle-at(index: int) {
        if index < 0 || index >= root.count || !root.has-action(index) {
            return;
        }
        if CallView.people[index].you {
            Actions.raise-hand({ on: !root.hand-up });
        } else {
            Actions.mute-for-me({
                user-id: CallView.people[index].user-id,
                on: !CallView.people[index].muted-for-you,
            });
        }
    }

    pure function detail-of(person: CallPersonEntry) -> string {
        return CallWords.person-detail(person, CallView.hands-raised);
    }

    pure function label-of(person: CallPersonEntry) -> string {
        return CallWords.person-label(person.name, person.you, root.detail-of(person));
    }

    function pick-at(index: int, by-keys: bool) {
        if index >= 0 && index < root.count && CallView.people[index].key != "" {
            root.picked(CallView.people[index].key, by-keys);
        }
    }

    width: Metrics.call-people-width;
    height: min(scroll.rows-height + 2 * Space.sm, root.room);

    TouchArea { }

    keys := RovingKeys {
        count: root.count;
        cursor <=> root.cursor;
        intercept(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            if event.text == Key.RightArrow && root.cursor >= 0 {
                root.on-action = true;
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.on-action = false;
                return accept;
            }
            return reject;
        }
        activated(index) => {
            if root.acts {
                root.toggle-at(index);
            } else {
                root.pick-at(index, true);
            }
        }
    }

    scroll := MenuScroll {
        width: parent.width;
        height: parent.height - 2 * Space.sm;

        for person[index] in CallView.people: PersonRow {
            person: person;
            index: index;
            detail: root.detail-of(person);
            label: root.label-of(person);
            above-modal: root.above-modal;
            offers-hand: root.offers-hand;
            hand-up: root.hand-up;
            roving-focus: root.keys-focused && root.cursor == index && !(root.acts);
            action-focus: root.keys-focused && root.cursor == index && root.acts;
            roved(top, size) => {
                scroll.reveal(top, size);
            }
            picked => {
                root.pick-at(index, false);
            }
            toggled => {
                root.toggle-at(index);
            }
        }
    }
}
