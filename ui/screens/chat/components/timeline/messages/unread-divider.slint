import { Palette } from "std-widgets.slint";
import { AppStyle, Fonts, Space, Stroke, Weight } from "../../../../../theme.slint";

export component UnreadDivider inherits Rectangle {
    height: label.preferred-height + Space.lg;
    background: AppStyle.accent-background-soft;

    accessible-role: text;
    accessible-label: label.text;

    label := Text {
        text: @tr("Unread messages");
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: Palette.accent-background;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: 0;
        height: Stroke.hairline;
        background: AppStyle.accent-divider;
    }
}
