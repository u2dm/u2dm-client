import { Palette, Spinner } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";
import { MessageEntry } from "../../../../../types.slint";
import { ClickArea } from "../../../../../components/a11y.slint";
import { Pill } from "../../../../../components/pill.slint";
import { MediaState, MessageKind, SendState } from "../../../../../enums.slint";
import { MediaFailures } from "../../../../../messages.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Size, Space, Weight } from "../../../../../theme.slint";
import { Actions } from "../../../../../actions.slint";
import { TextMessage } from "./text-message.slint";
import { MessageMeta } from "../message-meta.slint";

export component UploadProgress inherits Spinner {
    in property <SendState> send-state;
    in property <float> send-progress;

    indeterminate: root.send-state != SendState.uploading;
    progress: root.send-progress;
}

component UploadScrim inherits Rectangle {
    in property <MessageEntry> msg;

    background: AppStyle.overlay-media-scrim;

    UploadProgress {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        send-state: root.msg.send-state;
        send-progress: root.msg.send-progress;
    }
}

component PlayBadge inherits Rectangle {
    in property <bool> cramped;

    width: root.cramped ? Metrics.video-play-badge-compact : Metrics.video-play-badge;
    height: self.width;
    border-radius: self.height / 2;
    background: AppStyle.overlay-media-scrim;

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: IconSet.Play;
        size: root.cramped ? IconSize.md : IconSize.lg;
        stroke: Palette.foreground;
    }
}

component ScrimChip inherits Rectangle {
    width: content.preferred-width + Space.xl;
    height: content.preferred-height + Space.md;
    border-radius: self.height / 2;
    background: AppStyle.overlay-media-scrim;

    content := HorizontalLayout {
        x: Space.md;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;

        @children
    }
}

export component DurationChip inherits ScrimChip {
    in property <string> duration;

    Text {
        text: root.duration;
        font-size: Fonts.body-small;
        color: Palette.foreground;
        vertical-alignment: center;
    }
}

export component MediaPlaceholder inherits Text {
    in property <MessageEntry> msg;

    pure function describe() -> string {
        if root.msg.message-type == MessageKind.video {
            return root.msg.body != "" ? @tr("Video: {}", root.msg.body) : @tr("Video");
        }
        return root.msg.body != "" ? @tr("Image: {}", root.msg.body) : @tr("Image");
    }

    text: root.describe();
    font-size: Fonts.body;
    color: AppStyle.foreground-strong;
    wrap: word-wrap;
}

component MediaFailurePanel inherits VerticalLayout {
    in property <MessageEntry> msg;
    in property <bool> cramped;
    in property <Icon> icon;
    in property <string> title;
    in property <bool> is-video;
    in property <bool> opens-externally;
    in property <string> external-label;

    property <string> detail: MediaFailures.detail(
        root.msg.image-extension,
        root.msg.image-mimetype,
        root.msg.image-width,
        root.msg.image-height,
    );
    property <length> action-height: Size.md;

    alignment: center;
    padding: Space.md;
    spacing: root.cramped ? Space.sm : Space.md;

    HorizontalLayout {
        alignment: center;

        IconDisplay {
            icon: root.icon;
            size: root.cramped ? IconSize.md : IconSize.xl;
            stroke: AppStyle.foreground-faint;
        }
    }

    if !root.cramped: Text {
        text: root.title;
        font-size: Fonts.label;
        color: AppStyle.foreground-strong;
        horizontal-alignment: center;
        overflow: elide;
    }

    Text {
        text: MediaFailures.reason(root.msg.media-failure, root.is-video);
        font-size: root.cramped ? Fonts.caption : Fonts.body-small;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    if !root.cramped && root.detail != "": Text {
        text: root.detail;
        font-size: Fonts.caption;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        overflow: elide;
    }

    if root.opens-externally: HorizontalLayout {
        alignment: center;

        Pill {
            height: root.action-height;
            pad: root.cramped ? Space.sm : Space.lg;
            fill: AppStyle.overlay-hover;
            hover-lift: 0.25;
            label: root.external-label;
            clicked => {
                Actions.open-media(root.msg.event-id);
            }

            IconDisplay {
                icon: IconSet.ExternalLink;
                size: IconSize.sm;
                stroke: AppStyle.foreground-strong;
            }

            if !root.cramped: Text {
                text: @tr("Open externally");
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: AppStyle.foreground-strong;
                vertical-alignment: center;
            }
        }
    }
}

export component MediaFrame inherits VerticalLayout {
    in property <MessageEntry> msg;
    in property <int> timeline-row;
    in property <length> frame-limit: Metrics.media-width-max;
    in property <bool> shows-meta;
    in property <bool> bubble-hovered;
    in property <bool> openable;
    in property <string> open-label;
    in property <string> failure-title;
    in property <bool> opens-externally;
    in property <string> external-label;
    out property <bool> ready: root.msg.media-state == MediaState.ready;

    callback activated();

    property <bool> is-video: root.msg.message-type == MessageKind.video;
    property <bool> sending: root.msg.send-state == SendState.sending
        || root.msg.send-state == SendState.uploading;
    property <bool> failed: root.msg.media-state == MediaState.failed;
    property <bool> idle: root.msg.media-state == MediaState.idle;
    property <bool> has-caption: root.msg.body != "";
    property <bool> is-decoded: root.msg.thumbnail.width > 0 && root.msg.thumbnail.height > 0;
    property <bool> has-dimensions: root.msg.image-width > 0 && root.msg.image-height > 0;
    property <length> width-limit: min(root.frame-limit, Metrics.media-width-max);
    property <length> height-limit: Metrics.media-height-max;
    property <length> frame-width-min: root.failed
        ? min(root.width-limit, Metrics.media-failure-width-min)
        : Metrics.media-width-min;
    property <length> frame-height-min: root.failed
        ? min(root.height-limit, Metrics.media-failure-height-min)
        : Metrics.media-height-min;
    property <float> aspect: root.ready && root.is-decoded
        ? root.msg.thumbnail.width / max(root.msg.thumbnail.height, 1)
        : (root.has-dimensions ? root.msg.image-width / max(root.msg.image-height, 1) : 1.5);
    property <length> display-width: min(root.width-limit, max(root.frame-width-min, root.height-limit * root.aspect));
    property <length> display-height: min(root.height-limit, max(root.frame-height-min, root.display-width / max(root.aspect, 0.01)));
    property <bool> cramped: root.display-width < Metrics.media-failure-width-min
        || root.display-height < Metrics.media-failure-height-min;

    HorizontalLayout {
        alignment: start;

        Rectangle {
            width: root.display-width;
            height: root.display-height;
            background: root.ready ? transparent : Palette.alternate-background;
            clip: true;

            media-click := ClickArea {
                enabled: root.openable;
                label: root.open-label;
                ring-radius: Radius.xs;
                width: 100%;
                height: 100%;
                clicked => {
                    root.activated();
                }

                if root.ready: Image {
                    width: 100%;
                    height: 100%;
                    source: root.msg.thumbnail;
                    image-fit: ImageFit.cover;
                }
            }

            if !root.is-video && !root.ready && !root.failed: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }

            if root.is-video && !root.failed && !root.sending: PlayBadge {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                cramped: root.cramped;
            }

            if root.is-video && root.idle && !root.sending: Spinner {
                x: parent.width - self.width - Space.md;
                y: Space.md;
                width: IconSize.md;
                height: IconSize.md;
                indeterminate: true;
            }

            if root.sending: UploadScrim {
                width: 100%;
                height: 100%;
                msg: root.msg;
            }

            if root.failed: MediaFailurePanel {
                width: 100%;
                height: 100%;
                msg: root.msg;
                cramped: root.cramped;
                icon: root.is-video ? IconSet.VideoOff : IconSet.ImageOff;
                title: root.failure-title;
                is-video: root.is-video;
                opens-externally: root.opens-externally;
                external-label: root.external-label;
            }

            if root.is-video && root.msg.duration != "" && !root.failed: DurationChip {
                x: Space.md;
                y: parent.height - self.height - Space.md;
                duration: root.msg.duration;
            }

            if root.shows-meta: ScrimChip {
                x: parent.width - self.width - Space.md;
                y: parent.height - self.height - Space.md;
                opacity: media-click.has-hover || root.bubble-hovered ? 1 : 0;

                animate opacity {
                    duration: Motion.fast;
                    easing: ease-out;
                }

                MessageMeta {
                    msg: root.msg;
                    timeline-row: root.timeline-row;
                    tint: Palette.foreground;
                }
            }
        }
    }

    if root.has-caption: HorizontalLayout {
        alignment: start;
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;

        TextMessage {
            width: root.display-width - 2 * Space.lg;
            msg: root.msg;
        }
    }
}
