import { Palette, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { MessageEntry } from "../../types.slint";
import { ClickArea } from "../../../../../components/a11y.slint";
import { Pill } from "../../../../../components/pill.slint";
import { Delivery, MediaState, SendState } from "../../../../../enums.slint";
import { MediaFailures } from "../../../../../messages.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Size, Space, Weight } from "../../../../../theme.slint";
import { Actions } from "../../../../../actions.slint";
import { TextMessage } from "./text-message.slint";
import { DeliveryMark, ReaderCount, Readers } from "../delivery-mark.slint";

export component VideoMessage inherits VerticalLayout {
    in property <MessageEntry> msg;
    in property <int> timeline-row;
    in property <length> frame-limit: Metrics.media-width-max;
    in property <bool> show-timestamp;
    in property <bool> bubble-hovered;

    property <bool> is-sending: root.msg.send-state == SendState.sending
        || root.msg.send-state == SendState.uploading;

    out property <length> display-width: min(root.width-limit, max(root.frame-width-min, root.height-limit * root.aspect));
    out property <length> display-height: min(root.height-limit, max(root.frame-height-min, root.display-width / max(root.aspect, 0.01)));

    property <length> width-limit: min(root.frame-limit, Metrics.media-width-max);
    property <length> height-limit: Metrics.media-height-max;
    property <bool> has-poster: root.msg.media-state == MediaState.ready;
    property <bool> is-failed: root.msg.media-state == MediaState.failed;
    property <bool> is-loading: root.msg.media-state == MediaState.idle;
    property <bool> has-caption: root.msg.body != "";
    property <bool> is-decoded: root.msg.thumbnail.width > 0 && root.msg.thumbnail.height > 0;
    property <bool> has-dimensions: root.msg.image-width > 0 && root.msg.image-height > 0;
    property <length> frame-width-min: root.is-failed
        ? min(root.width-limit, Metrics.media-failure-width-min)
        : Metrics.media-width-min;
    property <length> frame-height-min: root.is-failed
        ? min(root.height-limit, Metrics.media-failure-height-min)
        : Metrics.media-height-min;
    property <bool> is-cramped: root.display-width < Metrics.media-failure-width-min
        || root.display-height < Metrics.media-failure-height-min;
    property <string> failure-detail: MediaFailures.detail(
        root.msg.image-extension,
        root.msg.image-mimetype,
        root.msg.image-width,
        root.msg.image-height,
    );
    property <length> action-height: Size.md;
    property <bool> can-open-externally: root.msg.event-id != "";
    property <float> aspect: root.has-poster && root.is-decoded
        ? root.msg.thumbnail.width / max(root.msg.thumbnail.height, 1)
        : (root.has-dimensions ? root.msg.image-width / max(root.msg.image-height, 1) : 1.5);
    property <length> badge: root.is-cramped
        ? Metrics.video-play-badge-compact
        : Metrics.video-play-badge;

    HorizontalLayout {
        alignment: start;

        Rectangle {
            width: root.display-width;
            height: root.display-height;
            background: root.has-poster ? transparent : Palette.alternate-background;
            clip: true;

            media-click := ClickArea {
                enabled: root.msg.event-id != "";
                label: root.has-caption ? @tr("Play video: {}", root.msg.body) : @tr("Play video");
                ring-radius: Radius.xs;
                width: 100%;
                height: 100%;
                clicked => {
                    Actions.open-video(root.msg.event-id);
                }

                if root.has-poster: Image {
                    width: 100%;
                    height: 100%;
                    source: root.msg.thumbnail;
                    image-fit: ImageFit.cover;
                }
            }

            if !root.is-failed && !root.is-sending: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: root.badge;
                height: root.badge;
                border-radius: self.height / 2;
                background: AppStyle.overlay-media-scrim;

                IconDisplay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Play;
                    size: root.is-cramped ? IconSize.md : IconSize.lg;
                    stroke: Palette.foreground;
                }
            }

            if root.is-loading && !root.is-sending: Spinner {
                x: parent.width - self.width - Space.md;
                y: Space.md;
                width: IconSize.md;
                height: IconSize.md;
                indeterminate: true;
            }

            if root.is-sending: Rectangle {
                width: 100%;
                height: 100%;
                background: AppStyle.overlay-media-scrim;

                Spinner {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    indeterminate: root.msg.send-state != SendState.uploading;
                    progress: root.msg.send-progress;
                }
            }

            if root.is-failed: VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                padding: Space.md;
                spacing: root.is-cramped ? Space.sm : Space.md;

                HorizontalLayout {
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.VideoOff;
                        size: root.is-cramped ? IconSize.md : IconSize.xl;
                        stroke: AppStyle.foreground-faint;
                    }
                }

                if !root.is-cramped: Text {
                    text: @tr("Video preview unavailable");
                    font-size: Fonts.label;
                    color: AppStyle.foreground-strong;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: MediaFailures.reason(root.msg.media-failure, true);
                    font-size: root.is-cramped ? Fonts.caption : Fonts.body-small;
                    color: AppStyle.foreground-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }

                if !root.is-cramped && root.failure-detail != "": Text {
                    text: root.failure-detail;
                    font-size: Fonts.caption;
                    color: AppStyle.foreground-muted;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if root.can-open-externally: HorizontalLayout {
                    alignment: center;

                    Pill {
                        height: root.action-height;
                        pad: root.is-cramped ? Space.sm : Space.lg;
                        fill: AppStyle.overlay-hover;
                        hover-lift: 0.25;
                        label: @tr("Try opening this video in another application");
                        clicked => {
                            Actions.open-media(root.msg.event-id);
                        }

                        IconDisplay {
                            icon: IconSet.ExternalLink;
                            size: IconSize.sm;
                            stroke: AppStyle.foreground-strong;
                        }

                        if !root.is-cramped: Text {
                            text: @tr("Open externally");
                            font-size: Fonts.body-small;
                            font-weight: Weight.semibold;
                            color: AppStyle.foreground-strong;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.msg.duration != "" && !root.is-failed: Rectangle {
                x: Space.md;
                y: parent.height - self.height - Space.md;
                width: duration-text.preferred-width + Space.xl;
                height: duration-text.preferred-height + Space.md;
                border-radius: self.height / 2;
                background: AppStyle.overlay-media-scrim;

                duration-text := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.msg.duration;
                    font-size: Fonts.body-small;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
            }

            if root.show-timestamp: Rectangle {
                x: parent.width - self.width - Space.md;
                y: parent.height - self.height - Space.md;
                width: timestamp-row.preferred-width + Space.xl;
                height: timestamp-row.preferred-height + Space.md;
                border-radius: self.height / 2;
                background: AppStyle.overlay-media-scrim;
                opacity: media-click.has-hover || root.bubble-hovered ? 1 : 0;

                animate opacity {
                    duration: Motion.fast;
                    easing: ease-out;
                }

                timestamp-row := HorizontalLayout {
                    x: Space.md;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    height: self.preferred-height;
                    spacing: Space.sm;

                    if root.msg.edited: IconDisplay {
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.Pencil;
                        size: IconSize.xs;
                        stroke: Palette.foreground;
                    }

                    if Readers.counted(root.msg): ReaderCount {
                        y: (parent.height - self.height) / 2;
                        msg: root.msg;
                        timeline-row: root.timeline-row;
                        tint: Palette.foreground;
                    }

                    Text {
                        text: root.msg.timestamp;
                        font-size: Fonts.body-small;
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }

                    if root.msg.delivery != Delivery.none && root.msg.delivery != Delivery.seen: DeliveryMark {
                        y: (parent.height - self.height) / 2;
                        msg: root.msg;
                        timeline-row: root.timeline-row;
                        tint: Palette.foreground;
                        counted: Readers.counted(root.msg);
                    }
                }
            }
        }
    }

    if root.has-caption: HorizontalLayout {
        alignment: start;
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;

        TextMessage {
            width: root.display-width - 2 * Space.lg;
            msg: root.msg;
        }
    }
}

export component VideoPlaceholder inherits Text {
    in property <MessageEntry> msg;

    text: root.msg.body != "" ? @tr("Video: {}", root.msg.body) : @tr("Video");
    font-size: Fonts.body;
    color: AppStyle.foreground-strong;
    wrap: word-wrap;
}
