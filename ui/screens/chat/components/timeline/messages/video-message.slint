import { Actions } from "../../../../../actions.slint";
import { MediaFrame } from "./media-frame.slint";

export component VideoMessage inherits MediaFrame {
    openable: root.msg.event-id != "";
    open-label: root.msg.body != "" ? @tr("Play video: {}", root.msg.body) : @tr("Play video");
    failure-title: @tr("Video preview unavailable");
    opens-externally: root.msg.event-id != "";
    external-label: @tr("Try opening this video in another application");
    activated => {
        Actions.open-video(root.msg.event-id);
    }
}
