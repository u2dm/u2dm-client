import { Icon, IconDisplay } from "@lucide";
import { MessageEntry } from "../../../../../types.slint";
import { ClickArea } from "../../../../../components/a11y.slint";
import { SendState } from "../../../../../enums.slint";
import { AppStyle, IconSize, Metrics } from "../../../../../theme.slint";
import { UploadProgress } from "./media-frame.slint";
import { StateLayer } from "../../../../../components/state-layer.slint";

export component MediaButton inherits ClickArea {
    in property <Icon> icon;
    in property <bool> solid;
    in property <length> glyph-size: IconSize.md;
    in property <MessageEntry> msg;
    in property <bool> loading;

    property <bool> spinning: root.loading
        || root.msg.send-state == SendState.uploading
        || root.msg.send-state == SendState.sending;
    property <color> glyph: root.msg.is-own ? AppStyle.on-media-button-own : AppStyle.on-media-button;

    width: Metrics.media-button;
    height: Metrics.media-button;
    border-radius: self.height / 2;
    ring-inset: -Metrics.ring-outset;
    ring-radius: self.height / 2 + Metrics.ring-outset;
    background: root.msg.is-own ? AppStyle.media-button-own : AppStyle.media-button;

    StateLayer {
        border-radius: root.border-radius;
        ink: root.glyph;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    if !root.spinning: IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: root.glyph-size;
        stroke: root.glyph;
        stroke-fill: root.solid ? root.glyph : transparent;
    }

    if root.spinning: UploadProgress {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: IconSize.lg;
        height: IconSize.lg;
        send-state: root.msg.send-state;
        send-progress: root.msg.send-progress;
    }
}
