import { IconDisplay, IconSet } from "@lucide";
import { MessageEntry } from "../../../../../types.slint";
import { DecryptionFailure } from "../../../../../enums.slint";
import { AppStyle, Fonts, IconSize, Radius, Space } from "../../../../../theme.slint";

export component UtdMessage inherits Rectangle {
    in property <MessageEntry> msg;
    property <color> muted: root.msg.is-own ? AppStyle.overlay-foreground-muted-own : AppStyle.overlay-foreground-muted;

    property <DecryptionFailure> failure: root.msg.decryption-failure;
    property <bool> refused: root.failure == DecryptionFailure.unsigned-device
        || root.failure == DecryptionFailure.unknown-device
        || root.failure == DecryptionFailure.verification-violation;

    pure function reason() -> string {
        if root.failure == DecryptionFailure.sent-before-joining {
            return @tr("Unable to decrypt: you weren't in the room when this was sent");
        }
        if root.failure == DecryptionFailure.withheld-from-unverified {
            return @tr("Unable to decrypt: the sender only shares keys with verified sessions");
        }
        if root.failure == DecryptionFailure.withheld-by-sender {
            return @tr("Unable to decrypt: the sender didn't share the key with this session");
        }
        if root.failure == DecryptionFailure.history-without-backup {
            return @tr("Unable to decrypt: sent before this session signed in, and key storage is off");
        }
        if root.failure == DecryptionFailure.history-needs-verification {
            return @tr("Unable to decrypt: verify this session to read messages from before it signed in");
        }
        if root.failure == DecryptionFailure.unsigned-device {
            return root.msg.is-own
                ? @tr("Not shown: sent from one of your devices that isn't verified")
                : @tr("Not shown: sent from a device its owner hasn't verified");
        }
        if root.failure == DecryptionFailure.unknown-device {
            return @tr("Not shown: sent from an unknown or deleted device");
        }
        if root.failure == DecryptionFailure.verification-violation {
            return @tr("Not shown: the sender's verified identity has changed");
        }
        return @tr("Unable to decrypt message");
    }

    height: layout.preferred-height;
    border-radius: Radius.xs;
    background: AppStyle.well;

    layout := HorizontalLayout {
        padding: Space.md;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: start;

        IconDisplay {
            icon: root.refused ? IconSet.ShieldAlert : IconSet.LockKeyhole;
            size: IconSize.sm;
            stroke: root.muted;
        }

        Text {
            text: root.reason();
            font-size: Fonts.label;
            font-italic: true;
            color: root.muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
