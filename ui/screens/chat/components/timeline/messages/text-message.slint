import { Palette } from "std-widgets.slint";

import { MessageEntry } from "../../types.slint";
import { Actions } from "../../../../../actions.slint";
import { TextSelection } from "../../../../../local.slint";
import { AppStyle, Fonts } from "../../../../../theme.slint";

export component TextMessage inherits Rectangle {
    in property <MessageEntry> msg;

    property <bool> selecting: TextSelection.active-id == root.msg.unique-id && root.msg.unique-id != "";

    preferred-width: content.preferred-width;
    height: content.preferred-height;

    accessible-role: text;
    accessible-label: root.msg.body;
    accessible-action-default => {
        TextSelection.select(root.msg.unique-id);
    }

    content := VerticalLayout {
        if !root.selecting: StyledText {
            text: root.msg.styled;
            default-font-family: Fonts.emoji;
            default-font-size: Fonts.body;
            default-color: Palette.foreground;
            link-color: root.msg.is-own ? AppStyle.own-link : AppStyle.link;
            link-clicked(url) => {
                Actions.open-link(url);
            }
        }

        if root.selecting: TextInput {
            text: root.msg.body;
            font-family: Fonts.emoji;
            font-size: Fonts.body;
            color: Palette.foreground;
            wrap: word-wrap;
            read-only: true;
            single-line: false;
            selection-background-color: Palette.selection-background;
            selection-foreground-color: Palette.selection-foreground;

            init => {
                self.focus();
                self.select-all();
            }
            changed has-focus => {
                if (!self.has-focus) {
                    TextSelection.clear();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    TextSelection.clear();
                    return accept;
                }
                return reject;
            }
        }
    }

    if !root.selecting && !root.msg.has-links: TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: text;
        clicked => {
            TextSelection.select(root.msg.unique-id);
        }
    }
}
