import { Palette } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { MessageEntry } from "../../types.slint";
import { Interaction } from "../../../../../components/a11y.slint";
import { Actions } from "../../../../../actions.slint";
import { AppStyle, Fonts, IconSize, Space, Weight } from "../../../../../theme.slint";
import { MediaButton } from "./media-button.slint";

export component FileMessage inherits HorizontalLayout {
    in property <MessageEntry> msg;

    property <bool> can-save: root.msg.event-id != "";

    function save() {
        Actions.save-file({ event-id: root.msg.event-id, filename: root.msg.filename });
    }

    padding-top: Space.md;
    spacing: Space.lg;
    alignment: start;

    MediaButton {
        cross-axis-self-alignment: center;
        enabled: root.can-save;
        is-own: root.msg.is-own;
        icon: IconSet.ArrowDown;
        glyph-size: IconSize.lg;
        send-state: root.msg.send-state;
        send-progress: root.msg.send-progress;
        label: @tr("Save {}", root.msg.filename);
        clicked => {
            root.save();
        }
    }

    TouchArea {
        enabled: Interaction.actionable(root.can-save, false);
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.save();
        }

        VerticalLayout {
            alignment: center;
            spacing: Space.xs;

            Text {
                text: root.msg.filename;
                font-size: Fonts.body;
                font-weight: Weight.semibold;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.msg.size != "": Text {
                text: root.msg.size;
                font-size: Fonts.body-small;
                color: AppStyle.overlay-foreground-muted;
                overflow: elide;
            }
        }
    }
}
