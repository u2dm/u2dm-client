import { Button, Palette, ProgressIndicator } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Actions } from "../../../../../actions.slint";
import { SendState } from "../../../../../enums.slint";
import { Fonts, IconSize, Metrics, Space } from "../../../../../theme.slint";

export component FileMessage inherits VerticalLayout {
    in property <string> body;
    in property <string> event-id;
    in property <SendState> send-state;
    in property <float> send-progress;

    property <bool> is-sending: root.send-state == SendState.sending
        || root.send-state == SendState.uploading;

    spacing: Space.sm;

    HorizontalLayout {
        spacing: Space.md;
        alignment: start;

        IconDisplay {
            icon: IconSet.Paperclip;
            size: IconSize.sm;
            stroke: Palette.foreground;
        }

        Text {
            text: root.body;
            font-size: Fonts.body;
            vertical-alignment: center;
        }

        Button {
            text: @tr("Save");
            enabled: root.event-id != "";
            clicked => {
                Actions.save-file({ event-id: root.event-id, filename: root.body });
            }
        }
    }

    if root.is-sending: ProgressIndicator {
        height: Metrics.upload-bar;
        indeterminate: root.send-state != SendState.uploading;
        progress: root.send-progress;
    }
}
