import { Palette, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { MessageEntry } from "../../types.slint";
import { MediaState } from "../../../../../enums.slint";
import { MediaFailures } from "../../../../../messages.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Space } from "../../../../../theme.slint";

export component StickerMessage inherits HorizontalLayout {
    in property <MessageEntry> msg;
    in property <bool> bubble-hovered;

    property <length> max-long-edge: Metrics.sticker-max-extent;
    property <bool> is-ready: root.msg.media-state == MediaState.ready;
    property <bool> is-failed: root.msg.media-state == MediaState.failed;
    property <bool> has-dimensions: root.msg.image-width > 0 && root.msg.image-height > 0;
    property <float> aspect: root.has-dimensions
        ? root.msg.image-width / max(root.msg.image-height, 1)
        : 1.0;
    property <bool> is-landscape: root.aspect >= 1.0;
    property <length> intrinsic-long-edge: max(root.msg.image-width, root.msg.image-height) * 1px;
    property <length> display-long-edge: root.has-dimensions
        ? min(root.intrinsic-long-edge, root.max-long-edge)
        : root.max-long-edge;

    out property <length> display-width: root.is-landscape
        ? root.display-long-edge
        : root.display-long-edge * root.aspect;
    out property <length> display-height: root.is-landscape
        ? root.display-long-edge / max(root.aspect, 0.01)
        : root.display-long-edge;

    alignment: root.msg.is-own ? end : start;

    Rectangle {
        width: root.display-width;
        height: root.display-height;

        accessible-role: image;
        accessible-label: root.is-failed
            ? @tr("Sticker unavailable. {}", MediaFailures.reason(root.msg.media-failure, false))
            : (root.msg.body != "" ? @tr("Sticker: {}", root.msg.body) : @tr("Sticker"));

        if root.is-ready: Image {
            width: 100%;
            height: 100%;
            source: root.msg.thumbnail;
            image-fit: ImageFit.contain;
        }

        if !root.is-ready: Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Radius.sm;
            background: AppStyle.overlay-hover;

            if !root.is-failed: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }

            if root.is-failed: IconDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconSet.ImageOff;
                size: IconSize.lg;
                stroke: AppStyle.foreground-faint;
            }
        }

        if root.msg.body != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Space.sm;
            width: min(parent.width, alt-text.preferred-width + Space.xl);
            height: alt-text.preferred-height + Space.md;
            border-radius: self.height / 2;
            background: AppStyle.overlay-sticker-scrim;
            opacity: root.is-ready && root.bubble-hovered ? 1 : 0;

            animate opacity {
                duration: Motion.fast;
                easing: ease-out;
            }

            alt-text := Text {
                x: Space.md;
                y: (parent.height - self.height) / 2;
                width: parent.width - Space.xl;
                text: root.msg.body;
                font-family: Fonts.emoji;
                font-size: Fonts.caption;
                color: Palette.foreground;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}
