import { Palette } from "std-widgets.slint";
import { AppStyle, Fonts, Radius, Space } from "../../../../../theme.slint";

export component UnsupportedMessage inherits Rectangle {
    in property <string> kind;
    in property <string> body;

    height: layout.preferred-height;
    border-radius: Radius.xs;
    background: AppStyle.overlay-hover;

    layout := HorizontalLayout {
        padding: Space.md;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: start;

        Text {
            text: "\u{2753}";
            font-size: Fonts.label;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: Space.xs;

            Text {
                text: @tr("Unsupported message type: {}", root.kind);
                font-size: Fonts.label;
                font-italic: true;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if root.body != "": Text {
                text: root.body;
                font-size: Fonts.label;
                font-italic: true;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
