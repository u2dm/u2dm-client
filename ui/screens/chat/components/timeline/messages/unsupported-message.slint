import { MessageEntry } from "../../../../../types.slint";
import { AppStyle, Fonts, Radius, Space } from "../../../../../theme.slint";

export component UnsupportedMessage inherits Rectangle {
    in property <MessageEntry> msg;
    property <color> muted: root.msg.is-own ? AppStyle.overlay-foreground-muted-own : AppStyle.overlay-foreground-muted;

    height: layout.preferred-height;
    border-radius: Radius.xs;
    background: AppStyle.well;

    layout := HorizontalLayout {
        padding: Space.md;
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: start;

        Text {
            text: "\u{2753}";
            font-size: Fonts.label;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: Space.xs;

            Text {
                text: @tr("Unsupported message type: {}", root.msg.unsupported-kind);
                font-size: Fonts.label;
                font-italic: true;
                color: root.muted;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if root.msg.body != "": Text {
                text: root.msg.body;
                font-size: Fonts.label;
                font-italic: true;
                color: root.muted;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
