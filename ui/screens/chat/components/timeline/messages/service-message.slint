import { MessageEntry } from "../../../../../types.slint";
import { AppStyle, Fonts, Space } from "../../../../../theme.slint";
import { CallWords, ServiceLabel, UpgradeLinks } from "../../../../../messages.slint";
import { LinkButton } from "../../../../../components/button.slint";
import { Actions } from "../../../../../actions.slint";
import { CallOffer, ServiceKind, UpgradeLink } from "../../../../../enums.slint";
import { CallPanel, CallSheetOpener } from "../../../../../local.slint";
import { CallView, DirectoryView, UpgradeView } from "../../../../../views.slint";
import { ReaderCount, Readers } from "../delivery-mark.slint";

export component ServiceMessage inherits VerticalLayout {
    in property <MessageEntry> msg;
    in property <int> timeline-row;

    property <bool> links-older-room: root.msg.service-kind == ServiceKind.upgraded-room-created
        && UpgradeView.predecessor != UpgradeLink.hidden
        && UpgradeView.room-id == DirectoryView.selected-room-id;
    property <bool> joining-older-room: UpgradeView.predecessor == UpgradeLink.joining;
    property <bool> call-row: root.msg.service-kind == ServiceKind.call-started
        || root.msg.service-kind == ServiceKind.call-notification
        || root.msg.service-kind == ServiceKind.call-video-notification
        || root.msg.service-kind == ServiceKind.call-declined;
    property <bool> room-offers: CallView.offer-room-id == DirectoryView.selected-room-id;
    property <bool> call-here: CallView.here-room-id == DirectoryView.selected-room-id && CallView.here-people > 0;
    property <bool> joins: CallView.offer == CallOffer.join || (CallView.offer == CallOffer.refused && root.call-here);
    property <bool> calls-back: CallView.offer == CallOffer.start
        || (CallView.offer == CallOffer.refused && !root.call-here);
    property <bool> offers-call: root.call-row && root.room-offers && (root.joins || root.calls-back);

    padding-top: Space.sm;
    padding-bottom: Space.sm;
    spacing: Space.xs;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: content.preferred-width;
            height: content.preferred-height;
            border-radius: self.height / 2;
            background: AppStyle.overlay-hover;

            content := HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.md;

                Text {
                    text: ServiceLabel.explained(
                        root.msg.service-kind,
                        root.msg.sender,
                        root.msg.service-target,
                        root.msg.service-reason);
                    font-family: Fonts.emoji;
                    font-size: Fonts.body-small;
                    color: AppStyle.foreground-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                if Readers.counted(root.msg): ReaderCount {
                    y: (parent.height - self.height) / 2;
                    msg: root.msg;
                    timeline-row: root.timeline-row;
                    tint: AppStyle.foreground-muted;
                    trailing-gap: 0;
                }
            }
        }
    }

    if root.offers-call: HorizontalLayout {
        alignment: center;

        LinkButton {
            text: root.joins ? @tr("Join current call") : root.msg.is-own ? @tr("Call again") : @tr("Call back");
            label: root.joins ? @tr("Join current call in this room")
                : root.msg.is-own ? @tr("Call again in this room")
                : CallWords.call-back(root.msg.sender);
            tint: CallView.offer == CallOffer.refused ? AppStyle.foreground-muted : AppStyle.link;
            pad: 2 * Space.sm;
            clicked => {
                CallPanel.open-sheet(
                    DirectoryView.selected-room-id,
                    root.msg.service-kind == ServiceKind.call-video-notification,
                    CallSheetOpener.composer);
            }
        }
    }

    if root.links-older-room: HorizontalLayout {
        alignment: center;

        LinkButton {
            text: UpgradeLinks.predecessor(UpgradeView.predecessor);
            label: self.text;
            enabled: !root.joining-older-room;
            tint: root.joining-older-room ? AppStyle.foreground-disabled : AppStyle.link;
            pad: 2 * Space.sm;
            clicked => {
                if UpgradeView.predecessor == UpgradeLink.open {
                    Actions.select-room(UpgradeView.predecessor-id);
                } else {
                    Actions.join-predecessor(UpgradeView.room-id);
                }
            }
        }
    }
}
