import { MediaFailure } from "../../../../../enums.slint";
import { Actions } from "../../../../../actions.slint";
import { MediaFrame } from "./media-frame.slint";

export component ImageMessage inherits MediaFrame {
    openable: root.ready && root.msg.event-id != "";
    open-label: root.msg.body != "" ? @tr("Open image: {}", root.msg.body) : @tr("Open image");
    failure-title: @tr("Image unavailable");
    opens-externally: root.msg.event-id != "" && root.msg.media-failure != MediaFailure.no-source;
    external-label: @tr("Try opening this image in another application");
    activated => {
        Actions.open-media(root.msg.event-id);
    }
}
