import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

import { ClickArea } from "../../../../components/a11y.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Space } from "../../../../theme.slint";

component AttachRow inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;

    callback clicked();

    height: Metrics.attach-row;
    border-radius: Radius.sm;
    background: touch.has-hover ? AppStyle.overlay-hover : transparent;

    touch := ClickArea {
        label: root.label;
        ring-radius: Radius.sm;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        VerticalLayout {
            alignment: center;
            IconDisplay {
                icon: root.icon;
                size: IconSize.md;
                stroke: AppStyle.foreground-muted;
            }
        }

        Text {
            text: root.label;
            font-size: Fonts.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: Palette.foreground;
        }
    }
}

export component AttachMenu inherits PickerCard {
    callback photo-picked();
    callback document-picked();

    width: Metrics.attach-menu-width;
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding: Space.sm;
        spacing: Space.xs;

        AttachRow {
            icon: IconSet.Image;
            label: @tr("Photo or video");
            clicked => {
                root.photo-picked();
            }
        }

        AttachRow {
            icon: IconSet.File;
            label: @tr("Document");
            clicked => {
                root.document-picked();
            }
        }
    }
}
