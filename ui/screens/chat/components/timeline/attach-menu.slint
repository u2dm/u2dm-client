import { IconSet } from "@lucide";

import { MenuRow } from "../../../../components/menu-row.slint";
import { PickerCard } from "../../../../components/overlay.slint";
import { Metrics, Space } from "../../../../theme.slint";
import { RoomView } from "../../../../views.slint";

export component AttachMenu inherits PickerCard {
    callback photo-chosen();
    callback document-chosen();
    callback poll-chosen();

    in property <bool> takes-focus;

    width: Metrics.attach-menu-width;
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding: Space.sm;
        spacing: Space.xs;

        if RoomView.may-send-messages: MenuRow {
            init => {
                if root.takes-focus {
                    self.take-focus();
                }
            }
            height: Metrics.attach-row;
            icon: IconSet.Image;
            label: @tr("Photo or video");
            clicked => {
                root.photo-chosen();
            }
        }

        if RoomView.may-send-messages: MenuRow {
            height: Metrics.attach-row;
            icon: IconSet.File;
            label: @tr("Document");
            clicked => {
                root.document-chosen();
            }
        }

        if RoomView.may-start-polls: MenuRow {
            init => {
                if root.takes-focus && !RoomView.may-send-messages {
                    self.take-focus();
                }
            }
            height: Metrics.attach-row;
            icon: IconSet.ChartBar;
            label: @tr("Poll");
            clicked => {
                root.poll-chosen();
            }
        }
    }
}
