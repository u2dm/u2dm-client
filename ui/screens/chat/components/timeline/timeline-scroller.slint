import { ListView } from "std-widgets.slint";

import { MessageBubble } from "./message-bubble.slint";
import { RoomView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";

export component TimelineScroller inherits Rectangle {
    in property <length> available-width;
    in property <int> anchor-index: -1;
    in property <int> timeline-token;
    in property <int> prepend-token;
    in property <bool> backwards-loading;
    in property <bool> forwards-loading;
    in property <length> top-inset;
    in property <length> bottom-inset;
    in property <length> composer-top;

    out property <bool> at-top: flickable.at-top;
    out property <bool> at-bottom: flickable.at-bottom;
    out property <bool> following: flickable.auto-scroll;

    out property <int> item-count: flickable.item-count;
    out property <int> first-unseen-row: flickable.first-unseen-row;
    out property <bool> anchor-held: flickable.anchor-held;
    out property <int> anchor-scrolls: flickable.anchor-scrolls;
    out property <bool> settling: flickable.settling;
    out property <int> seen-timeline-token: flickable.seen-timeline-token;
    out property <int> seen-prepend-token: flickable.seen-prepend-token;
    out property <length> anchor-target: flickable.anchor-target;

    property <int> max-anchor-scrolls: 20;
    property <duration> settle-interval: 60ms;
    property <length> list-height: 0;

    property <int> focus-blinks: 3;
    property <duration> blink-interval: 400ms;
    property <int> blink-phases-left: 0;
    property <bool> focus-lit: mod(root.blink-phases-left, 2) == 1;

    public function jump-to-latest() {
        flickable.release-anchor();
        flickable.scroll-to-bottom();
        flickable.auto-scroll = true;
        Actions.jump-to-latest();
    }

    function blink-focus() {
        root.blink-phases-left = 2 * root.focus-blinks - 1;
    }

    blink := Timer {
        interval: root.blink-interval;
        running: root.blink-phases-left > 0;
        triggered => {
            root.blink-phases-left -= 1;
        }
    }

    settle := Timer {
        interval: root.settle-interval;
        running: false;
        triggered => {
            self.running = false;
            flickable.settle-anchor();
        }
    }

    step := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            flickable.step-anchor();
        }
    }

    adopt-unseen-token := Timer {
        interval: 1ms;
        running: root.timeline-token != flickable.seen-timeline-token;
        triggered => {
            flickable.adopt-timeline();
        }
    }

    flickable := ListView {
        width: parent.width;
        height: root.list-height > 0 ? min(parent.height, root.list-height) : parent.height;
        y: parent.height - self.height;

        property <length> scroll-threshold: 40px;
        property <length> scroll-end-epsilon: 0.5px;
        property <bool> auto-scroll: true;
        property <bool> programmatic-scroll: false;
        property <bool> settling: false;

        property <bool> was-at-top: false;
        property <bool> was-at-bottom: true;
        property <bool> at-top: self.content-y >= -self.scroll-threshold;
        property <bool> at-bottom:
            self.content-y <= -(self.max-scroll-y - self.scroll-threshold);
        property <bool> at-scroll-end:
            self.content-y <= -(self.max-scroll-y - self.scroll-end-epsilon);

        property <int> first-unseen-row: 0;

        public function note-reading-edge(row: int) {
            if self.first-unseen-row == row {
                return;
            }
            self.first-unseen-row = row;
            if !self.anchor-held {
                self.report-position();
            }
        }

        function report-position() {
            Actions.scroll-position-changed(self.at-bottom, self.first-unseen-row,
                self.seen-timeline-token);
        }

        property <int> seen-prepend-token: 0;
        property <length> prev-content-height: 0;
        property <length> prev-content-y: 0;
        property <int> prev-item-count: 0;

        property <length> max-scroll-y:
            self.content-height - self.visible-height;
        property <bool> scrollable:
            self.content-height > self.visible-height;
        property <int> item-count: RoomView.timeline.length;
        property <bool> history-prepended: root.prepend-token != self.seen-prepend-token
            && self.scrollable
            && self.prev-content-height > 0
            && self.prev-item-count > 0
            && self.item-count > self.prev-item-count;

        property <int> seen-timeline-token: 0;
        property <bool> anchor-held: false;
        property <int> anchor-scrolls: 0;
        property <int> reported-row: -1;
        property <length> reported-drift: 0;
        property <bool> last-move-corrected: false;
        property <length> anchor-target: -min(
            max(root.anchor-index * (self.content-height / max(self.item-count, 1)), 0px),
            max(self.max-scroll-y, 0px));

        changed content-height => {
            self.adopt-timeline();
            if self.anchor-held && self.anchor-scrolls >= root.max-anchor-scrolls {
                self.finish-anchor();
            }
            root.list-height = self.content-height;
            if self.anchor-held {
                self.request-anchor-step();
            } else if (self.settling || self.auto-scroll) && self.scrollable
                && self.content-y <= self.prev-content-y {
                self.scroll-to-bottom();
            } else if self.history-prepended {
                self.programmatic-scroll = true;
                self.content-y = self.anchor-content-y();
            }
            self.seen-prepend-token = root.prepend-token;
            self.prev-content-height = self.content-height;
            self.prev-item-count = self.item-count;
        }

        changed content-y => {
            if self.programmatic-scroll {
                self.programmatic-scroll = false;
            } else if !self.anchor-held {
                self.settling = false;
                if self.scrollable && self.at-top && !self.was-at-top
                    && !root.backwards-loading {
                    Actions.paginate-backwards();
                }
                if self.scrollable && self.at-bottom && !self.was-at-bottom
                    && !root.forwards-loading {
                    Actions.paginate-forwards();
                }
                if self.scrollable {
                    if self.content-y > self.prev-content-y && !self.at-scroll-end {
                        self.auto-scroll = false;
                    } else if self.at-bottom {
                        self.auto-scroll = true;
                    }
                }
            }

            self.prev-content-y = self.content-y;

            if !self.anchor-held
                && ((self.at-top != self.was-at-top) || (self.at-bottom != self.was-at-bottom)) {
                self.was-at-top = self.at-top;
                self.was-at-bottom = self.at-bottom;
                self.report-position();
            }
        }

        changed item-count => {
            self.adopt-timeline();
            if self.auto-scroll && !self.anchor-held {
                self.settling = true;
                self.scroll-to-bottom();
            }
        }

        function scroll-to-bottom() {
            self.programmatic-scroll = true;
            self.content-y = -max(self.max-scroll-y, 0px);
        }

        public function adopt-timeline() {
            if root.timeline-token == self.seen-timeline-token {
                return;
            }
            self.seen-timeline-token = root.timeline-token;
            self.seen-prepend-token = root.prepend-token;
            root.blink-phases-left = 0;
            self.first-unseen-row = 0;
            self.anchor-scrolls = 0;
            self.reported-row = -1;
            self.prev-content-height = 0;
            self.prev-content-y = 0;
            self.prev-item-count = 0;
            if root.anchor-index >= 0 {
                self.anchor-held = true;
                self.auto-scroll = false;
                self.settling = false;
                self.last-move-corrected = false;
                self.request-anchor-step();
                self.delay-settle();
            } else {
                self.release-anchor();
                self.auto-scroll = true;
                self.settling = true;
                self.scroll-to-bottom();
            }
        }

        public function release-anchor() {
            self.anchor-held = false;
            self.reported-row = -1;
        }

        function delay-settle() {
            settle.running = true;
            settle.restart();
        }

        function request-anchor-step() {
            step.running = true;
            step.restart();
        }

        public function finish-anchor() {
            if !self.anchor-held {
                return;
            }
            self.release-anchor();
            self.auto-scroll = self.at-bottom;
            self.was-at-top = self.at-top;
            self.was-at-bottom = self.at-bottom;
            self.report-position();
            if RoomView.focus-event-id != "" {
                root.blink-focus();
            }
        }

        public function note-anchor(row: int, drift: length) {
            if !self.anchor-held || row != root.anchor-index {
                return;
            }
            self.reported-row = row;
            self.reported-drift = drift;
        }

        pure function anchor-reported() -> bool {
            return self.reported-row == root.anchor-index;
        }

        public function step-anchor() {
            if !self.anchor-held {
                return;
            }
            if self.anchor-reported() {
                self.correct-anchor();
            } else if !self.last-move-corrected {
                self.approach-anchor();
            }
        }

        public function settle-anchor() {
            if !self.anchor-held {
                return;
            }
            if self.anchor-reported() {
                if !self.correct-anchor() {
                    self.finish-anchor();
                }
            } else if self.last-move-corrected || !self.approach-anchor() {
                self.finish-anchor();
            }
        }

        function correct-anchor() -> bool {
            if !self.moves-view(self.content-y - self.reported-drift) {
                return false;
            }
            self.move-anchor-view(self.content-y - self.reported-drift);
            self.last-move-corrected = true;
            return true;
        }

        function approach-anchor() -> bool {
            if root.anchor-index < 0 || root.anchor-index >= self.item-count
                || self.content-height <= 0px || !self.moves-view(self.anchor-target) {
                return false;
            }
            self.move-anchor-view(self.anchor-target);
            self.last-move-corrected = false;
            return true;
        }

        pure function moves-view(target: length) -> bool {
            return self.anchor-scrolls < root.max-anchor-scrolls
                && Math.abs(self.clamped-content-y(target) - self.content-y) > 0.5px;
        }

        function move-anchor-view(target: length) {
            self.settling = false;
            self.auto-scroll = false;
            self.anchor-scrolls += 1;
            self.reported-row = -1;
            self.programmatic-scroll = true;
            self.content-y = self.clamped-content-y(target);
            self.delay-settle();
        }

        pure function clamped-content-y(target: length) -> length {
            max(min(target, 0px), -max(self.max-scroll-y, 0px))
        }

        pure function anchor-content-y() -> length {
            -((-self.content-y / (self.prev-content-height / self.prev-item-count))
                + (self.item-count - self.prev-item-count))
                * (self.content-height / self.item-count)
        }

        for msg[row] in RoomView.timeline: VerticalLayout {
            padding-top: row == 0 ? root.top-inset : 0px;
            padding-bottom: row == RoomView.timeline.length - 1 ? root.bottom-inset : 0px;

            MessageBubble {
                is-own: msg.is-own;
                msg: msg;
                timeline-row: row;
                available-width: root.available-width;
                composer-top: root.composer-top;
                focus-lit: root.focus-lit;

                property <bool> crosses-reading-edge: self.height > 0
                    && self.absolute-position.y < root.composer-top
                    && self.absolute-position.y + self.height > root.composer-top;

                changed crosses-reading-edge => {
                    if self.crosses-reading-edge {
                        flickable.note-reading-edge(row);
                    }
                }

                property <bool> holds-anchor: row == root.anchor-index && flickable.anchor-held;
                property <length> anchor-drift: self.holds-anchor
                    ? self.absolute-position.y - root.absolute-position.y - root.top-inset
                    : 0px;

                changed holds-anchor => {
                    if self.holds-anchor {
                        flickable.note-anchor(row, self.anchor-drift);
                    }
                }

                changed anchor-drift => {
                    if self.holds-anchor {
                        flickable.note-anchor(row, self.anchor-drift);
                    }
                }

                init => {
                    if self.holds-anchor {
                        flickable.note-anchor(row, self.anchor-drift);
                    }
                    if msg.needs-media {
                        Actions.request-media(msg.unique-id);
                    }
                }
            }
        }
    }
}
