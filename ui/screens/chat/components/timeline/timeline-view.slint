import { IconSet } from "@lucide";

import { TimelineContent } from "./timeline-content.slint";
import { MessageInput } from "./message-input.slint";
import { ReactionOverlay } from "./reaction-overlay.slint";
import { MessageMenuOverlay } from "./message-menu.slint";
import { CopyNotice } from "../../../../components/copy-notice.slint";
import { ModalHost, Placement } from "../../../../components/overlay.slint";
import { ResizeEdge, ResizeHandle } from "../../../../components/resize-handle.slint";
import { AppStyle, Fonts, Glyph, Metrics, Size, Space, Stroke } from "../../../../theme.slint";
import { HeaderIconButton } from "../../../../components/button.slint";
import { CloseWatch } from "../../../../components/close-watch.slint";
import { PresenceLine, TimelineState } from "../../../../enums.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { CopyNotifier } from "../../../../components/copier.slint";
import { AudioView, CallView, DirectoryView, PresenceView, RoomView, TypingView, WindowView } from "../../../../views.slint";
import { PresenceWords, TypingLine } from "../../../../messages.slint";
import { Actions } from "../../../../actions.slint";
import { CallMode, CallPanel, CallSheetOpener, CallSize, CallSurface, LocalState, ReplySwipe, RoomMenu, RoomMenuOrigin, RoomMenuReturn, RoomSearch, Shell } from "../../../../local.slint";
import { StatusPill } from "../../../../components/status-pill.slint";
import { NowPlayingBar } from "./now-playing-bar.slint";
import { PinnedBar } from "./pinned-bar.slint";
import { HeaderTitle } from "../header-title.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { RoomInfoPane } from "../room-info.slint";
import { CallBand } from "../call/call-band.slint";
import { CallViewMenu } from "../call/call-view-menu.slint";
import { CallOffer } from "../../../../enums.slint";
import { CallWords } from "../../../../messages.slint";
import { CallJoinButton } from "../call/call-join-button.slint";

component RoomHeaderButton inherits HeaderIconButton {
    fill: AppStyle.control;
}

export component TimelineView inherits Rectangle {
    in-out property <string> input-message: "";

    in property <bool> compact: false;
    in property <length> overlay-width;
    in property <length> dock-height;
    in property <length> dock-height-with-stage;
    in property <bool> room-info-pane-fits: false;
    in property <bool> room-info-pane-shown: false;
    in property <length> room-info-pane-width;

    property <string> room-id: DirectoryView.selected-room-id;
    property <length> header-height: Metrics.header-row;
    property <length> header-avatar-size: Size.md;
    property <length> spacing: Metrics.timeline-gap;
    property <length> nav-slot: Space.lg + Size.lg + Space.md;
    property <bool> has-pins: RoomView.pinned-count > 0;
    property <length> pinned-height: root.has-pins ? Metrics.pinned-bar + Space.md : 0px;
    property <length> now-playing-height: AudioView.visible ? Metrics.now-playing-bar : 0px;
    property <bool> in-call-room: CallView.active && CallView.active-room-id == root.room-id;
    out property <bool> call-split-fits: root.width >= Metrics.call-split-min;
    property <bool> call-stage-fitted;
    property <CallSize> call-size: !CallView.active || !root.has-room || WindowView.call-windowed ? CallSize.hidden
        : CallPanel.mode == CallMode.chat-only ? CallSize.hidden
        : CallPanel.mode == CallMode.call-only ? CallSize.full
        : root.call-stage-fitted ? CallSize.stage
        : CallPanel.turn == CallSurface.call && !CallPanel.kept-chat ? CallSize.full
        : CallSize.hidden;
    property <bool> shows-band: CallView.active && root.call-size != CallSize.hidden;
    property <bool> call-split: root.shows-band && root.call-size == CallSize.stage && root.call-split-fits;
    property <length> widest-stage: max(Metrics.call-split-stage-min, root.width - Metrics.timeline-min);
    property <length> split-width: clamp(
        root.width * CallPanel.split-share,
        Metrics.call-split-stage-min,
        root.widest-stage);
    property <length> chat-x: root.call-split ? root.split-width : 0px;
    out property <bool> call-covers-timeline: root.shows-band && root.call-size == CallSize.full;
    property <bool> call-owns-header: root.call-covers-timeline && !root.in-call-room;
    out property <bool> shows-call-media: root.shows-band;
    property <int> composer-requests;
    property <bool> call-here: CallView.here-room-id == root.room-id && CallView.here-people > 0;
    property <bool> offers-call-here: CallView.offer-room-id == root.room-id;
    property <bool> offers-call-start: root.offers-call-here
        && (CallView.offer == CallOffer.start || (CallView.offer == CallOffer.refused && !root.call-here));
    property <bool> offers-call-join: root.offers-call-here
        && (CallView.offer == CallOffer.join || (CallView.offer == CallOffer.refused && root.call-here));
    property <bool> has-room: RoomView.selected-room-name != "";
    property <bool> is-loading: RoomView.timeline-status == TimelineState.loading
        || RoomView.timeline-status == TimelineState.loading-unread
        || RoomView.timeline-status == TimelineState.loading-focus;
    property <bool> is-blocking-status: root.is-loading
        || RoomView.timeline-status == TimelineState.failed
        || RoomView.timeline-status == TimelineState.disconnected;
    property <bool> can-retry: (RoomView.timeline-status == TimelineState.failed && RoomView.timeline-retryable)
        || RoomView.timeline-status == TimelineState.disconnected;
    property <int> link-serial: RoomView.message-link-serial;

    background: AppStyle.canvas;

    changed link-serial => {
        if RoomView.message-link != "" {
            notifier.copy(RoomView.message-link, @tr("Link copied"));
        }
    }

    changed room-id => {
        LocalState.forget-room();
        if !RoomSearch.opened(root.room-id) {
            RoomSearch.opened-room = "";
        }
        if CallView.active && !WindowView.call-windowed && root.room-id != CallView.active-room-id {
            CallPanel.show-chat();
        }
    }

    pure function status-message(status: TimelineState) -> string {
        if status == TimelineState.loading {
            return @tr("Loading messages...");
        }
        if status == TimelineState.loading-unread {
            return @tr("Loading unread messages...");
        }
        if status == TimelineState.loading-focus {
            return @tr("Going to the message...");
        }
        if status == TimelineState.disconnected {
            return @tr("Connection lost");
        }
        return @tr("Couldn't load messages");
    }

    public function focus-nav() {
        nav-button.take-focus();
    }

    public function focus-composer() {
        root.composer-requests += 1;
    }

    public function show-call-chat() -> bool {
        if !root.call-covers-timeline {
            return false;
        }
        CallPanel.show-chat();
        return true;
    }

    notifier := CopyNotifier { }

    if !root.has-room: Text {
        text: @tr("Select a room");
        font-size: Fonts.title;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-room: room-header := Rectangle {
        property <length> menu-slot: Space.md + Size.lg + Space.lg;
        property <length> pane-slot: root.room-info-pane-fits ? Space.md + Size.lg : 0;
        property <length> action-slot: root.offers-call-start
            ? Size.lg + Space.md
            : root.offers-call-join ? join-button.width + Space.md : 0;
        property <length> title-least: (root.compact ? 0 : Space.lg) + root.header-avatar-size + Space.md
            + header-title.title-width + Space.sm;
        property <length> join-room: self.width - title-area.x - self.menu-slot - self.pane-slot - Space.md
            - self.title-least;
        property <int> menu-returns: RoomMenu.focus-returns;
        property <int> sheet-returns: CallPanel.sheet-returns;
        property <bool> call-takes-row: root.call-owns-header;
        property <bool> row-given;

        x: root.chat-x;
        y: 0;
        width: root.width - root.chat-x;
        height: root.header-height;
        visible: !self.row-given;
        background: root.background;

        init => {
            self.row-given = self.call-takes-row;
        }

        changed call-takes-row => {
            if self.call-takes-row && self.holds-focus() {
                CallPanel.band-takes-focus += 1;
            }
            self.row-given = self.call-takes-row;
        }

        function holds-focus() -> bool {
            return title-area.has-focus || start-button.has-focus || join-button.has-focus || pane-button.has-focus
                || room-menu-button.has-focus;
        }

        changed menu-returns => {
            if RoomMenu.returns-to(RoomMenuReturn.header, DirectoryView.selected-room-id) {
                room-menu-button.take-focus();
            }
        }

        changed sheet-returns => {
            if root.offers-call-start {
                start-button.take-focus();
            } else if root.offers-call-join {
                join-button.take-focus();
            }
        }

        title-area := ClickArea {
            x: root.compact ? root.nav-slot : 0;
            width: parent.width - self.x - parent.menu-slot - parent.pane-slot - parent.action-slot;
            height: parent.height;
            enabled: !root.room-info-pane-shown;
            label: @tr("Room info");
            clicked => {
                Actions.open-room-info(DirectoryView.selected-room-id);
            }

            HorizontalLayout {
                x: root.compact ? 0 : Space.lg;
                width: parent.width - self.x - Space.sm;
                height: parent.height;
                spacing: Space.md;

                Avatar {
                    cross-axis-self-alignment: center;
                    width: root.header-avatar-size;
                    height: root.header-avatar-size;
                    color-index: RoomView.selected-room-color-index;
                    has-image: RoomView.selected-room-has-avatar;
                    image: RoomView.selected-room-avatar;
                    initial: RoomView.selected-room-initial;
                    initial-size: Glyph.xs;
                }

                header-title := HeaderTitle {
                    horizontal-stretch: 1;
                    title: RoomView.selected-room-name;
                    members: RoomView.selected-room-members;
                    encrypted: RoomView.selected-room-encrypted;
                    readable-by-anyone: RoomView.selected-room-readable-by-anyone;
                    typing: TypingView.room-id == root.room-id
                        ? TypingLine.text(TypingView.count, TypingView.first, TypingView.second)
                        : "";
                    presence-line: PresenceView.room-id == root.room-id
                        ? PresenceView.partner
                        : PresenceLine.hidden;
                    presence: PresenceWords.text(self.presence-line, PresenceView.partner-minutes);
                }
            }
        }

        start-button := RoomHeaderButton {
            x: parent.width - parent.menu-slot - parent.pane-slot - self.width;
            y: (parent.height - self.height) / 2;
            visible: root.offers-call-start;
            icon: IconSet.Phone;
            tint: CallView.offer == CallOffer.start ? AppStyle.foreground-strong : AppStyle.foreground-disabled;
            label: CallView.offer == CallOffer.start ? @tr("Start a call") : CallWords.refusal(CallView.refusal);
            tip: self.label;
            tip-below: true;
            clicked => {
                CallPanel.open-sheet(root.room-id, false, CallSheetOpener.header);
            }
        }

        join-button := CallJoinButton {
            x: parent.width - parent.menu-slot - parent.pane-slot - self.width;
            y: (parent.height - self.height) / 2;
            visible: root.offers-call-join;
            room: parent.join-room;
            faces: CallView.here-faces;
            others: CallView.here-people - (CallView.here-joined ? 1 : 0);
            video: CallView.here-video;
            refused: CallView.offer == CallOffer.refused;
            refusal: CallWords.refusal(CallView.refusal);
            clicked => {
                CallPanel.open-sheet(root.room-id, false, CallSheetOpener.header);
            }
        }

        pane-button := RoomHeaderButton {
            x: parent.width - parent.menu-slot - self.width;
            y: (parent.height - self.height) / 2;
            visible: root.room-info-pane-fits;
            icon: IconSet.PanelRight;
            active: Shell.room-info-pane-open;
            label: Shell.room-info-pane-open
                ? @tr("Hide the room info panel")
                : @tr("Show the room info panel");
            clicked => {
                Shell.room-info-pane-open = !Shell.room-info-pane-open;
            }
        }

        room-menu-button := RoomHeaderButton {
            x: parent.width - self.width - Space.lg;
            y: (parent.height - self.height) / 2;
            icon: IconSet.EllipsisVertical;
            label: @tr("Room options");
            clicked => {
                RoomMenu.open(
                    DirectoryView.selected-room-id,
                    RoomMenuOrigin.header,
                    self.absolute-position.x + self.width,
                    self.absolute-position.y + self.height,
                    self.has-focus);
            }
        }
    }

    nav-bar := Rectangle {
        x: 0;
        y: 0;
        width: root.compact ? root.nav-slot : 0;
        height: root.header-height;
        visible: root.compact;
        background: root.call-owns-header ? AppStyle.call-band : root.background;

        nav-button := RoomHeaderButton {
            x: Space.lg;
            y: (parent.height - self.height) / 2;
            enabled: root.compact;
            icon: IconSet.ArrowLeft;
            label: @tr("Back to the room list");
            clicked => {
                Shell.nav-open = true;
            }
        }
    }

    if root.has-room: stage := Rectangle {
        property <bool> swipe-within-reach: ReplySwipe.within-reach;
        property <int> menu-returns: RoomMenu.focus-returns;
        property <bool> opened-from-search: RoomSearch.opened(root.room-id) && Shell.background-reachable;
        property <bool> call-covered: root.call-covers-timeline;
        property <bool> composer-covered;
        property <int> composer-requests: root.composer-requests;
        property <length> stage-room: self.height - root.header-height - input.height - root.dock-height
            - root.pinned-height - root.now-playing-height;
        property <length> stack-room: self.height - root.header-height - input.height - root.dock-height-with-stage
            - root.pinned-height - root.now-playing-height;
        property <bool> stage-fits: self.stack-room >= Metrics.call-stage-min + Metrics.call-chat-min
            || root.call-split-fits;
        property <length> tallest-stage: max(Metrics.call-stage-min, self.stage-room - Metrics.call-chat-min);
        property <length> stage-height: min(
            self.stage-room,
            clamp(self.stage-room * CallPanel.stage-share, Metrics.call-stage-min, self.tallest-stage));
        property <bool> call-on-top: root.call-split || root.call-owns-header;
        property <length> call-top: self.call-on-top ? 0px : root.header-height;
        property <length> call-height: !root.shows-band ? 0px
            : root.call-size == CallSize.full || root.call-split ? self.height - self.call-top - root.dock-height
            : self.stage-height;
        property <length> call-width: root.call-split ? root.split-width : self.width;
        property <length> call-above-chat: root.call-split ? 0px : self.call-height;
        property <length> chat-x: root.chat-x;
        property <length> chat-width: self.width - self.chat-x;

        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        init => {
            root.call-stage-fitted = self.stage-fits;
            self.composer-covered = self.call-covered;
            if self.opened-from-search {
                self.take-keyboard-from-search();
            }
        }

        changed stage-fits => {
            self.follow-fit();
        }

        function follow-fit() {
            if self.stage-fits {
                CallPanel.kept-chat = false;
                CallPanel.space-uncovered = root.call-covers-timeline && CallPanel.mode == CallMode.call-and-chat;
            } else if input.input-focused && CallPanel.mode == CallMode.call-and-chat {
                CallPanel.kept-chat = true;
            }
            root.call-stage-fitted = self.stage-fits;
        }

        changed opened-from-search => {
            if self.opened-from-search {
                self.take-keyboard-from-search();
            }
        }

        function take-keyboard-from-search() {
            RoomSearch.opened-room = "";
            input.focus-input();
        }

        changed swipe-within-reach => {
            if self.swipe-within-reach {
                ReplySwipe.commit();
                input.focus-input();
            }
        }

        changed menu-returns => {
            if RoomMenu.return-to == RoomMenuReturn.composer {
                self.refocus-composer();
            }
        }

        changed composer-requests => {
            self.refocus-composer();
        }

        function refocus-composer() {
            if Shell.background-reachable {
                input.focus-input();
            }
        }

        function resize-stage(grow: length) {
            if self.stage-room > 0px {
                CallPanel.stage-share = clamp(self.stage-height + grow, Metrics.call-stage-min, self.tallest-stage)
                    / self.stage-room;
            }
        }

        function resize-split(grow: length) {
            CallPanel.split-share = clamp(root.split-width + grow, Metrics.call-split-stage-min, root.widest-stage)
                / self.width;
        }

        CloseWatch {
            open: Shell.room-info-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.room-info-pane-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.source-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.user-info-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.invite-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.removal-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.leave-space-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.room-preview-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.create-room-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.invite-people-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.room-log-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.readers-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.encryption-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.account-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.logout-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.call-sheet-open;
            closed => {
                stage.hand-back-sheet();
            }
        }

        function hand-back-sheet() {
            if !Shell.background-reachable {
                return;
            }
            if CallPanel.sheet-dismissed && CallPanel.sheet-opener == CallSheetOpener.room-menu {
                RoomMenu.return-focus();
            } else if CallPanel.sheet-dismissed
                && CallPanel.sheet-opener == CallSheetOpener.header
                && (root.offers-call-start || root.offers-call-join) {
                CallPanel.sheet-returns += 1;
            } else {
                input.focus-input();
            }
        }

        changed call-covered => {
            if self.call-covered && input.input-focused {
                band.focus-chat();
            }
            let uncovered = self.composer-covered && !self.call-covered;
            self.composer-covered = self.call-covered;
            if uncovered && CallPanel.space-uncovered {
                CallPanel.space-uncovered = false;
            } else if uncovered {
                self.refocus-composer();
            }
        }

        content := TimelineContent {
            x: stage.chat-x;
            y: root.header-height;
            width: stage.chat-width;
            height: parent.height - root.header-height;
            visible: !root.call-covers-timeline;
            available-width: stage.chat-width;
            top-inset: stage.call-above-chat + root.pinned-height + root.now-playing-height;
            bottom-inset: input.height + root.spacing + root.dock-height;
            composer-top: parent.height - root.dock-height - input.height;
        }

        band := CallBand {
            x: 0;
            y: stage.call-top;
            width: stage.call-width;
            height: stage.call-height;
            visible: root.shows-band;
            size: root.call-size;
            beside-chat: root.call-split;
            top-row: stage.call-on-top ? root.header-height : 0px;
            lead-inset: root.compact && root.call-owns-header ? root.nav-slot : 0px;
        }

        if root.shows-band && root.call-size == CallSize.stage && !root.call-split: ResizeHandle {
            x: 0;
            y: root.header-height + stage.call-height - self.height;
            width: stage.call-width;
            height: Metrics.divider;
            edge: ResizeEdge.bottom;
            label: @tr("Call height");
            grab-before: Space.md - Metrics.divider;
            value: stage.call-height;
            minimum: Metrics.call-stage-min;
            maximum: stage.tallest-stage;
            step: Metrics.resize-step;
            dragged(grow) => {
                stage.resize-stage(grow);
            }
            stepped(grow) => {
                stage.resize-stage(grow);
            }
        }

        if root.call-split: ResizeHandle {
            x: stage.call-width - self.width;
            y: stage.call-top;
            width: Metrics.divider;
            height: stage.call-height;
            label: @tr("Call width");
            grab-before: Space.md - Metrics.divider;
            grab-after: Metrics.divider-grab;
            value: stage.call-width;
            minimum: Metrics.call-split-stage-min;
            maximum: root.widest-stage;
            step: Metrics.resize-step;
            dragged(grow) => {
                stage.resize-split(grow);
            }
            stepped(grow) => {
                stage.resize-split(grow);
            }
        }

        if root.has-pins && !root.call-covers-timeline: Rectangle {
            x: stage.chat-x;
            y: root.header-height + stage.call-above-chat;
            width: stage.chat-width;
            height: root.pinned-height;
            background: root.background;

            TouchArea { }

            PinnedBar {
                x: Metrics.timeline-inset;
                y: 0;
                width: parent.width - 2 * Metrics.timeline-inset;
            }
        }

        header-separator := Rectangle {
            x: stage.chat-x;
            y: root.header-height + stage.call-above-chat + root.pinned-height - self.height;
            width: stage.chat-width;
            height: Stroke.hairline;
            visible: !root.call-covers-timeline;
            background: AppStyle.border;
        }

        if AudioView.visible && !root.call-covers-timeline: NowPlayingBar {
            x: stage.chat-x;
            y: root.header-height + stage.call-above-chat + root.pinned-height;
            width: stage.chat-width;
        }

        if root.is-blocking-status: StatusPill {
            x: stage.chat-x + Space.xl;
            y: parent.height - root.dock-height - input.height - root.spacing - self.height - Space.xl;
            text: root.status-message(RoomView.timeline-status);
            loading: root.is-loading;
            show-retry: root.can-retry;
            retry-label: @tr("Retry loading messages");
            retry => {
                Actions.retry-timeline();
            }
        }

        input := MessageInput {
            x: stage.chat-x;
            y: parent.height - root.dock-height - self.height;
            width: stage.chat-width;
            visible: !stage.composer-covered;
            room-id: root.room-id;
            message <=> root.input-message;
            overlay-x: -root.x - self.x;
            overlay-y: -self.y;
            overlay-width: root.overlay-width;
            overlay-height: root.height - root.dock-height;
        }

        if root.room-info-pane-shown: RoomInfoPane {
            x: parent.width;
            y: 0;
            width: root.room-info-pane-width;
            height: parent.height;
            overlay-width: root.overlay-width;
            overlay-height: root.height;
        }

        ReactionOverlay {
            x: -root.x;
            y: 0;
            width: root.overlay-width;
            height: root.height - root.dock-height;
            timeline-bottom: content.y + content.height - root.dock-height - input.height;
            closed => {
                input.focus-input();
            }
        }

        if notifier.notice != "": CopyNotice {
            x: stage.chat-x + (stage.chat-width - self.width) / 2;
            y: parent.height - root.dock-height - input.height - root.spacing - self.height - Space.xl;
            text: notifier.notice;
        }

        MessageMenuOverlay {
            x: -root.x;
            y: 0;
            width: root.overlay-width;
            height: root.height - root.dock-height;
            closed => {
                input.focus-input();
            }
            copy-requested(text) => {
                notifier.copy(text, @tr("Text copied"));
            }
        }

        if CallPanel.menu-open && root.shows-band: ModalHost {
            x: -root.x;
            y: 0;
            width: root.overlay-width;
            height: root.height;
            dim: false;
            label: @tr("View");
            dismissed => {
                CallPanel.menu-open = false;
                band.focus-menu();
            }
            opened => {
                view-menu.open(CallPanel.menu-by-keys);
            }

            view-menu := CallViewMenu {
                x: Placement.fit(band.menu-right - self.width, self.width, root.overlay-width, Space.md);
                y: Placement.fit(band.menu-bottom + Space.xs, self.height, root.height - root.dock-height, Space.md);
                room: root.height - root.dock-height - 2 * Space.md;
                beside-chat: root.call-split-fits;
                chose => {
                    CallPanel.menu-open = false;
                    if root.shows-band {
                        band.focus-menu();
                    } else {
                        CallPanel.dock-takes-focus += 1;
                    }
                }
            }
        }
    }
}
