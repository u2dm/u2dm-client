import { Palette } from "std-widgets.slint";
import { IconSet } from "@lucide";

import { TimelineContent } from "./timeline-content.slint";
import { MessageInput } from "./message-input.slint";
import { ReactionOverlay } from "./reaction-overlay.slint";
import { MessageMenuOverlay } from "./message-menu.slint";
import { CopyNotice } from "../../../../components/copy-notice.slint";
import { AppStyle, Fonts, Metrics, Size, Space } from "../../../../theme.slint";
import { HeaderIconButton } from "../../../../components/button.slint";
import { CloseWatch } from "../../../../components/close-watch.slint";
import { TimelineState } from "../../../../enums.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { CopyNotifier } from "../../../../components/copier.slint";
import { AudioView, DirectoryView, RoomView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { LocalState, ReplySwipe, RoomMenu, RoomMenuOrigin, RoomMenuReturn, RoomSearch, Shell } from "../../../../local.slint";
import { StatusPill } from "../../../../components/status-pill.slint";
import { NowPlayingBar } from "./now-playing-bar.slint";
import { PinnedBar } from "./pinned-bar.slint";
import { HeaderTitle } from "../header-title.slint";
import { RoomInfoPane } from "../room-info.slint";

export component TimelineView inherits Rectangle {
    in-out property <string> input-message: "";

    in property <bool> compact: false;
    in property <length> overlay-width;
    in property <bool> room-info-pane-fits: false;
    in property <bool> room-info-pane-shown: false;
    in property <length> room-info-pane-width;

    property <string> room-id: DirectoryView.selected-room-id;
    property <length> header-height: Metrics.header-row;
    property <length> spacing: Metrics.timeline-gap;
    property <length> nav-button-width: Size.target;
    property <bool> has-pins: RoomView.pinned-count > 0;
    property <length> pinned-height: root.has-pins ? Metrics.pinned-bar : 0px;
    property <length> now-playing-height: AudioView.visible ? Metrics.now-playing-bar : 0px;
    property <bool> has-room: RoomView.selected-room-name != "";
    property <bool> is-loading: RoomView.timeline-status == TimelineState.loading
        || RoomView.timeline-status == TimelineState.loading-unread
        || RoomView.timeline-status == TimelineState.loading-focus;
    property <bool> is-blocking-status: root.is-loading
        || RoomView.timeline-status == TimelineState.failed
        || RoomView.timeline-status == TimelineState.disconnected;
    property <bool> can-retry: (RoomView.timeline-status == TimelineState.failed && RoomView.timeline-retryable)
        || RoomView.timeline-status == TimelineState.disconnected;
    property <int> link-serial: RoomView.message-link-serial;

    background: Palette.background;

    changed link-serial => {
        if RoomView.message-link != "" {
            notifier.copy(RoomView.message-link, @tr("Link copied"));
        }
    }

    changed room-id => {
        root.input-message = "";
        LocalState.forget-room();
        if !RoomSearch.opened(root.room-id) {
            RoomSearch.opened-room = "";
        }
    }

    pure function status-message(status: TimelineState) -> string {
        if status == TimelineState.loading {
            return @tr("Loading messages...");
        }
        if status == TimelineState.loading-unread {
            return @tr("Loading unread messages...");
        }
        if status == TimelineState.loading-focus {
            return @tr("Going to the message...");
        }
        if status == TimelineState.disconnected {
            return @tr("Connection lost");
        }
        return @tr("Couldn't load messages");
    }

    public function focus-nav() {
        nav-button.take-focus();
    }

    notifier := CopyNotifier { }

    if !root.has-room: Text {
        text: @tr("Select a room");
        font-size: Fonts.title;
        color: AppStyle.foreground-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-room: Rectangle {
        property <length> menu-slot: Size.lg + 2 * Space.sm;
        property <length> pane-slot: root.room-info-pane-fits ? Size.lg + Space.sm : 0;
        property <int> menu-returns: RoomMenu.focus-returns;

        x: 0;
        y: 0;
        width: root.width;
        height: root.header-height;
        background: Palette.alternate-background;

        changed menu-returns => {
            if RoomMenu.returns-to(RoomMenuReturn.header, DirectoryView.selected-room-id) {
                room-menu-button.take-focus();
            }
        }

        ClickArea {
            x: root.compact ? root.nav-button-width : 0;
            width: parent.width - self.x - parent.menu-slot - parent.pane-slot;
            height: parent.height;
            enabled: !root.room-info-pane-shown;
            background: self.has-hover ? AppStyle.overlay-subtle : transparent;
            label: @tr("Room info");
            clicked => {
                Actions.open-room-info(DirectoryView.selected-room-id);
            }

            HeaderTitle {
                x: root.compact ? 0 : Space.lg;
                width: parent.width - self.x - Space.sm;
                title: RoomView.selected-room-name;
                members: RoomView.selected-room-members;
                encrypted: RoomView.selected-room-encrypted;
            }
        }

        if root.room-info-pane-fits: HeaderIconButton {
            x: parent.width - parent.menu-slot - self.width;
            y: (parent.height - self.height) / 2;
            icon: IconSet.PanelRight;
            active: Shell.room-info-pane-open;
            label: Shell.room-info-pane-open
                ? @tr("Hide the room info panel")
                : @tr("Show the room info panel");
            clicked => {
                Shell.room-info-pane-open = !Shell.room-info-pane-open;
            }
        }

        room-menu-button := HeaderIconButton {
            x: parent.width - self.width - Space.sm;
            y: (parent.height - self.height) / 2;
            icon: IconSet.EllipsisVertical;
            label: @tr("Room options");
            clicked => {
                RoomMenu.open(
                    DirectoryView.selected-room-id,
                    RoomMenuOrigin.header,
                    self.absolute-position.x + self.width,
                    self.absolute-position.y + self.height,
                    self.has-focus);
            }
        }
    }

    nav-bar := Rectangle {
        x: 0;
        y: 0;
        width: root.compact ? root.nav-button-width : 0;
        height: root.header-height;
        visible: root.compact;
        background: Palette.alternate-background;

        nav-button := HeaderIconButton {
            x: Space.sm;
            y: (parent.height - self.height) / 2;
            enabled: root.compact;
            icon: IconSet.ArrowLeft;
            label: @tr("Back to the room list");
            clicked => {
                Shell.nav-open = true;
            }
        }
    }

    if root.has-room: stage := Rectangle {
        property <bool> swipe-within-reach: ReplySwipe.within-reach;
        property <int> menu-returns: RoomMenu.focus-returns;
        property <bool> opened-from-search: RoomSearch.opened(root.room-id) && Shell.background-reachable;

        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        init => {
            if self.opened-from-search {
                self.take-keyboard-from-search();
            }
        }

        changed opened-from-search => {
            if self.opened-from-search {
                self.take-keyboard-from-search();
            }
        }

        function take-keyboard-from-search() {
            RoomSearch.opened-room = "";
            input.focus-input();
        }

        changed swipe-within-reach => {
            if self.swipe-within-reach {
                ReplySwipe.commit();
                input.focus-input();
            }
        }

        changed menu-returns => {
            if RoomMenu.return-to == RoomMenuReturn.composer {
                self.refocus-composer();
            }
        }

        function refocus-composer() {
            if Shell.background-reachable {
                input.focus-input();
            }
        }

        CloseWatch {
            open: Shell.room-info-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.room-info-pane-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.source-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.user-info-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.room-log-open;
            closed => {
                stage.refocus-composer();
            }
        }

        CloseWatch {
            open: Shell.readers-open;
            closed => {
                stage.refocus-composer();
            }
        }

        content := TimelineContent {
            x: 0;
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height;
            available-width: parent.width;
            top-inset: root.pinned-height + root.now-playing-height;
            bottom-inset: input.height + root.spacing;
            composer-top: parent.height - input.height;
        }

        if root.has-pins: PinnedBar {
            x: 0;
            y: root.header-height;
            width: parent.width;
        }

        if AudioView.visible: NowPlayingBar {
            x: 0;
            y: root.header-height + root.pinned-height;
            width: parent.width;
        }

        if root.is-blocking-status: StatusPill {
            x: Space.xl;
            y: parent.height - input.height - root.spacing - self.height - Space.xl;
            text: root.status-message(RoomView.timeline-status);
            loading: root.is-loading;
            show-retry: root.can-retry;
            retry-label: @tr("Retry loading messages");
            retry => {
                Actions.retry-timeline();
            }
        }

        input := MessageInput {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            room-id: root.room-id;
            message <=> root.input-message;
            overlay-x: -root.x;
            overlay-y: -self.y;
            overlay-width: root.overlay-width;
            overlay-height: root.height;
        }

        if root.room-info-pane-shown: RoomInfoPane {
            x: parent.width;
            y: 0;
            width: root.room-info-pane-width;
            height: parent.height;
            overlay-width: root.overlay-width;
            overlay-height: root.height;
        }

        ReactionOverlay {
            x: -root.x;
            y: 0;
            width: root.overlay-width;
            height: root.height;
            timeline-bottom: content.y + content.height - input.height;
            closed => {
                input.focus-input();
            }
        }

        if notifier.notice != "": CopyNotice {
            x: (parent.width - self.width) / 2;
            y: parent.height - input.height - root.spacing - self.height - Space.xl;
            text: notifier.notice;
        }

        MessageMenuOverlay {
            x: -root.x;
            y: 0;
            width: root.overlay-width;
            height: root.height;
            closed => {
                input.focus-input();
            }
            copy-requested(text) => {
                notifier.copy(text, @tr("Text copied"));
            }
        }
    }
}
