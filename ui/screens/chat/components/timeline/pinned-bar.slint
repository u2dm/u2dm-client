import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { MessagePreview } from "../../../../messages.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { IconButton } from "../../../../components/button.slint";
import { Actions } from "../../../../actions.slint";
import { RoomView } from "../../../../views.slint";
import { AppStyle, Fonts, IconSize, Metrics, Motion, Radius, Size, Space } from "../../../../theme.slint";

export component PinnedBar inherits Rectangle {
    property <bool> multiple: RoomView.pinned-count > 1;
    property <string> preview: MessagePreview.label(RoomView.pinned-kind, RoomView.pinned-body);

    height: Metrics.pinned-bar;
    border-radius: Radius.md;
    background: Palette.alternate-background;
    accessible-role: groupbox;
    accessible-label: @tr("Pinned messages");

    Rectangle {
        border-radius: root.border-radius;
        background: pinned-preview.pressed
            ? AppStyle.overlay-pressed
            : (pinned-preview.has-hover ? AppStyle.overlay-hover : transparent);

        animate background {
            duration: Motion.fast;
            easing: ease-out;
        }
    }

    HorizontalLayout {
        padding-right: root.multiple ? Space.md : 0;
        spacing: Space.sm;

        pinned-preview := ClickArea {
            horizontal-stretch: 1;
            min-width: 0;
            ring-inset: Space.xs;
            ring-radius: root.border-radius - self.ring-inset;
            label: @tr("Go to pinned message {} of {}: {}",
                RoomView.pinned-index + 1, RoomView.pinned-count, root.preview);
            clicked => {
                Actions.open-pinned(RoomView.pinned-event-id);
            }

            HorizontalLayout {
                padding-left: Space.lg;
                padding-right: Space.lg;
                spacing: Space.lg;

                IconDisplay {
                    cross-axis-self-alignment: center;
                    icon: IconSet.Pin;
                    size: IconSize.sm;
                    stroke: Palette.accent-background;
                }

                Text {
                    horizontal-stretch: 1;
                    min-width: 0;
                    text: root.preview;
                    font-family: Fonts.emoji;
                    font-size: Fonts.body-small;
                    color: AppStyle.foreground-strong;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        if root.multiple: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.sm;

            Text {
                horizontal-stretch: 0;
                text: @tr("{} / {}", RoomView.pinned-index + 1, RoomView.pinned-count);
                font-size: Fonts.caption;
                color: AppStyle.foreground-muted;
                vertical-alignment: center;
                accessible-label: @tr("Pinned message {} of {}",
                    RoomView.pinned-index + 1, RoomView.pinned-count);
                accessible-live-region: polite;
            }

            previous-pin := IconButton {
                cross-axis-self-alignment: center;
                size: Size.target-min;
                icon-size: IconSize.sm;
                icon: IconSet.ChevronUp;
                label: @tr("Previous pinned message");
                enabled: RoomView.pinned-index > 0;
                clicked => {
                    Actions.previous-pinned(RoomView.pinned-event-id);
                }
            }

            next-pin := IconButton {
                cross-axis-self-alignment: center;
                size: Size.target-min;
                icon-size: IconSize.sm;
                icon: IconSet.ChevronDown;
                label: @tr("Next pinned message");
                enabled: RoomView.pinned-index + 1 < RoomView.pinned-count;
                clicked => {
                    Actions.next-pinned(RoomView.pinned-event-id);
                }
            }
        }
    }
}
