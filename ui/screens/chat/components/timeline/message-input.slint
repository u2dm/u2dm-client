import { IconSet } from "@lucide";

import { PickerPanel, PickerSection } from "./picker-panel.slint";
import { AttachMenu } from "./attach-menu.slint";
import { ComposerField } from "./composer-field.slint";
import { EmotePopup } from "./emote-popup.slint";
import { MentionPopup } from "./mention-popup.slint";
import { EditBar, ReplyBar } from "./reply-bar.slint";
import { IdentityBanner } from "./identity-banner.slint";
import { UpgradeBanner } from "./upgrade-banner.slint";
import { ReplyQuote } from "./reply-quote.slint";
import { AppStyle, Metrics, Space, Stroke } from "../../../../theme.slint";
import { LinkButton } from "../../../../components/button.slint";
import { ModalHost } from "../../../../components/overlay.slint";
import { FocusRing, FocusTrail, Interaction } from "../../../../components/a11y.slint";
import { Actions } from "../../../../actions.slint";
import { Composer, Polls, Reactions, Shell } from "../../../../local.slint";
import { ComposerDraft, EditedMessage, ReplyDraft } from "../../../../types.slint";
import { IdentityAlertView, RoomView, UnsentView, UpgradeView } from "../../../../views.slint";
import { IdentityAlertKind, UpgradeLink } from "../../../../enums.slint";

component OversizeBanner inherits Rectangle {
    in property <bool> saving;
    in property <int> shorten-by;

    height: Metrics.reply-bar;
    background: AppStyle.danger-background;

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.md;
        padding-top: Space.md;
        padding-bottom: Space.md;

        ReplyQuote {
            horizontal-stretch: 1;
            accent: AppStyle.danger;
            liveness: AccessibleLiveness.assertive;
            sender: root.saving ? @tr("Edit too long to save") : @tr("Too long to send");
            preview: @tr("Shorten it by about {}%", root.shorten-by);
        }
    }
}

component UnsentBanner inherits Rectangle {
    in property <bool> restorable: true;

    callback restore-clicked();
    callback discard-clicked();

    property <bool> too-long: UnsentView.shorten-by > 0;

    height: Metrics.reply-bar;
    background: AppStyle.danger-background;

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.md;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.md;

        ReplyQuote {
            horizontal-stretch: 1;
            accent: AppStyle.danger;
            liveness: AccessibleLiveness.assertive;
            sender: root.too-long
                ? (UnsentView.is-edit ? @tr("Edit too long to save") : @tr("Too long to send"))
                : (UnsentView.is-edit ? @tr("Edit not saved") : @tr("Not sent"));
            preview: root.too-long
                ? @tr("Shorten it by about {}%", UnsentView.shorten-by)
                : (UnsentView.edit-caption && UnsentView.body == "" ? @tr("No caption") : UnsentView.body);
        }

        if root.restorable: LinkButton {
            text: @tr("Restore");
            pad: 2 * Space.sm;
            label: UnsentView.is-edit
                ? @tr("Put the unsaved edit back in the composer")
                : @tr("Put the unsent message back in the composer");
            clicked => {
                root.restore-clicked();
            }
        }

        LinkButton {
            text: @tr("Discard");
            tint: AppStyle.danger-muted;
            pad: 2 * Space.sm;
            label: UnsentView.is-edit
                ? @tr("Discard the unsaved edit")
                : @tr("Discard the unsent message");
            clicked => {
                root.discard-clicked();
            }
        }
    }
}

export component MessageInput inherits Rectangle {
    in property <string> room-id;
    in-out property <string> message: "";
    out property <bool> input-focused: field.input-focused;

    in property <length> overlay-x;
    in property <length> overlay-y;
    in property <length> overlay-width;
    in property <length> overlay-height;

    property <PickerSection> picker-section;
    property <bool> writable: RoomView.may-send-messages;
    property <bool> offers-stickers: RoomView.may-send-stickers && !Composer.editing;
    property <bool> picker-offered: root.writable || root.offers-stickers;
    property <bool> attach-offered: root.writable || RoomView.may-start-polls;
    property <string> attach-label: !root.writable
        ? @tr("Create a poll")
        : RoomView.may-start-polls
        ? @tr("Attach a file or create a poll")
        : @tr("Attach a photo or a file");
    property <string> picker-label: !root.writable
        ? @tr("Stickers")
        : root.offers-stickers
        ? @tr("Emoji, emotes and stickers")
        : @tr("Emoji and emotes");
    property <bool> edits-caption: Composer.editing && Composer.edited.caption;
    property <string> placeholder: !Composer.editing
        ? @tr("Send a message...")
        : (root.edits-caption ? @tr("Add a caption...") : @tr("Edit the message..."));
    property <bool> is-replying: Composer.reply-event-id != "";
    property <bool> carries-replies: root.writable || RoomView.may-send-stickers;
    property <int> settled-submission: 0;
    property <bool> replaced: UpgradeView.successor != UpgradeLink.hidden
        && UpgradeView.room-id == root.room-id;
    property <bool> has-unsent: UnsentView.visible
        && UnsentView.room-id == root.room-id
        && UnsentView.submission != root.settled-submission
        && !Composer.editing;
    property <length> picker-headroom: root.overlay-height - root.height
        - Metrics.header-row - Space.xl;

    property <string> stashed-text;
    property <ReplyDraft> stashed-reply;
    property <string> drafted-room;
    property <int> edit-requests: Composer.edit-requests;

    property <length> surface-inset: Metrics.timeline-inset;
    property <bool> composing: root.writable && root.message != "";
    property <int> edits: field.edits;
    property <bool> field-focused: field.input-focused;
    property <int> shorten-by: 0;

    background: AppStyle.composer-gradient;
    height: field.height + root.surface-inset;

    changed edit-requests => {
        root.begin-edit(Composer.requested-edit, Composer.requested-edit.original);
    }

    init => {
        root.restore-draft();
    }

    changed room-id => {
        root.keep-draft();
        root.restore-draft();
        root.report-activity();
    }

    changed writable => {
        Shell.picker-open = false;
        Shell.attach-open = false;
    }

    changed picker-offered => {
        if !self.picker-offered {
            Shell.picker-open = false;
        }
    }

    changed attach-offered => {
        if !self.attach-offered {
            Shell.attach-open = false;
        }
    }

    changed composing => {
        root.report-activity();
    }

    changed message => {
        root.shorten-by = 0;
    }

    changed field-focused => {
        if !self.field-focused {
            FocusTrail.leave();
        }
    }

    changed edits => {
        root.report-activity();
    }

    function report-activity() {
        Actions.composer-changed(root.room-id, root.composing, root.edits);
    }

    function keep-draft() {
        Actions.keep-draft({
            held: true,
            room-id: root.drafted-room,
            text: root.message,
            caret: field.caret,
            reply: Composer.reply,
            edited: Composer.edited,
            stashed-text: root.stashed-text,
            stashed-reply: root.stashed-reply,
        });
    }

    function restore-draft() {
        root.drafted-room = root.room-id;
        let draft = Actions.take-draft(root.room-id);
        if draft.held {
            root.apply-draft(draft);
        } else {
            root.apply-draft({ });
        }
    }

    function apply-draft(draft: ComposerDraft) {
        Composer.restore-reply(draft.reply);
        Composer.edited = draft.edited;
        root.stashed-text = draft.stashed-text;
        root.stashed-reply = draft.stashed-reply;
        field.replace-text(draft.text);
        field.place-caret(draft.caret);
    }

    function submit() {
        let verdict = Actions.send-message({
            room-id: root.room-id,
            body: root.message,
            reply-to: Composer.reply-event-id,
            reply-sender: Composer.reply-sender,
            reply-preview: Composer.reply-preview,
        });
        root.shorten-by = verdict.shorten-by;
        if !verdict.accepted {
            return;
        }
        field.clear();
        Composer.clear-reply();
    }

    function begin-edit(target: EditedMessage, text: string) {
        Shell.picker-open = false;
        Shell.attach-open = false;
        if Composer.is-being-edited(target.event-id, target.local-id) {
            field.focus-input();
            return;
        }
        if !Composer.editing {
            root.stashed-text = root.message;
            root.stashed-reply = Composer.reply;
            Composer.clear-reply();
        }
        Composer.edited = target;
        field.replace-text(text);
        field.focus-input();
    }

    function finish-edit() {
        Shell.picker-open = false;
        Composer.edited = { };
        Composer.restore-reply(root.stashed-reply);
        field.replace-text(root.stashed-text);
        root.stashed-text = "";
        root.stashed-reply = { };
        field.focus-input();
    }

    function save-edit() {
        let verdict = Actions.edit-message({
            room-id: root.room-id,
            unique-id: Composer.edited.unique-id,
            timeline-token: Composer.edited.timeline-token,
            event-id: Composer.edited.event-id,
            local-id: Composer.edited.local-id,
            caption: Composer.edited.caption,
            restored: Composer.edited.restored,
            original: Composer.edited.original,
            body: root.message,
        });
        root.shorten-by = verdict.shorten-by;
        if verdict.accepted {
            root.finish-edit();
        }
    }

    function edit-latest() -> bool {
        if RoomView.timeline-detached {
            return false;
        }
        let row = Actions.last-editable-row();
        if row < 0 {
            return false;
        }
        root.begin-edit(Composer.edit-of(RoomView.timeline[row]), RoomView.timeline[row].edit-text);
        return true;
    }

    function restore-unsent() {
        if UnsentView.is-edit {
            let row = Actions.row-of-message(UnsentView.edit-event-id, UnsentView.edit-local-id);
            let loaded = row >= 0;
            root.begin-edit({
                event-id: UnsentView.edit-event-id,
                local-id: UnsentView.edit-local-id,
                unique-id: loaded ? RoomView.timeline[row].unique-id : "",
                timeline-token: RoomView.timeline-token,
                caption: UnsentView.edit-caption,
                restored: true,
                original: "",
                preview: loaded
                    ? Composer.edit-of(RoomView.timeline[row]).preview
                    : UnsentView.edit-preview,
            }, UnsentView.body);
            root.settle-unsent();
            return;
        }
        if !root.is-replying {
            Composer.reply-event-id = UnsentView.reply-event-id;
            Composer.reply-sender = UnsentView.reply-sender;
            Composer.reply-preview = UnsentView.reply-preview;
        }
        field.insert-at-caret(UnsentView.body);
        field.focus-input();
        root.settle-unsent();
    }

    function settle-unsent() {
        root.settled-submission = UnsentView.submission;
        Actions.dismiss-unsent(UnsentView.submission);
    }

    function close-picker() {
        Shell.picker-open = false;
        field.focus-input();
    }

    public function focus-input() {
        field.focus-input();
    }

    function send-sticker(pack-id: string, shortcode: string) {
        Actions.send-sticker({
            room-id: root.room-id,
            pack-id: pack-id,
            shortcode: shortcode,
            reply-to: Composer.reply-event-id,
        });
        Composer.clear-reply();
        root.close-picker();
    }

    function close-attach() {
        Shell.attach-open = false;
        field.focus-input();
    }

    function open-poll() {
        Polls.stop-editing();
        Shell.attach-open = false;
        Shell.poll-open = true;
    }

    function pick(document: bool) {
        root.close-attach();
        if document {
            Actions.pick-document(root.room-id);
        } else {
            Actions.pick-photo(root.room-id);
        }
    }

    if Shell.picker-open: ModalHost {
        x: root.overlay-x;
        y: root.overlay-y;
        width: root.overlay-width;
        height: root.overlay-height;
        dim: false;
        label: !root.writable
            ? @tr("Sticker picker")
            : root.offers-stickers
            ? @tr("Emoji, emote and sticker picker")
            : @tr("Emoji and emote picker");
        dismissed => {
            root.close-picker();
        }

        PickerPanel {
            width: min(root.width - Space.xl, Metrics.picker-width);
            height: max(
                Metrics.picker-min-height,
                min(Metrics.picker-height, root.picker-headroom),
            );
            x: root.width - self.width - Space.md - root.overlay-x;
            y: -self.height - Space.md - root.overlay-y;
            section <=> root.picker-section;
            emoji: root.writable;
            stickers: root.offers-stickers;
            emoji-picked(glyph) => {
                field.insert-at-caret(glyph);
            }
            emote-picked(pack-id, shortcode) => {
                field.place-emote(pack-id, shortcode, false);
            }
            sticker-picked(pack-id, shortcode) => {
                root.send-sticker(pack-id, shortcode);
            }
        }
    }

    if Shell.attach-open: ModalHost {
        x: root.overlay-x;
        y: root.overlay-y;
        width: root.overlay-width;
        height: root.overlay-height;
        dim: false;
        label: root.attach-label;
        dismissed => {
            root.close-attach();
        }

        AttachMenu {
            x: root.surface-inset + field.row-inset - root.overlay-x;
            y: -self.height - Space.md - root.overlay-y;
            photo-chosen => {
                root.pick(false);
            }
            document-chosen => {
                root.pick(true);
            }
            poll-chosen => {
                root.open-poll();
            }
        }
    }

    mentions := MentionPopup {
        x: field.x;
        y: -self.height - Space.sm;
        width: field.width;
        room-id: root.room-id;
        text: root.message;
        caret: field.caret;
        active: field.input-focused && Shell.background-reachable;
        headroom: root.picker-headroom;
        complete(insert) => {
            field.complete-mention(insert);
        }
    }

    emotes := EmotePopup {
        x: field.x;
        y: -self.height - Space.sm;
        width: field.width;
        text: root.message;
        caret: field.caret;
        active: field.input-focused && Shell.background-reachable;
        headroom: root.picker-headroom;
        complete(pack-id, shortcode) => {
            field.place-emote(pack-id, shortcode, true);
        }
    }

    Rectangle {
        x: field.x;
        y: field.y;
        width: field.width;
        height: field.height;
        border-radius: field.border-radius;
        background: AppStyle.canvas;
    }

    field := ComposerField {
        x: root.surface-inset;
        y: 0;
        width: root.width - 2 * root.surface-inset;
        text <=> root.message;
        placeholder: root.placeholder;
        input-label: root.edits-caption ? @tr("Caption") : @tr("Message");
        writable: root.writable;
        notice: @tr("You cannot send messages in this room");
        lead-shown: root.attach-offered;
        emoji-shown: root.picker-offered;
        lead-icon: IconSet.Paperclip;
        lead-label: root.attach-label;
        lead-active: Shell.attach-open;
        lead-enabled: !Composer.editing;
        emoji-label: root.picker-label;
        emoji-active: Shell.picker-open;
        text-optional: root.edits-caption;
        send-icon: Composer.editing ? IconSet.Check : IconSet.SendHorizontal;
        send-label: Composer.editing ? @tr("Save") : @tr("Send");
        lead-clicked => {
            Reactions.close();
            Shell.picker-open = false;
            Shell.attach-open = !Shell.attach-open;
        }
        emoji-clicked => {
            Reactions.close();
            Shell.attach-open = false;
            Shell.picker-open = !Shell.picker-open;
        }
        submitted => {
            if Composer.editing {
                root.save-edit();
            } else {
                root.submit();
            }
        }
        paste-pressed => {
            if Composer.editing {
                return EventResult.reject;
            }
            return Actions.paste-attachment(root.room-id) ? EventResult.accept : EventResult.reject;
        }
        key-captured(event) => {
            if mentions.key(event) == EventResult.accept {
                return EventResult.accept;
            }
            if emotes.key(event) == EventResult.accept {
                return EventResult.accept;
            }
            if event.text == Key.Escape && Composer.editing {
                root.finish-edit();
                return EventResult.accept;
            }
            if event.text == Key.UpArrow && Interaction.unmodified(event) && root.message == ""
                && !Composer.editing {
                return root.edit-latest() ? EventResult.accept : EventResult.reject;
            }
            return EventResult.reject;
        }

        if IdentityAlertView.kind != IdentityAlertKind.none: IdentityBanner { }

        if root.replaced: UpgradeBanner { }

        if root.has-unsent: UnsentBanner {
            restorable: root.writable;
            restore-clicked => {
                root.restore-unsent();
            }
            discard-clicked => {
                root.settle-unsent();
            }
        }

        if Composer.editing && root.writable: EditBar {
            caption: Composer.edited.caption;
            preview: Composer.edited.preview;
            cancel-clicked => {
                root.finish-edit();
            }
        }

        if root.is-replying && !Composer.editing && root.carries-replies: ReplyBar {
            sender: Composer.reply-sender;
            preview: Composer.reply-preview;
            cancel-clicked => {
                Composer.clear-reply();
            }
        }

        if root.shorten-by > 0 && root.writable: OversizeBanner {
            saving: Composer.editing;
            shorten-by: root.shorten-by;
        }
    }

    if root.field-focused: FocusRing {
        x: field.x;
        y: field.y;
        width: field.width;
        height: field.height;
        radius: field.border-radius;
        thickness: Stroke.hairline;
    }
}
