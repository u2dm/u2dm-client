import {
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { EmojiInsert } from "../types.slint";
import { EmojiStore } from "./emoji-picker.slint";
import { PickerPanel } from "./picker-panel.slint";
import { ReplyQuote } from "../reply-quote.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Size, Space } from "../../../../theme.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { ModalHost } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { Composer, Reactions, Shell } from "../../../../local.slint";

export component MessageInput inherits Rectangle {
    in property <string> room-id;
    in-out property <string> message: "";

    in property <length> overlay-x;
    in property <length> overlay-y;
    in property <length> overlay-width;
    in property <length> overlay-height;

    property <int> picker-tab: 0;
    property <bool> is-replying: Composer.reply-event-id != "";
    property <bool> has-text: root.message != "";
    property <int> caret: 0;
    property <EmojiInsert> pending-insert;
    property <length> picker-headroom: root.overlay-height - root.height
        - Metrics.header-row - Space.xl;

    property <int> max-lines: 6;
    property <length> text-inset: Space.md;
    property <length> line-height: line-probe.preferred-height;
    property <length> text-height: min(
        max(text-input.preferred-height, root.line-height),
        root.line-height * root.max-lines,
    );
    property <length> row-height: max(
        Metrics.composer-row,
        root.text-height + 2 * root.text-inset,
    );

    background: Palette.alternate-background;
    height: layout.preferred-height;

    function submit() {
        if root.has-text {
            Actions.send-message({
                room-id: root.room-id,
                body: root.message,
                reply-to: Composer.reply-event-id,
            });
            root.message = "";
            scroll.viewport-y = 0px;
            Composer.clear();
        }
    }

    function keep-scroll-in-range() {
        scroll.viewport-y = min(
            0px,
            max(scroll.height - scroll.viewport-height, scroll.viewport-y),
        );
    }

    function reveal-caret(caret-y: length) {
        if caret-y + scroll.viewport-y < 0px {
            scroll.viewport-y = min(
                0px,
                max(scroll.height - scroll.viewport-height, -caret-y),
            );
        } else if caret-y + scroll.viewport-y > scroll.height - root.line-height {
            scroll.viewport-y = min(
                0px,
                max(
                    scroll.height - scroll.viewport-height,
                    scroll.height - caret-y - root.line-height,
                ),
            );
        }
    }

    function close-picker() {
        Shell.picker-open = false;
        text-input.focus();
    }

    public function focus-input() {
        text-input.focus();
    }

    line-probe := Text {
        visible: false;
        text: " ";
        font-family: Fonts.emoji;
        font-size: Fonts.body;
    }

    if Shell.picker-open: ModalHost {
        x: root.overlay-x;
        y: root.overlay-y;
        width: root.overlay-width;
        height: root.overlay-height;
        dim: false;
        label: @tr("Emoji and sticker picker");
        dismissed => {
            root.close-picker();
        }

        PickerPanel {
            width: min(root.width - Space.xl, Metrics.picker-width);
            height: max(
                Metrics.picker-min-height,
                min(Metrics.picker-height, root.picker-headroom),
            );
            x: root.width - self.width - Space.md - root.overlay-x;
            y: -self.height - Space.md - root.overlay-y;
            tab <=> root.picker-tab;
            emoji-picked(glyph) => {
                root.insert-at-caret(glyph);
            }
            sticker-picked(pack-id, shortcode) => {
                root.send-sticker(pack-id, shortcode);
            }
        }
    }

    function send-sticker(pack-id: string, shortcode: string) {
        Actions.send-sticker({
            room-id: root.room-id,
            pack-id: pack-id,
            shortcode: shortcode,
            reply-to: Composer.reply-event-id,
        });
        Composer.clear();
        root.close-picker();
    }

    function insert-at-caret(glyph: string) {
        root.pending-insert = EmojiStore.insert(root.message, root.caret, glyph);
        root.message = root.pending-insert.text;
        root.caret = root.pending-insert.caret;
        text-input.focus();
        text-input.set-selection-offsets(root.pending-insert.caret, root.pending-insert.caret);
    }

    layout := VerticalLayout {
        if root.is-replying: Rectangle {
            height: Metrics.reply-bar;
            background: AppStyle.surface-sunken;

            HorizontalLayout {
                padding-left: Space.lg;
                padding-right: Space.md;
                padding-top: Space.md;
                padding-bottom: Space.md;
                spacing: Space.md;

                ReplyQuote {
                    horizontal-stretch: 1;
                    sender: @tr("Reply to {}", Composer.reply-sender);
                    preview: Composer.reply-preview;
                }

                cancel-reply-touch := ClickArea {
                    width: Size.md;
                    ring-radius: Radius.sm;
                    label: @tr("Cancel reply");
                    clicked => {
                        Composer.clear();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.X;
                        size: IconSize.sm;
                        stroke: AppStyle.foreground-muted;
                    }
                }
            }
        }

        HorizontalLayout {
            height: root.row-height;
            padding-left: Space.lg;
            padding-right: Space.lg;

            keys := FocusScope {
                horizontal-stretch: 1;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) {
                        root.submit();
                        return accept;
                    }
                    return reject;
                }

                Rectangle {
                    scroll := Flickable {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: root.text-height;
                        interactive: false;
                        viewport-width: self.width;
                        viewport-height: max(self.height, text-input.preferred-height);

                        text-input := TextInput {
                            color: Palette.foreground;
                            font-family: Fonts.emoji;
                            font-size: Fonts.body;
                            vertical-alignment: top;
                            single-line: false;
                            wrap: word-wrap;
                            page-height: scroll.height;
                            enabled: Shell.background-reachable;
                            accessible-label: @tr("Message");
                            accessible-placeholder-text: @tr("Send a message...");
                            text <=> root.message;
                            edited => {
                                root.caret = self.cursor-position-byte-offset;
                                root.keep-scroll-in-range();
                            }
                            cursor-position-changed(pos) => {
                                root.caret = self.cursor-position-byte-offset;
                                root.reveal-caret(pos.y);
                            }
                        }
                    }

                    if !root.has-text: Text {
                        x: 0;
                        y: scroll.y;
                        width: parent.width;
                        height: scroll.height;
                        text: @tr("Send a message...");
                        color: AppStyle.foreground-muted;
                        font-size: Fonts.body;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }
            }

            VerticalLayout {
                alignment: end;

                emoji-touch := ClickArea {
                    width: Size.target;
                    height: Metrics.composer-row;
                    ring-radius: Radius.sm;
                    label: @tr("Emoji and stickers");
                    clicked => {
                        Reactions.close();
                        Shell.picker-open = !Shell.picker-open;
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.Smile;
                        size: IconSize.md;
                        stroke: Shell.picker-open
                            ? Palette.accent-background
                            : AppStyle.foreground-muted;
                    }
                }
            }

            VerticalLayout {
                alignment: end;

                send-touch := ClickArea {
                    width: Size.target;
                    height: Metrics.composer-row;
                    ring-radius: Radius.sm;
                    enabled: root.has-text;
                    label: @tr("Send");
                    clicked => {
                        root.submit();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.SendHorizontal;
                        size: IconSize.md;
                        stroke: root.has-text
                            ? Palette.accent-background
                            : AppStyle.foreground-faint;
                    }
                }
            }
        }
    }
}
