import {
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { EmojiInsert } from "../types.slint";
import { EmojiStore } from "./emoji-picker.slint";
import { PickerPanel } from "./picker-panel.slint";
import { AttachMenu } from "./attach-menu.slint";
import { ReplyQuote } from "../reply-quote.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { ModalHost } from "../../../../components/overlay.slint";
import { Actions } from "../../../../actions.slint";
import { Composer, Reactions, Shell } from "../../../../local.slint";
import { UnsentView } from "../../../../views.slint";

export component MessageInput inherits Rectangle {
    in property <string> room-id;
    in-out property <string> message: "";

    in property <length> overlay-x;
    in property <length> overlay-y;
    in property <length> overlay-width;
    in property <length> overlay-height;

    property <int> picker-tab: 0;
    property <bool> is-replying: Composer.reply-event-id != "";
    property <int> settled-submission: 0;
    property <bool> has-unsent: UnsentView.visible
        && UnsentView.room-id == root.room-id
        && UnsentView.submission != root.settled-submission;
    property <bool> has-text: root.message != "";
    property <int> caret: 0;
    property <EmojiInsert> pending-insert;
    property <length> picker-headroom: root.overlay-height - root.height
        - Metrics.header-row - Space.xl;

    property <length> surface-inset: Metrics.timeline-inset;
    property <length> row-inset: Space.sm;

    property <int> max-lines: 6;
    property <length> text-inset: Space.md;
    property <length> line-height: line-probe.preferred-height;
    property <length> text-height: min(
        max(text-input.preferred-height, root.line-height),
        root.line-height * root.max-lines,
    );
    property <length> row-height: max(
        Metrics.composer-row,
        root.text-height + 2 * root.text-inset,
    );

    background: AppStyle.composer-gradient;
    height: layout.preferred-height + root.surface-inset;

    function submit() {
        if root.has-text {
            Actions.send-message({
                room-id: root.room-id,
                body: root.message,
                reply-to: Composer.reply-event-id,
                reply-sender: Composer.reply-sender,
                reply-preview: Composer.reply-preview,
            });
            root.message = "";
            scroll.content-y = 0px;
            Composer.clear();
        }
    }

    function restore-unsent() {
        if !root.is-replying {
            Composer.reply-event-id = UnsentView.reply-event-id;
            Composer.reply-sender = UnsentView.reply-sender;
            Composer.reply-preview = UnsentView.reply-preview;
        }
        root.insert-at-caret(UnsentView.body);
        text-input.focus();
        root.settle-unsent();
    }

    function settle-unsent() {
        root.settled-submission = UnsentView.submission;
        Actions.dismiss-unsent(UnsentView.submission);
    }

    function keep-scroll-in-range() {
        scroll.content-y = min(
            0px,
            max(scroll.height - scroll.content-height, scroll.content-y),
        );
    }

    function reveal-caret(caret-y: length) {
        if caret-y + scroll.content-y < 0px {
            scroll.content-y = min(
                0px,
                max(scroll.height - scroll.content-height, -caret-y),
            );
        } else if caret-y + scroll.content-y > scroll.height - root.line-height {
            scroll.content-y = min(
                0px,
                max(
                    scroll.height - scroll.content-height,
                    scroll.height - caret-y - root.line-height,
                ),
            );
        }
    }

    function close-picker() {
        Shell.picker-open = false;
        text-input.focus();
    }

    public function focus-input() {
        text-input.focus();
    }

    line-probe := Text {
        visible: false;
        text: " ";
        font-family: Fonts.emoji;
        font-size: Fonts.body;
    }

    if Shell.picker-open: ModalHost {
        x: root.overlay-x;
        y: root.overlay-y;
        width: root.overlay-width;
        height: root.overlay-height;
        dim: false;
        label: @tr("Emoji and sticker picker");
        dismissed => {
            root.close-picker();
        }

        PickerPanel {
            width: min(root.width - Space.xl, Metrics.picker-width);
            height: max(
                Metrics.picker-min-height,
                min(Metrics.picker-height, root.picker-headroom),
            );
            x: root.width - self.width - Space.md - root.overlay-x;
            y: -self.height - Space.md - root.overlay-y;
            tab <=> root.picker-tab;
            emoji-picked(glyph) => {
                root.insert-at-caret(glyph);
            }
            sticker-picked(pack-id, shortcode) => {
                root.send-sticker(pack-id, shortcode);
            }
        }
    }

    if Shell.attach-open: ModalHost {
        x: root.overlay-x;
        y: root.overlay-y;
        width: root.overlay-width;
        height: root.overlay-height;
        dim: false;
        label: @tr("Attach a photo or a file");
        dismissed => {
            root.close-attach();
        }

        AttachMenu {
            x: root.surface-inset + root.row-inset - root.overlay-x;
            y: -self.height - Space.md - root.overlay-y;
            photo-picked => {
                root.pick(false);
            }
            document-picked => {
                root.pick(true);
            }
        }
    }

    function send-sticker(pack-id: string, shortcode: string) {
        Actions.send-sticker({
            room-id: root.room-id,
            pack-id: pack-id,
            shortcode: shortcode,
            reply-to: Composer.reply-event-id,
        });
        Composer.clear();
        root.close-picker();
    }

    function close-attach() {
        Shell.attach-open = false;
        text-input.focus();
    }

    function pick(document: bool) {
        root.close-attach();
        if (document) {
            Actions.pick-document(root.room-id);
        } else {
            Actions.pick-photo(root.room-id);
        }
    }

    function insert-at-caret(glyph: string) {
        root.pending-insert = EmojiStore.insert(root.message, root.caret, glyph);
        root.message = root.pending-insert.text;
        root.caret = root.pending-insert.caret;
        text-input.set-selection-offsets(root.pending-insert.caret, root.pending-insert.caret);
    }

    surface := Rectangle {
        x: root.surface-inset;
        y: 0;
        width: root.width - 2 * root.surface-inset;
        height: layout.preferred-height;
        background: Palette.alternate-background;
        border-radius: Radius.xl;
        border-width: Stroke.hairline;
        border-color: AppStyle.border;
        clip: true;

        layout := VerticalLayout {
            if root.has-unsent: Rectangle {
                height: Metrics.reply-bar;
                background: AppStyle.danger-background;

                HorizontalLayout {
                    padding-left: Space.lg;
                    padding-right: Space.md;
                    padding-top: Space.md;
                    padding-bottom: Space.md;
                    spacing: Space.md;

                    ReplyQuote {
                        horizontal-stretch: 1;
                        accent: AppStyle.danger;
                        liveness: AccessibleLiveness.assertive;
                        sender: @tr("Not sent");
                        preview: UnsentView.body;
                    }

                    restore-touch := ClickArea {
                        width: restore-label.preferred-width + 2 * Space.sm;
                        ring-radius: Radius.sm;
                        label: @tr("Put the unsent message back in the composer");
                        clicked => {
                            root.restore-unsent();
                        }

                        restore-label := Text {
                            text: @tr("Restore");
                            color: Palette.accent-background;
                            font-size: Fonts.body-small;
                            font-weight: Weight.semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    discard-touch := ClickArea {
                        width: discard-label.preferred-width + 2 * Space.sm;
                        ring-radius: Radius.sm;
                        label: @tr("Discard the unsent message");
                        clicked => {
                            root.settle-unsent();
                        }

                        discard-label := Text {
                            text: @tr("Discard");
                            color: AppStyle.danger-muted;
                            font-size: Fonts.body-small;
                            font-weight: Weight.semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.is-replying: Rectangle {
                height: Metrics.reply-bar;
                background: AppStyle.overlay-subtle;

                HorizontalLayout {
                    padding-left: Space.lg;
                    padding-right: Space.md;
                    padding-top: Space.md;
                    padding-bottom: Space.md;
                    spacing: Space.md;

                    ReplyQuote {
                        horizontal-stretch: 1;
                        sender: @tr("Reply to {}", Composer.reply-sender);
                        preview: Composer.reply-preview;
                    }

                    cancel-reply-touch := ClickArea {
                        width: Size.md;
                        ring-radius: Radius.sm;
                        label: @tr("Cancel reply");
                        clicked => {
                            Composer.clear();
                        }

                        IconDisplay {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon: IconSet.X;
                            size: IconSize.sm;
                            stroke: AppStyle.foreground-muted;
                        }
                    }
                }
            }

            HorizontalLayout {
                height: root.row-height;
                padding-left: root.row-inset;
                padding-right: root.row-inset;

                attach-touch := ClickArea {
                    cross-axis-self-alignment: end;
                    width: Size.target;
                    height: Metrics.composer-row;
                    ring-radius: Radius.sm;
                    label: @tr("Attach a photo or a file");
                    clicked => {
                        Reactions.close();
                        Shell.picker-open = false;
                        Shell.attach-open = !Shell.attach-open;
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.Paperclip;
                        size: IconSize.md;
                        stroke: Shell.attach-open
                            ? Palette.accent-background
                            : AppStyle.foreground-muted;
                    }
                }

                keys := FocusScope {
                    horizontal-stretch: 1;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    capture-key-pressed(event) => {
                        if (event.text == Key.Return && !event.modifiers.shift) {
                            root.submit();
                            return accept;
                        }
                        return reject;
                    }

                    Rectangle {
                        scroll := Flickable {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: root.text-height;
                            interactive: false;
                            content-width: self.width;
                            content-height: max(self.height, text-input.preferred-height);

                            text-input := TextInput {
                                color: Palette.foreground;
                                font-family: Fonts.emoji;
                                font-size: Fonts.body;
                                vertical-alignment: top;
                                single-line: false;
                                wrap: word-wrap;
                                page-height: scroll.height;
                                enabled: Shell.background-reachable;
                                accessible-label: @tr("Message");
                                accessible-placeholder-text: @tr("Send a message...");
                                text <=> root.message;
                                edited => {
                                    root.caret = self.cursor-position-byte-offset;
                                    root.keep-scroll-in-range();
                                }
                                cursor-position-changed(pos) => {
                                    root.caret = self.cursor-position-byte-offset;
                                    root.reveal-caret(pos.y);
                                }
                            }
                        }

                        if !root.has-text: Text {
                            x: 0;
                            y: scroll.y;
                            width: parent.width;
                            height: scroll.height;
                            text: @tr("Send a message...");
                            color: AppStyle.foreground-muted;
                            font-size: Fonts.body;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }
                }

                emoji-touch := ClickArea {
                    cross-axis-self-alignment: end;
                    width: Size.target;
                    height: Metrics.composer-row;
                    ring-radius: Radius.sm;
                    label: @tr("Emoji and stickers");
                    clicked => {
                        Reactions.close();
                        Shell.attach-open = false;
                        Shell.picker-open = !Shell.picker-open;
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.Smile;
                        size: IconSize.md;
                        stroke: Shell.picker-open
                            ? Palette.accent-background
                            : AppStyle.foreground-muted;
                    }
                }

                send-touch := ClickArea {
                    cross-axis-self-alignment: end;
                    width: Size.target;
                    height: Metrics.composer-row;
                    ring-radius: Radius.sm;
                    enabled: root.has-text;
                    label: @tr("Send");
                    clicked => {
                        root.submit();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.SendHorizontal;
                        size: IconSize.md;
                        stroke: root.has-text
                            ? Palette.accent-background
                            : AppStyle.foreground-faint;
                    }
                }
            }
        }
    }
}
