import { Palette, ScrollView } from "std-widgets.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

import { AttachmentKind, UserMessageKind } from "../../../../enums.slint";
import { AttachmentView, DirectoryView } from "../../../../views.slint";
import { Actions } from "../../../../actions.slint";
import { Composer, ReplyDraft } from "../../../../local.slint";
import { AppStyle, Fonts, IconSize, Metrics, Opacity, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { ErrorBanner } from "../../../../components/banner.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { DialogCard, ModalHost, PickerCard } from "../../../../components/overlay.slint";
import { ComposerField } from "./composer-field.slint";
import { EmojiPicker } from "./emoji-picker.slint";
import { ReplyBar } from "./reply-bar.slint";

component CheckRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;

    height: Size.sm;

    touch := ClickArea {
        above-modal: true;
        label: root.label;
        ring-radius: Radius.sm;
        clicked => {
            root.checked = !root.checked;
        }
    }

    HorizontalLayout {
        spacing: Space.md;

        Rectangle {
            cross-axis-self-alignment: center;
            width: Size.xs;
            height: Size.xs;
            border-radius: Radius.xs;
            border-width: Stroke.hairline;
            border-color: root.checked ? Palette.accent-background : AppStyle.foreground-faint;
            background: root.checked ? Palette.accent-background : transparent;

            if root.checked: IconDisplay {
                icon: IconSet.Check;
                size: IconSize.xs;
                stroke: Palette.accent-foreground;
            }
        }

        Text {
            text: root.label;
            font-size: Fonts.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: Palette.foreground;
        }
    }
}

component FileChip inherits Rectangle {
    in property <Icon> icon: IconSet.File;
    in property <string> detail;

    height: layout.preferred-height;
    border-radius: Radius.lg;
    background: AppStyle.overlay-subtle;

    layout := HorizontalLayout {
        padding: Space.lg;
        spacing: Space.lg;

        Rectangle {
            cross-axis-self-alignment: center;
            width: Metrics.attachment-chip;
            height: Metrics.attachment-chip;
            border-radius: self.height / 2;
            background: AppStyle.accent-background-soft;

            IconDisplay {
                icon: root.icon;
                size: IconSize.lg;
                stroke: Palette.accent-background;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Space.xs;
            horizontal-stretch: 1;

            Text {
                text: AttachmentView.filename;
                font-size: Fonts.body;
                font-weight: Weight.semibold;
                overflow: elide;
                color: Palette.foreground;
            }

            Text {
                text: root.detail;
                font-size: Fonts.body-small;
                overflow: elide;
                color: AppStyle.foreground-muted;
            }
        }
    }
}

component MediaPreview inherits Rectangle {
    in property <float> aspect;

    property <length> media-width: min(root.width, root.height * root.aspect);

    border-radius: Radius.lg;
    background: AppStyle.overlay-subtle;
    clip: true;

    Image {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: root.media-width;
        height: parent.height;
        source: AttachmentView.preview;
        image-fit: contain;
        accessible-label: AttachmentView.filename;
    }

    if AttachmentView.duration != "": Rectangle {
        x: (parent.width - root.media-width) / 2 + Space.md;
        y: parent.height - self.height - Space.md;
        width: duration-text.preferred-width + Space.xl;
        height: duration-text.preferred-height + Space.md;
        border-radius: self.height / 2;
        background: AppStyle.overlay-media-scrim;

        duration-text := Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: AttachmentView.duration;
            font-size: Fonts.body-small;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }
}

export component AttachmentDialog inherits ModalHost {
    dim-opacity: AppStyle.dark ? Opacity.scrim-strong : Opacity.scrim;
    label: @tr("Send an attachment");
    dismissed => {
        if (root.picker-open) {
            root.close-picker();
        } else {
            root.cancel();
        }
    }
    opened => {
        field.focus-input();
    }

    property <length> card-width: min(AppStyle.card-width-wide, root.width - AppStyle.card-inset);
    property <length> card-height: clamp(
        root.height - AppStyle.card-inset,
        card-body.min-height,
        card-body.preferred-height,
    );
    property <length> card-padding: Space.xl;

    property <bool> as-document: false;
    property <string> caption: "";
    property <bool> holds-reply: false;
    property <ReplyDraft> held-reply;
    property <ReplyDraft> reply: root.holds-reply ? root.held-reply : Composer.reply;
    property <bool> is-replying: root.reply.event-id != "";
    property <bool> picker-open: false;

    property <bool> shows-preview: (AttachmentView.kind == AttachmentKind.image
        || AttachmentView.kind == AttachmentKind.video)
        && AttachmentView.has-preview
        && !root.as-document;
    property <bool> is-audio: AttachmentView.kind == AttachmentKind.audio && !root.as-document;
    property <string> file-detail: AttachmentView.extension == ""
        ? AttachmentView.size
        : @tr("{} · {}", AttachmentView.extension, AttachmentView.size);
    property <string> audio-detail: AttachmentView.duration == ""
        ? root.file-detail
        : @tr("{} · {}", AttachmentView.duration, AttachmentView.size);
    property <float> aspect: AttachmentView.width > 0 && AttachmentView.height > 0
        ? AttachmentView.width / AttachmentView.height
        : 1.5;
    property <length> preview-width: min(
        root.card-width - 2 * root.card-padding,
        max(Metrics.attachment-preview-min, Metrics.attachment-preview-max * root.aspect),
    );
    property <length> preview-height: min(
        Metrics.attachment-preview-max,
        max(Metrics.attachment-preview-min, root.preview-width / max(root.aspect, 0.01)),
    );
    property <length> picker-headroom: field.absolute-position.y - 2 * Space.md;

    pure function heading() -> string {
        if root.as-document || AttachmentView.kind == AttachmentKind.file {
            return @tr("Send as a file");
        }
        if AttachmentView.kind == AttachmentKind.video {
            return @tr("Send a video");
        }
        if AttachmentView.kind == AttachmentKind.audio {
            return @tr("Send an audio file");
        }
        return @tr("Send an image");
    }

    function cancel() {
        if (!AttachmentView.sending) {
            Actions.cancel-attachment();
        }
    }

    function close-picker() {
        root.picker-open = false;
        field.focus-input();
    }

    function hold-reply() {
        if (!root.holds-reply) {
            root.holds-reply = true;
            root.held-reply = Composer.reply;
            Composer.clear();
        }
    }

    function cancel-reply() {
        root.holds-reply = true;
        root.held-reply = { };
        Composer.clear();
        field.focus-input();
    }

    function submit() {
        if (!AttachmentView.sending) {
            root.hold-reply();
            Actions.send-attachment({
                room-id: DirectoryView.selected-room-id,
                caption: root.caption,
                as-document: root.as-document,
                reply-to: root.held-reply.event-id,
            });
        }
    }

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, root.card-height + AppStyle.card-inset);

        DialogCard {
            x: (root.width - self.width) / 2;
            y: (scroll.content-height - self.height) / 2;
            width: root.card-width;
            height: root.card-height;

            card-body := VerticalLayout {
                padding: root.card-padding;
                spacing: Space.lg;

                Text {
                    text: root.heading();
                    font-size: Fonts.heading;
                    font-weight: Weight.bold;
                    overflow: elide;
                }

                if root.shows-preview: MediaPreview {
                    min-height: Metrics.attachment-preview-min;
                    preferred-height: root.preview-height;
                    max-height: root.preview-height;
                    aspect: root.aspect;
                }

                if !root.shows-preview: FileChip {
                    icon: root.is-audio ? IconSet.Music : IconSet.File;
                    detail: root.is-audio ? root.audio-detail : root.file-detail;
                }

                if AttachmentView.kind == AttachmentKind.image: CheckRow {
                    label: @tr("Send as a document");
                    checked <=> root.as-document;
                }

                if AttachmentView.error != UserMessageKind.none: ErrorBanner {
                    messages: [{ kind: AttachmentView.error, detail: AttachmentView.error-detail }];
                }

                field := ComposerField {
                    background: AppStyle.page;
                    above-modal: true;
                    text <=> root.caption;
                    placeholder: @tr("Add a caption...");
                    input-label: @tr("Caption");
                    lead-icon: IconSet.X;
                    lead-label: @tr("Discard the attachment");
                    lead-destructive: true;
                    emoji-label: @tr("Emoji");
                    emoji-active: root.picker-open;
                    text-optional: true;
                    busy: AttachmentView.sending;
                    lead-clicked => {
                        root.cancel();
                    }
                    emoji-clicked => {
                        root.picker-open = true;
                    }
                    submitted => {
                        root.submit();
                    }

                    if root.is-replying: ReplyBar {
                        sender: root.reply.sender;
                        preview: root.reply.preview;
                        enabled: !AttachmentView.sending;
                        above-modal: true;
                        cancel-clicked => {
                            root.cancel-reply();
                        }
                    }
                }
            }
        }
    }

    if root.picker-open: ModalHost {
        dim: false;
        label: @tr("Emoji picker");
        dismissed => {
            root.close-picker();
        }

        PickerCard {
            width: min(root.width - Space.xl, Metrics.picker-width);
            height: max(
                Metrics.picker-min-height,
                min(Metrics.picker-height, root.picker-headroom),
            );
            x: max(Space.md, field.absolute-position.x + field.width - self.width);
            y: max(Space.md, field.absolute-position.y - self.height - Space.md);

            VerticalLayout {
                padding: Space.md;
                padding-bottom: 0;

                EmojiPicker {
                    above-modal: true;
                    picked(glyph) => {
                        field.insert-at-caret(glyph);
                    }
                }
            }
        }
    }
}
