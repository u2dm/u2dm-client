import { IconSet } from "@lucide";

import { ClickArea } from "../../../../components/a11y.slint";
import { NoticeLine } from "../../../../components/notice-line.slint";
import { AppStyle, Radius, Space } from "../../../../theme.slint";

export component PickerCell inherits ClickArea {
    in property <length> cell;
    in property <int> column;

    x: root.column * root.cell;
    y: 0;
    width: root.cell;
    height: root.cell;
    ring-radius: Radius.sm;

    Rectangle {
        width: root.cell - Space.sm;
        height: root.cell - Space.sm;
        border-radius: Radius.sm;
        background: root.has-hover ? AppStyle.overlay-hover : transparent;
    }

    @children
}

export component UnencryptedNotice inherits NoticeLine {
    icon: IconSet.ShieldAlert;
    padding-left: Space.sm;
    padding-right: Space.sm;
    padding-top: Space.xs;
}
