import { Palette } from "std-widgets.slint";

import { EmojiPicker } from "./emoji-picker.slint";
import { StickerPicker } from "./sticker-picker.slint";
import { PickerTab } from "./picker-tab.slint";
import { AppStyle, Fonts, Size, Space } from "../../../../theme.slint";
import { PickerCard } from "../../../../components/overlay.slint";

export enum PickerSection { emoji, stickers }

component PanelTab inherits PickerTab {
    horizontal-stretch: 1;
    height: Size.md;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: Fonts.body-small;
        color: root.selected ? Palette.accent-background : AppStyle.foreground-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PickerPanel inherits PickerCard {
    callback emoji-picked(string);
    callback sticker-picked(string, string);

    in-out property <PickerSection> section: PickerSection.emoji;
    in property <bool> stickers: true;
    in property <bool> above-modal: false;

    property <bool> shows-stickers: root.stickers && root.section == PickerSection.stickers;

    VerticalLayout {
        padding: Space.md;
        padding-bottom: 0;
        spacing: Space.md;

        if root.stickers: HorizontalLayout {
            height: Size.md;
            spacing: Space.sm;

            PanelTab {
                label: @tr("Emoji");
                selected: root.section == PickerSection.emoji;
                above-modal: root.above-modal;
                clicked => {
                    root.section = PickerSection.emoji;
                }
            }

            PanelTab {
                label: @tr("Stickers");
                selected: root.section == PickerSection.stickers;
                above-modal: root.above-modal;
                clicked => {
                    root.section = PickerSection.stickers;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if !root.shows-stickers: EmojiPicker {
                width: 100%;
                height: 100%;
                above-modal: root.above-modal;
                picked(glyph) => {
                    root.emoji-picked(glyph);
                }
            }

            if root.shows-stickers: StickerPicker {
                width: 100%;
                height: 100%;
                picked(pack-id, shortcode) => {
                    root.sticker-picked(pack-id, shortcode);
                }
            }
        }
    }
}
