import { Palette } from "std-widgets.slint";

import { ReactionEntry, ReactorAvatar } from "../../../../types.slint";
import { EmojiArt, ReactionSend } from "../../../../enums.slint";
import { ReactionKeys } from "../../../../messages.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { Pill } from "../../../../components/pill.slint";
import { AnchorRect } from "../../../../local.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Opacity, Space, Stroke, Weight } from "../../../../theme.slint";
import { CustomEmojiImage } from "./custom-emoji.slint";

export component ReactionGlyph inherits HorizontalLayout {
    in property <ReactionEntry> entry;
    in property <length> glyph-size;
    in property <length> image-size;
    in property <length> icon-size;

    if root.entry.art == EmojiArt.text: Text {
        text: root.entry.label;
        font-family: Fonts.emoji;
        font-size: root.glyph-size;
        vertical-alignment: center;
    }

    if root.entry.art != EmojiArt.text: CustomEmojiImage {
        key: root.entry.key;
        art: root.entry.art;
        image: root.entry.image;
        size: root.image-size;
        icon-size: root.icon-size;
    }
}

component ReactorFaces inherits Rectangle {
    in property <[ReactorAvatar]> reactors;

    width: Metrics.reactor-avatar
        + (root.reactors.length - 1) * Metrics.reactor-avatar-pitch;
    height: Metrics.reactor-avatar;

    for reactor[index] in root.reactors: Avatar {
        x: index * Metrics.reactor-avatar-pitch;
        y: (parent.height - self.height) / 2;
        width: Metrics.reactor-avatar;
        height: self.width;
        color-index: reactor.color-index;
        has-image: reactor.has-avatar;
        image: reactor.avatar;
        initial: reactor.initial;
        initial-size: Glyph.xs;
    }
}

component ReactionChip inherits Pill {
    in property <ReactionEntry> entry;
    in property <bool> is-own;
    property <bool> shows-faces: root.entry.avatars.length > 0;
    property <bool> failed: root.entry.send == ReactionSend.failed;

    property <color> mine-fill: AppStyle.chip-fill-mine;
    property <color> other-fill: root.is-own
        ? AppStyle.chip-fill
        : AppStyle.overlay-hover;

    height: Metrics.reaction-chip;
    border-width: root.entry.mine || root.failed ? Stroke.hairline : 0;
    border-color: root.failed ? AppStyle.danger-border : AppStyle.accent-border;
    fill: root.failed
        ? AppStyle.danger-background
        : root.entry.mine ? root.mine-fill : root.other-fill;
    hover-lift: root.entry.mine ? 0.15 : 0.25;
    opacity: root.entry.send == ReactionSend.sending ? Opacity.pending : 1;

    if !root.entry.overflow: ReactionGlyph {
        entry: root.entry;
        glyph-size: Glyph.xs;
        image-size: Metrics.reaction-image;
        icon-size: IconSize.xs;
    }

    if root.shows-faces: ReactorFaces {
        reactors: root.entry.avatars;
    }

    if !root.shows-faces: Text {
        text: root.entry.overflow ? "+" + root.entry.count : root.entry.count;
        font-size: Fonts.body-small;
        font-weight: Weight.semibold;
        color: root.entry.mine
            ? Palette.accent-background
            : AppStyle.foreground-strong;
        vertical-alignment: center;
    }
}

export component ReactionRow inherits FlexboxLayout {
    in property <[ReactionEntry]> reactions;
    in property <bool> is-own;
    in property <bool> can-react;
    in property <int> tracked-index: -1;

    callback toggled(string);
    callback overflow-clicked();
    callback hovered(int, string, AnchorRect);
    callback unhovered(int);

    alignment: start;
    spacing: Space.sm;

    pure function anchor(index: int, x: length, y: length, w: length, h: length) -> AnchorRect {
        return {
            row: index,
            x: x,
            y: y,
            width: w,
            height: h,
        };
    }

    for entry[index] in root.reactions: chip := ReactionChip {
        property <AnchorRect> tracked-anchor: root.tracked-index == index
            ? root.anchor(index, chip.absolute-position.x, chip.absolute-position.y, chip.width, chip.height)
            : { row: -1 };

        changed tracked-anchor => {
            if root.tracked-index == index {
                root.hovered(index, root.reactor-text(entry), self.tracked-anchor);
            }
        }

        entry: entry;
        is-own: root.is-own;
        enabled: entry.overflow || root.can-react;
        label: root.chip-label(entry);
        clicked => {
            if entry.overflow {
                root.overflow-clicked();
            } else {
                root.toggled(entry.key);
            }
        }
        changed has-hover => {
            if self.has-hover && !entry.overflow {
                root.hovered(index, root.reactor-text(entry),
                             root.anchor(index, chip.absolute-position.x, chip.absolute-position.y, chip.width, chip.height));
            } else {
                root.unhovered(index);
            }
        }
    }

    pure function reactor-text(entry: ReactionEntry) -> string {
        return entry.hidden-reactors > 0
            ? @tr("{} and {} more" , entry.reactors, entry.hidden-reactors)
            : entry.reactors;
    }

    pure function chip-label(entry: ReactionEntry) -> string {
        if entry.overflow {
            return @tr("Show {} more reactions", entry.count);
        }
        if entry.mine {
            return @tr("Remove your {} reaction, reacted by {}", ReactionKeys.label(entry.art, entry.label), root.reactor-text(entry));
        }
        return @tr("React with {}, reacted by {}", ReactionKeys.label(entry.art, entry.label), root.reactor-text(entry));
    }
}
