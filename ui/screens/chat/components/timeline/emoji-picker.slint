import { ListView, Palette } from "std-widgets.slint";
import { IconDisplay, IconSet, Icon } from "@lucide";

import { EmojiEntry } from "../../../../types.slint";
import { EmojiStore } from "../../../../emoji-store.slint";
import { SearchField } from "../../../../components/search-field.slint";
import { AppStyle, Fonts, Glyph, IconSize, Radius, Size, Space, Stroke } from "../../../../theme.slint";
import { PickerTab } from "./picker-tab.slint";
import { PickerCell } from "./picker-grid.slint";
import { ClickArea } from "../../../../components/a11y.slint";

component ToneSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    in property <string> label;
    in property <bool> above-modal;
    callback clicked();

    width: Size.xs;
    height: Size.xs;
    border-radius: self.width / 2;
    background: root.swatch;
    border-width: root.selected ? Stroke.emphasis : Stroke.hairline;
    border-color: root.selected
        ? Palette.accent-background
        : AppStyle.foreground-faint;

    ClickArea {
        label: root.label;
        above-modal: root.above-modal;
        ring-radius: Radius.md;
        clicked => {
            root.clicked();
        }
    }
}

component CategoryTab inherits PickerTab {
    in property <Icon> icon;

    horizontal-stretch: 1;
    height: Size.md;

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: IconSize.sm;
        stroke: root.selected ? Palette.accent-background : AppStyle.foreground-strong;
    }
}

export component EmojiPicker inherits Rectangle {
    callback picked(string);

    property <int> category: 0;
    property <string> query: "";
    in property <bool> above-modal: false;

    property <length> min-cell: Size.lg;
    property <length> grid-width: root.width - Space.xl;
    property <int> columns: max(1, floor(root.grid-width / root.min-cell));
    property <length> cell: root.grid-width / root.columns;
    property <int> row-count: ceil(root.current-items.length / root.columns);
    property <bool> is-searching: root.query != "";
    property <[EmojiEntry]> current-items: root.is-searching
        ? EmojiStore.results
        : (EmojiStore.groups.length > root.category
        ? EmojiStore.groups[root.category].items
        : []);

    pure function tone-glyph(entry: EmojiEntry) -> string {
        return entry.tones.length > 0 ? entry.tones[EmojiStore.tone] : entry.base;
    }

    property <[{ icon: Icon, label: string }]> categories: [
        { icon: IconSet.Smile, label: @tr("Smileys & emotion") },
        { icon: IconSet.Users, label: @tr("People & body") },
        { icon: IconSet.Cat, label: @tr("Animals & nature") },
        { icon: IconSet.Coffee, label: @tr("Food & drink") },
        { icon: IconSet.Car, label: @tr("Travel & places") },
        { icon: IconSet.Trophy, label: @tr("Activities") },
        { icon: IconSet.Lightbulb, label: @tr("Objects") },
        { icon: IconSet.Hash, label: @tr("Symbols") },
        { icon: IconSet.Flag, label: @tr("Flags") },
    ];
    property <[color]> tone-colors: [
        #FFCC4D,
        #F7DECE,
        #F3D2A2,
        #D5AB88,
        #AF7E57,
        #7C533E,
    ];

    VerticalLayout {
        padding: Space.md;
        spacing: Space.md;

        HorizontalLayout {
            height: Size.md;
            spacing: Space.md;

            SearchField {
                horizontal-stretch: 1;
                placeholder: @tr("Search emoji");
                above-modal: root.above-modal;
                query <=> root.query;
                edited(text) => {
                    EmojiStore.search(text);
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: center;
                    for swatch[idx] in root.tone-colors: ToneSwatch {
                        swatch: swatch;
                        selected: idx == EmojiStore.tone;
                        label: @tr("Skin tone {}", idx + 1);
                        above-modal: root.above-modal;
                        clicked => {
                            EmojiStore.tone = idx;
                        }
                    }
                }
            }
        }

        if !root.is-searching: HorizontalLayout {
            height: Size.md;
            spacing: Space.xs;
            for tab[idx] in root.categories: CategoryTab {
                icon: tab.icon;
                selected: idx == root.category;
                label: tab.label;
                above-modal: root.above-modal;
                clicked => {
                    root.category = idx;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            ListView {
                for row in root.row-count: Rectangle {
                    height: root.cell;

                    for column in min(root.columns, root.current-items.length - row * root.columns): emoji-cell := PickerCell {
                        property <EmojiEntry> entry: root.current-items[row * root.columns + column];

                        cell: root.cell;
                        column: column;
                        label: self.entry.name;
                        above-modal: root.above-modal;
                        clicked => {
                            root.picked(root.tone-glyph(self.entry));
                        }

                        Text {
                            text: root.tone-glyph(emoji-cell.entry);
                            font-family: Fonts.emoji;
                            font-size: Glyph.lg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.is-searching && root.current-items.length == 0: Text {
                text: @tr("No emoji found");
                color: AppStyle.foreground-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
