import { IconDisplay, IconSet, Icon } from "@lucide";

import { MessageEntry, MessageLink } from "../../../../types.slint";
import { ServiceLabel } from "../../../../messages.slint";
import { MessageShape } from "./message-body.slint";
import { QuickReactions, StripCell } from "./quick-reactions.slint";
import { Readers } from "./delivery-mark.slint";
import { ClickArea, Interaction, RovingKeys } from "../../../../components/a11y.slint";
import { ConfirmChoice, Confirmations, MenuCard, MenuConfirmation, MenuScroll } from "../../../../components/menu.slint";
import { MenuRow } from "../../../../components/menu-row.slint";
import { ModalHost, PickerCard, Placement } from "../../../../components/overlay.slint";
import { Composer, FocusHome, FocusRegion, LocalState, MessageMenu, Overlays, Polls, ReactionPopup, Reactions, RoomMenu, TextSelection } from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { RoomView } from "../../../../views.slint";
import { LinkKind, MessageKind, SendState, SpoilerState } from "../../../../enums.slint";
import { AppStyle, Glyph, IconSize, Metrics, Size, Space } from "../../../../theme.slint";

enum MenuAction {
    reply,
    edit,
    spoilers,
    copy-text,
    copy-link,
    save-as,
    view-profile,
    read-by,
    pin,
    select-text,
    view-source,
    retry,
    discard,
    delete,
}

component QuickReactionBar inherits PickerCard {
    callback picked(string);
    callback more-clicked();

    property <length> cell: Metrics.message-menu-reaction;
    property <length> pad: Space.sm;
    property <length> gap: Space.xs;
    property <int> more-index: QuickReactions.keys.length;
    property <int> count: root.more-index + 1;
    property <int> cursor: -1;

    width: root.count * root.cell + (root.count - 1) * root.gap + 2 * root.pad;
    height: root.cell + 2 * root.pad;
    border-radius: self.height / 2;
    accessible-role: groupbox;
    accessible-label: @tr("Quick reactions");
    accessible-item-count: root.count;
    accessible-delegate-focus: root.cursor;

    function run(index: int) {
        if index == root.more-index {
            root.more-clicked();
        } else if index >= 0 && index < root.more-index {
            root.picked(QuickReactions.keys[index]);
        }
    }

    keys := RovingKeys {
        count: root.count;
        cursor <=> root.cursor;
        horizontal: true;
        ring-on-any-focus: true;
        enabled: root.visible;
        activated(index) => {
            root.run(index);
        }
    }

    TouchArea { }

    HorizontalLayout {
        padding: root.pad;
        spacing: root.gap;

        for key[index] in QuickReactions.keys: StripCell {
            width: root.cell;
            height: root.cell;
            key: key;
            label: @tr("React with {}", key);
            accessible-item-index: index;
            glyph: Glyph.lg;
            focusable: false;
            roving-focus: keys.has-focus && root.cursor == index;
            clicked => {
                root.picked(key);
            }
        }

        ClickArea {
            width: root.cell;
            height: root.cell;
            border-radius: self.height / 2;
            ring-radius: self.height / 2;
            label: @tr("More reactions");
            accessible-item-index: root.more-index;
            focusable: false;
            roving-focus: keys.has-focus && root.cursor == root.more-index;
            background: self.has-hover ? AppStyle.overlay-pressed : transparent;
            clicked => {
                root.more-clicked();
            }

            IconDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Size.xs;
                height: Size.xs;
                icon: IconSet.ChevronDown;
                size: IconSize.sm;
                stroke: AppStyle.foreground-strong;
            }
        }
    }
}

component MessageMenuCard inherits MenuCard {
    in property <MessageEntry> msg;
    in property <length> room;

    callback chose(MenuAction);
    callback link-chosen(MessageLink);
    callback confirmed();
    callback cancelled();

    property <[MenuAction]> head;
    property <[MenuAction]> tail;
    property <int> links-at: root.head.length;
    property <int> tail-at: root.links-at + root.msg.links.length;
    property <int> cursor: -1;
    property <bool> asking: MessageMenu.asking-delete;
    property <ConfirmChoice> confirm-cursor: ConfirmChoice.cancel;
    out property <int> spoken-count: root.row-count;
    out property <int> spoken-index: root.asking
        ? root.row-count + (root.confirm-cursor == ConfirmChoice.confirm ? 0 : 1)
        : root.cursor;

    property <bool> has-remote-id: root.msg.event-id != "";
    property <bool> is-service: root.msg.message-type == MessageKind.service;
    property <bool> is-remote-message: root.has-remote-id && !root.is-service;
    property <bool> send-failed: root.msg.send-state == SendState.failed && root.msg.local-id != "";
    property <bool> is-poll: root.msg.message-type == MessageKind.poll;
    property <bool> carries-file: root.msg.message-type == MessageKind.image
        || root.msg.message-type == MessageKind.video
        || root.msg.message-type == MessageKind.audio
        || root.msg.message-type == MessageKind.file;

    width: Metrics.message-menu-width;
    row-count: root.tail-at + root.tail.length;
    row-height: Metrics.message-menu-row;
    height: min(root.row-count * root.row-height + 2 * root.pad, root.room);

    changed asking => {
        root.confirm-cursor = ConfirmChoice.cancel;
    }

    public pure function available(action: MenuAction) -> bool {
        if action == MenuAction.reply {
            return root.is-remote-message && !Composer.editing && RoomView.may-send-messages;
        }
        if action == MenuAction.edit {
            return (root.msg.text-editable && RoomView.may-send-messages)
                || (root.msg.poll-editable && RoomView.may-start-polls);
        }
        if action == MenuAction.copy-text {
            return root.is-service || MessageShape.has-selectable-text(root.msg);
        }
        if action == MenuAction.select-text {
            return MessageShape.has-selectable-text(root.msg);
        }
        if action == MenuAction.spoilers {
            return root.msg.spoilers != SpoilerState.none;
        }
        if action == MenuAction.copy-link || action == MenuAction.view-source {
            return root.has-remote-id;
        }
        if action == MenuAction.save-as {
            return root.has-remote-id && root.carries-file;
        }
        if action == MenuAction.view-profile {
            return !root.msg.is-own && !root.is-service && root.msg.sender-id != "";
        }
        if action == MenuAction.read-by {
            return root.has-remote-id && Readers.counted(root.msg);
        }
        if action == MenuAction.pin {
            return root.is-remote-message && RoomView.may-pin;
        }
        if action == MenuAction.delete {
            return root.is-remote-message
                && (root.msg.is-own ? RoomView.may-delete-own : RoomView.may-delete-others)
                && !Composer.is-being-edited(root.msg.event-id, root.msg.local-id);
        }
        return root.send-failed;
    }

    public function open(keyboard: bool) {
        root.head = [];
        root.tail = [];
        if root.available(MenuAction.reply) {
            root.head.push(MenuAction.reply);
        }
        if root.available(MenuAction.edit) {
            root.head.push(MenuAction.edit);
        }
        if root.available(MenuAction.spoilers) {
            root.head.push(MenuAction.spoilers);
        }
        if root.available(MenuAction.copy-text) {
            root.tail.push(MenuAction.copy-text);
        }
        if root.available(MenuAction.copy-link) {
            root.tail.push(MenuAction.copy-link);
        }
        if root.available(MenuAction.save-as) {
            root.tail.push(MenuAction.save-as);
        }
        if root.available(MenuAction.view-profile) {
            root.tail.push(MenuAction.view-profile);
        }
        if root.available(MenuAction.read-by) {
            root.tail.push(MenuAction.read-by);
        }
        if root.available(MenuAction.pin) {
            root.tail.push(MenuAction.pin);
        }
        if root.available(MenuAction.select-text) {
            root.tail.push(MenuAction.select-text);
        }
        if root.available(MenuAction.view-source) {
            root.tail.push(MenuAction.view-source);
        }
        if root.available(MenuAction.retry) {
            root.tail.push(MenuAction.retry);
        }
        if root.available(MenuAction.discard) {
            root.tail.push(MenuAction.discard);
        }
        if root.available(MenuAction.delete) {
            root.tail.push(MenuAction.delete);
        }
        root.cursor = keyboard ? 0 : -1;
        keys.focus();
    }

    pure function label-of(action: MenuAction) -> string {
        if action == MenuAction.reply {
            return @tr("Reply");
        }
        if action == MenuAction.edit {
            if root.is-poll {
                return @tr("Edit poll");
            }
            if root.msg.message-type != MessageKind.text {
                return @tr("Edit caption");
            }
            return @tr("Edit");
        }
        if action == MenuAction.copy-text {
            return @tr("Copy text");
        }
        if action == MenuAction.copy-link {
            return @tr("Copy link");
        }
        if action == MenuAction.save-as {
            return @tr("Save as…");
        }
        if action == MenuAction.view-profile {
            return @tr("View profile");
        }
        if action == MenuAction.read-by {
            return @tr("Read by {n} person" | "Read by {n} people" % root.msg.reader-count);
        }
        if action == MenuAction.pin {
            return root.msg.pinned ? @tr("Unpin") : @tr("Pin");
        }
        if action == MenuAction.select-text {
            return @tr("Select text");
        }
        if action == MenuAction.spoilers {
            return root.msg.spoilers == SpoilerState.shown ? @tr("Hide spoilers") : @tr("Reveal spoilers");
        }
        if action == MenuAction.view-source {
            return @tr("View source");
        }
        if action == MenuAction.retry {
            return @tr("Retry sending");
        }
        if action == MenuAction.discard {
            return @tr("Discard");
        }
        return @tr("Delete");
    }

    pure function delete-prompt() -> string {
        if root.msg.is-own {
            return @tr("Delete this message for everyone?");
        }
        return @tr("Delete {}'s message for everyone?", root.msg.sender);
    }

    pure function icon-of(action: MenuAction) -> Icon {
        if action == MenuAction.reply {
            return IconSet.Reply;
        }
        if action == MenuAction.edit {
            return IconSet.Pencil;
        }
        if action == MenuAction.copy-text {
            return IconSet.Copy;
        }
        if action == MenuAction.copy-link {
            return IconSet.Link;
        }
        if action == MenuAction.save-as {
            return IconSet.Download;
        }
        if action == MenuAction.view-profile {
            return IconSet.UserRound;
        }
        if action == MenuAction.read-by {
            return IconSet.Eye;
        }
        if action == MenuAction.pin {
            return root.msg.pinned ? IconSet.PinOff : IconSet.Pin;
        }
        if action == MenuAction.select-text {
            return IconSet.TextCursor;
        }
        if action == MenuAction.spoilers {
            return root.msg.spoilers == SpoilerState.shown ? IconSet.EyeOff : IconSet.Eye;
        }
        if action == MenuAction.view-source {
            return IconSet.Code;
        }
        if action == MenuAction.retry {
            return IconSet.RotateCw;
        }
        if action == MenuAction.discard {
            return IconSet.X;
        }
        return IconSet.Trash2;
    }

    pure function destructive(action: MenuAction) -> bool {
        return action == MenuAction.discard || action == MenuAction.delete;
    }

    pure function link-label(link: MessageLink) -> string {
        if link.kind == LinkKind.person {
            return @tr("View profile of {}", link.label);
        }
        return @tr("Open link: {}", link.label);
    }

    pure function link-icon(link: MessageLink) -> Icon {
        if link.kind == LinkKind.person {
            return IconSet.UserRound;
        }
        if link.kind == LinkKind.room {
            return IconSet.Hash;
        }
        return IconSet.ExternalLink;
    }

    pure function link-detail(link: MessageLink) -> string {
        return link.target == link.label ? "" : link.target;
    }

    pure function is-link(index: int) -> bool {
        return index >= root.links-at && index < root.tail-at;
    }

    pure function action-at(index: int) -> MenuAction {
        return index < root.links-at ? root.head[index] : root.tail[index - root.tail-at];
    }

    pure function link-at(index: int) -> MessageLink {
        return root.msg.links[index - root.links-at];
    }

    function answer(choice: ConfirmChoice) {
        if choice == ConfirmChoice.confirm {
            root.confirmed();
        } else {
            root.cancelled();
        }
    }

    function confirm-key(event: KeyEvent) -> EventResult {
        if event.text == Key.DownArrow || event.text == Key.UpArrow {
            root.confirm-cursor = Confirmations.other(root.confirm-cursor);
            return accept;
        }
        if Interaction.activates(event.text) {
            root.answer(root.confirm-cursor);
            return accept;
        }
        return reject;
    }

    function choose-at(index: int) {
        if index < 0 || index >= root.row-count {
            return;
        }
        if root.is-link(index) {
            root.link-chosen(root.link-at(index));
        } else {
            root.choose(root.action-at(index));
        }
    }

    function choose(action: MenuAction) {
        if root.available(action) {
            root.chose(action);
        }
    }

    keys := RovingKeys {
        count: root.row-count;
        cursor <=> root.cursor;
        paused: root.asking;
        intercept(event) => {
            if root.asking {
                return root.confirm-key(event);
            }
            return reject;
        }
        activated(index) => {
            root.choose-at(index);
        }
    }

    Rectangle {
        visible: !root.asking;

        scroll := MenuScroll {
            width: parent.width;
            height: parent.height - 2 * root.pad;
            spacing: 0;

            for action[index] in root.head: MenuRow {
                height: root.row-height;
                icon: root.icon-of(action);
                label: root.label-of(action);
                index: index;
                destructive: root.destructive(action);
                focusable: false;
                roving-focus: keys.has-focus && root.cursor == index;
                changed roving-focus => {
                    if self.roving-focus {
                        scroll.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(action);
                }
            }

            for link[index] in root.msg.links: MenuRow {
                height: root.row-height;
                icon: root.link-icon(link);
                label: root.link-label(link);
                detail: root.link-detail(link);
                index: root.links-at + index;
                focusable: false;
                roving-focus: keys.has-focus && root.cursor == root.links-at + index;
                changed roving-focus => {
                    if self.roving-focus {
                        scroll.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.link-chosen(link);
                }
            }

            for action[index] in root.tail: MenuRow {
                height: root.row-height;
                icon: root.icon-of(action);
                label: root.label-of(action);
                index: root.tail-at + index;
                destructive: root.destructive(action);
                focusable: false;
                roving-focus: keys.has-focus && root.cursor == root.tail-at + index;
                changed roving-focus => {
                    if self.roving-focus {
                        scroll.reveal(self.y, self.height);
                    }
                }
                clicked => {
                    root.choose(action);
                }
            }
        }
    }

    if root.asking: MenuConfirmation {
        padding: root.pad;
        prompt: root.delete-prompt();
        confirm-icon: IconSet.Trash2;
        confirm-label: @tr("Delete for everyone");
        row-height: root.row-height;
        cursor: root.confirm-cursor;
        rings: keys.has-focus && root.cursor >= 0;
        answered(choice) => {
            root.answer(choice);
        }
    }
}

export component MessageMenuOverlay inherits Rectangle {
    callback copy-requested(string);

    property <length> edge: Space.md;
    property <length> gap: Space.sm;
    property <MessageEntry> msg: MessageMenu.target;
    property <bool> shows-bar: root.msg.event-id != ""
        && root.msg.message-type != MessageKind.service
        && RoomView.may-react;

    pure function text-of(msg: MessageEntry) -> string {
        if msg.message-type == MessageKind.service {
            return ServiceLabel.label(msg.service-kind, msg.sender, msg.service-target);
        }
        return msg.body;
    }

    pure function card-left(width: length) -> length {
        return Placement.flip(MessageMenu.at-x, width, root.width, root.edge);
    }

    pure function card-top(height: length, headroom: length) -> length {
        return clamp(
            MessageMenu.at-y + height + root.edge > root.height ? MessageMenu.at-y - height : MessageMenu.at-y,
            root.edge + headroom,
            max(root.edge + headroom, root.height - height - root.edge));
    }

    pure function bar-left(card-x: length, card-width: length, width: length) -> length {
        return Placement.fit(card-x + (card-width - width) / 2, width, root.width, root.edge);
    }

    function dismiss() {
        MessageMenu.close();
    }

    function react(key: string) {
        Actions.toggle-reaction(root.msg.event-id, key);
        root.dismiss();
    }

    function delete-confirmed() {
        let msg = root.msg;
        if Composer.reply-event-id != "" && Composer.reply-event-id == msg.event-id {
            Composer.clear-reply();
        }
        Actions.delete-message(msg.event-id);
        root.dismiss();
    }

    function more-reactions() {
        let anchor = MessageMenu.anchor;
        MessageMenu.close();
        Reactions.open-popup(anchor, ReactionPopup.picker);
    }

    function follow(link: MessageLink) {
        root.dismiss();
        Actions.open-link(link.url);
    }

    function run(action: MenuAction) {
        let msg = root.msg;
        if action == MenuAction.select-text {
            FocusHome.entered-row(FocusRegion.timeline, msg.unique-id);
            MessageMenu.close();
            TextSelection.select(msg.unique-id);
            return;
        }
        if action == MenuAction.view-source {
            MessageMenu.close();
            Actions.open-event-source(msg.event-id);
            return;
        }
        if action == MenuAction.view-profile {
            MessageMenu.close();
            Actions.open-user-info(msg.sender-id);
            return;
        }
        if action == MenuAction.read-by {
            MessageMenu.close();
            Actions.open-readers(msg.event-id);
            return;
        }
        if action == MenuAction.delete {
            MessageMenu.asking-delete = true;
            return;
        }
        if action == MenuAction.edit && msg.poll-editable && msg.message-type == MessageKind.poll {
            MessageMenu.close();
            Polls.edit(msg);
            return;
        }
        if action == MenuAction.reply {
            FocusHome.entered(FocusRegion.composer, "");
            Composer.reply-to(msg);
        } else if action == MenuAction.edit {
            FocusHome.entered(FocusRegion.composer, "");
            Composer.request-edit(msg);
        } else if action == MenuAction.spoilers {
            Actions.show-spoilers(msg.unique-id, msg.spoilers == SpoilerState.covered);
        } else if action == MenuAction.copy-text {
            root.copy-requested(root.text-of(msg));
        } else if action == MenuAction.copy-link {
            Actions.copy-message-link(msg.event-id);
        } else if action == MenuAction.save-as {
            Actions.save-file({ event-id: msg.event-id, filename: msg.filename, mimetype: msg.mimetype });
        } else if action == MenuAction.pin && msg.pinned {
            Actions.unpin-message(msg.event-id);
        } else if action == MenuAction.pin {
            Actions.pin-message(msg.event-id);
        } else if action == MenuAction.retry {
            Actions.retry-send(msg.local-id);
        } else if action == MenuAction.discard {
            Actions.discard-send(msg.local-id);
        }
        root.dismiss();
    }

    if MessageMenu.visible: host := ModalHost {
        layer: Overlays.popup;
        property <length> headroom: root.shows-bar ? bar.height + root.gap : 0;
        property <length> card-x: root.card-left(card.width);
        property <length> card-y: root.card-top(card.height, self.headroom);

        width: 100%;
        height: 100%;
        dim: false;
        any-button-dismisses: true;
        keeps-tab: true;
        label: @tr("Message actions");
        accessible-delegate-focus: card.spoken-index < 0 ? -1 : 1 + card.spoken-index;
        accessible-item-count: card.spoken-count;
        opened => {
            RoomMenu.close();
            LocalState.close-popovers();
            card.open(MessageMenu.by-keyboard);
        }
        dismissed => {
            if MessageMenu.asking-delete {
                MessageMenu.asking-delete = false;
            } else {
                root.dismiss();
            }
        }

        bar := QuickReactionBar {
            x: root.bar-left(host.card-x, card.width, self.width);
            y: host.card-y - root.gap - self.height;
            visible: root.shows-bar;
            picked(key) => {
                root.react(key);
            }
            more-clicked => {
                root.more-reactions();
            }
        }

        card := MessageMenuCard {
            x: host.card-x;
            y: host.card-y;
            msg: root.msg;
            room: root.height - 2 * root.edge - host.headroom;
            chose(action) => {
                root.run(action);
            }
            link-chosen(link) => {
                root.follow(link);
            }
            confirmed => {
                root.delete-confirmed();
            }
            cancelled => {
                MessageMenu.asking-delete = false;
            }
        }
    }
}
