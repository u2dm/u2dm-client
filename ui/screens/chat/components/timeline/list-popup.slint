import { PickerCard } from "../../../../components/overlay.slint";
import { SectionLabel } from "../../../../components/text-roles.slint";
import { Size, Space } from "../../../../theme.slint";

export component ListPopup inherits PickerCard {
    in property <string> title;

    VerticalLayout {
        padding: Space.md;
        spacing: Space.xs;

        SectionLabel {
            text: root.title;
            horizontal-alignment: left;
            vertical-alignment: center;
            height: Size.xs;
        }

        Flickable {
            vertical-stretch: 1;
            content-height: rows.preferred-height;

            rows := VerticalLayout {
                alignment: start;
                spacing: Space.xs;

                @children
            }
        }
    }
}
