import { IconDisplay, IconSet } from "@lucide";

import { EmojiArt } from "../../../../enums.slint";
import { Actions } from "../../../../actions.slint";
import { SettingsView } from "../../../../views.slint";
import { AppStyle, Metrics, Radius } from "../../../../theme.slint";

export global EmojiBox {
    public pure function width(art: EmojiArt, source: image, size: length) -> length {
        art == EmojiArt.ready && source.height > 0
            ? min(size * source.width / source.height, Metrics.body-emoji-max-width)
            : size
    }
}

export component CustomEmojiImage inherits Rectangle {
    in property <string> key;
    in property <EmojiArt> art;
    in property <image> image;
    in property <length> size;
    in property <length> icon-size;

    property <bool> animates: SettingsView.play-animations;

    width: root.size;
    height: root.size;
    border-radius: Radius.xs;
    background: root.art == EmojiArt.pending ? AppStyle.overlay-hover : transparent;

    changed animates => {
        if root.animates && root.art == EmojiArt.ready {
            Actions.request-custom-emoji(root.key);
        }
    }

    init => {
        if root.art == EmojiArt.pending {
            Actions.request-custom-emoji(root.key);
        }
    }

    if root.art == EmojiArt.ready: Image {
        width: 100%;
        height: 100%;
        source: root.image;
        image-fit: contain;
    }

    if root.art == EmojiArt.failed: IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: IconSet.ImageOff;
        size: root.icon-size;
        stroke: AppStyle.foreground-faint;
    }
}
