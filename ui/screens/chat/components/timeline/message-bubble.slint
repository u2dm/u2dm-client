import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { MessageEntry } from "../../../../types.slint";

import { MessagePreview } from "../../../../messages.slint";
import { ReplyQuote } from "./reply-quote.slint";
import { ServiceMessage } from "./messages/service-message.slint";
import { UnreadDivider } from "./unread-divider.slint";
import { MessageBody, MessageShape } from "./message-body.slint";
import { BubbleTail } from "./bubble-tail.slint";
import { ReactionRow } from "./reaction-row.slint";
import { RowActions } from "./row-actions.slint";
import { SendFailedRow } from "./send-failed-row.slint";
import { SenderLine } from "./sender-line.slint";
import { MessageMeta } from "./message-meta.slint";
import { ContextPress } from "../context-press.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import {
    AnchorRect,
    Composer,
    MessageMenu,
    ReactionPopup,
    Reactions,
    ReplySwipe,
    Shell,
    TextSelection,
} from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { RoomView } from "../../../../views.slint";
import { AppStyle, Glyph, IconSize, Metrics, Motion, Opacity, Radius, Size, Space, Stroke } from "../../../../theme.slint";
import { MessageKind, SendState } from "../../../../enums.slint";

component BubbleReactions inherits ReactionRow {
    in property <string> event-id;

    callback detail-anchor() -> AnchorRect;

    tracked-index: Reactions.tooltip-event-id == root.event-id ? Reactions.tooltip-row : -1;

    toggled(key) => {
        Actions.toggle-reaction(root.event-id, key);
    }
    overflow-clicked => {
        Shell.picker-open = false;
        Reactions.open-popup(root.detail-anchor(), ReactionPopup.detail);
    }
    hovered(index, text, rect) => {
        Reactions.show-tooltip(root.event-id, index, text, rect);
    }
    unhovered(index) => {
        Reactions.hide-tooltip(root.event-id, index);
    }
}

component BubbleReply inherits ClickArea {
    in property <MessageEntry> msg;

    height: Metrics.reply-bar;
    enabled: root.msg.reply-event-id != "";
    label: @tr("Go to the message this replies to");
    ring-radius: Radius.md;
    clicked => {
        Actions.jump-to-event(root.msg.reply-event-id);
    }

    Rectangle {
        border-radius: root.border-radius;
        background: root.pressed
            ? AppStyle.overlay-pressed
            : (root.has-hover ? AppStyle.overlay-hover : AppStyle.overlay-subtle);
    }

    ReplyQuote {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: Space.md;
        padding-bottom: Space.md;
        sender: root.msg.reply-sender;
        preview: MessagePreview.label(root.msg.reply-kind, root.msg.reply-body);
    }
}

component BubbleFooter inherits HorizontalLayout {
    in property <MessageEntry> msg;
    in property <int> timeline-row;
    in property <bool> is-own;
    in property <bool> has-remote-id;
    in property <bool> has-reactions;

    callback detail-anchor() -> AnchorRect;

    spacing: Space.md;
    padding-left: Space.lg;
    padding-right: Space.lg;
    padding-top: root.has-reactions ? Space.sm : 0;

    if root.has-reactions: BubbleReactions {
        horizontal-stretch: 0;
        padding-bottom: Space.sm;
        reactions: root.msg.reactions;
        is-own: root.is-own;
        can-react: root.has-remote-id;
        event-id: root.msg.event-id;
        detail-anchor() => {
            return root.detail-anchor();
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    MessageMeta {
        cross-axis-self-alignment: end;
        alignment: end;
        msg: root.msg;
        timeline-row: root.timeline-row;
        tint: AppStyle.overlay-foreground-muted;
    }
}

component SenderAvatar inherits ClickArea {
    in property <MessageEntry> msg;

    enabled: root.msg.sender-id != "";
    focusable: false;
    label: @tr("View profile of {}", root.msg.sender);
    clicked => {
        Actions.open-user-info(root.msg.sender-id);
    }

    Avatar {
        width: 100%;
        height: 100%;
        color-index: root.msg.color-index;
        has-image: root.msg.has-avatar;
        image: root.msg.avatar;
        initial: root.msg.sender-initial;
        initial-size: Glyph.xs;
    }

    if root.has-hover: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: AppStyle.overlay-hover;
    }
}

export component MessageBubble inherits VerticalLayout {
    in property <bool> is-own;
    in property <MessageEntry> msg;
    in property <length> available-width;
    in property <int> timeline-row;
    in property <length> composer-top;
    in property <bool> focus-lit;

    property <color> bubble-color: root.is-own
        ? AppStyle.own-bubble
        : Palette.alternate-background;
    property <length> bubble-max-width: max(
        Metrics.bubble-max / 2,
        min(Metrics.bubble-max, root.available-width - Metrics.bubble-gutter),
    );

    property <length> avatar-size: Size.md;

    property <int> last-row: max(RoomView.timeline.length - 1, 0);
    property <MessageEntry> previous: RoomView.timeline[max(root.timeline-row - 1, 0)];
    property <MessageEntry> following: RoomView.timeline[min(root.timeline-row + 1, root.last-row)];

    property <bool> is-service: root.msg.message-type == MessageKind.service;
    property <bool> has-remote-id: root.msg.event-id != "";
    property <bool> is-focused: root.has-remote-id && root.msg.event-id == RoomView.focus-event-id;
    property <bool> strip-mine: root.has-remote-id
        && Reactions.strip-anchor.event-id == root.msg.event-id;

    property <bool> continues-previous: root.timeline-row > 0
        && MessageShape.joins-run(root.previous, root.msg);
    property <bool> continued-by-next: root.timeline-row < root.last-row
        && MessageShape.joins-run(root.msg, root.following);

    property <bool> is-sticker: root.msg.message-type == MessageKind.sticker;
    property <bool> has-photo: MessageShape.has-photo(root.msg);
    property <bool> is-photo-only: MessageShape.is-photo-only(root.msg);
    property <bool> is-unsent: root.msg.send-state != SendState.sent;
    property <bool> dims-while-unsent: root.is-unsent && !root.send-failed && !root.has-photo;
    property <bool> has-reactions: root.msg.reactions.length > 0;
    property <bool> send-failed: root.msg.send-state == SendState.failed;
    property <bool> chips-outside: root.is-photo-only && root.has-reactions;
    property <length> outside-chips-gap: Space.sm;
    property <bool> being-edited: Composer.is-being-edited(root.msg.event-id, root.msg.local-id);
    property <bool> outlined: (root.is-focused && root.focus-lit)
        || root.send-failed
        || root.being-edited;
    property <color> outline-color: root.send-failed
        ? AppStyle.danger-border
        : Palette.accent-background;
    property <bool> has-tail: !root.continued-by-next
        && !root.is-sticker
        && !root.is-photo-only;
    property <length> tail-side-top-radius: root.continues-previous ? Radius.xs : Radius.md;
    property <length> tail-side-bottom-radius: root.has-tail
        ? 0
        : (root.continued-by-next ? Radius.xs : Radius.md);

    if root.msg.first-unread: UnreadDivider { }

    if root.is-service: service-row := TouchArea {
        height: service.preferred-height;

        ContextPress {
            hovered: service-row.has-hover;
            pressed => {
                MessageMenu.open(
                    {
                        event-id: root.msg.event-id,
                        row: root.timeline-row,
                        x: service-row.absolute-position.x,
                        y: service-row.absolute-position.y,
                        width: service-row.width,
                        height: service-row.height,
                    },
                    root.msg.unique-id,
                    service-row.absolute-position.x + service-row.mouse-x,
                    service-row.absolute-position.y + service-row.mouse-y,
                    false);
            }
        }

        service := ServiceMessage {
            msg: root.msg;
            timeline-row: root.timeline-row;
        }
    }

    if !root.is-service: message-row := Rectangle {
        property <bool> has-composer: root.composer-top > 0px;
        property <length> row-top: self.absolute-position.y;
        property <bool> starts-above-composer: !self.has-composer
            || self.row-top < root.composer-top;
        property <bool> ends-below-composer: self.has-composer
            && self.row-top + self.height >= root.composer-top;
        property <bool> shows-avatar: !root.is-own
            && self.starts-above-composer
            && (!root.continued-by-next || self.ends-below-composer);

        property <bool> bubble-hovered: false;

        property <bool> swipe-mine: root.has-remote-id && ReplySwipe.event-id == root.msg.event-id;
        property <length> swipe-pull: self.swipe-mine ? ReplySwipe.pull : 0px;

        property <length> bubble-left: bubble-column.x + bubble.x;
        property <length> bubble-top: bubble-column.y + bubble.y;
        property <length> bubble-x: self.bubble-left + row.x;

        property <length> outside-chips-height: root.chips-outside
            ? Metrics.reaction-chip + root.outside-chips-gap
            : 0;

        height: row.preferred-height
            + self.outside-chips-height
            + (root.send-failed
            ? Metrics.reaction-chip + root.outside-chips-gap
            : 0);

        property <AnchorRect> tracked-anchor: root.strip-mine
            ? bubble.anchor()
            : { row: -1 };

        changed tracked-anchor => {
            Reactions.follow-bubble(self.tracked-anchor);
        }

        ContextPress {
            hovered: hover-row.has-hover;
            pressed => {
                MessageMenu.open(
                    bubble.anchor(),
                    root.msg.unique-id,
                    message-row.absolute-position.x + hover-row.mouse-x,
                    message-row.absolute-position.y + hover-row.mouse-y,
                    false);
            }
        }

        if message-row.swipe-mine: IconDisplay {
            x: message-row.bubble-left + bubble.width - self.width - Space.xs;
            y: message-row.bubble-top + (bubble.height - self.height) / 2;
            icon: IconSet.Reply;
            size: IconSize.md;
            stroke: ReplySwipe.within-reach
                ? Palette.accent-background
                : AppStyle.overlay-foreground-muted;
            opacity: ReplySwipe.reach;
        }

        hover-row := TouchArea {
            width: 100%;
            height: 100%;
            changed has-hover => {
                if self.has-hover && root.has-remote-id {
                    ReplySwipe.hover(bubble.anchor());
                } else {
                    ReplySwipe.leave(root.msg.event-id);
                }
            }

            row := HorizontalLayout {
                x: -message-row.swipe-pull;
                animate x {
                    duration: ReplySwipe.settling ? Motion.normal : 0ms;
                    easing: ease-out;
                }

                alignment: root.is-own ? end : start;
                padding-left: root.is-own ? 0 : Metrics.timeline-inset;
                padding-right: root.is-own ? Metrics.bubble-tail-width + Metrics.timeline-inset : 0;
                padding-top: root.continues-previous ? 0 : Space.sm;
                padding-bottom: Space.xs;

                if !root.is-own: Rectangle {
                    width: root.avatar-size;
                }

                if !root.is-own: Rectangle {
                    width: Space.md;
                }

                bubble-column := VerticalLayout {
                    alignment: start;
                    spacing: Space.xs;

                    if !root.is-own && !root.continues-previous: SenderLine {
                        sender: root.msg.sender;
                        pronouns: root.msg.pronouns;
                        clickable: root.msg.sender-id != "";
                        name-clicked => {
                            Actions.open-user-info(root.msg.sender-id);
                        }
                    }

                    bubble := Rectangle {
                        pure function anchor() -> AnchorRect {
                            return {
                                event-id: root.msg.event-id,
                                row: root.timeline-row,
                                is-own: root.is-own,
                                x: self.absolute-position.x,
                                y: self.absolute-position.y,
                                width: self.width,
                                height: self.height,
                            };
                        }

                        cross-axis-self-alignment: start;
                        max-width: bubble-max-width;
                        height: bubble-content.preferred-height;
                        opacity: root.dims-while-unsent ? Opacity.pending : 1.0;

                        animate opacity { duration: Motion.normal; }

                        if root.has-tail: BubbleTail {
                            x: root.is-own
                                ? parent.width - Metrics.bubble-tail-overlap
                                : -Metrics.bubble-tail-width;
                            y: parent.height - self.height;
                            is-right-side: root.is-own;
                            fill: root.outlined ? root.outline-color : root.bubble-color;

                            animate fill { duration: Motion.normal; }
                        }

                        surface := Rectangle {
                            background: root.is-sticker ? transparent : root.bubble-color;
                            border-top-left-radius: root.is-own ? Radius.md : root.tail-side-top-radius;
                            border-top-right-radius: root.is-own ? root.tail-side-top-radius : Radius.md;
                            border-bottom-left-radius: root.is-own ? Radius.md : root.tail-side-bottom-radius;
                            border-bottom-right-radius: root.is-own ? root.tail-side-bottom-radius : Radius.md;
                            border-width: root.outlined ? Stroke.emphasis : 0;
                            border-color: root.outline-color;
                            clip: true;

                            animate border-width { duration: Motion.normal; }

                            surface-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    TextSelection.clear();
                                }
                                changed has-hover => {
                                    message-row.bubble-hovered = self.has-hover;
                                    if self.has-hover && root.has-remote-id {
                                        Reactions.hover-bubble(bubble.anchor());
                                    } else {
                                        Reactions.leave-bubble(root.msg.event-id);
                                    }
                                }

                                bubble-content := VerticalLayout {
                                    padding-bottom: root.is-photo-only ? 0 : Space.sm;

                                    if root.msg.has-reply: BubbleReply {
                                        msg: root.msg;
                                        background: root.is-sticker ? root.bubble-color : transparent;
                                        border-radius: root.is-sticker ? Radius.md : 0;
                                    }

                                    MessageBody {
                                        padding-top: root.has-photo ? 0 : Space.sm;
                                        padding-left: root.has-photo ? 0 : Space.lg;
                                        padding-right: root.has-photo ? 0 : Space.lg;
                                        msg: root.msg;
                                        timeline-row: root.timeline-row;
                                        frame-limit: root.bubble-max-width;
                                        hovered: actions.hovered;
                                    }

                                    if !root.is-photo-only: BubbleFooter {
                                        msg: root.msg;
                                        timeline-row: root.timeline-row;
                                        is-own: root.is-own;
                                        has-remote-id: root.has-remote-id;
                                        has-reactions: root.has-reactions;
                                        detail-anchor() => {
                                            return bubble.anchor();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !root.is-own: avatar-target := SenderAvatar {
                property <length> resting: message-row.bubble-top + bubble.height - root.avatar-size;
                property <length> floor: root.composer-top - Space.sm - row.padding-bottom;
                property <length> lifted: self.floor
                    - message-row.row-top
                    - root.avatar-size;

                visible: message-row.shows-avatar;
                x: Metrics.timeline-inset + row.x;
                y: !message-row.has-composer
                    ? self.resting
                    : (root.continues-previous
                        ? min(self.resting, self.lifted)
                        : max(bubble-column.y, min(self.resting, self.lifted)));
                width: root.avatar-size;
                height: root.avatar-size;
                msg: root.msg;
            }
        }

        if root.chips-outside: BubbleReactions {
            x: message-row.bubble-x;
            y: message-row.bubble-top + bubble.height + root.outside-chips-gap;
            width: bubble.width;
            flex-wrap: FlexboxLayoutWrap.no-wrap;
            reactions: root.msg.reactions;
            is-own: root.is-own;
            can-react: root.has-remote-id;
            event-id: root.msg.event-id;
            detail-anchor() => {
                return bubble.anchor();
            }
        }

        if root.send-failed: SendFailedRow {
            x: message-row.bubble-x;
            y: message-row.bubble-top + bubble.height + root.outside-chips-gap + parent.outside-chips-height;
            width: bubble.width;
            height: Metrics.reaction-chip;
            alignment: root.is-own ? end : start;
            local-id: root.msg.local-id;
        }

        actions := RowActions {
            x: message-row.bubble-x;
            y: message-row.bubble-top;
            width: bubble.width;
            height: bubble.height;
            msg: root.msg;
            bubble-hovered: message-row.bubble-hovered;
            strip-mine: root.strip-mine;
            anchor() => {
                return bubble.anchor();
            }
        }
    }
}
