import {
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { MessageEntry } from "../types.slint";

import { MessagePreview } from "../message-preview.slint";
import { ReplyQuote } from "../reply-quote.slint";
import { ServiceMessage } from "./messages/service-message.slint";
import { TextMessage } from "./messages/text-message.slint";
import { ImageMessage, ImagePlaceholder } from "./messages/image-message.slint";
import { StickerMessage } from "./messages/sticker-message.slint";
import { FileMessage } from "./messages/file-message.slint";
import { UtdMessage } from "./messages/utd-message.slint";
import { UnsupportedMessage } from "./messages/unsupported-message.slint";
import { UnreadDivider } from "./messages/unread-divider.slint";
import { ReactionRow } from "./reaction-row.slint";
import { QuickReactions } from "./reaction-picker.slint";
import { Avatar } from "../../../../components/avatar.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import {
    Composer,
    ReactionAnchor,
    Reactions,
    Shell,
} from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { RoomView } from "../../../../views.slint";
import { AppStyle, Avatars, Fonts, Glyph, IconSize, Metrics, Motion, Radius, Size, Space, Stroke, Weight } from "../../../../theme.slint";
import { MediaState, MessageKind } from "../../../../enums.slint";

component PronounBadge inherits Rectangle {
    in property <string> text;

    width: pronoun-text.preferred-width + Space.lg;
    height: pronoun-text.preferred-height + Space.xs;
    border-radius: self.height / 2;
    background: AppStyle.overlay-hover;

    pronoun-text := Text {
        text: root.text;
        font-size: Fonts.caption;
        color: AppStyle.accent-on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component BubbleReactions inherits ReactionRow {
    in property <string> event-id;

    callback detail-anchor() -> ReactionAnchor;

    toggled(key) => {
        Actions.toggle-reaction(root.event-id, key);
    }
    overflow-clicked => {
        Shell.picker-open = false;
        Reactions.open-detail(root.detail-anchor());
    }
    hovered(index, text, rect) => {
        Reactions.show-tooltip(root.event-id, index, text, rect);
    }
    unhovered(index) => {
        Reactions.hide-tooltip(root.event-id, index);
    }
}

component SenderLine inherits HorizontalLayout {
    in property <string> sender;
    in property <[string]> pronouns;

    alignment: start;
    spacing: Space.sm;

    Text {
        text: root.sender;
        font-size: Fonts.body-small;
        font-weight: Weight.bold;
        color: Palette.accent-background;
        vertical-alignment: center;
        overflow: elide;
    }

    for pronoun in root.pronouns: PronounBadge {
        y: (parent.height - self.height) / 2;
        text: pronoun;
    }
}

export component MessageBubble inherits VerticalLayout {
    in property <bool> is-own;
    in property <MessageEntry> msg;
    in property <length> available-width;
    in property <int> timeline-row;

    property <color> own-bubble-color: AppStyle.own-bubble;
    property <color> other-bubble-color: Palette.alternate-background;
    property <length> bubble-max-width: max(
        Metrics.bubble-max / 2,
        min(Metrics.bubble-max, root.available-width - Metrics.bubble-gutter),
    );

    property <bool> is-service: msg.message-type == MessageKind.service;
    property <bool> is-plain-text: msg.message-type == MessageKind.text
        || msg.message-type == MessageKind.notice
        || msg.message-type == MessageKind.emote;
    property <bool> has-remote-id: msg.event-id != "";
    property <bool> is-focused: root.has-remote-id && msg.event-id == RoomView.focus-event-id;
    property <bool> strip-mine: root.has-remote-id
        && Reactions.strip-anchor.event-id == msg.event-id;

    property <bool> is-image: msg.message-type == MessageKind.image;
    property <bool> is-sticker: msg.message-type == MessageKind.sticker;
    property <bool> has-caption: msg.body != "";
    property <bool> has-photo: root.is-image
        && (msg.media-state != MediaState.idle || (msg.image-width > 0 && msg.image-height > 0));
    property <bool> is-photo-only: root.has-photo && !root.has-caption;
    property <bool> has-reactions: msg.reactions.length > 0;
    property <bool> chips-outside: root.is-photo-only && root.has-reactions;
    property <length> outside-chips-gap: Space.sm;
    property <length> photo-row-padding: root.has-photo ? Space.lg : 0px;

    if msg.first-unread: UnreadDivider { }

    if is-service: ServiceMessage {
        kind: msg.service-kind;
        actor: msg.sender;
        target: msg.service-target;
    }

    if !is-service: message-row := Rectangle {
        property <bool> hovered: root.has-remote-id
            && (hover-bg.has-hover
            || root.strip-mine
            || react-btn.has-hover || react-btn.has-focus
            || reply-btn.has-hover || reply-btn.has-focus);

        height: row.preferred-height
            + (root.chips-outside
            ? Metrics.reaction-chip + root.outside-chips-gap
            : 0);

        row := HorizontalLayout {
            alignment: is-own ? end : start;
            padding-left: is-own ? 0 : Space.md;
            padding-right: is-own ? Space.md : 0;
            padding-top: Space.xs;
            padding-bottom: Space.xs;

            if !is-own: Avatar {
                width: Size.md;
                height: Size.md;
                background: Avatars.color(msg.color-index);
                has-image: msg.has-avatar;
                image: msg.avatar;
                initial: msg.sender-initial;
                initial-size: Glyph.xs;
            }

            if !is-own: Rectangle {
                width: Space.md;
            }

            bubble := Rectangle {
                pure function anchor() -> ReactionAnchor {
                    return {
                        event-id: msg.event-id,
                        row: root.timeline-row,
                        is-own: root.is-own,
                        x: self.absolute-position.x,
                        y: self.absolute-position.y,
                        width: self.width,
                        height: self.height,
                    };
                }

                max-width: bubble-max-width;
                height: bubble-content.preferred-height;
                background: root.is-sticker
                    ? transparent
                    : (is-own ? own-bubble-color : other-bubble-color);
                border-radius: Radius.md;
                border-width: root.is-focused ? Stroke.emphasis : 0;
                border-color: Palette.accent-background;
                clip: true;

                animate border-width { duration: Motion.normal; }

                hover-bg := TouchArea {
                    width: 100%;
                    height: 100%;
                    changed has-hover => {
                        if (self.has-hover && root.has-remote-id) {
                            Reactions.hover-bubble(bubble.anchor());
                        } else {
                            Reactions.leave-bubble(msg.event-id);
                        }
                    }
                }

                bubble-content := VerticalLayout {
                    padding-top: root.has-photo ? 0 : Space.sm;
                    padding-bottom: root.is-photo-only ? 0 : Space.sm;
                    padding-left: root.has-photo ? 0 : Space.lg;
                    padding-right: root.has-photo ? 0 : Space.lg;

                    if !is-own: HorizontalLayout {
                        padding-left: root.photo-row-padding;
                        padding-right: root.photo-row-padding;
                        padding-top: root.has-photo ? Space.sm : 0;
                        padding-bottom: root.has-photo ? Space.sm : 0;

                        SenderLine {
                            sender: msg.sender;
                            pronouns: msg.pronouns;
                        }
                    }

                    if msg.has-reply: VerticalLayout {
                        padding-top: is-own ? 0 : Space.sm;
                        padding-bottom: root.has-photo ? Space.sm : 0;
                        padding-left: root.photo-row-padding;
                        padding-right: root.photo-row-padding;

                        reply-jump := ClickArea {
                            height: reply-quote.preferred-height;
                            border-radius: Radius.xs;
                            ring-radius: Radius.xs;
                            enabled: msg.reply-event-id != "";
                            label: @tr("Go to the message this replies to");
                            property <color> quote-tint: is-own
                                ? Palette.accent-background
                                : Palette.foreground;
                            property <float> quote-veil: is-own
                                ? (reply-jump.has-hover ? 0.55 : 0.7)
                                : (reply-jump.has-hover ? 0.86 : 0.92);
                            background: self.quote-tint.transparentize(self.quote-veil);
                            clicked => {
                                Actions.jump-to-event(msg.reply-event-id);
                            }

                            reply-quote := ReplyQuote {
                                padding: Space.sm;
                                sender: msg.reply-sender;
                                preview: MessagePreview.label(msg.reply-kind, msg.reply-body);
                            }
                        }
                    }

                    if root.has-photo: ImageMessage {
                        thumbnail: msg.thumbnail;
                        media-state: msg.media-state;
                        image-width: msg.image-width;
                        image-height: msg.image-height;
                        body: msg.body;
                        event-id: msg.event-id;
                        frame-limit: root.bubble-max-width;
                        timestamp: msg.timestamp;
                        edited: msg.edited;
                        show-timestamp: root.is-photo-only;
                        bubble-hovered: message-row.hovered;
                    }

                    if root.is-image && !root.has-photo: ImagePlaceholder {
                        body: msg.body;
                    }

                    if root.is-sticker: StickerMessage {
                        sticker: msg.thumbnail;
                        media-state: msg.media-state;
                        sticker-width: msg.image-width;
                        sticker-height: msg.image-height;
                        alt: msg.body;
                        bubble-hovered: message-row.hovered;
                        is-own: root.is-own;
                    }

                    if msg.message-type == MessageKind.file: FileMessage {
                        body: msg.body;
                        event-id: msg.event-id;
                    }

                    if msg.message-type == MessageKind.utd: UtdMessage { }

                    if msg.message-type == MessageKind.unsupported: UnsupportedMessage {
                        kind: msg.unsupported-kind;
                        body: msg.body;
                    }

                    if is-plain-text: TextMessage {
                        text: msg.body;
                    }

                    if !root.is-photo-only: HorizontalLayout {
                        spacing: Space.md;
                        padding-left: root.photo-row-padding;
                        padding-right: root.photo-row-padding;
                        padding-top: root.has-reactions ? Space.sm : 0;

                        if root.has-reactions: BubbleReactions {
                            horizontal-stretch: 0;
                            padding-bottom: Space.sm;
                            reactions: msg.reactions;
                            is-own: root.is-own;
                            can-react: root.has-remote-id;
                            event-id: msg.event-id;
                            detail-anchor() => {
                                return bubble.anchor();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: end;

                            HorizontalLayout {
                                alignment: end;
                                spacing: Space.sm;

                                if msg.edited: IconDisplay {
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.Pencil;
                                    size: IconSize.xs;
                                    stroke: AppStyle.overlay-foreground-muted;
                                }

                                Text {
                                    text: msg.timestamp;
                                    font-size: Fonts.body-small;
                                    color: AppStyle.overlay-foreground-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                reply-btn := ClickArea {
                    x: parent.width - self.width - Space.sm;
                    y: Space.sm;
                    width: reply-text.width + Space.lg;
                    height: Size.target-min;
                    ring-radius: Radius.sm;
                    label: @tr("Reply to {}", msg.sender);
                    enabled: root.has-remote-id;
                    opacity: message-row.hovered ? 1 : 0;
                    clicked => {
                        Composer.reply-event-id = msg.event-id;
                        Composer.reply-sender = msg.sender;
                        Composer.reply-preview = MessagePreview.label(msg.preview-kind, msg.body);
                    }

                    reply-text := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: @tr("Reply");
                        font-size: Fonts.body-small;
                        font-weight: Weight.semibold;
                        color: root.is-own ? Palette.foreground : Palette.accent-background;
                    }

                    if reply-btn.has-hover: Rectangle {
                        x: reply-text.x;
                        y: reply-text.y + reply-text.height;
                        width: reply-text.width;
                        height: Stroke.hairline;
                        background: reply-text.color;
                    }
                }
            }
        }

        if root.chips-outside: BubbleReactions {
            x: bubble.x;
            y: bubble.y + bubble.height + root.outside-chips-gap;
            width: bubble.width;
            reactions: msg.reactions;
            is-own: root.is-own;
            can-react: root.has-remote-id;
            event-id: msg.event-id;
            detail-anchor() => {
                return bubble.anchor();
            }
        }

        react-btn := ClickArea {
            x: root.is-own
                ? bubble.x - self.width + Metrics.reaction-strip-overlap
                : bubble.x + bubble.width - Metrics.reaction-strip-overlap;
            y: bubble.y + bubble.height - self.height;
            width: Metrics.reaction-strip-width;
            height: self.width;
            border-radius: self.height / 2;
            ring-radius: self.height / 2;
            background: Palette.alternate-background;
            enabled: root.has-remote-id;
            label: @tr("React to {}'s message with {}", msg.sender, QuickReactions.default-key);
            opacity: message-row.hovered && !root.strip-mine ? 1 : 0;

            clicked => {
                Actions.toggle-reaction(msg.event-id, QuickReactions.default-key);
            }
            changed has-hover => {
                if (self.has-hover && root.has-remote-id) {
                    Reactions.hover-bubble(bubble.anchor());
                } else {
                    Reactions.leave-bubble(msg.event-id);
                }
            }

            Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: QuickReactions.default-key;
                font-family: Fonts.emoji;
                font-size: Glyph.xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
