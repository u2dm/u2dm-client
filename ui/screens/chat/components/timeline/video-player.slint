import { Palette, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { ClickArea } from "../../../../components/a11y.slint";
import { ModalHost } from "../../../../components/overlay.slint";
import { UserMessageKind } from "../../../../enums.slint";
import { Clocks, UserMessages } from "../../../../messages.slint";
import { AppStyle, Fonts, IconSize, Metrics, Opacity, Radius, Size, Space, Stroke } from "../../../../theme.slint";
import { Actions } from "../../../../actions.slint";
import { VideoView } from "../../../../views.slint";

component ScrubBar inherits Rectangle {
    in property <int> position-ms;
    in property <int> duration-ms;
    callback seek(int);

    property <float> progress: root.duration-ms > 0
        ? clamp(root.position-ms / root.duration-ms, 0.0, 1.0)
        : 0.0;

    height: Metrics.video-scrub-knob;
    accessible-role: slider;
    accessible-label: @tr("Seek");
    accessible-value: root.position-ms / 1000;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration-ms / 1000;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: Metrics.video-scrub-track;
        border-radius: self.height / 2;
        background: Palette.foreground.transparentize(0.75);

        Rectangle {
            x: 0;
            width: parent.width * root.progress;
            height: parent.height;
            border-radius: self.height / 2;
            background: Palette.accent-background;
        }
    }

    knob := Rectangle {
        x: track.width * root.progress - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: Metrics.video-scrub-knob;
        height: Metrics.video-scrub-knob;
        border-radius: self.height / 2;
        background: Palette.accent-background;
        opacity: scrub.has-hover || scrub.pressed ? 1 : Opacity.scrim-strong;
    }

    scrub := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (self.pressed && root.duration-ms > 0) {
                root.seek(clamp(self.mouse-x / root.width, 0.0, 1.0) * root.duration-ms);
            }
        }
        clicked => {
            if (root.duration-ms > 0) {
                root.seek(clamp(self.mouse-x / root.width, 0.0, 1.0) * root.duration-ms);
            }
        }
    }
}

export component VideoPlayer inherits ModalHost {
    dim-opacity: Opacity.scrim-strong;
    label: @tr("Video player");
    dismissed => {
        Actions.close-video();
    }

    property <bool> has-error: VideoView.error != UserMessageKind.none;

    VerticalLayout {
        padding: Metrics.video-stage-inset;
        spacing: Space.lg;

        Rectangle {
            vertical-stretch: 1;

            if VideoView.has-frame: Image {
                width: 100%;
                height: 100%;
                source: VideoView.frame;
                image-fit: contain;
                accessible-label: @tr("Video");
            }

            if VideoView.loading && !root.has-error: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }

            if root.has-error: VerticalLayout {
                alignment: center;
                spacing: Space.md;

                HorizontalLayout {
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.VideoOff;
                        size: IconSize.xl;
                        stroke: AppStyle.foreground-faint;
                    }
                }

                Text {
                    text: UserMessages.text(VideoView.error, "");
                    font-size: Fonts.body;
                    color: AppStyle.foreground-strong;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-live-region: assertive;
                }
            }
        }

        HorizontalLayout {
            height: Metrics.video-controls-row;
            spacing: Space.lg;

            VerticalLayout {
                alignment: center;

                ClickArea {
                    above-modal: true;
                    enabled: VideoView.has-frame;
                    width: Size.xl;
                    height: Size.xl;
                    ring-radius: Radius.sm;
                    label: VideoView.playing ? @tr("Pause") : @tr("Play");
                    clicked => {
                        Actions.toggle-video();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: VideoView.playing ? IconSet.Pause : IconSet.Play;
                        size: IconSize.lg;
                        stroke: Palette.foreground;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;

                ScrubBar {
                    position-ms: VideoView.position-ms;
                    duration-ms: VideoView.duration-ms;
                    seek(ms) => {
                        Actions.seek-video(ms);
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                Text {
                    text: Clocks.label(VideoView.position-ms) + " / " + Clocks.label(VideoView.duration-ms);
                    font-size: Fonts.body-small;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;

                ClickArea {
                    above-modal: true;
                    width: Size.xl;
                    height: Size.xl;
                    ring-radius: Radius.sm;
                    label: @tr("Close");
                    clicked => {
                        Actions.close-video();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.X;
                        size: IconSize.md;
                        stroke: Palette.foreground;
                    }
                }
            }
        }
    }
}
