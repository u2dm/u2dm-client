import { Palette, Spinner } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { ClickArea } from "../../../../components/a11y.slint";
import { ScrubBar } from "../../../../components/scrub-bar.slint";
import { ModalHost } from "../../../../components/overlay.slint";
import { UserMessageKind } from "../../../../enums.slint";
import { Clocks, UserMessages } from "../../../../messages.slint";
import { AppStyle, Fonts, IconSize, Metrics, Opacity, Radius, Size, Space, Stroke } from "../../../../theme.slint";
import { Actions } from "../../../../actions.slint";
import { VideoView } from "../../../../views.slint";

export component VideoPlayer inherits ModalHost {
    dim-opacity: Opacity.scrim-strong;
    label: @tr("Video player");
    dismissed => {
        Actions.close-video();
    }

    property <bool> has-error: VideoView.error != UserMessageKind.none;

    VerticalLayout {
        padding: Metrics.video-stage-inset;
        spacing: Space.lg;

        Rectangle {
            vertical-stretch: 1;

            if VideoView.has-frame: Image {
                width: 100%;
                height: 100%;
                source: VideoView.frame;
                image-fit: contain;
                accessible-label: @tr("Video");
            }

            if VideoView.loading && !root.has-error: Spinner {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }

            if root.has-error: VerticalLayout {
                alignment: center;
                spacing: Space.md;

                HorizontalLayout {
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.VideoOff;
                        size: IconSize.xl;
                        stroke: AppStyle.foreground-faint;
                    }
                }

                Text {
                    text: UserMessages.text(VideoView.error, "");
                    font-size: Fonts.body;
                    color: AppStyle.foreground-strong;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-live-region: assertive;
                }
            }
        }

        HorizontalLayout {
            height: Metrics.video-controls-row;
            spacing: Space.lg;

            VerticalLayout {
                alignment: center;

                ClickArea {
                    above-modal: true;
                    enabled: VideoView.has-frame;
                    width: Size.xl;
                    height: Size.xl;
                    ring-radius: Radius.sm;
                    label: VideoView.playing ? @tr("Pause") : @tr("Play");
                    clicked => {
                        Actions.toggle-video();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: VideoView.playing ? IconSet.Pause : IconSet.Play;
                        size: IconSize.lg;
                        stroke: Palette.foreground;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;

                ScrubBar {
                    above-modal: true;
                    resting-knob-opacity: Opacity.scrim-strong;
                    position-ms: VideoView.position-ms;
                    duration-ms: VideoView.duration-ms;
                    seek(ms) => {
                        Actions.seek-video(ms);
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                Text {
                    text: Clocks.label(VideoView.position-ms) + " / " + Clocks.label(VideoView.duration-ms);
                    font-size: Fonts.body-small;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;

                ClickArea {
                    above-modal: true;
                    enabled: VideoView.has-frame;
                    width: Size.xl;
                    height: Size.xl;
                    ring-radius: Radius.sm;
                    label: VideoView.muted ? @tr("Unmute") : @tr("Mute");
                    clicked => {
                        Actions.toggle-video-muted();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: VideoView.muted ? IconSet.VolumeX : IconSet.Volume2;
                        size: IconSize.md;
                        stroke: Palette.foreground;
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                ClickArea {
                    above-modal: true;
                    width: Size.xl;
                    height: Size.xl;
                    ring-radius: Radius.sm;
                    label: @tr("Close");
                    clicked => {
                        Actions.close-video();
                    }

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: IconSet.X;
                        size: IconSize.md;
                        stroke: Palette.foreground;
                    }
                }
            }
        }
    }
}
