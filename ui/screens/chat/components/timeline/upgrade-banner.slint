import { AppStyle, Space } from "../../../../theme.slint";
import { LinkButton } from "../../../../components/button.slint";
import { Actions } from "../../../../actions.slint";
import { UpgradeLink } from "../../../../enums.slint";
import { UpgradeLinks } from "../../../../messages.slint";
import { UpgradeView } from "../../../../views.slint";
import { MarkedBanner } from "./composer-strip.slint";

export component UpgradeBanner inherits MarkedBanner {
    property <bool> joining: UpgradeView.successor == UpgradeLink.joining;

    background: AppStyle.well;
    marker: AppStyle.link;
    title: @tr("This room has been replaced");
    body: @tr("It is no longer active. The conversation continues in a new room.");
    liveness: AccessibleLiveness.polite;

    LinkButton {
        text: UpgradeLinks.successor(UpgradeView.successor);
        label: self.text;
        enabled: !root.joining;
        tint: root.joining ? AppStyle.foreground-disabled : AppStyle.link;
        pad: 2 * Space.sm;
        clicked => {
            if UpgradeView.successor == UpgradeLink.open {
                Actions.select-room(UpgradeView.successor-id);
            } else {
                Actions.join-successor(UpgradeView.room-id);
            }
        }
    }
}
