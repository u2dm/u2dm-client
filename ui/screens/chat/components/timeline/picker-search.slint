import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { AppStyle, Fonts, IconSize, Radius, Size, Space, Stroke } from "../../../../theme.slint";
import { IconButton } from "../../../../components/button.slint";

import { ClickArea } from "../../../../components/a11y.slint";

export component PickerSearch inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> query: "";
    callback edited(string);

    height: Size.md;
    border-radius: Radius.sm;
    background: AppStyle.overlay-hover;
    border-width: Stroke.hairline;
    border-color: input.has-focus
        ? AppStyle.accent-surface
        : AppStyle.overlay-hover;

    forward-focus: input;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        spacing: Space.md;

        VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: IconSet.Search;
                size: IconSize.sm;
                stroke: AppStyle.foreground-faint;
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            input := TextInput {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text <=> root.query;
                color: Palette.foreground;
                font-size: Fonts.label;
                vertical-alignment: center;
                single-line: true;
                accessible-label: root.placeholder;
                accessible-placeholder-text: root.placeholder;
                edited => {
                    root.edited(self.text);
                }
            }

            if root.query == "": Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: AppStyle.foreground-muted;
                font-size: Fonts.label;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            width: Size.sm;

            if root.query != "": IconButton {
                size: Size.target-min;
                radius: Radius.sm;
                icon-size: IconSize.xs;
                icon: IconSet.X;
                label: @tr("Clear search");
                clicked => {
                    root.query = "";
                    root.edited("");
                    input.focus();
                }
            }
        }
    }
}
