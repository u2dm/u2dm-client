import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { StatusPill } from "./status-pill.slint";

import { TimelineScroller } from "./timeline-scroller.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { RoomView } from "../../../../views.slint";
import { Fonts, IconSize, Radius, Size, Space, Weight } from "../../../../theme.slint";

export component TimelineContent inherits Rectangle {
    in property <length> available-width;

    clip: true;

    scroller := TimelineScroller {
        width: parent.width;
        height: parent.height;
        available-width: root.available-width;
        anchor-index: RoomView.anchor-index;
        timeline-token: RoomView.timeline-token;
        prepend-token: RoomView.prepend-token;
        backwards-loading: RoomView.backwards-loading;
        forwards-loading: RoomView.forwards-loading;
    }

    if RoomView.backwards-loading && RoomView.timeline.length > 0: StatusPill {
        x: Space.xl;
        y: parent.height - self.height - Space.xl;
        text: @tr("Loading older messages...");
        loading: true;
    }

    if RoomView.forwards-loading && RoomView.timeline.length > 0: StatusPill {
        x: Space.xl;
        y: parent.height - self.height - Space.xl;
        text: @tr("Loading newer messages...");
        loading: true;
    }

    if !scroller.following && RoomView.timeline.length > 0: ClickArea {
        x: parent.width - self.width - Space.xl;
        y: parent.height - self.height - Space.xl;
        width: Size.xl;
        height: Size.xl;
        border-radius: Radius.xl;
        ring-radius: Radius.xl;
        background: Palette.alternate-background;
        label: @tr("Jump to latest messages");
        clicked => {
            scroller.jump-to-latest();
        }

        IconDisplay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconSet.ChevronDown;
            size: IconSize.md;
            stroke: Palette.alternate-foreground;
        }

        if RoomView.new-messages-count > 0: Rectangle {
            x: parent.width - self.width / 2 - Space.xs;
            y: -self.height / 2 + Space.xs;
            width: Math.max(Size.xs, badge-text.preferred-width + Space.md);
            height: Size.xs;
            border-radius: Radius.md;
            background: Palette.accent-background;

            badge-text := Text {
                text: RoomView.new-messages-count;
                font-size: Fonts.caption;
                font-weight: Weight.bold;
                color: Palette.accent-foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
