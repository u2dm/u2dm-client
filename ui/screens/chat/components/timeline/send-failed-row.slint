
import { LinkButton } from "../../../../components/button.slint";
import { Actions } from "../../../../actions.slint";
import { AppStyle, Glyph, Space, Weight } from "../../../../theme.slint";

export component SendFailedRow inherits HorizontalLayout {
    in property <string> local-id;

    spacing: Space.sm;

    Text {
        text: @tr("Not sent");
        color: AppStyle.danger;
        font-size: Glyph.xs;
        font-weight: Weight.semibold;
        vertical-alignment: center;
    }

    LinkButton {
        text: @tr("Retry");
        font-size: Glyph.xs;
        label: @tr("Retry sending this message");
        clicked => {
            Actions.retry-send(root.local-id);
        }
    }

    LinkButton {
        text: @tr("Discard");
        tint: AppStyle.danger-muted;
        font-size: Glyph.xs;
        label: @tr("Discard this message");
        clicked => {
            Actions.discard-send(root.local-id);
        }
    }
}
