import { Palette, Spinner } from "std-widgets.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { Fonts, Radius, Size, Space, Weight } from "../../../../theme.slint";

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <bool> loading;
    in property <bool> show-retry;

    callback retry();

    width: pill-layout.preferred-width;
    height: pill-layout.preferred-height;
    border-radius: self.height / 2;
    background: Palette.alternate-background;

    pill-layout := HorizontalLayout {
        padding-left: Space.xl;
        padding-right: root.show-retry ? Space.md : Space.xl;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.md;

        if root.loading: Spinner {
            width: Size.xxs;
            height: Size.xxs;
            indeterminate: true;
        }

        Text {
            text: root.text;
            font-size: Fonts.label;
            color: Palette.foreground;
            vertical-alignment: center;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if root.show-retry: ClickArea {
            width: retry-label.preferred-width + Space.lg;
            ring-radius: Radius.sm;
            label: @tr("Retry loading messages");
            clicked => {
                root.retry();
            }

            retry-label := Text {
                x: (parent.width - self.width) / 2;
                text: @tr("Retry");
                font-size: Fonts.label;
                font-weight: Weight.semibold;
                color: Palette.accent-background;
                vertical-alignment: center;
            }
        }
    }
}
