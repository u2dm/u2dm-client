import {
    Palette,
} from "std-widgets.slint";

import { ClickArea } from "../../../../components/a11y.slint";
import { AppStyle, Fonts, Space, Stroke, Weight } from "../../../../theme.slint";

component PronounBadge inherits Rectangle {
    in property <string> text;

    width: pronoun-text.preferred-width + Space.lg;
    height: pronoun-text.preferred-height + Space.xs;
    border-radius: self.height / 2;
    background: AppStyle.overlay-hover;

    pronoun-text := Text {
        text: root.text;
        font-size: Fonts.caption;
        color: AppStyle.accent-on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component SenderLine inherits HorizontalLayout {
    in property <string> sender;
    in property <[string]> pronouns;
    in property <bool> clickable;

    callback name-clicked();

    alignment: start;
    spacing: Space.sm;

    name-target := ClickArea {
        horizontal-stretch: 0;
        preferred-width: name.preferred-width;
        max-width: name.preferred-width;
        min-height: name.preferred-height;
        preferred-height: name.preferred-height;
        enabled: root.clickable;
        focusable: false;
        label: @tr("View profile of {}", root.sender);
        clicked => {
            root.name-clicked();
        }

        name := Text {
            width: parent.width;
            height: parent.height;
            text: root.sender;
            font-size: Fonts.body-small;
            font-weight: Weight.bold;
            color: Palette.accent-background;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        if name-target.has-hover && root.clickable: Rectangle {
            x: 0;
            y: (parent.height + name.preferred-height) / 2 - Stroke.hairline;
            width: parent.width;
            height: Stroke.hairline;
            background: Palette.accent-background;
        }
    }

    for pronoun in root.pronouns: PronounBadge {
        y: (parent.height - self.height) / 2;
        text: pronoun;
    }
}
