import {
    Palette,
} from "std-widgets.slint";

import { ReactionPicker, ReactionStrip } from "reaction-picker.slint";
import { ReactionDetail } from "reaction-detail.slint";
import { PollVoters } from "poll-voters.slint";
import { ModalHost, PickerCard } from "../../../../components/overlay.slint";
import { DeliveryTip, Reactions, Shell } from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { Deliveries, DeliveryStatus } from "../../../../messages.slint";
import { StickerView } from "../../../../views.slint";
import { Fonts, Metrics, Motion, Radius, Size, Space } from "../../../../theme.slint";

component TipCard inherits PickerCard {
    in property <string> text;

    width: tip-text.preferred-width + Space.xl;
    height: Size.sm;
    border-radius: Radius.sm;

    tip-text := Text {
        x: Space.md;
        width: parent.width - Space.xl;
        height: parent.height;
        text: root.text;
        font-size: Fonts.caption;
        color: Palette.foreground;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ReactionOverlay inherits Rectangle {
    in property <length> timeline-bottom: root.height;

    callback closed();

    property <length> edge: Space.md;
    property <length> gap: Space.md;
    property <duration> strip-close-delay: Motion.close-delay;
    property <length> timeline-top: Metrics.header-row;

    property <bool> strip-in-view:
        Reactions.strip-anchor.y + Reactions.strip-anchor.height > root.timeline-top
        && Reactions.strip-anchor.y < root.timeline-bottom;

    property <length> pane-w: min(Metrics.picker-width, root.width - 2 * root.edge);
    property <length> pane-h: min(Metrics.picker-height, root.height - 2 * root.edge);
    property <length> detail-w: min(Metrics.reaction-detail-width, root.width - 2 * root.edge);
    property <length> detail-h: min(Metrics.reaction-detail-height, root.height - 2 * root.edge);
    property <length> voters-w: min(Metrics.poll-voters-width, root.width - 2 * root.edge);
    property <length> voters-h: min(Metrics.poll-voters-height, root.height - 2 * root.edge);

    pure function place-x(anchor-x: length, anchor-w: length, is-own: bool, w: length) -> length {
        return clamp(
            is-own ? anchor-x + anchor-w - w : anchor-x,
            root.edge,
            max(root.edge, root.width - w - root.edge));
    }

    pure function place-y(anchor-y: length, anchor-h: length, h: length) -> length {
        return (anchor-y - h - root.gap >= root.edge)
            ? anchor-y - h - root.gap
            : clamp(anchor-y + anchor-h + root.gap,
                    root.edge,
                    max(root.edge, root.height - h - root.edge));
    }

    Timer {
        interval: Motion.reveal-delay;
        running: Reactions.strip-pending && !Reactions.strip-revealed;
        triggered => {
            Reactions.strip-revealed = true;
        }
    }

    Timer {
        interval: root.strip-close-delay;
        running: Reactions.strip-pending
            && (!root.strip-in-view
            || (!Reactions.bubble-hovered && !Reactions.strip-hovered));
        triggered => {
            Reactions.close-strip();
        }
    }

    if Reactions.strip-visible && root.strip-in-view: ReactionStrip {
        x: Reactions.strip-anchor.is-own
            ? Reactions.strip-anchor.x - self.width + Metrics.reaction-strip-overlap
            : Reactions.strip-anchor.x + Reactions.strip-anchor.width - Metrics.reaction-strip-overlap;
        y: clamp(Reactions.strip-anchor.y + Reactions.strip-anchor.height - self.height,
                 root.timeline-top,
                 max(root.timeline-top, root.timeline-bottom - self.height));

        changed open => {
            Reactions.strip-hovered = self.open;
        }
        picked(key) => {
            Actions.toggle-reaction(Reactions.strip-anchor.event-id, key);
        }
        more-clicked => {
            Shell.picker-open = false;
            Shell.attach-open = false;
            Reactions.open-picker(Reactions.strip-anchor);
        }
    }

    if Reactions.picker-open: ModalHost {
        width: 100%;
        height: 100%;
        dim: false;
        label: @tr("React to a message");
        dismissed => {
            Reactions.close();
            root.closed();
        }

        ReactionPicker {
            x: root.place-x(Reactions.anchor.x, Reactions.anchor.width,
                            Reactions.anchor.is-own, root.pane-w);
            y: root.place-y(Reactions.anchor.y, Reactions.anchor.height, root.pane-h);
            width: root.pane-w;
            height: root.pane-h;
            encrypted: StickerView.room-encrypted;
            picked(key) => {
                Actions.toggle-reaction(Reactions.anchor.event-id, key);
                Reactions.close();
                root.closed();
            }
        }
    }

    if Reactions.detail-visible: ModalHost {
        width: 100%;
        height: 100%;
        dim: false;
        label: @tr("Everyone who reacted");
        dismissed => {
            Reactions.close();
            root.closed();
        }

        ReactionDetail {
            x: root.place-x(Reactions.anchor.x, Reactions.anchor.width,
                            Reactions.anchor.is-own, root.detail-w);
            y: root.place-y(Reactions.anchor.y, Reactions.anchor.height, root.detail-h);
            width: root.detail-w;
            height: root.detail-h;
            items: Reactions.items;
            toggled(key) => {
                Actions.toggle-reaction(Reactions.anchor.event-id, key);
            }
        }
    }

    if Reactions.voters-visible: ModalHost {
        width: 100%;
        height: 100%;
        dim: false;
        label: @tr("Who voted");
        dismissed => {
            Reactions.close();
            root.closed();
        }

        PollVoters {
            x: root.place-x(Reactions.anchor.x, Reactions.anchor.width,
                            Reactions.anchor.is-own, root.voters-w);
            y: root.place-y(Reactions.anchor.y, Reactions.anchor.height, root.voters-h);
            width: root.voters-w;
            height: root.voters-h;
            answers: Reactions.target.poll-answers;
        }
    }

    if Reactions.tooltip-row >= 0 && !Reactions.open: TipCard {
        x: clamp(Reactions.tooltip-anchor.x, root.edge,
                 max(root.edge, root.width - self.width - root.edge));
        y: max(root.edge, Reactions.tooltip-anchor.y - self.height - Space.sm);
        text: Reactions.tooltip-text;
    }

    if DeliveryTip.showing && !Reactions.open: TipCard {
        x: clamp(DeliveryTip.anchor.x + DeliveryTip.anchor.width - self.width, root.edge,
                 max(root.edge, root.width - self.width - root.edge));
        y: max(root.edge, DeliveryTip.anchor.y - self.height - Space.sm);
        text: DeliveryTip.on-counter
            ? Deliveries.label(DeliveryTip.target.delivery, DeliveryTip.target.readers,
                               DeliveryTip.target.hidden-readers)
            : DeliveryStatus.text(DeliveryTip.target.delivery, DeliveryTip.target.sent-at);
    }
}
