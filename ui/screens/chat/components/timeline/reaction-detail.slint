import { Palette } from "std-widgets.slint";

import { ReactionEntry } from "../../../../types.slint";
import { ClickArea } from "../../../../components/a11y.slint";
import { AppStyle, Fonts, Radius, Size, Space, Weight } from "../../../../theme.slint";
import { ListPopup } from "./list-popup.slint";

component DetailRow inherits ClickArea {
    in property <ReactionEntry> entry;

    height: Size.lg;
    border-radius: Radius.sm;
    ring-radius: Radius.sm;
    background: root.has-hover
        ? AppStyle.overlay-hover
        : (root.entry.mine ? AppStyle.accent-background-soft : transparent);

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        Text {
            text: root.entry.label;
            font-family: Fonts.emoji;
            font-size: Fonts.title;
            vertical-alignment: center;
        }

        Text {
            width: Size.sm;
            text: root.entry.count;
            font-size: Fonts.body-small;
            font-weight: Weight.semibold;
            color: root.entry.mine
                ? Palette.accent-background
                : AppStyle.foreground-strong;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.entry.hidden-reactors > 0
                ? @tr("{} and {} more", root.entry.reactors, root.entry.hidden-reactors)
                : root.entry.reactors;
            font-size: Fonts.body-small;
            color: AppStyle.foreground-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component ReactionDetail inherits ListPopup {
    in property <[ReactionEntry]> items;

    callback toggled(string);

    title: @tr("Reactions");

    for entry in root.items: DetailRow {
        entry: entry;
        label: entry.mine
            ? @tr("Remove your {} reaction", entry.label)
            : @tr("React with {}", entry.label);
        clicked => {
            root.toggled(entry.key);
        }
    }
}
