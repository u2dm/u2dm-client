import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { MessageEntry } from "../../../../types.slint";

import { MessageShape } from "./message-body.slint";
import { QuickReactions } from "./quick-reactions.slint";
import { Pill } from "../../../../components/pill.slint";
import {
    Composer,
    FocusRegion,
    AnchorRect,
    Reactions,
    TextSelection,
} from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { RoomView } from "../../../../views.slint";
import { AppStyle, Fonts, Glyph, IconSize, Metrics, Motion, Space, Weight } from "../../../../theme.slint";

enum RowAction {
    edit,
    select-text,
    reply,
    react,
}

export component RowActions inherits Rectangle {
    in property <MessageEntry> msg;
    in property <bool> bubble-hovered;
    in property <bool> strip-mine;
    in property <bool> row-focused;

    callback anchor() -> AnchorRect;

    property <bool> has-remote-id: root.msg.event-id != "";
    property <bool> can-edit: root.msg.text-editable && RoomView.may-send-messages;
    property <bool> can-reply: root.has-remote-id && !Composer.editing && RoomView.may-send-messages;
    property <bool> can-react: root.has-remote-id && RoomView.may-react;
    property <bool> can-select-text: MessageShape.has-selectable-text(root.msg);
    property <[RowAction]> row-actions: root.offered-actions();
    property <bool> has-actions: root.row-actions.length > 0;

    property <bool> action-hovered: false;

    property <length> pill-height: Metrics.row-action-pill;
    property <length> pill-gap: Space.sm;
    property <length> pill-overlap: Metrics.row-action-overlap;
    property <color> pill-fill: AppStyle.elevated;
    property <color> pill-foreground: Palette.accent-background;

    out property <bool> hovered: root.has-actions
        && (root.bubble-hovered
        || root.action-hovered
        || root.strip-mine
        || root.row-focused);

    pure function action-label(action: RowAction) -> string {
        if action == RowAction.edit {
            return @tr("Edit this message");
        }
        if action == RowAction.select-text {
            return @tr("Select the text of this message");
        }
        if action == RowAction.reply {
            return @tr("Reply to {}", root.msg.sender);
        }
        return @tr("React to {}'s message with {}", root.msg.sender, QuickReactions.default-key);
    }

    pure function offered-actions() -> [RowAction] {
        if root.can-reply && root.can-react {
            if root.can-edit && root.can-select-text {
                return [RowAction.edit, RowAction.select-text, RowAction.reply, RowAction.react];
            }
            if root.can-edit {
                return [RowAction.edit, RowAction.reply, RowAction.react];
            }
            if root.can-select-text {
                return [RowAction.select-text, RowAction.reply, RowAction.react];
            }
            return [RowAction.reply, RowAction.react];
        }
        if root.can-reply {
            if root.can-edit && root.can-select-text {
                return [RowAction.edit, RowAction.select-text, RowAction.reply];
            }
            if root.can-edit {
                return [RowAction.edit, RowAction.reply];
            }
            if root.can-select-text {
                return [RowAction.select-text, RowAction.reply];
            }
            return [RowAction.reply];
        }
        if root.can-react {
            if root.can-edit && root.can-select-text {
                return [RowAction.edit, RowAction.select-text, RowAction.react];
            }
            if root.can-edit {
                return [RowAction.edit, RowAction.react];
            }
            if root.can-select-text {
                return [RowAction.select-text, RowAction.react];
            }
            return [RowAction.react];
        }
        if root.can-edit && root.can-select-text {
            return [RowAction.edit, RowAction.select-text];
        }
        if root.can-edit {
            return [RowAction.edit];
        }
        if root.can-select-text {
            return [RowAction.select-text];
        }
        return [];
    }

    pure function available(action: RowAction) -> bool {
        if action == RowAction.edit {
            return root.can-edit;
        }
        if action == RowAction.select-text {
            return root.can-select-text;
        }
        if action == RowAction.reply {
            return root.can-reply;
        }
        return root.can-react;
    }

    function run-action(action: RowAction) {
        if !root.available(action) {
            return;
        }
        if action == RowAction.edit {
            Composer.request-edit(root.msg);
        } else if action == RowAction.select-text {
            TextSelection.select(root.msg.unique-id);
        } else if action == RowAction.reply {
            Composer.reply-to(root.msg);
        } else {
            Actions.toggle-reaction(root.msg.event-id, QuickReactions.default-key);
        }
    }

    if root.hovered: Rectangle {
        property <bool> any-hovered: edit-pill.has-hover
            || select-pill.has-hover
            || reply-pill.has-hover
            || react-btn.has-hover;

        width: 100%;
        height: 100%;
        opacity: 0;

        animate opacity {
            duration: Motion.fast;
            easing: ease-out;
        }

        init => {
            self.opacity = 1;
        }

        changed any-hovered => {
            root.action-hovered = self.any-hovered;
        }

        edit-pill := Pill {
            x: select-pill.visible
                ? select-pill.x - self.width - root.pill-gap
                : (reply-pill.visible ? reply-pill.x - self.width - root.pill-gap : root.width - self.width);
            y: reply-pill.y;
            width: root.pill-height;
            height: root.pill-height;
            pad: 0;
            fill: root.pill-fill;
            label: root.action-label(RowAction.edit);
            enabled: root.available(RowAction.edit);
            visible: self.enabled;
            focusable: false;
            region: FocusRegion.timeline;
            clicked => {
                root.run-action(RowAction.edit);
            }

            IconDisplay {
                icon: IconSet.Pencil;
                size: IconSize.sm;
                stroke: root.pill-foreground;
            }
        }

        select-pill := Pill {
            x: reply-pill.visible ? reply-pill.x - self.width - root.pill-gap : root.width - self.width;
            y: reply-pill.y;
            width: root.pill-height;
            height: root.pill-height;
            pad: 0;
            fill: root.pill-fill;
            label: root.action-label(RowAction.select-text);
            enabled: root.available(RowAction.select-text);
            visible: self.enabled;
            focusable: false;
            region: FocusRegion.timeline;
            clicked => {
                root.run-action(RowAction.select-text);
            }

            IconDisplay {
                icon: IconSet.TextCursor;
                size: IconSize.sm;
                stroke: root.pill-foreground;
            }
        }

        reply-pill := Pill {
            x: root.width - self.width;
            y: root.pill-overlap - self.height;
            height: root.pill-height;
            fill: root.pill-fill;
            label: root.action-label(RowAction.reply);
            enabled: root.available(RowAction.reply);
            visible: self.enabled;
            focusable: false;
            region: FocusRegion.timeline;
            clicked => {
                root.run-action(RowAction.reply);
            }

            Text {
                text: @tr("Reply");
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: root.pill-foreground;
                vertical-alignment: center;
            }
        }

        react-btn := Pill {
            x: root.msg.is-own
                ? Metrics.reaction-strip-overlap - self.width
                : root.width - Metrics.reaction-strip-overlap;
            y: root.height - self.height;
            width: Metrics.reaction-strip-width;
            height: self.width;
            pad: 0;
            fill: root.pill-fill;
            label: root.action-label(RowAction.react);
            enabled: root.available(RowAction.react);
            visible: self.enabled;
            focusable: false;
            region: FocusRegion.timeline;
            opacity: root.strip-mine ? 0 : 1;

            animate opacity {
                duration: Motion.fast;
                easing: ease-out;
            }

            clicked => {
                root.run-action(RowAction.react);
            }
            changed has-hover => {
                if self.has-hover && root.can-react {
                    Reactions.hover-bubble(root.anchor());
                } else {
                    Reactions.leave-bubble(root.msg.event-id);
                }
            }

            Text {
                text: QuickReactions.default-key;
                font-family: Fonts.emoji;
                font-size: Glyph.xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
