import {
    Palette,
} from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { MessageEntry } from "../types.slint";

import { MessagePreview } from "../message-preview.slint";
import { MessageShape } from "./message-body.slint";
import { QuickReactions } from "./reaction-picker.slint";
import { Interaction } from "../../../../components/a11y.slint";
import { Pill } from "../../../../components/pill.slint";
import {
    Composer,
    ReactionAnchor,
    Reactions,
    TextSelection,
} from "../../../../local.slint";
import { Actions } from "../../../../actions.slint";
import { Fonts, Glyph, IconSize, Metrics, Motion, Size, Space, Weight } from "../../../../theme.slint";

enum RowAction {
    select-text,
    reply,
    react,
}

export component RowActions inherits Rectangle {
    in property <MessageEntry> msg;
    in property <bool> bubble-hovered;
    in property <bool> strip-mine;

    callback anchor() -> ReactionAnchor;

    property <bool> has-remote-id: root.msg.event-id != "";
    property <bool> can-select-text: MessageShape.has-selectable-text(root.msg);
    property <[RowAction]> row-actions: root.offered-actions();
    property <bool> has-actions: root.row-actions.length > 0;

    property <bool> action-hovered: false;
    property <int> action-cursor: 0;
    property <RowAction> focused-action: root.row-actions[min(root.action-cursor, root.row-actions.length - 1)];

    property <length> pill-height: Size.target-min + 2 * Space.xs;
    property <length> pill-gap: Space.sm;
    property <length> pill-overlap: Space.sm;
    property <color> pill-fill: Palette.alternate-background;
    property <color> pill-foreground: Palette.accent-background;

    out property <bool> hovered: root.has-actions
        && (root.bubble-hovered
        || root.action-hovered
        || root.strip-mine
        || action-focus.has-focus);

    pure function action-label(action: RowAction) -> string {
        if action == RowAction.select-text {
            return @tr("Select the text of this message");
        }
        if action == RowAction.reply {
            return @tr("Reply to {}", root.msg.sender);
        }
        return @tr("React to {}'s message with {}", root.msg.sender, QuickReactions.default-key);
    }

    pure function offered-actions() -> [RowAction] {
        if root.has-remote-id && root.can-select-text {
            return [RowAction.select-text, RowAction.reply, RowAction.react];
        }
        if root.has-remote-id {
            return [RowAction.reply, RowAction.react];
        }
        if root.can-select-text {
            return [RowAction.select-text];
        }
        return [];
    }

    pure function available(action: RowAction) -> bool {
        return action == RowAction.select-text ? root.can-select-text : root.has-remote-id;
    }

    function run-action(action: RowAction) {
        if !root.available(action) {
            return;
        }
        if action == RowAction.select-text {
            TextSelection.select(root.msg.unique-id);
        } else if action == RowAction.reply {
            Composer.reply-event-id = root.msg.event-id;
            Composer.reply-sender = root.msg.sender;
            Composer.reply-preview = MessagePreview.label(root.msg.preview-kind, root.msg.preview-body);
        } else {
            Actions.toggle-reaction(root.msg.event-id, QuickReactions.default-key);
        }
    }

    action-focus := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: Interaction.actionable(root.has-actions, false);
        accessible-role: button;
        accessible-label: root.action-label(root.focused-action);
        accessible-action-default => {
            root.run-action(root.focused-action);
        }
        key-pressed(event) => {
            if event.text == Key.RightArrow {
                root.action-cursor = mod(root.action-cursor + 1, root.row-actions.length);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.action-cursor = mod(root.action-cursor + root.row-actions.length - 1, root.row-actions.length);
                return accept;
            }
            if Interaction.activates(event.text) {
                root.run-action(root.focused-action);
                return accept;
            }
            return reject;
        }
    }

    if root.hovered: Rectangle {
        property <bool> any-hovered: select-pill.has-hover
            || reply-pill.has-hover
            || react-btn.has-hover;

        width: 100%;
        height: 100%;
        opacity: 0;

        animate opacity {
            duration: Motion.fast;
            easing: ease-out;
        }

        init => {
            self.opacity = 1;
        }

        changed any-hovered => {
            root.action-hovered = self.any-hovered;
        }

        select-pill := Pill {
            x: reply-pill.visible ? reply-pill.x - self.width - root.pill-gap : root.width - self.width;
            y: reply-pill.y;
            width: root.pill-height;
            height: root.pill-height;
            pad: 0;
            fill: root.pill-fill;
            label: root.action-label(RowAction.select-text);
            enabled: root.available(RowAction.select-text);
            visible: self.enabled;
            focusable: false;
            roving-focus: action-focus.has-focus && root.focused-action == RowAction.select-text;
            clicked => {
                root.run-action(RowAction.select-text);
            }

            IconDisplay {
                icon: IconSet.TextCursor;
                size: IconSize.sm;
                stroke: root.pill-foreground;
            }
        }

        reply-pill := Pill {
            x: root.width - self.width;
            y: root.pill-overlap - self.height;
            height: root.pill-height;
            fill: root.pill-fill;
            label: root.action-label(RowAction.reply);
            enabled: root.available(RowAction.reply);
            visible: self.enabled;
            focusable: false;
            roving-focus: action-focus.has-focus && root.focused-action == RowAction.reply;
            clicked => {
                root.run-action(RowAction.reply);
            }

            Text {
                text: @tr("Reply");
                font-size: Fonts.body-small;
                font-weight: Weight.semibold;
                color: root.pill-foreground;
                vertical-alignment: center;
            }
        }

        react-btn := Pill {
            x: root.msg.is-own
                ? Metrics.reaction-strip-overlap - self.width
                : root.width - Metrics.reaction-strip-overlap;
            y: root.height - self.height;
            width: Metrics.reaction-strip-width;
            height: self.width;
            pad: 0;
            fill: root.pill-fill;
            label: root.action-label(RowAction.react);
            enabled: root.available(RowAction.react);
            visible: self.enabled;
            focusable: false;
            roving-focus: action-focus.has-focus && root.focused-action == RowAction.react;
            opacity: root.strip-mine ? 0 : 1;

            animate opacity {
                duration: Motion.fast;
                easing: ease-out;
            }

            clicked => {
                root.run-action(RowAction.react);
            }
            changed has-hover => {
                if (self.has-hover && root.has-remote-id) {
                    Reactions.hover-bubble(root.anchor());
                } else {
                    Reactions.leave-bubble(root.msg.event-id);
                }
            }

            Text {
                text: QuickReactions.default-key;
                font-family: Fonts.emoji;
                font-size: Glyph.xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
