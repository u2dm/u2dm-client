import { Palette } from "std-widgets.slint";
import { AppStyle, Fonts, Space, Stroke, Weight } from "../../../theme.slint";

export component ReplyQuote inherits HorizontalLayout {
    in property <string> sender;
    in property <string> preview;

    spacing: Space.md;

    Rectangle {
        width: Stroke.marker;
        border-radius: self.width / 2;
        background: Palette.accent-background;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Space.xs;

        Text {
            text: root.sender;
            font-size: Fonts.body-small;
            font-weight: Weight.bold;
            color: Palette.accent-background;
            overflow: elide;
        }

        Text {
            text: root.preview;
            font-family: Fonts.emoji;
            font-size: Fonts.body-small;
            color: AppStyle.overlay-foreground-muted;
            overflow: elide;
        }
    }
}
