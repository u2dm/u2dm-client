        if kind == UserMessageKind.room-address-taken {
            return @tr("{} is already taken", detail);
        }
        if kind == UserMessageKind.room-create-refused {
            return @tr("Your homeserver does not let you create rooms");
        }
        if kind == UserMessageKind.room-create-unsupported {
            return @tr("Your homeserver cannot create a room with these settings");
        }
        if kind == UserMessageKind.room-create-failed {
            return @tr("Could not create {}", detail);
        }
        if kind == UserMessageKind.add-to-space-failed {
            return @tr("Created the room, but could not add it to {}", detail);
        }
        if kind == UserMessageKind.people-search-failed {
            return @tr("Could not search the user directory");
        }
        if kind == UserMessageKind.invite-blocked {
            return @tr("{} does not accept invites", detail);
        }
        if kind == UserMessageKind.invite-refused {
            return @tr("You cannot invite {} to this room", detail);
        }
        if kind == UserMessageKind.invite-failed {
            return @tr("Could not invite {}", detail);
        }
        if kind == UserMessageKind.notify-change-failed {
            return @tr("Could not change the notifications for {}", detail);
        }
        if kind == UserMessageKind.mark-read-failed {
            return @tr("Could not mark {} as read", detail);
        }
        if kind == UserMessageKind.room-link-failed {
            return @tr("Could not copy the link to {}", detail);
        }
        if kind == UserMessageKind.user-info-failed {
            return @tr("Could not load the profile of {}", detail);
        }
        if kind == UserMessageKind.direct-chat-failed {
            return @tr("Could not start a chat with {}", detail);
        }
        if kind == UserMessageKind.user-verification-failed {
            return @tr("Could not ask {} to verify. Please try again.", detail);
        }
        if kind == UserMessageKind.partner-left-chat {
            return @tr("{} is no longer in your chat, so the request cannot reach them. Invite them back first.", detail);
        }
        if kind == UserMessageKind.ignore-failed {
            return @tr("Could not ignore {}", detail);
        }
        if kind == UserMessageKind.unignore-failed {
            return @tr("Could not stop ignoring {}", detail);
        }
        if kind == UserMessageKind.kick-failed {
            return @tr("Could not remove {} from the room", detail);
        }
        if kind == UserMessageKind.ban-failed {
            return @tr("Could not ban {}", detail);
        }
        if kind == UserMessageKind.unban-failed {
            return @tr("Could not unban {}", detail);
        }
        if kind == UserMessageKind.identity-accept-failed {
            return @tr("Could not accept the new identity of {}", detail);
        }
        if kind == UserMessageKind.verification-withdraw-failed {
            return @tr("Could not withdraw the verification of {}", detail);
        }
        if kind == UserMessageKind.identity-reset-acknowledge-failed {
            return @tr("Could not save that you saw your identity was reset");
        }
        if kind == UserMessageKind.media-download-failed {
            return @tr("Failed to download media");
        }
        if kind == UserMessageKind.file-download-failed {
            return @tr("Failed to download file");
        }
        if kind == UserMessageKind.media-open-failed {
            return @tr("Failed to open media");
        }
        if kind == UserMessageKind.media-not-viewable {
            return @tr("That attachment isn't a viewable image");
        }
        if kind == UserMessageKind.attachment-unreadable {
            return @tr("That file could not be read");
        }
        if kind == UserMessageKind.attachment-too-large {
            return @tr("That file is larger than this homeserver accepts (limit {})", detail);
        }
        if kind == UserMessageKind.caption-too-long {
            return @tr("The caption is too long. Shorten it by about {}%.", detail);
        }
        if kind == UserMessageKind.send-attachment-failed {
            return @tr("Failed to send attachment");
        }
        if kind == UserMessageKind.poll-vote-failed {
            return @tr("Your vote couldn't be sent");
        }
        if kind == UserMessageKind.poll-end-failed {
            return @tr("The poll couldn't be ended");
        }
        if kind == UserMessageKind.poll-edit-failed {
            return @tr("Your changes to the poll couldn't be saved");
        }
        if kind == UserMessageKind.poll-too-long {
            return @tr("The poll is too long. Shorten it by about {}%.", detail);
        }
        if kind == UserMessageKind.video-playback-failed {
            return @tr("This video could not be played");
        }
        if kind == UserMessageKind.audio-playback-failed {
            return @tr("This audio could not be played");
        }
        if kind == UserMessageKind.file-save-failed {
            return @tr("Failed to save file");
        }
        if kind == UserMessageKind.file-saved {
            return @tr("File saved to {}", detail);
        }
        if kind == UserMessageKind.verification-accept-failed {
            return @tr("Could not accept the request. Please try again.");
        }
        if kind == UserMessageKind.verification-confirm-failed {
            return @tr("Could not confirm the match. Please try again.");
        }
        if kind == UserMessageKind.verification-reject-failed {
            return @tr("Could not decline the request. Please try again.");
        }
        if kind == UserMessageKind.verification-timed-out {
            return @tr("Nobody answered in time, so the request expired.");
        }
        if kind == UserMessageKind.verification-sas-accept-failed {
            return @tr("Could not accept the verification. Please try again.");
        }
        if kind == UserMessageKind.verification-cancelled {
            return @tr("The other device cancelled the verification.");
        }
        if kind == UserMessageKind.verification-declined {
            return @tr("You declined the verification.");
        }
        if kind == UserMessageKind.verification-withdrawn {
            return @tr("You cancelled the verification.");
        }
        if kind == UserMessageKind.verification-mismatch {
            return @tr("The emoji did not match, so the verification was stopped.");
        }
        if kind == UserMessageKind.verification-accepted-elsewhere {
            return @tr("This request was answered on another one of your devices.");
        }
        if kind == UserMessageKind.verification-failed {
            return @tr("The verification could not be completed.");
        }
        if kind == UserMessageKind.verification-request-failed {
            return @tr("Could not ask your other sessions to verify this one. Please try again.");
        }
        if kind == UserMessageKind.recovery-key-wrong {
            return @tr("That recovery key or passphrase is not the one for your account.");
        }
        if kind == UserMessageKind.recovery-key-failed {
            return @tr("Could not use the recovery key. Check your connection and try again.");
        }
        if kind == UserMessageKind.recovery-setup-failed {
            return @tr("Could not set up recovery. Please try again.");
        }
        if kind == UserMessageKind.recovery-backup-in-the-way {
            return @tr("Your account already has a key backup this session cannot open. Set up recovery in the client that made it.");
        }
        if kind == UserMessageKind.recovery-key-change-failed {
            return @tr("Could not change the recovery key. Please try again.");
        }
        if kind == UserMessageKind.auth-password-wrong {
            return @tr("That password isn't right. Please try again.");
        }
        if kind == UserMessageKind.auth-step-unfinished {
            return @tr("Your homeserver says that step isn't finished yet. Finish it in your browser, then continue.");
        }
        if kind == UserMessageKind.auth-refused {
            return @tr("Your homeserver refused the confirmation: {}", detail);
        }
        if kind == UserMessageKind.auth-unsupported {
            return @tr("Your homeserver asks for a kind of confirmation U2DM can't do yet. Use another Matrix app for this.");
        }
        if kind == UserMessageKind.session-rename-failed {
            return @tr("Could not rename the session. Please try again.");
        }
        if kind == UserMessageKind.session-sign-out-failed {
            return @tr("Could not sign out of {}. Please try again.", detail);
        }
        if kind == UserMessageKind.session-signed-out {
            return @tr("Signed out of {}.", detail);
        }
        if kind == UserMessageKind.password-change-failed {
            return @tr("Could not change your password. Please try again.");
        }
        if kind == UserMessageKind.new-password-too-weak {
            return @tr("Use at least 8 characters, with a lower-case letter, an upper-case letter, a number and a symbol.");
        }
        if kind == UserMessageKind.new-password-refused {
            return @tr("Your homeserver refused that password: {}", detail);
        }
        if kind == UserMessageKind.password-changed {
            return @tr("Your password was changed.");
        }
        if kind == UserMessageKind.password-changed-others-signed-out {
            return @tr("Your password was changed, and your other sessions were signed out.");
        }
        if kind == UserMessageKind.deactivation-failed {
            return @tr("Could not deactivate your account. Please try again.");
        }
        if kind == UserMessageKind.account-page-opened {
            return @tr("Your homeserver's account page opened in your browser. Continue there.");
        }
        if kind == UserMessageKind.identity-reset-failed {
            return @tr("Could not reset your identity. Please try again.");
        }
        if kind == UserMessageKind.encryption-setup-failed {
            return @tr("Could not set up encryption. Please try again.");
        }
        if kind == UserMessageKind.key-export-failed {
            return @tr("Could not export your room keys.");
        }
        if kind == UserMessageKind.key-import-failed {
            return @tr("Could not import room keys from that file.");
        }
        if kind == UserMessageKind.key-passphrase-wrong {
            return @tr("That passphrase doesn't open this file.");
        }
        if kind == UserMessageKind.key-file-unreadable {
            return @tr("That file isn't a room key export U2DM can read.");
        }
        return "";
    }
}

export global Clocks {
    pure function pad(value: int) -> string {
        return value < 10 ? "0" + value : value;
    }

    public pure function label(total-ms: int) -> string {
        if total-ms <= 0 {
            return "0:00";
        }
        if total-ms < 3600000 {
            return floor(total-ms / 60000) + ":" + root.pad(floor(mod(total-ms / 1000, 60)));
        }
        return floor(total-ms / 3600000) + ":" + root.pad(floor(mod(total-ms / 60000, 60))) + ":"
            + root.pad(floor(mod(total-ms / 1000, 60)));
    }
}

export global Deliveries {
    public pure function label(delivery: Delivery, readers: string, hidden-readers: int) -> string {
        if delivery == Delivery.pending {
            return @tr("Sending");
        }
        if delivery == Delivery.sent {
            return @tr("Sent");
        }
        if delivery == Delivery.read || delivery == Delivery.seen {
            if readers == "" {
                return @tr("Read");
            }
            return hidden-readers > 0
                ? @tr("Read by {} and {} more", readers, hidden-readers)
                : @tr("Read by {}", readers);
        }
        if delivery == Delivery.failed {
            return @tr("Not sent");
        }
        return "";
    }
}

export global DeliveryStatus {
    public pure function text(delivery: Delivery, sent-at: string) -> string {
        if delivery == Delivery.pending {
            return @tr("Sending…");
        }
        if delivery == Delivery.sent {
            return @tr("Sent {}", sent-at);
        }
        if delivery == Delivery.read {
            return @tr("Read · sent {}", sent-at);
        }
        if delivery == Delivery.failed {
            return @tr("Not sent");
        }
        return "";
    }
}

export global ShieldReasons {
    public pure function text(reason: ShieldReason) -> string {
        if reason == ShieldReason.sent-in-clear {
            return @tr("Not encrypted");
        }
        if reason == ShieldReason.mismatched-sender {
            return @tr("Encrypted by a device that doesn't belong to the sender");
        }
        if reason == ShieldReason.unknown-device {
            return @tr("Encrypted by an unknown or deleted device");
        }
        if reason == ShieldReason.unsigned-device {
            return @tr("Encrypted by a device not verified by its owner");
        }
        if reason == ShieldReason.verification-violation {
            return @tr("Encrypted by a user whose verified identity changed");
        }
        if reason == ShieldReason.unverified-identity {
            return @tr("Encrypted by an unverified user");
        }
        if reason == ShieldReason.authenticity-not-guaranteed {
            return @tr("Authenticity can't be guaranteed on this device");
        }
        return "";
    }
}

export global MediaFailures {
    public pure function reason(failure: MediaFailure, is-video: bool) -> string {
        if failure == MediaFailure.no-source {
            return is-video
                ? @tr("This message carries no preview image.")
                : @tr("This message carries no image to download.");
        }
        if failure == MediaFailure.download {
            return @tr("The homeserver did not send it. It may be offline, or the file may be gone.");
        }
        if failure == MediaFailure.too-large {
            return is-video
                ? @tr("It is larger than the download limit for videos.")
                : @tr("It is larger than the download limit for images.");
        }
        if failure == MediaFailure.storage {
            return @tr("It could not be written to the media cache on this device.");
        }
        if failure == MediaFailure.unreadable {
            return is-video
                ? @tr("It downloaded, but could not be read as a video.")
                : @tr("It downloaded, but could not be read as an image.");
        }
        if failure == MediaFailure.unsupported-format {
            return is-video
                ? @tr("The preview image downloaded, but U2DM cannot display its format.")
                : @tr("It downloaded, but U2DM cannot display this image format.");
        }
        if failure == MediaFailure.too-large-to-display {
            return is-video
                ? @tr("The preview image downloaded, but is too large to display here.")
                : @tr("It downloaded, but is too large to display here.");
        }
        if failure == MediaFailure.damaged {
            return is-video
                ? @tr("The preview image downloaded, but is damaged or incomplete.")
                : @tr("It downloaded, but the file is damaged or incomplete.");
        }
        return @tr("It could not be loaded.");
    }

    pure function join(left: string, right: string) -> string {
        if left == "" {
            return right;
        }
        if right == "" {
            return left;
        }
        return @tr("{} · {}", left, right);
    }

    public pure function detail(extension: string, mimetype: string, width: int, height: int) -> string {
        return root.join(
            root.join(extension, mimetype),
            width > 0 && height > 0 ? @tr("{}×{}", width, height) : "",
        );
    }
}

export global SpoilerCover {
    in-out property <string> reason-slot: "{}";
    in-out property <string> label: @tr("Spoiler");
    in-out property <string> reason-label: @tr("Spoiler: {}", root.reason-slot);
}

export global MessagePreview {
    public pure function label(kind: PreviewKind, body: string) -> string {
        if kind == PreviewKind.image {
            return @tr("📷 Photo");
        }
        if kind == PreviewKind.video {
            return @tr("🎬 Video");
        }
        if kind == PreviewKind.audio {
            return @tr("🎵 Audio");
        }
        if kind == PreviewKind.voice {
            return @tr("🎤 Voice message");
        }
        if kind == PreviewKind.file {
            return @tr("📎 {}", body);
        }
        if kind == PreviewKind.location {
            return @tr("📍 Location");
        }
        if kind == PreviewKind.encrypted {
            return @tr("🔒 Encrypted message");
        }
        if kind == PreviewKind.sticker {
            return @tr("Sticker");
        }
        if kind == PreviewKind.poll {
            return @tr("📊 {}", body);
        }
        if kind == PreviewKind.deleted {
            return @tr("🗑 Deleted message");
        }
        return body;
    }
}

export global ReactionKeys {
    public pure function label(art: EmojiArt, text: string) -> string {
        if art == EmojiArt.text {
            return text;
        }
        return @tr("custom emoji");
    }
}

export global ServiceLabel {
    public pure function explained(kind: ServiceKind, actor: string, target: string, reason: string) -> string {
        if reason == "" {
            return root.label(kind, actor, target);
        }
        return @tr("{}: {}", root.label(kind, actor, target), reason);
    }

    public pure function label(kind: ServiceKind, actor: string, target: string) -> string {
        if kind == ServiceKind.joined {
            return @tr("{} joined the room", actor);
        }
        if kind == ServiceKind.left {
            return @tr("{} left the room", actor);
        }
        if kind == ServiceKind.invited {
            return @tr("{} invited {}", actor, target);
        }
        if kind == ServiceKind.invitation-accepted {
            return @tr("{} accepted the invitation", actor);
        }
        if kind == ServiceKind.invitation-rejected {
            return @tr("{} rejected the invitation", actor);
        }
        if kind == ServiceKind.invitation-revoked {
            return @tr("{} revoked the invitation for {}", actor, target);
        }
        if kind == ServiceKind.kicked {
            return @tr("{} removed {}", actor, target);
        }
        if kind == ServiceKind.banned {
            return @tr("{} banned {}", actor, target);
        }
        if kind == ServiceKind.unbanned {
            return @tr("{} unbanned {}", actor, target);
        }
        if kind == ServiceKind.knocked {
            return @tr("{} requested to join", actor);
        }
        if kind == ServiceKind.knock-accepted {
            return @tr("{} allowed {} to join", actor, target);
        }
        if kind == ServiceKind.knock-retracted {
            return @tr("{} withdrew their request to join", actor);
        }
        if kind == ServiceKind.knock-denied {
            return @tr("{} declined the request to join from {}", actor, target);
        }
        if kind == ServiceKind.name-set {
            return @tr("{} set their name to {}", actor, target);
        }
        if kind == ServiceKind.name-changed {
            return @tr("{} changed their name to {}", actor, target);
        }
        if kind == ServiceKind.name-removed {
            return @tr("{} removed their name", actor);
        }
        if kind == ServiceKind.avatar-changed {
            return @tr("{} changed their avatar", actor);
        }
        if kind == ServiceKind.room-name {
            return @tr("{} changed the room name to {}", actor, target);
        }
        if kind == ServiceKind.room-name-removed {
            return @tr("{} removed the room name", actor);
        }
        if kind == ServiceKind.room-topic {
            return @tr("{} changed the room topic", actor);
        }
        if kind == ServiceKind.room-avatar {
            return @tr("{} changed the room avatar", actor);
        }
        if kind == ServiceKind.room-created {
            return @tr("{} created the room", actor);
        }
        if kind == ServiceKind.upgraded-room-created {
            return @tr("{} created this room to continue an older one", actor);
        }
        if kind == ServiceKind.room-upgraded {
            return @tr("{} upgraded this room", actor);
        }
        if kind == ServiceKind.encryption {
            return @tr("{} enabled end-to-end encryption", actor);
        }
        if kind == ServiceKind.join-public {
            return @tr("{} made the room public", actor);
        }
        if kind == ServiceKind.join-invite {
            return @tr("{} made the room invite only", actor);
        }
        if kind == ServiceKind.join-knock {
            return @tr("{} let people ask to join the room", actor);
        }
        if kind == ServiceKind.join-restricted {
            return @tr("{} let space members join the room", actor);
        }
        if kind == ServiceKind.join-knock-restricted {
            return @tr("{} let space members join and others ask to join", actor);
        }
        if kind == ServiceKind.join-rule {
            return @tr("{} changed who can join the room", actor);
        }
        if kind == ServiceKind.history-world-readable {
            return @tr("{} made future room history visible to anyone", actor);
        }
        if kind == ServiceKind.history-shared {
            return @tr("{} made future room history visible to all members", actor);
        }
        if kind == ServiceKind.history-invited {
            return @tr("{} made future room history visible to members from when they are invited", actor);
        }
        if kind == ServiceKind.history-joined {
            return @tr("{} made future room history visible to members from when they join", actor);
        }
        if kind == ServiceKind.history {
            return @tr("{} changed who can see future room history", actor);
        }
        if kind == ServiceKind.guests-allowed {
            return @tr("{} allowed guests to join the room", actor);
        }
        if kind == ServiceKind.guests-forbidden {
            return @tr("{} stopped guests from joining the room", actor);
        }
        if kind == ServiceKind.guest-access {
            return @tr("{} changed whether guests can join the room", actor);
        }
        if kind == ServiceKind.server-acl {
            return @tr("{} changed which servers can take part in the room", actor);
        }
        if kind == ServiceKind.main-address {
            return @tr("{} set the room's main address to {}", actor, target);
        }
        if kind == ServiceKind.main-address-removed {
            return @tr("{} removed the room's main address", actor);
        }
        if kind == ServiceKind.alt-addresses {
            return @tr("{} changed the room's alternative addresses", actor);
        }
        if kind == ServiceKind.message-pinned {
            return @tr("{} pinned a message", actor);
        }
        if kind == ServiceKind.message-unpinned {
            return @tr("{} unpinned a message", actor);
        }
        if kind == ServiceKind.pins-changed {
            return @tr("{} changed the pinned messages", actor);
        }
        if kind == ServiceKind.made-admin {
            return @tr("{} made {} an admin", actor, target);
        }
        if kind == ServiceKind.made-moderator {
            return @tr("{} made {} a moderator", actor, target);
        }
        if kind == ServiceKind.no-longer-admin {
            return @tr("{} removed {} as an admin", actor, target);
        }
        if kind == ServiceKind.no-longer-moderator {
            return @tr("{} removed {} as a moderator", actor, target);
        }
        if kind == ServiceKind.power-level {
            return @tr("{} changed the power level of {}", actor, target);
        }
        if kind == ServiceKind.power-levels {
            return @tr("{} changed the room's power levels", actor);
        }
        if kind == ServiceKind.call-started {
            return @tr("{} started a call", actor);
        }
        if kind == ServiceKind.call-notification {
            return @tr("{} started a call", actor);
        }
        if kind == ServiceKind.call-video-notification {
            return @tr("{} started a video call", actor);
        }
        if kind == ServiceKind.call-declined {
            return @tr("{} called, {} declined", actor, target);
        }
        if kind == ServiceKind.verification-requested {
            return @tr("{} sent {} a verification request", actor, target);
        }
        if target != "" {
            return target;
        }
        return actor;
    }
}

export global NotificationText {
    in-out property <string> open-label: @tr("Open");
    in-out property <string> decline-label: @tr("Decline");
    in-out property <string> answer-label: @tr("Answer");

    public pure function ring(video: bool, caller: string) -> string {
        if video {
            return @tr("Incoming video call from {}", caller);
        }
        return @tr("Incoming call from {}", caller);
    }

    public pure function message(kind: PreviewKind, body: string, sender: string) -> string {
        if sender == "" {
            return MessagePreview.label(kind, body);
        }
        return @tr("{}: {}", sender, MessagePreview.label(kind, body));
    }

    public pure function service(kind: ServiceKind, actor: string, target: string) -> string {
        return ServiceLabel.label(kind, actor, target);
    }

    public pure function invite(inviter: string) -> string {
        if inviter == "" {
            return @tr("Invitation");
        }
        return @tr("Invited by {}", inviter);
    }
}

export global CallWords {
    public pure function incoming(video: bool) -> string {
        if video {
            return @tr("Incoming video call");
        }
        return @tr("Incoming voice call");
    }

    public pure function in-call(people: int) -> string {
        return @tr("{n} in the call" | "{n} in the call" % people);
    }

    public pure function mark(mark: RoomCallMark) -> string {
        if mark == RoomCallMark.voice {
            return @tr("voice call in progress");
        }
        if mark == RoomCallMark.video {
            return @tr("video call in progress");
        }
        return "";
    }

    public pure function phase(phase: CallPhase, elapsed: string) -> string {
        if phase == CallPhase.joining {
            return @tr("Joining the call…");
        }
        if phase == CallPhase.ringing {
            return @tr("Ringing…");
        }
        if phase == CallPhase.connecting {
            return @tr("Connecting…");
        }
        if phase == CallPhase.reconnecting {
            return @tr("Reconnecting…");
        }
        return elapsed;
    }

    public pure function tile(state: CallTileState) -> string {
        if state == CallTileState.joining {
            return @tr("Joining…");
        }
        if state == CallTileState.waiting-for-keys {
            return @tr("Waiting for keys");
        }
        if state == CallTileState.cant-decrypt {
            return @tr("Can't decrypt");
        }
        if state == CallTileState.unverified-device {
            return @tr("Can't decrypt: this device isn't verified by its owner");
        }
        if state == CallTileState.unreachable {
            return @tr("Can't reach their call server");
        }
        return "";
    }

    public pure function refusal(refusal: CallRefusal) -> string {
        if refusal == CallRefusal.not-built {
            return @tr("This build of U2DM can't join calls");
        }
        if refusal == CallRefusal.media-broken {
            return @tr("Your microphone and speaker could not start");
        }
        if refusal == CallRefusal.no-server {
            return @tr("Your homeserver has no call server");
        }
        if refusal == CallRefusal.not-allowed {
            return @tr("You may not join calls in this room");
        }
        return @tr("Verify this session to join encrypted calls");
    }

    public pure function share(screen: CallScreen, refusal: CallScreenRefusal) -> string {
        if screen == CallScreen.choosing {
            return @tr("Cancel sharing your screen");
        }
        if screen == CallScreen.on {
            return @tr("Stop sharing your screen");
        }
        if screen == CallScreen.failed {
            return @tr("Your screen share did not start, try again");
        }
        if screen == CallScreen.unavailable {
            if refusal == CallScreenRefusal.not-wayland {
                return @tr("Screen sharing needs a Wayland session");
            }
            return @tr("Screen sharing needs the desktop's screen-cast portal");
        }
        return @tr("Share your screen");
    }

    public pure function screen-of(name: string) -> string {
        return @tr("{}'s screen", name);
    }

    public pure function microphone(mic: CallMic) -> string {
        if mic == CallMic.on {
            return @tr("Mute your microphone");
        }
        if mic == CallMic.failed {
            return @tr("Your microphone did not start, try again");
        }
        return @tr("Unmute your microphone");
    }

    public pure function camera(camera: CallCamera) -> string {
        if camera == CallCamera.on || camera == CallCamera.starting {
            return @tr("Turn your camera off");
        }
        if camera == CallCamera.failed {
            return @tr("Your camera did not start, try again");
        }
        return @tr("Turn your camera on");
    }

    public pure function stop-sharing(screen: CallScreen) -> string {
        if screen == CallScreen.choosing {
            return @tr("Cancel sharing");
        }
        return @tr("Stop sharing");
    }
}

export global TypingLine {
    public pure function text(count: int, first: string, second: string) -> string {
        if count <= 0 {
            return "";
        }
        if count == 1 {
            return @tr("{} is typing…", first);
        }
        if count == 2 {
            return @tr("{} and {} are typing…", first, second);
        }
        return @tr("{} and {n} other is typing…" | "{} and {n} others are typing…" % (count - 1), first);
    }
}

export global PresenceWords {
    public pure function text(line: PresenceLine, minutes: int) -> string {
        if line == PresenceLine.online {
            return @tr("Online");
        }
        if line == PresenceLine.away {
            return @tr("Away");
        }
        if line != PresenceLine.last-seen {
            return "";
        }
        if minutes < 1 {
            return @tr("Last seen just now");
        }
        if minutes < 60 {
            return @tr("Last seen {n} minute ago" | "Last seen {n} minutes ago" % minutes);
        }
        if minutes < 1440 {
            return @tr("Last seen {n} hour ago" | "Last seen {n} hours ago" % floor(minutes / 60));
        }
        if minutes < 43200 {
            return @tr("Last seen {n} day ago" | "Last seen {n} days ago" % floor(minutes / 1440));
        }
        return @tr("Last seen over a month ago");
    }
}

export global UpgradeLinks {
    public pure function successor(link: UpgradeLink) -> string {
        if link == UpgradeLink.open {
            return @tr("Open the new room");
        }
        if link == UpgradeLink.join {
            return @tr("Join the new room");
        }
        if link == UpgradeLink.joining {
            return @tr("Joining the new room…");
        }
        return "";
    }

    public pure function predecessor(link: UpgradeLink) -> string {
        if link == UpgradeLink.open {
            return @tr("Open the old room");
        }
        if link == UpgradeLink.join {
            return @tr("Join the old room");
        }
        if link == UpgradeLink.joining {
            return @tr("Joining the old room…");
        }
        return "";
    }
}
