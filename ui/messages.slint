import { CallCamera, CallMic, CallPhase, CallRefusal, CallScreen, CallScreenRefusal, CallTileState, Delivery, EmojiArt, MediaFailure, PresenceLine, PreviewKind, RoomCallMark, ServiceKind, ShieldReason, UpgradeLink, UserMessageKind } from "./enums.slint";

export global UserMessages {
    public pure function text(kind: UserMessageKind, detail: string) -> string {
        if kind == UserMessageKind.server-unreachable {
            return @tr("Could not reach that homeserver. Check the address and your connection.");
        }
        if kind == UserMessageKind.sliding-sync-unsupported {
            return @tr("This homeserver does not offer sliding sync (MSC4186), which U2DM needs to receive messages. Ask its administrator to turn it on.");
        }
        if kind == UserMessageKind.unsupported-login-method {
            if detail == "" {
                return @tr("This homeserver did not offer any login method U2DM supports.");
            }
            return @tr("This homeserver only offers login methods U2DM does not support yet: {}", detail);
        }
        if kind == UserMessageKind.login-failed {
            return @tr("Login failed. Please try again.");
        }
        if kind == UserMessageKind.invalid-credentials {
            return @tr("Incorrect username or password.");
        }
        if kind == UserMessageKind.account-deactivated {
            return @tr("This account has been deactivated.");
        }
        if kind == UserMessageKind.invalid-username {
            return @tr("That username is not valid on this homeserver.");
        }
        if kind == UserMessageKind.rate-limited {
            return @tr("Too many attempts. Please wait a moment and try again.");
        }
        if kind == UserMessageKind.login-method-unsupported {
            return @tr("This homeserver does not support this way of signing in.");
        }
        if kind == UserMessageKind.insecure-sign-in-page {
            return @tr("This homeserver's sign-in page is not a secure web address, so U2DM did not open it.");
        }
        if kind == UserMessageKind.session-unreadable {
            return @tr("U2DM keeps your session in your credential store, which could not be read. Nothing was deleted. Unlock the credential store, then try again. ({})", detail);
        }
        if kind == UserMessageKind.session-restore-failed {
            return @tr("The saved session could not be restored. Please log in again.");
        }
        if kind == UserMessageKind.store-key-missing {
            return @tr("The key to the local store is missing. Please log in again.");
        }
        if kind == UserMessageKind.store-key-unreadable {
            return @tr("The key to this device's encrypted data could not be read from your credential store. Nothing was deleted. Unlock the credential store, then try again. ({})", detail);
        }
        if kind == UserMessageKind.identity-diverged {
            return @tr("This session's encryption keys no longer match the ones the server has for it. Please log in again to create a new session.");
        }
        if kind == UserMessageKind.session-expired {
            return @tr("Session expired. Please log in again.");
        }
        if kind == UserMessageKind.reauth-not-possible {
            return @tr("Signing in returned a different account or device, so this device's encrypted history cannot be reused. Sign in again as the same user, or sign out to start a new session.");
        }
        if kind == UserMessageKind.data-quarantined {
            return @tr("Some local data could not be deleted, but its key was destroyed, so it is unreadable. It will be removed on the next start. ({})", detail);
        }
        if kind == UserMessageKind.data-not-erased {
            return @tr("Some local account data could not be erased.");
        }
        if kind == UserMessageKind.device-left-behind {
            return @tr("Your homeserver may still list session {}, which U2DM could not sign out. Remove it from the sessions list in another Matrix client.", detail);
        }
        if kind == UserMessageKind.interrupted-login-unresolved {
            return @tr("An earlier login was interrupted and cannot be undone safely, so signing in is paused to protect the encrypted history of the previous session. Make sure your credential store is unlocked and restart U2DM. ({})", detail);
        }
        if kind == UserMessageKind.another-instance-running {
            return @tr("Another U2DM is already running and is using the local data, so this window will not touch it. Close the other U2DM and try again. ({})", detail);
        }
        if kind == UserMessageKind.local-data-claim-failed {
            return @tr("U2DM could not claim its local data for this window alone, so signing in is paused rather than risk two copies writing the same stores. Make sure no other U2DM is running and that its data directory is writable, then restart U2DM. ({})", detail);
        }
        if kind == UserMessageKind.session-save-failed {
            return @tr("Could not save the refreshed session.");
        }
        if kind == UserMessageKind.send-message-failed {
            return @tr("Failed to send message");
        }
        if kind == UserMessageKind.send-not-allowed {
            return @tr("The room's permissions don't let you send that");
        }
        if kind == UserMessageKind.load-more-failed {
            return @tr("Failed to load more messages");
        }
        if kind == UserMessageKind.message-not-found {
            return @tr("That message could not be found");
        }
        if kind == UserMessageKind.message-not-showable {
            return @tr("That message can't be shown");
        }
        if kind == UserMessageKind.message-link-failed {
            return @tr("Couldn't copy the link to that message");
        }
        if kind == UserMessageKind.message-pin-failed {
            return @tr("Couldn't pin that message");
        }
        if kind == UserMessageKind.message-unpin-failed {
            return @tr("Couldn't unpin that message");
        }
        if kind == UserMessageKind.message-delete-failed {
            return @tr("Couldn't delete that message");
        }
        if kind == UserMessageKind.space-order-save-failed {
            return @tr("Failed to save space order");
        }
        if kind == UserMessageKind.pack-setting-failed {
            return @tr("Couldn't change where that pack is used");
        }
        if kind == UserMessageKind.join-room-failed {
            return @tr("Could not join {}", detail);
        }
        if kind == UserMessageKind.join-new-room-failed {
            return @tr("Could not join the room that replaced {}", detail);
        }
        if kind == UserMessageKind.join-old-room-failed {
            return @tr("Could not join the room that {} replaced", detail);
        }
        if kind == UserMessageKind.decline-invite-failed {
            return @tr("Could not decline the invitation to {}", detail);
        }
        if kind == UserMessageKind.call-decline-failed {
            return @tr("Could not decline the call in {}", detail);
        }
        if kind == UserMessageKind.call-join-failed {
            return @tr("Could not join the call in {}", detail);
        }
        if kind == UserMessageKind.call-server-unreachable {
            return @tr("Could not reach the call server for {}", detail);
        }
        if kind == UserMessageKind.call-media-failed {
            return @tr("Could not start the call's audio in {}", detail);
        }
        if kind == UserMessageKind.call-cut-off {
            return @tr("The call in {} was cut off", detail);
        }
        if kind == UserMessageKind.call-no-answer {
            return @tr("Nobody answered the call in {}", detail);
        }
        if kind == UserMessageKind.call-declined-there {
            return @tr("{} declined the call", detail);
        }
        if kind == UserMessageKind.room-not-found {
            return @tr("No room has the address {}", detail);
        }
        if kind == UserMessageKind.room-preview-failed {
            return @tr("Could not look up {}", detail);
        }
        if kind == UserMessageKind.room-address-invalid {
            return @tr("Enter a room address like #room:example.org, or a Matrix link");
        }
        if kind == UserMessageKind.leave-room-failed {
            return @tr("Could not leave {}", detail);
        }
        if kind == UserMessageKind.space-rooms-kept {
            return @tr("Left {}, but could not leave some of its rooms", detail);
        }
        if kind == UserMessageKind.forget-room-failed {
            return @tr("Could not forget {}", detail);
        }
        if kind == UserMessageKind.room-name-missing {
            return @tr("Give it a name");
        }
        if kind == UserMessageKind.room-address-missing {
            return @tr("A room anyone can join needs an address");
        }
        if kind == UserMessageKind.room-address-unusable {
            return @tr("An address can only use letters, digits and . _ = - +");
