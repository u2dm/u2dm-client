import { Delivery, LoginPhase } from "enums.slint";
import { AttachmentView, LoginView, RoomView, VerificationView, VideoView, WindowView } from "views.slint";
import { MessageEntry, ReactionEntry } from "screens/chat/components/types.slint";
import { MessagePreview } from "screens/chat/components/message-preview.slint";
import { Metrics } from "theme.slint";

export struct ReactionAnchor {
    event-id: string,
    row: int,
    is-own: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

export global Probe {
    in property <bool> enabled: false;
}

export global Composer {
    in-out property <string> reply-event-id;
    in-out property <string> reply-sender;
    in-out property <string> reply-preview;

    public function clear() {
        self.reply-event-id = "";
        self.reply-sender = "";
        self.reply-preview = "";
    }
}

export global TextSelection {
    in-out property <string> active-id;

    public function select(id: string) {
        self.active-id = id;
    }

    public function clear() {
        self.active-id = "";
    }
}

export global Shell {
    in-out property <bool> drawer-open: false;
    in-out property <bool> nav-open: false;
    in-out property <bool> picker-open: false;
    in-out property <bool> attach-open: false;

    out property <bool> verification-open: VerificationView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> attachment-open: AttachmentView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> video-open: VideoView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> modal-over-nav: root.drawer-open
        || root.verification-open
        || root.attachment-open
        || root.video-open;
    out property <bool> modal-open: root.nav-open || root.modal-over-nav;
    out property <bool> nav-on-top: root.nav-open && !root.modal-over-nav;
    out property <bool> background-reachable: !root.modal-open;

    public function close-overlays() {
        self.drawer-open = false;
        self.nav-open = false;
        self.picker-open = false;
        self.attach-open = false;
    }
}

export global DeliveryTip {
    in-out property <string> key;
    in-out property <bool> on-counter;
    in-out property <ReactionAnchor> anchor: { row: -1 };

    out property <MessageEntry> target: (root.anchor.row >= 0
        && root.anchor.row < RoomView.timeline.length)
        ? RoomView.timeline[root.anchor.row]
        : { };
    out property <bool> names-readers: root.target.delivery == Delivery.read
        || root.target.delivery == Delivery.seen;
    out property <bool> showing: root.key != ""
        && root.target.unique-id == root.key
        && (root.on-counter ? root.names-readers : root.target.delivery != Delivery.none);

    public function show(key: string, a: ReactionAnchor, on-counter: bool) {
        self.key = key;
        self.anchor = a;
        self.on-counter = on-counter;
    }

    public function follow(key: string, a: ReactionAnchor, on-counter: bool) {
        if (self.key == key && self.on-counter == on-counter) {
            self.anchor = a;
        }
    }

    public function hide(key: string, on-counter: bool) {
        if (self.key == key && self.on-counter == on-counter) {
            self.clear();
        }
    }

    public function clear() {
        self.key = "";
        self.anchor = { row: -1 };
    }
}

export global Reactions {
    in-out property <ReactionAnchor> anchor: { row: -1 };
    in-out property <bool> picker-open: false;
    in-out property <bool> detail-open: false;

    in-out property <ReactionAnchor> strip-anchor: { row: -1 };
    in-out property <bool> bubble-hovered: false;
    in-out property <bool> strip-hovered: false;
    in-out property <bool> strip-revealed: false;

    in-out property <int> tooltip-row: -1;
    in-out property <string> tooltip-event-id;
    in-out property <string> tooltip-text;
    in-out property <ReactionAnchor> tooltip-anchor;

    out property <MessageEntry> target: (root.anchor.row >= 0
        && root.anchor.row < RoomView.timeline.length)
        ? RoomView.timeline[root.anchor.row]
        : { };
    out property <bool> target-valid: root.anchor.event-id != ""
        && root.target.event-id == root.anchor.event-id;
    out property <[ReactionEntry]> items: root.target.all-reactions;

    out property <bool> detail-visible: root.detail-open && root.target-valid;
    out property <bool> open: root.picker-open || root.detail-visible;
    out property <bool> strip-pending: root.strip-anchor.event-id != "" && !root.open;
    out property <bool> strip-visible: root.strip-pending && root.strip-revealed;

    public function hover-bubble(a: ReactionAnchor) {
        if (!self.open) {
            if (self.strip-anchor.event-id != a.event-id) {
                self.strip-revealed = false;
            }
            self.strip-anchor = a;
            self.bubble-hovered = true;
        }
    }

    public function follow-bubble(a: ReactionAnchor) {
        if (self.strip-anchor.event-id == a.event-id) {
            self.strip-anchor = a;
        }
    }

    public function leave-bubble(event-id: string) {
        if (self.strip-anchor.event-id == event-id) {
            self.bubble-hovered = false;
        }
    }

    public function close-strip() {
        self.strip-anchor = { row: -1 };
        self.bubble-hovered = false;
        self.strip-hovered = false;
        self.strip-revealed = false;
    }

    public function open-picker(a: ReactionAnchor) {
        self.anchor = a;
        self.detail-open = false;
        self.picker-open = true;
        self.close-strip();
        self.tooltip-row = -1;
    }

    public function open-detail(a: ReactionAnchor) {
        self.anchor = a;
        self.picker-open = false;
        self.detail-open = true;
        self.close-strip();
        self.tooltip-row = -1;
    }

    public function close() {
        self.picker-open = false;
        self.detail-open = false;
        self.anchor = { row: -1 };
        self.tooltip-row = -1;
        self.close-strip();
    }

    public function show-tooltip(event-id: string, row: int, text: string, a: ReactionAnchor) {
        self.tooltip-event-id = event-id;
        self.tooltip-row = row;
        self.tooltip-text = text;
        self.tooltip-anchor = a;
    }

    public function hide-tooltip(event-id: string, row: int) {
        if (self.tooltip-row == row && self.tooltip-event-id == event-id) {
            self.tooltip-row = -1;
        }
    }
}

export global ReplySwipe {
    in-out property <ReactionAnchor> anchor: { row: -1 };

    in-out property <bool> armed: root.anchor.event-id != ""
        && !Reactions.open
        && !Shell.modal-open;

    out property <MessageEntry> target: (root.anchor.row >= 0
        && root.anchor.row < RoomView.timeline.length)
        ? RoomView.timeline[root.anchor.row]
        : { };
    out property <string> event-id: (root.armed
        && root.target.event-id != ""
        && root.target.event-id == root.anchor.event-id)
        ? root.target.event-id
        : "";

    out property <length> pull: min(WindowView.swipe-travel * 1px, Metrics.swipe-reply-pull);
    out property <float> reach: min(WindowView.swipe-travel * 1px / Metrics.swipe-reply-travel, 1.0);
    out property <bool> within-reach: root.reach >= 1.0;
    out property <bool> settling: WindowView.swipe-travel == 0;

    public function hover(a: ReactionAnchor) {
        self.anchor = a;
    }

    public function leave(event-id: string) {
        if (self.anchor.event-id == event-id) {
            self.clear();
        }
    }

    public function clear() {
        self.anchor = { row: -1 };
    }

    public function commit() {
        if (root.event-id == "") {
            return;
        }
        Composer.reply-event-id = root.event-id;
        Composer.reply-sender = root.target.sender;
        Composer.reply-preview = MessagePreview.label(root.target.preview-kind, root.target.body);
    }
}
