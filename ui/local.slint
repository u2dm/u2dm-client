import { LoginPhase } from "enums.slint";
import { LoginView, VerificationView } from "views.slint";

export global Composer {
    in-out property <string> reply-event-id;
    in-out property <string> reply-sender;
    in-out property <string> reply-preview;

    public function clear() {
        self.reply-event-id = "";
        self.reply-sender = "";
        self.reply-preview = "";
    }
}

export global Shell {
    in-out property <bool> drawer-open: false;
    in-out property <bool> nav-open: false;
    in-out property <bool> picker-open: false;

    out property <bool> verification-open: VerificationView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> modal-open: root.drawer-open
        || root.nav-open
        || root.verification-open;
    out property <bool> background-reachable: !root.modal-open;

    public function close-overlays() {
        self.drawer-open = false;
        self.nav-open = false;
        self.picker-open = false;
    }
}
