import { Delivery, LoginPhase, MessageKind, PollPhase, RoomInfoPlacement } from "./enums.slint";
import { AttachmentView, LoginView, ReadersView, RoomInfoView, RoomLogView, RoomMenuView, RoomView, SourceView, UserInfoView, VerificationView, VideoView, WindowView } from "./views.slint";
import { Actions } from "./actions.slint";
import { MessageEntry, ReactionEntry } from "./types.slint";
import { MessagePreview } from "./messages.slint";
import { Metrics } from "./theme.slint";

export struct AnchorRect {
    event-id: string,
    row: int,
    is-own: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct ReplyDraft {
    event-id: string,
    sender: string,
    preview: string,
}

export struct EditedMessage {
    event-id: string,
    local-id: string,
    unique-id: string,
    timeline-token: int,
    caption: bool,
    restored: bool,
    original: string,
    preview: string,
}

global TimelineRows {
    public pure function at(row: int) -> MessageEntry {
        return row >= 0 && row < RoomView.timeline.length ? RoomView.timeline[row] : { };
    }
}

export global Probe {
    in property <bool> enabled: false;
}

export global Composer {
    in-out property <string> reply-event-id;
    in-out property <string> reply-sender;
    in-out property <string> reply-preview;
    out property <ReplyDraft> reply: {
        event-id: root.reply-event-id,
        sender: root.reply-sender,
        preview: root.reply-preview,
    };

    in-out property <EditedMessage> edited;
    in-out property <EditedMessage> requested-edit;
    in-out property <int> edit-requests;
    out property <bool> editing: root.edited.event-id != "" || root.edited.local-id != "";

    public pure function edit-of(msg: MessageEntry) -> EditedMessage {
        return {
            event-id: msg.event-id,
            local-id: msg.local-id,
            unique-id: msg.unique-id,
            timeline-token: RoomView.timeline-token,
            caption: msg.message-type != MessageKind.text,
            restored: false,
            original: msg.edit-text,
            preview: MessagePreview.label(msg.preview-kind, msg.preview-body),
        };
    }

    public pure function is-being-edited(event-id: string, local-id: string) -> bool {
        return root.editing
            && ((event-id != "" && event-id == root.edited.event-id)
                || (local-id != "" && local-id == root.edited.local-id));
    }

    public function request-edit(msg: MessageEntry) {
        root.requested-edit = root.edit-of(msg);
        root.edit-requests += 1;
    }

    public function reply-to(msg: MessageEntry) {
        root.reply-event-id = msg.event-id;
        root.reply-sender = msg.sender;
        root.reply-preview = MessagePreview.label(msg.preview-kind, msg.preview-body);
    }

    public function restore-reply(draft: ReplyDraft) {
        root.reply-event-id = draft.event-id;
        root.reply-sender = draft.sender;
        root.reply-preview = draft.preview;
    }

    public function clear-reply() {
        root.reply-event-id = "";
        root.reply-sender = "";
        root.reply-preview = "";
    }

    public function clear() {
        root.clear-reply();
        root.edited = { };
        root.requested-edit = { };
    }
}

export global TextSelection {
    property <string> active-id;
    property <int> timeline-token;
    property <bool> taken;

    public pure function holds(id: string) -> bool {
        return id != ""
            && id == root.active-id
            && root.timeline-token == RoomView.timeline-token;
    }

    public function select(id: string) {
        if root.holds(id) {
            return;
        }
        root.active-id = id;
        root.timeline-token = RoomView.timeline-token;
        root.taken = false;
    }

    public function take() -> bool {
        if root.taken {
            root.clear();
            return false;
        }
        root.taken = true;
        return true;
    }

    public function clear() {
        root.active-id = "";
    }
}

export global Shell {
    in-out property <bool> drawer-open: false;
    in-out property <bool> nav-open: false;
    in-out property <bool> picker-open: false;
    in-out property <bool> attach-open: false;
    in-out property <bool> poll-open: false;
    in-out property <bool> room-info-pane-open: false;

    out property <bool> verification-open: VerificationView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> attachment-open: AttachmentView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> video-open: VideoView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> room-info-open: RoomInfoView.placement == RoomInfoPlacement.dialog
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> source-open: SourceView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> user-info-open: UserInfoView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> room-log-open: RoomLogView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> readers-open: ReadersView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> modal-over-nav: root.drawer-open
        || root.verification-open
        || root.attachment-open
        || root.video-open
        || root.poll-open
        || root.room-info-open
        || root.user-info-open
        || root.source-open
        || root.room-log-open
        || root.readers-open;
    out property <bool> modal-open: root.nav-open || root.modal-over-nav;
    out property <bool> nav-on-top: root.nav-open && !root.modal-over-nav;
    out property <bool> background-reachable: !root.modal-open;

    public function close-overlays() {
        root.drawer-open = false;
        root.nav-open = false;
        root.picker-open = false;
        root.attach-open = false;
        root.poll-open = false;
    }
}

export global DeliveryTip {
    in-out property <string> key;
    in-out property <bool> on-counter;
    in-out property <AnchorRect> anchor: { row: -1 };

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> names-readers: root.target.delivery == Delivery.read
        || root.target.delivery == Delivery.seen;
    out property <bool> showing: root.key != ""
        && root.target.unique-id == root.key
        && (root.on-counter ? root.names-readers : root.target.delivery != Delivery.none);

    public function show(key: string, a: AnchorRect, on-counter: bool) {
        root.key = key;
        root.anchor = a;
        root.on-counter = on-counter;
    }

    public function follow(key: string, a: AnchorRect, on-counter: bool) {
        if root.key == key && root.on-counter == on-counter {
            root.anchor = a;
        }
    }

    public function hide(key: string, on-counter: bool) {
        if root.key == key && root.on-counter == on-counter {
            root.clear();
        }
    }

    public function clear() {
        root.key = "";
        root.anchor = { row: -1 };
    }
}

export enum ReactionPopup { none, picker, detail, voters }

export global Reactions {
    in-out property <AnchorRect> anchor: { row: -1 };
    in-out property <ReactionPopup> popup: ReactionPopup.none;

    in-out property <AnchorRect> strip-anchor: { row: -1 };
    in-out property <bool> bubble-hovered: false;
    in-out property <bool> strip-hovered: false;
    in-out property <bool> strip-revealed: false;

    in-out property <int> tooltip-row: -1;
    in-out property <string> tooltip-event-id;
    in-out property <string> tooltip-text;
    in-out property <AnchorRect> tooltip-anchor;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> target-valid: root.anchor.event-id != ""
        && root.target.event-id == root.anchor.event-id;
    out property <[ReactionEntry]> items: root.target.all-reactions;

    out property <bool> detail-visible: root.popup == ReactionPopup.detail && root.target-valid;
    out property <bool> voters-visible: root.popup == ReactionPopup.voters
        && root.target-valid
        && root.target.poll-phase != PollPhase.sealed;
    out property <bool> open: root.popup == ReactionPopup.picker || root.detail-visible || root.voters-visible;
    out property <bool> strip-pending: root.strip-anchor.event-id != "" && !root.open;
    out property <bool> strip-visible: root.strip-pending && root.strip-revealed;

    public function hover-bubble(a: AnchorRect) {
        if !root.open {
            if root.strip-anchor.event-id != a.event-id {
                root.strip-revealed = false;
            }
            root.strip-anchor = a;
            root.bubble-hovered = true;
        }
    }

    public function follow-bubble(a: AnchorRect) {
        if root.strip-anchor.event-id == a.event-id {
            root.strip-anchor = a;
        }
    }

    public function leave-bubble(event-id: string) {
        if root.strip-anchor.event-id == event-id {
            root.bubble-hovered = false;
        }
    }

    public function close-strip() {
        root.strip-anchor = { row: -1 };
        root.bubble-hovered = false;
        root.strip-hovered = false;
        root.strip-revealed = false;
    }

    public function open-popup(a: AnchorRect, popup: ReactionPopup) {
        root.anchor = a;
        root.popup = popup;
        root.close-strip();
        root.tooltip-row = -1;
    }

    public function close() {
        root.popup = ReactionPopup.none;
        root.anchor = { row: -1 };
        root.tooltip-row = -1;
        root.close-strip();
    }

    public function show-tooltip(event-id: string, row: int, text: string, a: AnchorRect) {
        root.tooltip-event-id = event-id;
        root.tooltip-row = row;
        root.tooltip-text = text;
        root.tooltip-anchor = a;
    }

    public function hide-tooltip(event-id: string, row: int) {
        if root.tooltip-row == row && root.tooltip-event-id == event-id {
            root.tooltip-row = -1;
        }
    }
}

export global MessageMenu {
    in-out property <AnchorRect> anchor: { row: -1 };
    in-out property <string> key;
    in-out property <int> timeline-token;
    in-out property <length> at-x;
    in-out property <length> at-y;
    in-out property <bool> by-keyboard;
    in-out property <bool> asking-delete;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> visible: root.key != ""
        && root.target.unique-id == root.key
        && root.timeline-token == RoomView.timeline-token;

    public function open(a: AnchorRect, key: string, x: length, y: length, keyboard: bool) {
        root.anchor = a;
        root.key = key;
        root.timeline-token = RoomView.timeline-token;
        root.at-x = x;
        root.at-y = y;
        root.by-keyboard = keyboard;
        root.asking-delete = false;
    }

    public function close() {
        root.key = "";
        root.anchor = { row: -1 };
        root.asking-delete = false;
    }
}

export enum RoomMenuOrigin { list, header }

export enum RoomMenuReturn { composer, row, header }

export global RoomMenu {
    in-out property <string> key;
    in-out property <RoomMenuOrigin> origin: RoomMenuOrigin.list;
    in-out property <length> at-x;
    in-out property <length> at-y;
    in-out property <bool> by-keyboard;
    in-out property <bool> asking-leave;
    in-out property <bool> flyout-open;
    in-out property <RoomMenuReturn> return-to: RoomMenuReturn.composer;
    in-out property <string> return-room;
    in-out property <int> focus-returns;

    out property <bool> visible: root.key != "" && RoomMenuView.room-id == root.key;

    public pure function shows(id: string) -> bool {
        return root.visible && root.key == id;
    }

    public pure function returns-to(target: RoomMenuReturn, id: string) -> bool {
        return root.return-to == target && root.return-room == id;
    }

    public function open(id: string, origin: RoomMenuOrigin, x: length, y: length, keyboard: bool) {
        root.key = id;
        root.origin = origin;
        root.at-x = x;
        root.at-y = y;
        root.by-keyboard = keyboard;
        root.asking-leave = false;
        root.flyout-open = false;
        Actions.open-room-menu(id);
    }

    public function close() {
        if root.key == "" {
            return;
        }
        root.key = "";
        root.asking-leave = false;
        root.flyout-open = false;
        Actions.close-room-menu();
    }

    public function dismiss() {
        if !root.by-keyboard {
            root.return-to = RoomMenuReturn.composer;
        } else if root.origin == RoomMenuOrigin.list {
            root.return-to = RoomMenuReturn.row;
        } else {
            root.return-to = RoomMenuReturn.header;
        }
        root.return-room = root.key;
        root.close();
        root.focus-returns += 1;
    }
}

export global ReplySwipe {
    in-out property <AnchorRect> anchor: { row: -1 };

    in-out property <bool> armed: root.anchor.event-id != ""
        && !Reactions.open
        && !MessageMenu.visible
        && !RoomMenu.visible
        && !Shell.modal-open
        && !Composer.editing;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <string> event-id: (root.armed
        && root.target.event-id != ""
        && root.target.event-id == root.anchor.event-id)
        ? root.target.event-id
        : "";

    out property <length> pull: min(WindowView.swipe-travel * 1px, Metrics.swipe-reply-pull);
    out property <float> reach: min(WindowView.swipe-travel * 1px / Metrics.swipe-reply-travel, 1.0);
    out property <bool> within-reach: root.reach >= 1.0;
    out property <bool> settling: WindowView.swipe-travel == 0;

    public function hover(a: AnchorRect) {
        root.anchor = a;
    }

    public function leave(event-id: string) {
        if root.anchor.event-id == event-id {
            root.clear();
        }
    }

    public function clear() {
        root.anchor = { row: -1 };
    }

    public function commit() {
        if root.event-id == "" {
            return;
        }
        Composer.reply-to(root.target);
    }
}

export global Polls {
    in-out property <string> ending;
    in-out property <MessageEntry> edit-source;

    public function ask-end(event-id: string) {
        root.ending = event-id;
    }

    public function cancel-end() {
        root.ending = "";
    }

    public function edit(msg: MessageEntry) {
        Reactions.close();
        root.ending = "";
        root.edit-source = msg;
        Shell.poll-open = true;
    }

    public function stop-editing() {
        root.edit-source = { };
    }

    public function clear() {
        root.ending = "";
        root.edit-source = { };
    }
}

export global RoomSearch {
    in-out property <string> query;
    in-out property <string> opened-room;

    public pure function opened(room-id: string) -> bool {
        return root.opened-room != "" && root.opened-room == room-id;
    }

    public function clear() {
        if root.query == "" {
            return;
        }
        root.query = "";
        Actions.filter-rooms("");
    }
}

export global LocalState {
    public function forget-session() {
        Composer.clear();
        Shell.close-overlays();
        Shell.room-info-pane-open = false;
        RoomSearch.query = "";
        RoomSearch.opened-room = "";
        TextSelection.clear();
        Reactions.close();
        MessageMenu.close();
        RoomMenu.close();
        ReplySwipe.clear();
        DeliveryTip.clear();
        Polls.clear();
    }

    public function forget-room() {
        Composer.clear();
        TextSelection.clear();
        Reactions.close();
        MessageMenu.close();
        ReplySwipe.clear();
        DeliveryTip.clear();
        Polls.clear();
        Shell.poll-open = false;
    }

    public function close-popovers() {
        Reactions.close();
        DeliveryTip.clear();
        Shell.picker-open = false;
        Shell.attach-open = false;
    }
}
