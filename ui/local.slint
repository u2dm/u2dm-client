import { Delivery, LoginPhase, MessageKind, PollPhase, ReactionSend, RoomInfoPlacement, Shield } from "./enums.slint";
import { AccountView, AttachmentView, CallView, CreateRoomView, DirectoryView, EncryptionView, InvitePeopleView, InviteView, LeaveSpaceView, LoginView, LogoutView, ReadersView, RemovalView, RoomInfoView, RoomLogView, RoomMenuView, RoomPreviewView, RoomView, SourceView, UserInfoView, VerificationView, VideoView, WindowView } from "./views.slint";
import { Actions } from "./actions.slint";
import { EditedMessage, MessageEntry, ReactionEntry, ReplyDraft } from "./types.slint";
import { MessagePreview } from "./messages.slint";
import { Metrics } from "./theme.slint";

export struct AnchorRect {
    event-id: string,
    row: int,
    is-own: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

global TimelineRows {
    public pure function at(row: int) -> MessageEntry {
        return row >= 0 && row < RoomView.timeline.length ? RoomView.timeline[row] : { };
    }
}

export global Probe {
    in property <bool> enabled: false;
}

export global Composer {
    in-out property <string> reply-event-id;
    in-out property <string> reply-sender;
    in-out property <string> reply-preview;
    out property <ReplyDraft> reply: {
        event-id: root.reply-event-id,
        sender: root.reply-sender,
        preview: root.reply-preview,
    };

    in-out property <EditedMessage> edited;
    in-out property <EditedMessage> requested-edit;
    in-out property <int> edit-requests;
    out property <bool> editing: root.edited.event-id != "" || root.edited.local-id != "";

    public pure function edit-of(msg: MessageEntry) -> EditedMessage {
        return {
            event-id: msg.event-id,
            local-id: msg.local-id,
            unique-id: msg.unique-id,
            timeline-token: RoomView.timeline-token,
            caption: msg.message-type != MessageKind.text,
            restored: false,
            original: msg.edit-text,
            preview: MessagePreview.label(msg.preview-kind, msg.preview-body),
        };
    }

    public pure function is-being-edited(event-id: string, local-id: string) -> bool {
        return root.editing
            && ((event-id != "" && event-id == root.edited.event-id)
                || (local-id != "" && local-id == root.edited.local-id));
    }

    public function request-edit(msg: MessageEntry) {
        root.requested-edit = root.edit-of(msg);
        root.edit-requests += 1;
    }

    public function reply-to(msg: MessageEntry) {
        root.reply-event-id = msg.event-id;
        root.reply-sender = msg.sender;
        root.reply-preview = MessagePreview.label(msg.preview-kind, msg.preview-body);
    }

    public function restore-reply(draft: ReplyDraft) {
        root.reply-event-id = draft.event-id;
        root.reply-sender = draft.sender;
        root.reply-preview = draft.preview;
    }

    public function clear-reply() {
        root.reply-event-id = "";
        root.reply-sender = "";
        root.reply-preview = "";
    }

    public function clear() {
        root.clear-reply();
        root.edited = { };
        root.requested-edit = { };
    }
}

export global TextSelection {
    property <string> active-id;
    property <int> timeline-token;
    property <bool> taken;

    public pure function holds(id: string) -> bool {
        return id != ""
            && id == root.active-id
            && root.timeline-token == RoomView.timeline-token;
    }

    public function select(id: string) {
        if root.holds(id) {
            return;
        }
        root.active-id = id;
        root.timeline-token = RoomView.timeline-token;
        root.taken = false;
    }

    public function take() -> bool {
        if root.taken {
            root.clear();
            return false;
        }
        root.taken = true;
        return true;
    }

    public function clear() {
        root.active-id = "";
    }
}

export enum CallSize { hidden, stage, full }

export enum CallMode { call-and-chat, call-only, chat-only }

export enum CallSurface { call, chat }

export enum CallSheetOpener { composer, header, room-menu }

export global CallPanel {
    in-out property <CallMode> mode: CallMode.chat-only;
    in-out property <CallMode> last-call-mode: CallMode.call-and-chat;
    in-out property <CallSurface> turn: CallSurface.call;
    in-out property <bool> kept-chat: false;
    in-out property <bool> space-uncovered: false;
    in-out property <float> stage-share: Metrics.call-stage-share;
    in-out property <float> split-share: Metrics.call-split-share;
    in-out property <bool> fits-videos: false;
    in-out property <bool> hides-strip: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> devices-open: false;
    in-out property <bool> menu-by-keys: false;
    in-out property <bool> devices-by-keys: false;
    in-out property <bool> people-open: false;
    in-out property <bool> people-by-keys: false;
    in-out property <length> people-left;
    in-out property <length> people-right;
    in-out property <length> people-top;
    in-out property <length> people-bottom;
    in-out property <int> people-returns;
    in-out property <bool> focus-stage: false;
    in-out property <string> focus-tile;
    in-out property <int> gallery-takes-focus;
    in-out property <int> share-takes-focus;
    in-out property <string> screen-key;
    in-out property <float> screen-scale: 0;
    in-out property <float> screen-x: 0.5;
    in-out property <float> screen-y: 0.5;
    in-out property <bool> viewer-focused: false;
    in-out property <int> band-takes-focus;
    in-out property <int> dock-takes-focus;
    in-out property <bool> details-open: false;
    in-out property <bool> details-by-keys: false;
    in-out property <int> details-returns;
    in-out property <bool> ring-devices-open: false;
    in-out property <bool> ring-devices-by-keys: false;
    in-out property <length> ring-devices-right;
    in-out property <length> ring-devices-bottom;
    in-out property <int> ring-devices-returns;
    in-out property <CallSheetOpener> sheet-opener: CallSheetOpener.composer;
    in-out property <bool> sheet-dismissed: false;
    in-out property <int> sheet-returns;

    public function open-sheet(room-id: string, video: bool, opener: CallSheetOpener) {
        root.sheet-opener = opener;
        root.sheet-dismissed = false;
        Actions.open-call-sheet({ room-id: room-id, video: video });
    }

    public function open-details(by-keys: bool) {
        root.menu-open = false;
        root.devices-open = false;
        root.people-open = false;
        root.details-by-keys = by-keys;
        root.details-open = true;
        Actions.watch-connections({ on: true });
    }

    public function close-details() {
        root.details-open = false;
        Actions.watch-connections({ on: false });
        if root.details-by-keys {
            root.details-returns += 1;
        }
    }

    public function open-ring-devices(by-keys: bool, right: length, bottom: length) {
        root.ring-devices-by-keys = by-keys;
        root.ring-devices-right = right;
        root.ring-devices-bottom = bottom;
        root.ring-devices-open = true;
        Actions.ring-devices({ open: true });
    }

    public function close-ring-devices() {
        root.ring-devices-open = false;
        Actions.ring-devices({ open: false });
        if root.ring-devices-by-keys {
            root.ring-devices-returns += 1;
        }
    }

    public function dismiss-sheet() {
        root.sheet-dismissed = true;
        Actions.close-call-sheet();
    }

    public function open-people(by-keys: bool, left: length, right: length, top: length, bottom: length) {
        root.people-by-keys = by-keys;
        root.people-left = left;
        root.people-right = right;
        root.people-top = top;
        root.people-bottom = bottom;
        root.people-open = true;
    }

    function take-over() {
        root.kept-chat = false;
        root.space-uncovered = false;
    }

    public function choose(mode: CallMode) {
        root.take-over();
        root.mode = mode;
        if mode != CallMode.chat-only {
            root.last-call-mode = mode;
            root.turn = CallSurface.call;
        }
    }

    public function show-call() {
        root.take-over();
        if root.mode == CallMode.chat-only {
            root.mode = root.last-call-mode;
        }
        root.turn = CallSurface.call;
    }

    public function fit-screen() {
        root.screen-key = "";
        root.screen-scale = 0;
        root.screen-x = 0.5;
        root.screen-y = 0.5;
    }

    public function show-chat() {
        root.take-over();
        if root.mode == CallMode.call-only {
            root.mode = CallMode.chat-only;
        }
        root.turn = CallSurface.chat;
    }

    public function begin(video: bool) {
        root.take-over();
        root.mode = video ? CallMode.call-and-chat : CallMode.chat-only;
        root.last-call-mode = CallMode.call-and-chat;
        root.turn = CallSurface.call;
        root.fits-videos = false;
        root.hides-strip = false;
        root.menu-open = false;
        root.devices-open = false;
        root.people-open = false;
        root.details-open = false;
        root.focus-stage = false;
        root.focus-tile = "";
        root.viewer-focused = false;
        root.fit-screen();
    }

    public function forget() {
        root.begin(false);
        root.stage-share = Metrics.call-stage-share;
        root.split-share = Metrics.call-split-share;
    }
}

export global Shell {
    in-out property <bool> drawer-open: false;
    in-out property <bool> nav-open: false;
    in-out property <bool> picker-open: false;
    in-out property <bool> attach-open: false;
    in-out property <bool> poll-open: false;
    in-out property <bool> room-info-pane-open: false;

    out property <bool> verification-open: VerificationView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> encryption-open: EncryptionView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> account-open: AccountView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> logout-open: LogoutView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> attachment-open: AttachmentView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> video-open: VideoView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> room-info-open: RoomInfoView.placement == RoomInfoPlacement.dialog
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> source-open: SourceView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> user-info-open: UserInfoView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> invite-open: InviteView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> removal-open: RemovalView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> leave-space-open: LeaveSpaceView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> room-preview-open: RoomPreviewView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> create-room-open: CreateRoomView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> invite-people-open: InvitePeopleView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> room-log-open: RoomLogView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> readers-open: ReadersView.visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> call-sheet-open: CallView.sheet-visible
        && LoginView.step == LoginPhase.logged-in;
    out property <bool> modal-over-nav: root.drawer-open
        || root.verification-open
        || root.encryption-open
        || root.account-open
        || root.logout-open
        || root.attachment-open
        || root.video-open
        || root.poll-open
        || root.room-info-open
        || root.user-info-open
        || root.invite-open
        || root.removal-open
        || root.leave-space-open
        || root.room-preview-open
        || root.create-room-open
        || root.invite-people-open
        || root.source-open
        || root.room-log-open
        || root.readers-open
        || root.call-sheet-open
        || (CallPanel.details-open && CallView.active);
    out property <bool> modal-open: root.nav-open || root.modal-over-nav;
    out property <bool> nav-on-top: root.nav-open && !root.modal-over-nav;
    out property <bool> background-reachable: !root.modal-open;

    public function close-overlays() {
        root.drawer-open = false;
        root.nav-open = false;
        root.picker-open = false;
        root.attach-open = false;
        root.poll-open = false;
        CallPanel.menu-open = false;
        CallPanel.devices-open = false;
        CallPanel.people-open = false;
    }
}

export enum MetaMark { delivery, readers, shield }

export global MetaTip {
    in-out property <string> key;
    in-out property <MetaMark> mark;
    in-out property <AnchorRect> anchor: { row: -1 };

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> names-readers: root.target.delivery == Delivery.read
        || root.target.delivery == Delivery.seen;
    property <bool> target-has-mark: root.mark == MetaMark.readers ? root.names-readers
        : root.mark == MetaMark.shield ? root.target.shield != Shield.none
        : root.target.delivery != Delivery.none;
    out property <bool> showing: root.key != ""
        && root.target.unique-id == root.key
        && root.target-has-mark;

    public function show(key: string, a: AnchorRect, mark: MetaMark) {
        root.key = key;
        root.anchor = a;
        root.mark = mark;
    }

    public function follow(key: string, a: AnchorRect, mark: MetaMark) {
        if root.key == key && root.mark == mark {
            root.anchor = a;
        }
    }

    public function hide(key: string, mark: MetaMark) {
        if root.key == key && root.mark == mark {
            root.clear();
        }
    }

    public function clear() {
        root.key = "";
        root.anchor = { row: -1 };
    }
}

export enum TipScope { any, call, ring }

export global Tips {
    in-out property <int> owner;
    in-out property <string> text;
    in-out property <string> keys;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    in-out property <bool> below;
    in-out property <bool> above-modal;
    in-out property <TipScope> scope;
    property <int> issued;

    out property <bool> in-scope: root.scope == TipScope.any
        || (root.scope == TipScope.call && (CallView.active || CallView.failed))
        || (root.scope == TipScope.ring && CallView.ring-visible);
    out property <bool> showing: root.owner != 0
        && root.text != ""
        && root.in-scope
        && !Shell.verification-open
        && (root.above-modal || Shell.background-reachable);

    public function show(text: string, keys: string, x: length, y: length, width: length, height: length,
                         below: bool, above-modal: bool, scope: TipScope) -> int {
        root.issued += 1;
        root.owner = root.issued;
        root.text = text;
        root.keys = keys;
        root.x = x;
        root.y = y;
        root.width = width;
        root.height = height;
        root.below = below;
        root.above-modal = above-modal;
        root.scope = scope;
        return root.owner;
    }

    public function hide(owner: int) {
        if owner != 0 && root.owner == owner {
            root.owner = 0;
        }
    }

    public function clear() {
        root.owner = 0;
    }
}

export enum ReactionPopup { none, picker, detail, voters }

export global Reactions {
    in-out property <AnchorRect> anchor: { row: -1 };
    in-out property <ReactionPopup> popup: ReactionPopup.none;

    in-out property <AnchorRect> strip-anchor: { row: -1 };
    in-out property <bool> bubble-hovered: false;
    in-out property <bool> strip-hovered: false;
    in-out property <bool> strip-revealed: false;

    in-out property <int> tooltip-row: -1;
    in-out property <string> tooltip-event-id;
    in-out property <string> tooltip-text;
    in-out property <AnchorRect> tooltip-anchor;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> target-valid: root.anchor.event-id != ""
        && root.target.event-id == root.anchor.event-id;
    out property <[ReactionEntry]> items: root.target.all-reactions;

    out property <bool> detail-visible: root.popup == ReactionPopup.detail && root.target-valid;
    out property <bool> voters-visible: root.popup == ReactionPopup.voters
        && root.target-valid
        && root.target.poll-phase != PollPhase.sealed;
    out property <bool> open: root.popup == ReactionPopup.picker || root.detail-visible || root.voters-visible;
    out property <bool> strip-pending: root.strip-anchor.event-id != "" && !root.open;
    out property <bool> strip-visible: root.strip-pending && root.strip-revealed;

    public pure function may-toggle(entry: ReactionEntry) -> bool {
        if !entry.mine {
            return RoomView.may-react;
        }
        return entry.send != ReactionSend.sent || RoomView.may-delete-own;
    }

    public function hover-bubble(a: AnchorRect) {
        if !root.open {
            if root.strip-anchor.event-id != a.event-id {
                root.strip-revealed = false;
            }
            root.strip-anchor = a;
            root.bubble-hovered = true;
        }
    }

    public function follow-bubble(a: AnchorRect) {
        if root.strip-anchor.event-id == a.event-id {
            root.strip-anchor = a;
        }
    }

    public function leave-bubble(event-id: string) {
        if root.strip-anchor.event-id == event-id {
            root.bubble-hovered = false;
        }
    }

    public function close-strip() {
        root.strip-anchor = { row: -1 };
        root.bubble-hovered = false;
        root.strip-hovered = false;
        root.strip-revealed = false;
    }

    public function open-popup(a: AnchorRect, popup: ReactionPopup) {
        root.anchor = a;
        root.popup = popup;
        root.close-strip();
        root.tooltip-row = -1;
    }

    public function close() {
        root.popup = ReactionPopup.none;
        root.anchor = { row: -1 };
        root.tooltip-row = -1;
        root.close-strip();
    }

    public function show-tooltip(event-id: string, row: int, text: string, a: AnchorRect) {
        root.tooltip-event-id = event-id;
        root.tooltip-row = row;
        root.tooltip-text = text;
        root.tooltip-anchor = a;
    }

    public function hide-tooltip(event-id: string, row: int) {
        if root.tooltip-row == row && root.tooltip-event-id == event-id {
            root.tooltip-row = -1;
        }
    }
}

export global MessageMenu {
    in-out property <AnchorRect> anchor: { row: -1 };
    in-out property <string> key;
    in-out property <int> timeline-token;
    in-out property <length> at-x;
    in-out property <length> at-y;
    in-out property <bool> by-keyboard;
    in-out property <bool> asking-delete;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <bool> visible: root.key != ""
        && root.target.unique-id == root.key
        && root.timeline-token == RoomView.timeline-token;

    public function open(a: AnchorRect, key: string, x: length, y: length, keyboard: bool) {
        root.anchor = a;
        root.key = key;
        root.timeline-token = RoomView.timeline-token;
        root.at-x = x;
        root.at-y = y;
        root.by-keyboard = keyboard;
        root.asking-delete = false;
    }

    public function close() {
        root.key = "";
        root.anchor = { row: -1 };
        root.asking-delete = false;
    }
}

export enum RoomMenuOrigin { list, header, rail, space-header }

export enum RoomMenuReturn { composer, row, header, tile, space-header }

export global RoomMenu {
    in-out property <string> key;
    in-out property <RoomMenuOrigin> origin: RoomMenuOrigin.list;
    in-out property <length> at-x;
    in-out property <length> at-y;
    in-out property <bool> by-keyboard;
    in-out property <bool> asking-leave;
    in-out property <bool> flyout-open;
    in-out property <RoomMenuReturn> return-to: RoomMenuReturn.composer;
    in-out property <string> return-room;
    in-out property <int> focus-returns;

    out property <bool> visible: root.key != "" && RoomMenuView.room-id == root.key;

    public pure function shows(id: string) -> bool {
        return root.visible && root.key == id;
    }

    public pure function returns-to(target: RoomMenuReturn, id: string) -> bool {
        return root.return-to == target && root.return-room == id;
    }

    public function open(id: string, origin: RoomMenuOrigin, x: length, y: length, keyboard: bool) {
        root.key = id;
        root.origin = origin;
        root.at-x = x;
        root.at-y = y;
        root.by-keyboard = keyboard;
        root.asking-leave = false;
        root.flyout-open = false;
        Actions.open-room-menu(id);
    }

    public function close() {
        if root.key == "" {
            return;
        }
        root.key = "";
        root.asking-leave = false;
        root.flyout-open = false;
        Actions.close-room-menu();
    }

    public function dismiss() {
        root.hand-over();
        root.focus-returns += 1;
    }

    public function hand-over() {
        if !root.by-keyboard {
            root.return-to = RoomMenuReturn.composer;
        } else if root.origin == RoomMenuOrigin.list {
            root.return-to = RoomMenuReturn.row;
        } else if root.origin == RoomMenuOrigin.rail {
            root.return-to = RoomMenuReturn.tile;
        } else if root.origin == RoomMenuOrigin.space-header {
            root.return-to = RoomMenuReturn.space-header;
        } else {
            root.return-to = RoomMenuReturn.header;
        }
        root.return-room = root.key;
        root.close();
    }

    public function return-focus() {
        root.focus-returns += 1;
    }
}

export global ReplySwipe {
    in-out property <AnchorRect> anchor: { row: -1 };

    in-out property <bool> armed: root.anchor.event-id != ""
        && !Reactions.open
        && !MessageMenu.visible
        && !RoomMenu.visible
        && !Shell.modal-open
        && !Composer.editing
        && RoomView.may-send-messages;

    out property <MessageEntry> target: TimelineRows.at(root.anchor.row);
    out property <string> event-id: (root.armed
        && root.target.event-id != ""
        && root.target.event-id == root.anchor.event-id)
        ? root.target.event-id
        : "";

    out property <length> pull: min(WindowView.swipe-travel * 1px, Metrics.swipe-reply-pull);
    out property <float> reach: min(WindowView.swipe-travel * 1px / Metrics.swipe-reply-travel, 1.0);
    out property <bool> within-reach: root.reach >= 1.0;
    out property <bool> settling: WindowView.swipe-travel == 0;

    public function hover(a: AnchorRect) {
        root.anchor = a;
    }

    public function leave(event-id: string) {
        if root.anchor.event-id == event-id {
            root.clear();
        }
    }

    public function clear() {
        root.anchor = { row: -1 };
    }

    public function commit() {
        if root.event-id == "" {
            return;
        }
        Composer.reply-to(root.target);
    }
}

export global Polls {
    in-out property <string> ending;
    in-out property <MessageEntry> edit-source;

    public function ask-end(event-id: string) {
        root.ending = event-id;
    }

    public function cancel-end() {
        root.ending = "";
    }

    public function edit(msg: MessageEntry) {
        Reactions.close();
        root.ending = "";
        root.edit-source = msg;
        Shell.poll-open = true;
    }

    public function stop-editing() {
        root.edit-source = { };
    }

    public function clear() {
        root.ending = "";
        root.edit-source = { };
    }
}

export enum SubspacePlacement { tabs, column }

export global Subspaces {
    in-out property <SubspacePlacement> placement: SubspacePlacement.tabs;
    property <bool> refocus-switch;

    public pure function in-column(collapsed: bool) -> bool {
        return DirectoryView.subspaces.length > 0
            && (root.placement == SubspacePlacement.column || collapsed);
    }

    public pure function in-tabs(collapsed: bool) -> bool {
        return DirectoryView.subspaces.length > 0
            && root.placement == SubspacePlacement.tabs
            && !collapsed;
    }

    public function place(placement: SubspacePlacement, keyboard: bool) {
        root.placement = placement;
        root.refocus-switch = keyboard;
    }

    public function take-refocus() -> bool {
        let refocus = root.refocus-switch;
        root.refocus-switch = false;
        return refocus;
    }

    public function forget() {
        root.placement = SubspacePlacement.tabs;
        root.refocus-switch = false;
    }
}

export global RoomSearch {
    in-out property <string> query;
    in-out property <string> opened-room;

    public pure function opened(room-id: string) -> bool {
        return root.opened-room != "" && root.opened-room == room-id;
    }

    public function clear() {
        if root.query == "" {
            return;
        }
        root.query = "";
        Actions.filter-rooms("");
    }
}

export global LocalState {
    public function forget-session() {
        Composer.clear();
        Shell.close-overlays();
        Shell.room-info-pane-open = false;
        CallPanel.forget();
        RoomSearch.query = "";
        RoomSearch.opened-room = "";
        Subspaces.forget();
        TextSelection.clear();
        Reactions.close();
        MessageMenu.close();
        RoomMenu.close();
        ReplySwipe.clear();
        MetaTip.clear();
        Tips.clear();
        Polls.clear();
    }

    public function forget-room() {
        TextSelection.clear();
        Reactions.close();
        MessageMenu.close();
        ReplySwipe.clear();
        MetaTip.clear();
        Polls.clear();
        Tips.clear();
        Shell.poll-open = false;
        CallPanel.menu-open = false;
        CallPanel.devices-open = false;
        CallPanel.people-open = false;
    }

    public function close-popovers() {
        Reactions.close();
        MetaTip.clear();
        Shell.picker-open = false;
        Shell.attach-open = false;
        CallPanel.menu-open = false;
        CallPanel.devices-open = false;
    }
}
