import { Palette } from "std-widgets.slint";

import { ShadedClickArea } from "./state-layer.slint";
import { AppStyle, Fonts, Metrics, Motion, Radius, Space, Weight } from "../theme.slint";

export component SwitchRow inherits ShadedClickArea {
    in property <string> text;
    in property <string> detail;
    in property <bool> on;

    callback toggled(bool);

    height: Metrics.choice-row;
    border-radius: Radius.md;
    ring-radius: Radius.md;
    above-modal: true;
    label: root.text;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-description: root.detail;
    clicked => {
        root.toggled(!root.on);
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.lg;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xs;

            Text {
                text: root.text;
                font-size: Fonts.label;
                font-weight: Weight.semibold;
                overflow: elide;
                accessible-role: none;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-size: Fonts.body-small;
                color: AppStyle.foreground-muted;
                overflow: elide;
                accessible-role: none;
            }
        }

        Rectangle {
            cross-axis-self-alignment: center;
            width: Metrics.switch-track-width;
            height: Metrics.switch-track-height;
            border-radius: self.height / 2;
            background: root.on ? Palette.accent-background : AppStyle.foreground-faint;

            animate background {
                duration: Motion.fast;
                easing: ease-out;
            }

            Rectangle {
                x: root.on
                    ? parent.width - self.width - Metrics.switch-thumb-inset
                    : Metrics.switch-thumb-inset;
                y: (parent.height - self.height) / 2;
                width: Metrics.switch-thumb;
                height: Metrics.switch-thumb;
                border-radius: self.width / 2;
                background: root.on ? Palette.accent-foreground : AppStyle.elevated;

                animate x {
                    duration: Motion.travel(Motion.fast);
                    easing: ease-out;
                }
            }
        }
    }
}
