import { Palette, Spinner } from "std-widgets.slint";
import { LinkButton } from "./button.slint";
import { Fonts, Size, Space } from "../theme.slint";

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <bool> loading;
    in property <bool> show-retry;
    in property <string> retry-label;
    in property <bool> above-modal: false;

    callback retry();

    width: pill-layout.preferred-width;
    height: pill-layout.preferred-height;
    border-radius: self.height / 2;
    background: Palette.alternate-background;

    pill-layout := HorizontalLayout {
        padding-left: Space.xl;
        padding-right: root.show-retry ? Space.md : Space.xl;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.md;

        if root.loading: Spinner {
            width: Size.xxs;
            height: Size.xxs;
            indeterminate: true;
        }

        Text {
            text: root.text;
            font-size: Fonts.label;
            color: Palette.foreground;
            vertical-alignment: center;
            accessible-live-region: AccessibleLiveness.polite;
        }

        if root.show-retry: LinkButton {
            text: @tr("Retry");
            font-size: Fonts.label;
            pad: Space.lg;
            label: root.retry-label;
            above-modal: root.above-modal;
            clicked => {
                root.retry();
            }
        }
    }
}
