import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { AppStyle, Fonts, IconSize, Size, Space, Stroke } from "../theme.slint";
import { FocusRing, FocusTrail } from "./a11y.slint";
import { IconButton } from "./button.slint";

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <string> label: root.placeholder;
    in property <bool> shows-icon: true;
    in-out property <string> query: "";
    in property <bool> above-modal: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();

    height: Size.md;
    border-radius: self.height / 2;
    background: AppStyle.control;

    forward-focus: input;

    changed has-focus => {
        if !self.has-focus {
            FocusTrail.leave();
        }
    }

    HorizontalLayout {
        padding-left: root.shows-icon ? Space.md : Space.lg;
        padding-right: Space.sm;
        spacing: Space.md;

        if root.shows-icon: IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Search;
            size: IconSize.sm;
            stroke: AppStyle.foreground-faint;
        }

        Rectangle {
            horizontal-stretch: 1;

            input := TextInput {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text <=> root.query;
                enabled: root.enabled;
                color: Palette.foreground;
                font-size: Fonts.label;
                vertical-alignment: center;
                single-line: true;
                accessible-label: root.label;
                accessible-placeholder-text: root.placeholder;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }

            if root.query == "": Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: AppStyle.overlay-foreground-muted;
                font-size: Fonts.label;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            width: Size.sm;

            if root.query != "": IconButton {
                size: Size.target-min;
                icon-size: IconSize.xs;
                icon: IconSet.X;
                label: @tr("Clear search");
                above-modal: root.above-modal;
                clicked => {
                    root.query = "";
                    root.edited("");
                    input.focus();
                }
            }
        }
    }

    if input.has-focus: FocusRing {
        width: 100%;
        height: 100%;
        radius: root.height / 2;
        thickness: Stroke.hairline;
    }
}
