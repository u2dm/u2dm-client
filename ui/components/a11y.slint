import { Palette } from "std-widgets.slint";

import { Shell } from "../local.slint";
import { Metrics, Motion, Radius, Stroke } from "../theme.slint";

export global Interaction {
    public pure function actionable(enabled: bool, above-modal: bool) -> bool {
        return enabled && (above-modal || Shell.background-reachable);
    }

    public pure function activates(key: string) -> bool {
        return key == " " || key == "\n";
    }

    public pure function requests-menu(event: KeyEvent) -> bool {
        return event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10);
    }

    public pure function unmodified(event: KeyEvent) -> bool {
        return !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt
            && !event.modifiers.meta;
    }

    public pure function next(cursor: int, count: int) -> int {
        return mod(max(cursor, -1) + 1, count);
    }

    public pure function previous(cursor: int, count: int) -> int {
        return cursor < 0 ? count - 1 : mod(cursor + count - 1, count);
    }
}

export global FocusTrail {
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    in-out property <length> radius;
    in-out property <bool> live;
    in-out property <bool> seeded;
    in-out property <duration> left-at;

    public function arrive(x: length, y: length, width: length, height: length, radius: length) {
        root.x = x;
        root.y = y;
        root.width = width;
        root.height = height;
        root.radius = radius;
        root.live = true;
        root.seeded = true;
    }

    public function leave() {
        root.live = false;
        root.left-at = animation-tick();
    }

    public function hands-over() -> bool {
        return root.seeded && (root.live || animation-tick() - root.left-at < Motion.slow);
    }
}

export component FocusRing inherits Rectangle {
    in property <length> thickness: Stroke.emphasis;
    in property <length> radius: Radius.sm;

    property <bool> travels;
    property <bool> landed;
    property <bool> moving;
    property <length> from-left;
    property <length> from-top;
    property <length> from-right;
    property <length> from-bottom;
    property <length> from-radius;
    property <bool> rightward: root.from-left + root.from-right < root.width;
    property <bool> downward: root.from-top + root.from-bottom < root.height;
    property <duration> lead: Motion.travel(root.travels ? Motion.ring-lead : Motion.slow);
    property <duration> trail: Motion.travel(root.travels ? Motion.ring-trail : Motion.slow);
    property <length> left: root.landed ? 0 : root.from-left;
    property <length> top: root.landed ? 0 : root.from-top;
    property <length> right: root.landed ? root.width : root.from-right;
    property <length> bottom: root.landed ? root.height : root.from-bottom;
    property <length> corner: root.landed ? root.radius : root.from-radius;
    property <float> shown: root.landed || root.travels ? 1 : 0;
    property <bool> start-evaluated;
    property <easing> flow: cubic-bezier(0.32, 0.72, 0, 1);

    animate left {
        duration: !root.moving ? 0ms : root.rightward ? root.trail : root.lead;
        easing: root.flow;
    }
    animate right {
        duration: !root.moving ? 0ms : root.rightward ? root.lead : root.trail;
        easing: root.flow;
    }
    animate top {
        duration: !root.moving ? 0ms : root.downward ? root.trail : root.lead;
        easing: root.flow;
    }
    animate bottom {
        duration: !root.moving ? 0ms : root.downward ? root.lead : root.trail;
        easing: root.flow;
    }
    animate corner {
        duration: !root.moving ? 0ms : root.lead;
        easing: root.flow;
    }
    animate shown {
        duration: root.travels ? 0ms : Motion.fast;
        easing: ease-out;
    }

    init => {
        root.travels = FocusTrail.hands-over();
        if root.travels {
            root.from-left = FocusTrail.x - root.absolute-position.x;
            root.from-top = FocusTrail.y - root.absolute-position.y;
            root.from-right = root.from-left + FocusTrail.width;
            root.from-bottom = root.from-top + FocusTrail.height;
            root.from-radius = FocusTrail.radius;
        } else {
            root.from-left = -Metrics.ring-bloom;
            root.from-top = -Metrics.ring-bloom;
            root.from-right = root.width + Metrics.ring-bloom;
            root.from-bottom = root.height + Metrics.ring-bloom;
            root.from-radius = root.radius + Metrics.ring-bloom;
        }
        root.start-evaluated = root.left < root.right && root.top < root.bottom && root.corner >= 0 && root.shown >= 0;
        root.moving = true;
        root.landed = true;
        FocusTrail.arrive(root.absolute-position.x, root.absolute-position.y, root.width, root.height, root.radius);
        settle.running = true;
    }

    settle := Timer {
        interval: max(root.lead, root.trail, 1ms);
        running: false;
        triggered => {
            root.moving = false;
            self.running = false;
        }
    }

    Rectangle {
        x: root.left;
        y: root.top;
        width: root.right - root.left;
        height: root.bottom - root.top;
        border-radius: root.corner;
        border-width: root.thickness;
        border-color: Palette.accent-background;
        opacity: root.shown;
    }
}

export component ClickArea inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> hovers-when-disabled: false;
    in property <bool> above-modal: false;
    in property <bool> draggable: false;
    in property <string> label;
    in property <bool> focusable: true;
    in property <bool> roving-focus: false;
    in property <length> ring-radius: Radius.sm;
    in property <length> ring-inset: 0;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    out property <bool> has-focus: fs.has-focus;
    out property <length> mouse-x: touch.mouse-x;
    out property <length> mouse-y: touch.mouse-y;

    callback clicked();
    callback moved(length);
    callback context-menu-requested() -> EventResult;

    property <bool> actionable: Interaction.actionable(root.enabled, root.above-modal);

    public function take-focus() {
        fs.focus();
    }

    accessible-role: button;
    accessible-enabled: root.actionable;
    accessible-label: root.label;
    accessible-action-default => {
        if root.actionable {
            root.clicked();
        }
    }
    forward-focus: fs;

    fs := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled && root.focusable;
        focus-on-tab-navigation: root.actionable && root.focusable;
        focus-lost(reason) => {
            FocusTrail.leave();
        }
        key-pressed(event) => {
            if root.enabled && Interaction.activates(event.text) {
                root.clicked();
                return accept;
            }
            if root.enabled && Interaction.requests-menu(event) {
                return root.context-menu-requested();
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled || root.hovers-when-disabled;
        mouse-cursor: root.enabled ? pointer : default;
        moved => {
            if root.enabled && root.draggable {
                root.moved(self.mouse-y - self.pressed-y);
            }
        }
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    @children

    if fs.has-focus || root.roving-focus: FocusRing {
        x: root.ring-inset;
        y: root.ring-inset;
        width: root.width - root.ring-inset * 2;
        height: root.height - root.ring-inset * 2;
        radius: root.ring-radius;
    }
}

export component ListItemArea inherits ClickArea {
    in property <bool> selected: false;
    in property <int> index: -1;

    accessible-role: list-item;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
}

export component RovingKeys inherits FocusScope {
    in property <int> count;
    in property <bool> horizontal: false;
    in property <bool> ring-on-any-focus: false;
    in property <bool> paused: false;
    in-out property <int> cursor: -1;

    callback activated(int);
    callback moved(int);
    callback intercept(KeyEvent) -> EventResult;

    x: 0;
    y: 0;
    width: 0;
    height: 0;
    focus-on-click: false;
    accessible-role: button;

    focus-lost(reason) => {
        FocusTrail.leave();
    }

    focus-gained(reason) => {
        if root.cursor < 0 && (root.ring-on-any-focus || reason == FocusReason.tab-navigation) {
            root.cursor = 0;
        }
    }

    key-pressed(event) => {
        if root.intercept(event) == EventResult.accept {
            return accept;
        }
        if root.paused || root.count == 0 {
            return reject;
        }
        if event.text == (root.horizontal ? Key.RightArrow : Key.DownArrow) {
            root.move-to(Interaction.next(root.cursor, root.count));
            return accept;
        }
        if event.text == (root.horizontal ? Key.LeftArrow : Key.UpArrow) {
            root.move-to(Interaction.previous(root.cursor, root.count));
            return accept;
        }
        if event.text == Key.Home {
            root.move-to(0);
            return accept;
        }
        if event.text == Key.End {
            root.move-to(root.count - 1);
            return accept;
        }
        if Interaction.activates(event.text) {
            root.activated(max(root.cursor, 0));
            return accept;
        }
        return reject;
    }

    function move-to(index: int) {
        root.cursor = index;
        root.moved(index);
    }
}
