import { FocusRing, FocusTrail } from "./a11y.slint";
import { Shell } from "../local.slint";
import { AppStyle, Motion } from "../theme.slint";

export enum ResizeEdge { right, left, bottom }

export component ResizeHandle inherits Rectangle {
    in property <ResizeEdge> edge: ResizeEdge.right;
    in property <string> label;
    in property <length> value;
    in property <length> minimum;
    in property <length> maximum;
    in property <length> step;
    in property <length> grab-before;
    in property <length> grab-after;

    callback dragged(length);
    callback stepped(length);

    property <bool> vertical: root.edge == ResizeEdge.bottom;
    property <float> outward: root.edge == ResizeEdge.left ? -1 : 1;
    property <string> back-key: root.vertical ? Key.UpArrow : Key.LeftArrow;
    property <string> forward-key: root.vertical ? Key.DownArrow : Key.RightArrow;

    accessible-role: AccessibleRole.slider;
    accessible-orientation: root.vertical ? Orientation.vertical : Orientation.horizontal;
    accessible-label: root.label;
    accessible-value: root.value / 1px;
    accessible-value-minimum: root.minimum / 1px;
    accessible-value-maximum: root.maximum / 1px;
    accessible-value-step: root.step / 1px;
    accessible-enabled: Shell.background-reachable;
    accessible-action-increment => {
        root.stepped(root.step);
    }
    accessible-action-decrement => {
        root.stepped(-root.step);
    }
    forward-focus: keys;

    keys := FocusScope {
        width: 0;
        focus-on-tab-navigation: Shell.background-reachable;
        focus-lost(reason) => {
            FocusTrail.leave();
        }
        key-pressed(event) => {
            if event.text == root.back-key {
                root.stepped(-root.step * root.outward);
                return accept;
            }
            if event.text == root.forward-key {
                root.stepped(root.step * root.outward);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        background: touch.has-hover || touch.pressed ? AppStyle.accent-divider : transparent;

        animate background {
            duration: Motion.fast;
            easing: ease-out;
        }
    }

    touch := TouchArea {
        x: root.vertical ? 0 : -root.grab-before;
        y: root.vertical ? -root.grab-before : 0;
        width: root.vertical ? root.width : root.width + root.grab-before + root.grab-after;
        height: root.vertical ? root.height + root.grab-before + root.grab-after : root.height;
        mouse-cursor: root.vertical ? MouseCursor.row-resize : MouseCursor.col-resize;
        moved => {
            root.dragged((root.vertical ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x) * root.outward);
        }
    }

    if keys.has-focus: FocusRing {
        width: 100%;
        height: 100%;
        radius: 0;
    }
}
