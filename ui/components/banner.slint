import { IconDisplay, IconSet } from "@lucide";

import { AppStyle } from "./style.slint";
import { UserMessage, UserMessages } from "../messages.slint";

export component ErrorBanner inherits Rectangle {
    in property <[UserMessage]> messages;

    background: AppStyle.danger-surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Colors.tomato.transparentize(0.78);

    HorizontalLayout {
        padding: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: start;

            IconDisplay {
                icon: IconSet.TriangleAlert;
                size: 16px;
                stroke: AppStyle.danger;
            }
        }

        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;

            for message in root.messages: Text {
                text: UserMessages.text(message.kind, message.detail);
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                color: AppStyle.danger;
            }
        }
    }
}
