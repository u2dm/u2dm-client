import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { AppStyle, Fonts, IconSize, Radius, Space, Stroke } from "../theme.slint";
import { UserMessage, UserMessages } from "../messages.slint";

export component ErrorBanner inherits Rectangle {
    in property <[UserMessage]> messages;

    background: AppStyle.danger-background;
    border-radius: Radius.md;
    border-width: Stroke.hairline;
    border-color: AppStyle.danger-border;

    HorizontalLayout {
        padding: Space.lg;
        spacing: Space.lg;

        VerticalLayout {
            alignment: start;

            IconDisplay {
                icon: IconSet.TriangleAlert;
                size: IconSize.sm;
                stroke: AppStyle.danger;
            }
        }

        VerticalLayout {
            spacing: Space.md;
            horizontal-stretch: 1;

            for message in root.messages: Text {
                text: UserMessages.text(message.kind, message.detail);
                font-size: Fonts.body-small;
                wrap: word-wrap;
                horizontal-stretch: 1;
                color: AppStyle.danger;
                accessible-live-region: AccessibleLiveness.assertive;
            }
        }
    }
}
