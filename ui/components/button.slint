import { Palette } from "std-widgets.slint";
import { IconDisplay, Icon } from "@lucide";

import { ClickArea } from "./a11y.slint";
import { AppStyle } from "./style.slint";
import { DotPulse } from "./dot-pulse.slint";

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> trailing-icon: false;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <bool> busy: false;
    in property <bool> filled: true;
    in property <color> tint: Palette.accent-background;

    callback clicked();

    property <bool> interactive: root.enabled && !root.busy;
    property <color> label-color: root.enabled
        ? (root.filled ? Palette.accent-foreground : root.tint)
        : AppStyle.faint;
    property <bool> has-icon: root.icon.paths.length > 0;

    height: AppStyle.control-height;
    border-radius: AppStyle.control-radius;
    border-width: root.filled ? 0 : 1px;
    border-color: root.filled ? transparent : AppStyle.hairline;
    background: !root.enabled
        ? AppStyle.surface
        : (root.filled
            ? (touch.pressed
                ? root.tint.darker(0.2)
                : (touch.has-hover && root.interactive ? root.tint.brighter(0.15) : root.tint))
            : (touch.pressed
                ? Palette.foreground.transparentize(0.88)
                : (touch.has-hover && root.interactive ? Palette.foreground.transparentize(0.94) : transparent)));

    animate background {
        duration: 130ms;
        easing: ease-out;
    }

    touch := ClickArea {
        enabled: root.interactive;
        above-modal: root.above-modal;
        label: root.text;
        ring-radius: AppStyle.control-radius;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 16px;
        padding-right: 16px;

        if root.busy: VerticalLayout {
            alignment: center;

            DotPulse {
                tint: root.label-color;
            }
        }

        if !root.busy && root.has-icon && !root.trailing-icon: VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: root.icon;
                size: 17px;
                stroke: root.label-color;
            }
        }

        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.label-color;
        }

        if !root.busy && root.has-icon && root.trailing-icon: VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: root.icon;
                size: 17px;
                stroke: root.label-color;
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <length> size: 34px;

    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 10px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: touch.has-hover && root.enabled ? Palette.foreground.transparentize(0.92) : transparent;

    touch := ClickArea {
        enabled: root.enabled;
        above-modal: root.above-modal;
        label: root.label;
        ring-radius: 10px;
        clicked => {
            root.clicked();
        }
    }

    IconDisplay {
        icon: root.icon;
        size: root.size * 0.53;
        stroke: AppStyle.muted;
    }
}
