import { Palette } from "std-widgets.slint";
import { IconDisplay, Icon } from "@lucide";

import { ClickArea } from "./a11y.slint";
import { AppStyle, Fonts, IconSize, Metrics, Opacity, Radius, Size, Space, Weight } from "../theme.slint";
import { DotPulse } from "./dot-pulse.slint";
import { StateLayer } from "./state-layer.slint";

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> trailing-icon: false;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <bool> busy: false;
    in property <bool> filled: true;
    in property <color> tint: Palette.accent-background;

    callback clicked();

    property <bool> interactive: root.enabled && !root.busy;
    property <bool> has-icon: root.icon.paths.length > 0;
    property <color> label-color: root.filled ? Palette.accent-foreground : root.tint;

    height: AppStyle.control-height;
    border-radius: Radius.md;
    background: root.filled ? root.tint : AppStyle.control;
    opacity: root.enabled ? 1 : Opacity.disabled;

    StateLayer {
        border-radius: root.border-radius;
        ink: root.label-color;
        hovered: touch.has-hover && root.interactive;
        pressed: touch.pressed && root.interactive;
    }

    touch := ClickArea {
        enabled: root.interactive;
        above-modal: root.above-modal;
        label: root.text;
        ring-inset: -Metrics.ring-outset;
        ring-radius: Radius.md + Metrics.ring-outset;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Space.md;
        padding-left: Space.xl;
        padding-right: Space.xl;

        if root.busy: DotPulse {
            cross-axis-self-alignment: center;
            tint: root.label-color;
        }

        if !root.busy && root.has-icon && !root.trailing-icon: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.sm;
            stroke: root.label-color;
        }

        Text {
            text: root.text;
            font-size: Fonts.body;
            font-weight: Weight.semibold;
            vertical-alignment: center;
            color: root.label-color;
        }

        if !root.busy && root.has-icon && root.trailing-icon: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.sm;
            stroke: root.label-color;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <bool> busy: false;
    in property <length> size: Size.lg;
    property <float> icon-scale: 0.53;
    in property <length> icon-size: root.size * root.icon-scale;
    in property <length> radius: root.size / 2;
    in property <color> tint: AppStyle.foreground-muted;
    in property <brush> fill: transparent;
    out property <bool> has-focus: touch.has-focus;
    out property <bool> has-hover: touch.has-hover;

    callback clicked();

    property <bool> interactive: root.enabled && !root.busy;
    property <length> ring-outset: root.fill == transparent ? 0 : Metrics.ring-outset;

    public function take-focus() {
        touch.take-focus();
    }

    width: root.size;
    height: root.size;
    border-radius: root.radius;
    opacity: root.enabled ? 1 : Opacity.disabled;
    background: root.fill;

    StateLayer {
        border-radius: root.radius;
        ink: root.tint;
        hovered: touch.has-hover && root.interactive;
        pressed: touch.pressed && root.interactive;
    }

    touch := ClickArea {
        enabled: root.interactive;
        above-modal: root.above-modal;
        label: root.label;
        ring-inset: -root.ring-outset;
        ring-radius: root.radius + root.ring-outset;
        clicked => {
            root.clicked();
        }
    }

    if !root.busy: IconDisplay {
        icon: root.icon;
        size: root.icon-size;
        stroke: root.tint;
    }

    if root.busy: HorizontalLayout {
        alignment: center;

        DotPulse {
            dot-size: Space.sm;
            tint: root.tint;
        }
    }
}

export component HeaderIconButton inherits IconButton {
    in property <bool> active;

    icon-size: IconSize.md;
    tint: root.active ? Palette.accent-background : AppStyle.foreground-strong;
}

export component LinkButton inherits ClickArea {
    in property <string> text;
    in property <color> tint: Palette.accent-background;
    in property <length> font-size: Fonts.body-small;
    in property <length> pad;

    width: caption.preferred-width + root.pad;
    opacity: root.enabled ? 1 : Opacity.disabled;

    StateLayer {
        border-radius: root.ring-radius;
        ink: root.tint;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    caption := Text {
        text: root.text;
        color: root.tint;
        font-size: root.font-size;
        font-weight: Weight.semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
