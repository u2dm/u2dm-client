import { Palette } from "std-widgets.slint";
import { IconDisplay, Icon } from "@lucide";

import { ClickArea } from "./a11y.slint";
import { AppStyle, Fonts, IconSize, Motion, Opacity, Radius, Size, Space, Stroke, Weight } from "../theme.slint";
import { DotPulse } from "./dot-pulse.slint";

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> trailing-icon: false;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <bool> busy: false;
    in property <bool> filled: true;
    in property <color> tint: Palette.accent-background;

    callback clicked();

    property <bool> interactive: root.enabled && !root.busy;
    property <bool> highlighted: touch.has-hover && root.interactive;
    property <bool> has-icon: root.icon.paths.length > 0;

    pure function label-tint() -> color {
        if !root.enabled {
            return AppStyle.foreground-disabled;
        }
        return root.filled ? Palette.accent-foreground : root.tint;
    }

    pure function fill() -> brush {
        if !root.enabled {
            return AppStyle.overlay-subtle;
        }
        if root.filled {
            if touch.pressed {
                return root.tint.darker(0.2);
            }
            return root.highlighted ? root.tint.brighter(0.15) : root.tint;
        }
        if touch.pressed {
            return AppStyle.overlay-pressed;
        }
        return root.highlighted ? AppStyle.overlay-hover : transparent;
    }

    property <color> label-color: root.label-tint();

    height: AppStyle.control-height;
    border-radius: Radius.md;
    border-width: root.filled ? 0 : Stroke.hairline;
    border-color: root.filled ? transparent : AppStyle.border;
    background: root.fill();

    animate background {
        duration: Motion.fast;
        easing: ease-out;
    }

    touch := ClickArea {
        enabled: root.interactive;
        above-modal: root.above-modal;
        label: root.text;
        ring-radius: Radius.md;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: Space.md;
        padding-left: Space.xl;
        padding-right: Space.xl;

        if root.busy: VerticalLayout {
            alignment: center;

            DotPulse {
                tint: root.label-color;
            }
        }

        if !root.busy && root.has-icon && !root.trailing-icon: VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: root.icon;
                size: IconSize.sm;
                stroke: root.label-color;
            }
        }

        Text {
            text: root.text;
            font-size: Fonts.body;
            font-weight: Weight.semibold;
            vertical-alignment: center;
            color: root.label-color;
        }

        if !root.busy && root.has-icon && root.trailing-icon: VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: root.icon;
                size: IconSize.sm;
                stroke: root.label-color;
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> above-modal: false;
    in property <length> size: Size.lg;
    property <float> icon-scale: 0.53;
    in property <length> icon-size: root.size * root.icon-scale;
    in property <length> radius: Radius.md;
    in property <color> tint: AppStyle.foreground-muted;

    callback clicked();

    public function take-focus() {
        touch.take-focus();
    }

    width: root.size;
    height: root.size;
    border-radius: root.radius;
    opacity: root.enabled ? 1.0 : Opacity.disabled;
    background: touch.has-hover && root.enabled ? AppStyle.overlay-hover : transparent;

    touch := ClickArea {
        enabled: root.enabled;
        above-modal: root.above-modal;
        label: root.label;
        ring-radius: root.radius;
        clicked => {
            root.clicked();
        }
    }

    IconDisplay {
        icon: root.icon;
        size: root.icon-size;
        stroke: root.tint;
    }
}
