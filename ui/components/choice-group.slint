import { Palette } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";

import { SettingKey } from "../enums.slint";
import { FocusReveal, RovingKeys } from "./a11y.slint";
import { ShadedClickArea } from "./state-layer.slint";
import { SoughtTint } from "./sought-tint.slint";
import { AppStyle, Fonts, IconSize, Metrics, Radius, Space, Stroke, Weight } from "../theme.slint";

export struct ChoiceOption {
    text: string,
    detail: string,
}

component ChoiceLine inherits ShadedClickArea {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;

    height: max(Metrics.settings-row, content.preferred-height + Space.md);
    background: AppStyle.control;
    ring-radius: Radius.sm;
    ring-inset: Stroke.emphasis;
    above-modal: true;
    focusable: false;
    label: root.detail == "" ? root.text : @tr("{}, {}", root.text, root.detail);
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.checked;

    content := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xs;

            Text {
                text: root.text;
                font-size: Fonts.label;
                font-weight: Weight.semibold;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.detail != "": Text {
                text: root.detail;
                font-size: Fonts.body-small;
                color: AppStyle.overlay-foreground-muted;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        IconDisplay {
            cross-axis-self-alignment: center;
            icon: IconSet.Check;
            size: IconSize.sm;
            stroke: Palette.accent-background;
            opacity: root.checked ? 1 : 0;
        }
    }
}

export component ChoiceGroup inherits Rectangle {
    in property <[ChoiceOption]> options;
    in property <int> selected: 0;
    in property <string> label;
    in property <SettingKey> key;

    callback chose(int);

    function choose(index: int) {
        keys.cursor = index;
        root.chose(index);
    }

    public function take-focus() {
        keys.cursor = root.selected;
        keys.focus();
    }

    keys := RovingKeys {
        count: root.options.length;
        cursor: root.selected;
        accessible-role: radio-button;
        accessible-label: @tr("{}: {}", root.label, root.options[max(self.cursor, 0)].text);
        accessible-checkable: true;
        accessible-checked: self.cursor == root.selected;
        accessible-action-default => {
            root.choose(max(self.cursor, 0));
        }
        activated(index) => {
            root.choose(index);
        }
        changed has-focus => {
            if self.has-focus {
                FocusReveal.ask(root.absolute-position.x, root.absolute-position.y, root.width, root.height);
            }
        }
    }

    VerticalLayout {
        spacing: Stroke.hairline;

        for option[index] in root.options: ChoiceLine {
            text: option.text;
            detail: option.detail;
            checked: index == root.selected;
            roving-focus: keys.has-focus && keys.cursor == index;
            clicked => {
                root.choose(index);
            }
        }
    }

    SoughtTint {
        key: root.key;
        arrived(keyed) => {
            if keyed {
                root.take-focus();
            }
        }
    }
}
