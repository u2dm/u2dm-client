import { Palette } from "std-widgets.slint";

import { ClickArea } from "./a11y.slint";
import { AppStyle, Motion } from "../theme.slint";

export component StateLayer inherits Rectangle {
    in property <bool> hovered;
    in property <bool> pressed;
    in property <color> ink: Palette.foreground;

    background: AppStyle.state-layer(root.ink, root.hovered, root.pressed);

    animate background {
        duration: Motion.fast;
        easing: ease-out;
    }
}

export component ShadedClickArea inherits ClickArea {
    in property <color> ink: Palette.foreground;
    in property <length> layer-radius: root.border-radius;

    StateLayer {
        border-radius: root.layer-radius;
        ink: root.ink;
        hovered: root.has-hover && root.enabled;
        pressed: root.pressed && root.enabled;
    }

    @children
}
