import { Palette, ScrollView } from "std-widgets.slint";
import { AppStyle, Fonts, Motion, Opacity, Radius, Size, Space, Weight } from "../theme.slint";

export global Placement {
    public pure function fit(start: length, size: length, extent: length, edge: length) -> length {
        return clamp(start, edge, max(edge, extent - size - edge));
    }

    public pure function flip(at: length, size: length, extent: length, edge: length) -> length {
        return root.fit(at + size + edge > extent ? at - size : at, size, extent, edge);
    }
}

export component PickerCard inherits Rectangle {
    background: AppStyle.elevated;
    border-radius: Radius.md;

    @children
}

export component TipCard inherits PickerCard {
    in property <string> text;
    in property <string> keys;

    width: row.preferred-width;
    height: Size.sm;

    row := HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        Text {
            text: root.text;
            font-size: Fonts.caption;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.keys != "": Text {
            text: root.keys;
            font-size: Fonts.caption;
            font-weight: Weight.semibold;
            color: AppStyle.foreground-muted;
            vertical-alignment: center;
        }
    }
}

export component DialogCard inherits Rectangle {
    background: AppStyle.elevated;
    border-radius: Radius.xl;

    TouchArea { }

    @children
}

export component ScrollingDialogCard inherits ScrollView {
    in property <length> body-padding: Space.xxl;
    in property <length> body-spacing: Space.xl;
    in property <bool> squeezes;
    out property <length> card-width: min(AppStyle.card-width-wide, root.width - AppStyle.card-inset);
    out property <length> card-height: root.squeezes
        ? clamp(root.height - AppStyle.card-inset, card-body.min-height, card-body.preferred-height)
        : card-body.preferred-height;

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    content-width: self.width;
    content-height: max(self.height, root.card-height + AppStyle.card-inset);

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.content-height - self.height) / 2;
        width: root.card-width;
        height: root.card-height;

        card-body := VerticalLayout {
            padding: root.body-padding;
            spacing: root.body-spacing;

            @children
        }
    }
}

export component FixedDialogCard inherits Rectangle {
    in property <length> card-width;
    in property <length> card-height;
    out property <length> shown-width: min(root.card-width, root.width - AppStyle.card-inset);
    out property <length> shown-height: min(root.card-height, root.height - AppStyle.card-inset);

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    DialogCard {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.shown-width;
        height: root.shown-height;
        clip: true;

        @children
    }
}

export component ModalHost inherits Rectangle {
    in property <bool> dim: true;
    in property <float> dim-opacity: Opacity.scrim;
    in property <bool> light-dismiss: true;
    in property <bool> any-button-dismisses: false;
    in property <string> label;
    out property <bool> dismissing-by-pointer: false;

    callback dismissed();
    callback opened();

    property <bool> entered: false;

    function dismiss-by-pointer() {
        root.dismissing-by-pointer = true;
        root.dismissed();
        root.dismissing-by-pointer = false;
    }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label;

    forward-focus: keys;

    init => {
        root.entered = true;
        keys.focus();
        root.opened();
    }

    keys := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: root.dim
                ? AppStyle.scrim.transparentize(1.0 - root.dim-opacity)
                : transparent;
            opacity: root.entered ? 1.0 : 0.0;
            animate opacity {
                duration: Motion.normal;
                easing: ease-out;
            }

            TouchArea {
                mouse-cursor: default;
                clicked => {
                    if root.light-dismiss {
                        root.dismiss-by-pointer();
                    }
                }
                pointer-event(event) => {
                    if root.light-dismiss
                        && root.any-button-dismisses
                        && event.kind == PointerEventKind.down
                        && event.button != PointerEventButton.left {
                        root.dismiss-by-pointer();
                    }
                }
                scroll-event(event) => {
                    return accept;
                }
            }
        }

        @children
    }
}
