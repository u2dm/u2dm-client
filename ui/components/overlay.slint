import { Palette } from "std-widgets.slint";
import { AppStyle, Motion, Opacity, Radius, Stroke } from "../theme.slint";

export global Placement {
    public pure function fit(start: length, size: length, extent: length, edge: length) -> length {
        return clamp(start, edge, max(edge, extent - size - edge));
    }

    public pure function flip(at: length, size: length, extent: length, edge: length) -> length {
        return root.fit(at + size + edge > extent ? at - size : at, size, extent, edge);
    }
}

export component PickerCard inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: Radius.md;
    border-width: Stroke.hairline;
    border-color: AppStyle.border;

    @children
}

export component DialogCard inherits Rectangle {
    background: AppStyle.card;
    border-radius: Radius.xl;
    border-width: Stroke.hairline;
    border-color: AppStyle.border;

    TouchArea { }

    @children
}

export component ModalHost inherits Rectangle {
    in property <bool> dim: true;
    in property <float> dim-opacity: Opacity.scrim;
    in property <bool> light-dismiss: true;
    in property <bool> any-button-dismisses: false;
    in property <string> label;
    out property <bool> dismissing-by-pointer: false;

    callback dismissed();
    callback opened();

    property <bool> entered: false;

    function dismiss-by-pointer() {
        root.dismissing-by-pointer = true;
        root.dismissed();
        root.dismissing-by-pointer = false;
    }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label;

    forward-focus: keys;

    init => {
        root.entered = true;
        keys.focus();
        root.opened();
    }

    keys := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: root.dim
                ? Colors.black.transparentize(1.0 - root.dim-opacity)
                : transparent;
            opacity: root.entered ? 1.0 : 0.0;
            animate opacity {
                duration: Motion.normal;
                easing: ease-out;
            }

            TouchArea {
                mouse-cursor: default;
                clicked => {
                    if root.light-dismiss {
                        root.dismiss-by-pointer();
                    }
                }
                pointer-event(event) => {
                    if root.light-dismiss
                        && root.any-button-dismisses
                        && event.kind == PointerEventKind.down
                        && event.button != PointerEventButton.left {
                        root.dismiss-by-pointer();
                    }
                }
                scroll-event(event) => {
                    return accept;
                }
            }
        }

        @children
    }
}
