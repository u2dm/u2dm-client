import { Palette } from "std-widgets.slint";
import { Space } from "../theme.slint";

export component DotPulse inherits HorizontalLayout {
    in property <color> tint: Palette.accent-background;
    in property <length> dot-size: Space.md;
    property <float> dim: 0.3;
    property <duration> period: 1.1s;
    property <angle> phase-step: 110deg;

    spacing: Space.sm;

    for offset in [0, 1, 2]: VerticalLayout {
        alignment: center;

        Rectangle {
            width: root.dot-size;
            height: root.dot-size;
            border-radius: self.width / 2;
            background: root.tint;
            opacity: root.dim + (1 - root.dim) * abs(sin(360deg * (animation-tick() / root.period) - offset * root.phase-step));
        }
    }
}
