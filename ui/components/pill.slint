import { ShadedClickArea } from "./state-layer.slint";
import { Space } from "../theme.slint";

export component Pill inherits ShadedClickArea {
    in property <color> fill;
    in property <length> pad: Space.md;

    width: content.preferred-width;
    border-radius: self.height / 2;
    ring-radius: self.height / 2;
    background: root.fill;

    content := VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: Space.sm;
            padding-left: root.pad;
            padding-right: root.pad;

            @children
        }
    }
}
