import { Palette } from "std-widgets.slint";
import { IconDisplay, Icon } from "@lucide";

import { ClickArea } from "a11y.slint";
import { DotPulse } from "dot-pulse.slint";
import { AppStyle, Fonts, IconSize, Opacity, Radius, Space } from "../theme.slint";

export component MenuRow inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <color> tint: AppStyle.foreground-muted;
    in property <color> text-color: Palette.foreground;
    in property <bool> focusable: true;
    in property <bool> roving-focus: false;
    in property <bool> above-modal: false;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <bool> highlighted: false;
    in property <Icon> trailing;
    out property <bool> has-hover: touch.has-hover;

    callback clicked();

    property <bool> has-trailing: root.trailing.paths.length > 0;

    border-radius: Radius.sm;
    background: touch.has-hover || root.highlighted ? AppStyle.overlay-hover : transparent;
    opacity: root.enabled || root.busy ? 1.0 : Opacity.disabled;

    touch := ClickArea {
        enabled: root.enabled;
        above-modal: root.above-modal;
        label: root.label;
        ring-radius: Radius.sm;
        focusable: root.focusable;
        roving-focus: root.roving-focus;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        if root.busy: DotPulse {
            width: IconSize.md;
            dot-size: Space.sm;
            tint: root.tint;
        }

        if !root.busy: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.icon;
            size: IconSize.md;
            stroke: root.tint;
        }

        Text {
            text: root.label;
            font-size: Fonts.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.text-color;
            overflow: elide;
        }

        if root.has-trailing: IconDisplay {
            cross-axis-self-alignment: center;
            icon: root.trailing;
            size: IconSize.sm;
            stroke: root.tint;
        }
    }
}
