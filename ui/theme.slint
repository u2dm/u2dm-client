    out property <length> reaction-strip-pad: Space.sm;
    out property <length> reaction-strip-overlap: Space.lg;
    out property <length> reaction-strip-width: root.reaction-strip-cell + 2 * root.reaction-strip-pad;
    out property <length> reaction-strip-overhang: root.reaction-strip-width - root.reaction-strip-overlap;
    out property <length> reaction-detail-width: 260px;
    out property <length> reaction-detail-height: 260px;
    out property <length> unread-dot: 12px;

    out property <length> drawer-width: 300px;
    out property <length> drawer-min-width: 240px;
    out property <length> drawer-header: 148px;
    out property <length> drawer-accounts-row: 84px;
    out property <length> drawer-inset: 20px;
    out property <length> drawer-row: 48px;
    out property <length> drawer-avatar: 60px;
    out property <length> drawer-close-inset: 52px;
    out property <length> overlay-peek: 44px;

    out property <length> media-width-max: 400px;
    out property <length> media-width-min: 140px;
    out property <length> media-height-max: 380px;
    out property <length> media-height-min: 80px;
    out property <length> sticker-max-extent: 176px;

    out property <length> toast-min-width: 200px;
    out property <length> toast-max-width: 500px;

    out property <length> login-glow-min-width: 360px;
    out property <length> login-dense-below: 620px;
    out property <length> login-card-margin: 40px;
    out property <length> login-mark: 60px;
    out property <length> login-mark-dense: 48px;
    out property <length> login-mark-compact: 52px;

    out property <length> verify-status-circle: 56px;
